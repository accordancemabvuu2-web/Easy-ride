ata-name=\"results description text\">\n                                Explore current buy listings from the marketplace.\n                            </p>\n                        </div>\n                        <a class=\"browse-link\" data-kid=\"1-4-2-4-1-1-2\" data-name=\"browse all listings link\" href=\"/marketplace?mode=buy\">\n                            Browse all sale listings\n                            <i aria-hidden=\"true\" class=\"icon icon-arrow-up-right\" data-kid=\"1-4-2-4-1-1-2-1\" data-name=\"arrow up right icon\">\n                            </i>\n                        </a>\n                    </div>\n                    <div class=\"empty-state\" data-kid=\"1-4-2-4-1-2\" data-name=\"empty results state card\" role=\"status\">\n                        <div class=\"empty-art\" data-kid=\"1-4-2-4-1-2-1\" data-name=\"empty state illustration circle\">\n                            <i aria-hidden=\"true\" class=\"icon icon-car-front\" data-kid=\"1-4-2-4-1-2-1-1\" data-name=\"car front illustration icon\">\n                            </i>\n                        </div>\n                        <div class=\"empty-copy\" data-kid=\"1-4-2-4-1-2-2\" data-name=\"empty state copy block\">\n                            <h3 data-kid=\"1-4-2-4-1-2-2-1\" data-name=\"empty state title heading\">\n                                No vehicles to show yet\n                            </h3>\n                            <p data-kid=\"1-4-2-4-1-2-2-2\" data-name=\"empty state description text\">\n                                There are no active buy listings to display right now. Browse the full marketplace to explore what’s available.\n                            </p>\n                            <a class=\"empty-action\" data-kid=\"1-4-2-4-1-2-2-3\" data-name=\"browse sale vehicles action button\" href=\"/marketplace?mode=buy\">\n                                Browse sale vehicles\n                                <i aria-hidden=\"true\" class=\"icon icon-arrow-right\" data-kid=\"1-4-2-4-1-2-2-3-1\" data-name=\"arrow right icon\">\n                                </i>\n                            </a>\n                        </div>\n                    </div>\n                </section>\n                <aside aria-labelledby=\"activity-title\" data-kid=\"1-4-2-4-2\" data-name=\"account activity sidebar\">\n                    <div class=\"aside-panel\" data-kid=\"1-4-2-4-2-1\" data-name=\"account activity panel\">\n                        <h2 data-kid=\"1-4-2-4-2-1-1\" data-name=\"account panel heading\" id=\"activity-title\">\n                            Your account\n                        </h2>\n                        <a class=\"activity-row\" data-kid=\"1-4-2-4-2-1-2\" data-name=\"favorites activity row\" href=\"/favorites\">\n                            <span class=\"row-start\" data-kid=\"1-4-2-4-2-1-2-1\" data-name=\"favorites row label group\">\n                                <i aria-hidden=\"true\" class=\"icon icon-heart\" data-kid=\"1-4-2-4-2-1-2-1-1\" data-name=\"heart icon\">\n                                </i>\n                                Favorites\n                            </span>\n                            <i aria-hidden=\"true\" class=\"icon arrow icon-arrow-up-right\" data-kid=\"1-4-2-4-2-1-2-2\" data-name=\"favorites row arrow icon\">\n                            </i>\n                        </a>\n                        <a class=\"activity-row\" data-kid=\"1-4-2-4-2-1-3\" data-name=\"offers activity row\" href=\"/offers\">\n                            <span class=\"row-start\" data-kid=\"1-4-2-4-2-1-3-1\" data-name=\"offers row label group\">\n                                <i aria-hidden=\"true\" class=\"icon icon-badge-dollar-sign\" data-kid=\"1-4-2-4-2-1-3-1-1\" data-name=\"dollar badge icon\">\n                                </i>\n                                Offers\n                            </span>\n                            <i aria-hidden=\"true\" class=\"icon arrow icon-arrow-up-right\" data-kid=\"1-4-2-4-2-1-3-2\" data-name=\"offers row arrow icon\">\n                            </i>\n                        </a>\n                        <a class=\"activity-row\" data-kid=\"1-4-2-4-2-1-4\" data-name=\"bookings activity row\" href=\"/bookings\">\n                            <span class=\"row-start\" data-kid=\"1-4-2-4-2-1-4-1\" data-name=\"bookings row label group\">\n                                <i aria-hidden=\"true\" class=\"icon icon-calendar-days\" data-kid=\"1-4-2-4-2-1-4-1-1\" data-name=\"calendar icon\">\n                                </i>\n                                Bookings\n                            </span>\n                            <i aria-hidden=\"true\" class=\"icon arrow icon-arrow-up-right\" data-kid=\"1-4-2-4-2-1-4-2\" data-name=\"bookings row arrow icon\">\n                            </i>\n                        </a>\n                        <a class=\"activity-row\" data-kid=\"1-4-2-4-2-1-5\" data-name=\"messages activity row\" href=\"/messages\">\n                            <span class=\"row-start\" data-kid=\"1-4-2-4-2-1-5-1\" data-name=\"messages row label group\">\n                                <i aria-hidden=\"true\" class=\"icon icon-message-circle\" data-kid=\"1-4-2-4-2-1-5-1-1\" data-name=\"message bubble icon\">\n                                </i>\n                                Messages\n                            </span>\n                            <i aria-hidden=\"true\" class=\"icon arrow icon-arrow-up-right\" data-kid=\"1-4-2-4-2-1-5-2\" data-name=\"messages row arrow icon\">\n                            </i>\n                        </a>\n                    </div>\n                    <div class=\"aside-help\" data-kid=\"1-4-2-4-2-2\" data-name=\"support help callout\">\n                        <h3 data-kid=\"1-4-2-4-2-2-1\" data-name=\"support callout heading\">\n                            Need help choosing?\n                        </h3>\n                        <p data-kid=\"1-4-2-4-2-2-2\" data-name=\"support callout description text\">\n                            Get help with buying, renting, or managing your account.\n                        </p>\n                        <a data-kid=\"1-4-2-4-2-2-3\" data-name=\"contact support link\" href=\"/support\">\n                            Contact support\n                            <i aria-hidden=\"true\" class=\"icon icon-arrow-right\" data-kid=\"1-4-2-4-2-2-3-1\" data-name=\"arrow right icon\">\n                            </i>\n                        </a>\n                    </div>\n                </aside>\n            </div>\n        </main>\n    </div>\n    <table aria-label=\"Design tokens\" class=\"color-spec\" data-kid=\"1-5\" data-name=\"design token color spec table\">\n        <tr data-kid=\"1-5-1\" data-name=\"design token row\">\n            <th data-kid=\"1-5-1-1\" data-name=\"nav token name header\">\n                Nav\n            </th>\n            <td data-kid=\"1-5-1-2\" data-name=\"nav token hex value\">\n                #063F2F\n            </td>\n            <th data-kid=\"1-5-1-3\" data-name=\"page token name header\">\n                Page\n            </th>\n            <td data-kid=\"1-5-1-4\" data-name=\"page token hex value\">\n                #F4F7F3\n            </td>\n            <th data-kid=\"1-5-1-5\" data-name=\"surface token name header\">\n                Surface\n            </th>\n            <td data-kid=\"1-5-1-6\" data-name=\"surface token hex value\">\n                #FFFFFF\n            </td>\n            <th data-kid=\"1-5-1-7\" data-name=\"inset token name header\">\n                Inset\n            </th>\n            <td data-kid=\"1-5-1-8\" data-name=\"inset token hex value\">\n                #EAF0E9\n            </td>\n            <th data-kid=\"1-5-1-9\" data-name=\"ink token name header\">\n                Ink\n            </th>\n            <td data-kid=\"1-5-1-10\" data-name=\"ink token hex value\">\n                #17251E\n            </td>\n            <th data-kid=\"1-5-1-11\" data-name=\"muted token name header\">\n                Muted\n            </th>\n            <td data-kid=\"1-5-1-12\" data-name=\"muted token hex value\">\n                #52665B\n            </td>\n            <th data-kid=\"1-5-1-13\" data-name=\"border token name header\">\n                Border\n            </th>\n            <td data-kid=\"1-5-1-14\" data-name=\"border token hex value\">\n                #CEDBD0\n            </td>\n            <th data-kid=\"1-5-1-15\" data-name=\"primary token name header\">\n                Primary\n            </th>\n            <td data-kid=\"1-5-1-16\" data-name=\"primary token hex value\">\n                #0B5D3B\n            </td>\n            <th data-kid=\"1-5-1-17\" data-name=\"gold token name header\">\n                Gold\n            </th>\n            <td data-kid=\"1-5-1-18\" data-name=\"gold token hex value\">\n                #C9A227\n            </td>\n            <th data-kid=\"1-5-1-19\" data-name=\"success token name header\">\n                Success\n            </th>\n            <td data-kid=\"1-5-1-20\" data-name=\"success token hex value\">\n                #24764C\n            </td>\n            <th data-kid=\"1-5-1-21\" data-name=\"warning token name header\">\n                Warning\n            </th>\n            <td data-kid=\"1-5-1-22\" data-name=\"warning token hex value\">\n                #9A6814\n            </td>\n            <th data-kid=\"1-5-1-23\" data-name=\"error token name header\">\n                Error\n            </th>\n            <td data-kid=\"1-5-1-24\" data-name=\"error token hex value\">\n                #AC3F35\n            </td>\n            <th data-kid=\"1-5-1-25\" data-name=\"info token name header\">\n                Info\n            </th>\n            <td data-kid=\"1-5-1-26\" data-name=\"info token hex value\">\n                #356F8A\n            </td>\n            <th data-kid=\"1-5-1-27\" data-name=\"neutral token name header\">\n                Neutral\n            </th>\n            <td data-kid=\"1-5-1-28\" data-name=\"neutral token hex value\">\n                #66716C\n            </td>\n            <th data-kid=\"1-5-1-29\" data-name=\"focus token name header\">\n                Focus\n            </th>\n            <td data-kid=\"1-5-1-30\" data-name=\"focus token hex value\">\n                #E3B72F\n            </td>\n        </tr>\n    </table>\n</div>\n",
      "comments": [],
      "created": "2026-10-16T12:28:48.287552+00:00",
      "modified": "2026-10-16T12:32:25.225318+00:00",
