      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Alfa+Slab+One&family=Cabin:wght@400;500;600;700&family=Mulish:wght@400;500;600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/boxicons@2.1.4/css/boxicons.min.css');\n:root{--nav:#123A2A;--page:#F8F4EA;--surface:#FFFEFA;--inset:#EFE9DA;--ink:#243127;--muted:#5E675B;--border:#DAD5C6;--primary:#0C6346;--gold:#BE8A24;--success:#28764B;--warning:#946618;--error:#AB4439;--info:#3F7282;--neutral:#697068;--focus:#E3AD35}\nbody{font-family:'Cabin',sans-serif}\n.font-display{font-family:'Mulish',sans-serif}\n.font-mark{font-family:'Alfa Slab One',serif}\n.icon{font-size:20px;line-height:1;color:currentColor;display:inline-flex;align-items:center;justify-content:center}\n#mobile-menu:checked~.app-shell .sidebar{transform:translateX(0)}\n#mobile-menu:checked~.app-shell .drawer-backdrop{display:block}\n@media(max-width:1023px){.desktop-sidebar{transform:translateX(-105%);position:fixed!important;inset:8px auto 8px 8px!important;z-index:90!important;width:min(300px,calc(100vw - 24px))!important;height:auto!important;max-height:calc(100dvh - 16px)!important;border-radius:18px!important;box-shadow:0 18px 48px #17251a3b!important;transition:transform .24s ease;overflow:hidden}.nav-scroll{overflow-y:auto;max-height:calc(100dvh - 215px)}.drawer-backdrop{display:none;position:fixed;inset:0;z-index:80;background:#17251a75}.content{margin-left:0!important;padding:20px 22px 42px!important}.mobile-header{display:flex!important}.desktop-header{display:none!important}.page-heading{align-items:flex-start!important;flex-direction:column}.heading-actions{width:100%}.heading-actions a{width:100%;justify-content:center}.inventory-empty{grid-template-columns:1fr!important}.inventory-empty .empty-copy{padding:22px!important}.nav-mobile-close{display:flex!important}}\n@media(max-width:520px){.content{padding:16px!important}.page-title{font-size:29px!important}.inventory-empty{padding:18px!important}.empty-copy{padding:12px!important}}\n:focus-visible{outline:3px solid var(--focus);outline-offset:3px}\n</style>\n<input aria-label=\"Toggle seller navigation\" class=\"sr-only\" data-kid=\"1\" data-name=\"mobile navigation toggle checkbox\" id=\"mobile-menu\" type=\"checkbox\"/>\n<div class=\"app-shell min-h-screen bg-[#F8F4EA] text-[#243127]\" data-kid=\"2\" data-name=\"seller dashboard app shell\">\n    <header class=\"mobile-header hidden sticky top-0 z-[70] h-[64px] items-center justify-between border-b border-[#DAD5C6] bg-[#FFFEFA] px-4 lg:hidden\" data-kid=\"2-1\" data-name=\"mobile top header bar\">\n        <a class=\"flex items-center gap-2.5 text-[#123A2A] no-underline\" data-kid=\"2-1-1\" data-name=\"mobile brand logo link\" href=\"/dashboard/seller\">\n            <span class=\"font-mark grid h-9 w-9 place-items-center rounded-[8px] bg-[#BE8A24] text-[15px] text-[#123A2A]\" data-kid=\"2-1-1-1\" data-name=\"mobile brand monogram badge\">\n                ER\n            </span>\n            <span class=\"font-display text-[16px] font-extrabold\" data-kid=\"2-1-1-2\" data-name=\"mobile brand name text\">\n                Easy Ride\n            </span>\n        </a>\n        <label aria-label=\"Open seller navigation\" class=\"flex h-11 w-11 cursor-pointer items-center justify-center rounded-[8px] border border-[#DAD5C6] bg-[#FFFEFA] text-[#123A2A]\" data-kid=\"2-1-2\" data-name=\"mobile menu open button\" for=\"mobile-menu\">\n            <i class=\"icon bx bx-menu text-[24px]\" data-kid=\"2-1-2-1\" data-name=\"mobile menu hamburger icon\">\n            </i>\n        </label>\n    </header>\n    <aside class=\"sidebar desktop-sidebar fixed inset-y-0 left-0 z-30 flex h-screen w-[268px] flex-col bg-[#123A2A] text-[#FFFEFA]\" data-kid=\"2-2\" data-name=\"desktop seller sidebar\">\n        <div class=\"flex items-center gap-3 px-6 pb-7 pt-7\" data-kid=\"2-2-1\" data-name=\"sidebar brand block\">\n            <span class=\"font-mark grid h-11 w-11 shrink-0 place-items-center rounded-[9px] bg-[#BE8A24] text-[16px] text-[#123A2A]\" data-kid=\"2-2-1-1\" data-name=\"sidebar brand monogram badge\">\n                ER\n            </span>\n            <span class=\"font-display leading-tight\" data-kid=\"2-2-1-2\" data-name=\"sidebar brand text block\">\n                <span class=\"block text-[16px] font-extrabold tracking-[-0.03em]\" data-kid=\"2-2-1-2-1\" data-name=\"sidebar brand name heading\">\n                    Easy Ride\n                </span>\n                <span class=\"mt-1 block text-[13px] text-[#FFFEFA]/65\" data-kid=\"2-2-1-2-2\" data-name=\"sidebar workspace subtitle text\">\n                    Seller workspace\n                </span>\n            </span>\n        </div>\n        <div class=\"mx-5 h-px bg-[#FFFEFA]/15\" data-kid=\"2-2-2\" data-name=\"sidebar top divider line\">\n        </div>\n        <nav aria-label=\"Seller workspace navigation\" class=\"nav-scroll flex-1 overflow-y-auto px-4 pb-4 pt-5\" data-kid=\"2-2-3\" data-name=\"main seller navigation menu\">\n            <p class=\"px-3 pb-2 text-[12px] font-bold text-[#FFFEFA]/55\" data-kid=\"2-2-3-1\" data-name=\"workspace nav section label\">\n                Workspace\n            </p>\n            <a aria-current=\"page\" class=\"mb-1 flex min-h-[46px] items-center gap-3 rounded-[8px] bg-[#EFE9DA] px-3 text-[14px] font-bold text-[#243127] no-underline\" data-kid=\"2-2-3-2\" data-name=\"active overview nav link\" href=\"/dashboard/seller\">\n                <i class=\"icon bx bx-grid-alt text-[20px]\" data-kid=\"2-2-3-2-1\" data-name=\"overview grid icon\">\n                </i>\n                <span data-kid=\"2-2-3-2-2\" data-name=\"overview nav link label\">\n                    Overview\n                </span>\n                <span aria-hidden=\"true\" class=\"ml-auto h-2 w-2 rounded-full bg-[#BE8A24]\" data-kid=\"2-2-3-2-3\" data-name=\"active state indicator dot\">\n                </span>\n            </a>\n            <a class=\"mb-1 flex min-h-[46px] items-center gap-3 rounded-[8px] px-3 text-[14px] font-semibold text-[#FFFEFA]/82 no-underline hover:bg-[#FFFEFA]/10\" data-kid=\"2-2-3-3\" data-name=\"my listings nav link\" href=\"#inventory\">\n                <i class=\"icon bx bx-car text-[20px]\" data-kid=\"2-2-3-3-1\" data-name=\"car icon\">\n                </i>\n                <span data-kid=\"2-2-3-3-2\" data-name=\"my listings nav link label\">\n                    My listings\n                </span>\n            </a>\n            <p class=\"px-3 pb-2 pt-5 text-[12px] font-bold text-[#FFFEFA]/55\" data-kid=\"2-2-3-4\" data-name=\"marketplace activity nav section label\">\n                Marketplace activity\n            </p>\n            <a class=\"mb-1 flex min-h-[46px] items-center gap-3 rounded-[8px] px-3 text-[14px] font-semibold text-[#FFFEFA]/82 no-underline hover:bg-[#FFFEFA]/10\" data-kid=\"2-2-3-5\" data-name=\"offers nav link\" href=\"/offers\">\n                <i class=\"icon bx bx-purchase-tag-alt text-[20px]\" data-kid=\"2-2-3-5-1\" data-name=\"purchase tag icon\">\n                </i>\n                <span data-kid=\"2-2-3-5-2\" data-name=\"offers nav link label\">\n                    Offers\n                </span>\n            </a>\n            <a class=\"mb-1 flex min-h-[46px] items-center gap-3 rounded-[8px] px-3 text-[14px] font-semibold text-[#FFFEFA]/82 no-underline hover:bg-[#FFFEFA]/10\" data-kid=\"2-2-3-6\" data-name=\"bookings nav link\" href=\"/bookings\">\n                <i class=\"icon bx bx-calendar-check text-[20px]\" data-kid=\"2-2-3-6-1\" data-name=\"calendar check icon\">\n                </i>\n                <span data-kid=\"2-2-3-6-2\" data-name=\"bookings nav link label\">\n                    Bookings\n                </span>\n            </a>\n            <a class=\"mb-1 flex min-h-[46px] items-center gap-3 rounded-[8px] px-3 text-[14px] font-semibold text-[#FFFEFA]/82 no-underline hover:bg-[#FFFEFA]/10\" data-kid=\"2-2-3-7\" data-name=\"messages nav link\" href=\"/messages\">\n                <i class=\"icon bx bx-message-rounded-dots text-[20px]\" data-kid=\"2-2-3-7-1\" data-name=\"message dots icon\">\n                </i>\n                <span data-kid=\"2-2-3-7-2\" data-name=\"messages nav link label\">\n                    Messages\n                </span>\n            </a>\n            <a class=\"mb-1 flex min-h-[46px] items-center gap-3 rounded-[8px] px-3 text-[14px] font-semibold text-[#FFFEFA]/82 no-underline hover:bg-[#FFFEFA]/10\" data-kid=\"2-2-3-8\" data-name=\"leads nav link\" href=\"/dashboard/seller/leads\">\n                <i class=\"icon bx bx-user-voice text-[20px]\" data-kid=\"2-2-3-8-1\" data-name=\"user voice icon\">\n                </i>\n                <span data-kid=\"2-2-3-8-2\" data-name=\"leads nav link label\">\n                    Leads\n                </span>\n            </a>\n            <p class=\"px-3 pb-2 pt-5 text-[12px] font-bold text-[#FFFEFA]/55\" data-kid=\"2-2-3-9\" data-name=\"account nav section label\">\n                Account\n            </p>\n            <a class=\"mb-1 flex min-h-[46px] items-center gap-3 rounded-[8px] px-3 text-[14px] font-semibold text-[#FFFEFA]/82 no-underline hover:bg-[#FFFEFA]/10\" data-kid=\"2-2-3-10\" data-name=\"profile nav link\" href=\"/dashboard/profile\">\n                <i class=\"icon bx bx-user text-[20px]\" data-kid=\"2-2-3-10-1\" data-name=\"user profile icon\">\n                </i>\n                <span data-kid=\"2-2-3-10-2\" data-name=\"profile nav link label\">\n                    Profile\n                </span>\n            </a>\n            <a class=\"mb-1 flex min-h-[46px] items-center gap-3 rounded-[8px] px-3 text-[14px] font-semibold text-[#FFFEFA]/82 no-underline hover:bg-[#FFFEFA]/10\" data-kid=\"2-2-3-11\" data-name=\"settings nav link\" href=\"/dashboard/settings\">\n                <i class=\"icon bx bx-cog text-[20px]\" data-kid=\"2-2-3-11-1\" data-name=\"settings gear icon\">\n                </i>\n                <span data-kid=\"2-2-3-11-2\" data-name=\"settings nav link label\">\n                    Settings\n                </span>\n            </a>\n            <a class=\"mb-1 flex min-h-[46px] items-center gap-3 rounded-[8px] px-3 text-[14px] font-semibold text-[#FFFEFA]/82 no-underline hover:bg-[#FFFEFA]/10\" data-kid=\"2-2-3-12\" data-name=\"support nav link\" href=\"/support\">\n                <i class=\"icon bx bx-help-circle text-[20px]\" data-kid=\"2-2-3-12-1\" data-name=\"help circle icon\">\n                </i>\n                <span data-kid=\"2-2-3-12-2\" data-name=\"support nav link label\">\n                    Support\n                </span>\n            </a>\n        </nav>\n        <div class=\"mx-5 h-px bg-[#FFFEFA]/15\" data-kid=\"2-2-4\" data-name=\"sidebar bottom divider line\">\n        </div>\n        <div class=\"flex items-center gap-3 px-6 py-5\" data-kid=\"2-2-5\" data-name=\"sidebar user account footer\">\n            <span class=\"grid h-9 w-9 place-items-center rounded-full border border-[#FFFEFA]/25 text-[#FFFEFA]/85\" data-kid=\"2-2-5-1\" data-name=\"account avatar circle\">\n                <i class=\"icon bx bx-user text-[19px]\" data-kid=\"2-2-5-1-1\" data-name=\"account avatar user icon\">\n                </i>\n            </span>\n            <div class=\"min-w-0\" data-kid=\"2-2-5-2\" data-name=\"account identity block\">\n                <p class=\"m-0 text-[13px] font-semibold\" data-kid=\"2-2-5-2-1\" data-name=\"account name text\">\n                    Your account\n                </p>\n                <p class=\"m-0 mt-1 text-[12px] text-[#FFFEFA]/60\" data-kid=\"2-2-5-2-2\" data-name=\"account role text\">\n                    Seller\n                </p>\n            </div>\n            <a aria-label=\"Sign out\" class=\"ml-auto rounded-[7px] p-2 text-[#FFFEFA]/70 no-underline hover:bg-[#FFFEFA]/10\" data-kid=\"2-2-5-3\" data-name=\"sign out link\" href=\"/\">\n                <i class=\"icon bx bx-log-out text-[19px]\" data-kid=\"2-2-5-3-1\" data-name=\"logout icon\">\n                </i>\n            </a>\n        </div>\n        <label class=\"nav-mobile-close hidden mx-4 mb-4 min-h-[44px] cursor-pointer items-center justify-center rounded-[8px] border border-[#FFFEFA]/25 text-[13px] font-bold text-[#FFFEFA]\" data-kid=\"2-2-6\" data-name=\"mobile close navigation button\" for=\"mobile-menu\">\n            Close navigation\n        </label>\n    </aside>\n    <label aria-label=\"Close seller navigation\" class=\"drawer-backdrop\" data-kid=\"2-3\" data-name=\"mobile drawer backdrop overlay\" for=\"mobile-menu\">\n    </label>\n    <main class=\"content ml-[268px] min-h-screen px-10 pb-14 pt-8 xl:px-[52px]\" data-kid=\"2-4\" data-name=\"main content area\">\n        <div class=\"desktop-header mb-8 flex items-center justify-between border-b border-[#DAD5C6] pb-5\" data-kid=\"2-4-1\" data-name=\"desktop page header bar\">\n            <div class=\"flex items-center gap-2 text-[13px] text-[#5E675B]\" data-kid=\"2-4-1-1\" data-name=\"breadcrumb navigation\">\n                <span data-kid=\"2-4-1-1-1\" data-name=\"breadcrumb workspace segment\">\n                    Seller workspace\n                </span>\n                <span aria-hidden=\"true\" data-kid=\"2-4-1-1-2\" data-name=\"breadcrumb separator\">\n                    /\n                </span>\n                <span class=\"font-semibold text-[#243127]\" data-kid=\"2-4-1-1-3\" data-name=\"breadcrumb current page segment\">\n                    Overview\n                </span>\n            </div>\n            <div class=\"flex items-center gap-3\" data-kid=\"2-4-1-2\" data-name=\"header user actions block\">\n                <span class=\"flex items-center gap-2 text-[13px] text-[#5E675B]\" data-kid=\"2-4-1-2-1\" data-name=\"role indicator with status dot\">\n                    <span class=\"h-2 w-2 rounded-full bg-[#697068]\" data-kid=\"2-4-1-2-1-1\" data-name=\"role status dot\">\n                    </span>\n                    Seller\n                </span>\n                <span class=\"grid h-9 w-9 place-items-center rounded-full bg-[#EFE9DA] text-[#123A2A]\" data-kid=\"2-4-1-2-2\" data-name=\"header avatar circle\">\n                    <i class=\"icon bx bx-user text-[18px]\" data-kid=\"2-4-1-2-2-1\" data-name=\"header avatar user icon\">\n                    </i>\n                </span>\n            </div>\n        </div>\n        <header class=\"page-heading mb-9 flex items-end justify-between gap-8\" data-kid=\"2-4-2\" data-name=\"page heading block\">\n            <div class=\"max-w-[700px]\" data-kid=\"2-4-2-1\" data-name=\"page title area\">\n                <h1 class=\"page-title font-display m-0 text-[36px] font-extrabold leading-[1.12] tracking-[-0.045em] text-[#243127]\" data-kid=\"2-4-2-1-1\" data-name=\"page main title heading\">\n                    Seller workspace\n                </h1>\n                <p class=\"mb-0 mt-3 max-w-[620px] text-[15px] leading-6 text-[#5E675B]\" data-kid=\"2-4-2-1-2\" data-name=\"page subtitle text\">\n                    Manage your listings and follow activity across your vehicles.\n                </p>\n            </div>\n            <div class=\"heading-actions shrink-0\" data-kid=\"2-4-2-2\" data-name=\"page heading actions container\">\n                <a class=\"inline-flex min-h-[48px] items-center gap-2 rounded-[8px] bg-[#0C6346] px-5 text-[14px] font-bold text-[#FFFEFA] no-underline shadow-[0_2px_0_#084d36] hover:bg-[#123A2A]\" data-kid=\"2-4-2-2-1\" data-name=\"add vehicle call-to-action button\" href=\"/create-listing\">\n                    <i class=\"icon bx bx-plus text-[21px]\" data-kid=\"2-4-2-2-1-1\" data-name=\"add plus icon\">\n                    </i>\n                    Add Vehicle\n                </a>\n            </div>\n        </header>\n        <section aria-labelledby=\"listings-title\" class=\"max-w-[1090px]\" data-kid=\"2-4-3\" data-name=\"my listings inventory section\" id=\"inventory\">\n            <div class=\"flex items-end justify-between border-b border-[#DAD5C6] pb-4\" data-kid=\"2-4-3-1\" data-name=\"section heading and label bar\">\n                <div data-kid=\"2-4-3-1-1\" data-name=\"section title and description block\">\n                    <h2 class=\"font-display m-0 text-[22px] font-extrabold tracking-[-0.025em] text-[#243127]\" data-kid=\"2-4-3-1-1-1\" data-name=\"section title heading\" id=\"listings-title\">\n                        My listings\n                    </h2>\n                    <p class=\"mb-0 mt-2 text-[14px] text-[#5E675B]\" data-kid=\"2-4-3-1-1-2\" data-name=\"section description text\">\n                        Vehicles you have listed for sale or rent.\n                    </p>\n                </div>\n                <span class=\"hidden text-[13px] text-[#697068] sm:block\" data-kid=\"2-4-3-1-2\" data-name=\"section inventory label\">\n                    Inventory\n                </span>\n            </div>\n            <div class=\"inventory-empty mt-5 grid min-h-[284px] grid-cols-[180px_1fr] items-center gap-6 rounded-[12px] border border-[#DAD5C6] bg-[#FFFEFA] px-8 py-7\" data-kid=\"2-4-3-2\" data-name=\"empty inventory state card\">\n                <div class=\"grid h-[132px] w-[156px] place-items-center rounded-[10px] bg-[#EFE9DA] text-[#123A2A]\" data-kid=\"2-4-3-2-1\" data-name=\"empty state illustration tile\">\n                    <i class=\"icon bx bx-car text-[58px]\" data-kid=\"2-4-3-2-1-1\" data-name=\"empty state car icon\">\n                    </i>\n                </div>\n                <div class=\"empty-copy py-5\" data-kid=\"2-4-3-2-2\" data-name=\"empty state copy block\">\n                    <h3 class=\"font-mark m-0 text-[24px] leading-[1.25] text-[#243127]\" data-kid=\"2-4-3-2-2-1\" data-name=\"empty state headline\">\n                        No vehicles listed yet\n                    </h3>\n                    <p class=\"mb-0 mt-3 max-w-[500px] text-[15px] leading-6 text-[#5E675B]\" data-kid=\"2-4-3-2-2-2\" data-name=\"empty state description text\">\n                        Add your first vehicle and start receiving interest. Once listed, its price, location, status, and views will appear here.\n                    </p>\n                </div>\n            </div>\n            <p class=\"mt-5 max-w-[780px] text-[13px] leading-5 text-[#697068]\" data-kid=\"2-4-3-3\" data-name=\"inventory helper note text\">\n                Offers, bookings, messages, and leads are available from the workspace navigation.\n            </p>\n        </section>\n        <footer class=\"mt-12 flex items-center justify-between border-t border-[#DAD5C6] pt-5 text-[12px] text-[#697068]\" data-kid=\"2-4-4\" data-name=\"page footer bar\">\n            <span data-kid=\"2-4-4-1\" data-name=\"footer brand line\">\n                Easy Ride · Seller workspace\n            </span>\n            <span class=\"hidden sm:inline\" data-kid=\"2-4-4-2\" data-name=\"footer accessibility note text\">\n                Status labels use words as well as color.\n            </span>\n        </footer>\n    </main>\n</div>\n",
