      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Raleway:wght@400;500;600;700;800&family=Source+Sans+3:wght@400;500;600;700&family=Yantramanav:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n:root{--nav:#092F2B;--page:#EFF4F1;--surface:#FFFFFF;--inset:#E3EDE8;--ink:#142C27;--muted:#50655F;--border:#CBDAD2;--primary:#146D55;--gold:#D0A43A;--success:#257653;--warning:#966919;--error:#B0443C;--info:#39738B;--neutral:#63726D;--focus:#E5B743}\nbody{margin:0;background:var(--page);color:var(--ink);font-family:'Source Sans 3',sans-serif;font-size:15px;line-height:1.45}\na{color:inherit;text-decoration:none}button,input{font:inherit}.shell{min-height:100vh}.sidebar{position:fixed;inset:0 auto 0 0;width:248px;background:var(--nav);color:#f6fbf8;padding:26px 17px 18px;display:flex;flex-direction:column}.brand{height:54px;display:flex;align-items:center;gap:12px;padding:0 11px;margin-bottom:34px}.brandmark{width:38px;height:38px;border-radius:8px;background:var(--gold);color:var(--nav);display:grid;place-items:center;font:800 17px 'Raleway',sans-serif;letter-spacing:-.08em}.brandname{font:700 17px 'Raleway',sans-serif;letter-spacing:-.03em}.branddesc{font-size:12px;color:#c1d2cc;margin-top:1px}.group{margin-bottom:25px}.group-title{font:700 11px 'Source Sans 3',sans-serif;letter-spacing:.11em;text-transform:uppercase;color:#a2b9b1;padding:0 12px;margin-bottom:8px}.nav-link{min-height:42px;border-radius:7px;padding:10px 12px;display:flex;gap:12px;align-items:center;color:#d0ded9;font-weight:600;font-size:14px;position:relative}.nav-link .icon{font-size:18px;width:19px;color:#a5c1b6}.nav-link.active{background:#174640;color:#fff}.nav-link.active .icon{color:#e6bd5a}.nav-link.active:after{content:'';position:absolute;right:13px;width:6px;height:6px;border-radius:50%;background:var(--gold)}.sidebar-bottom{margin-top:auto;border-top:1px solid #ffffff22;padding-top:13px}.account{display:flex;align-items:center;gap:11px;padding:11px 9px 14px;border-bottom:1px solid #ffffff1c;margin-bottom:7px}.account-icon{width:34px;height:34px;border-radius:50%;background:#204c45;color:#f6fbf8;display:grid;place-items:center;font-size:17px}.account small{display:block;color:#b2c5be;font-size:12px}.main{margin-left:248px;min-height:100vh;padding:0 42px 48px}.topbar{height:72px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--border);margin-bottom:30px}.crumb{color:var(--muted);font-size:14px}.crumb b{color:var(--ink);font-weight:600}.top-actions{display:flex;align-items:center;gap:16px}.toplink{font-weight:600;color:var(--primary);font-size:14px}.account-btn{display:flex;align-items:center;gap:9px;border:1px solid var(--border);background:#fff;border-radius:8px;padding:7px 12px;color:var(--ink);font-weight:600}.account-btn .icon{font-size:17px;color:var(--muted)}.content{max-width:1180px;margin:0 auto}.intro{display:flex;align-items:stretch;min-height:178px;background:var(--surface);border:1px solid var(--border);border-radius:10px;overflow:hidden}.intro-copy{padding:24px 28px;flex:1;display:flex;flex-direction:column;justify-content:center}.intro h1{font:700 30px/1.14 'Raleway',sans-serif;letter-spacing:-.04em;margin:0;color:var(--ink)}.intro p{margin:9px 0 16px;color:var(--muted);font-size:15px;max-width:560px}.intro-actions{display:flex;align-items:center;gap:12px}.primary-btn{display:inline-flex;min-height:42px;align-items:center;justify-content:center;gap:9px;padding:10px 17px;border-radius:7px;background:var(--primary);color:#fff;font-weight:700;font-size:14px}.primary-btn .icon{font-size:16px}.quiet-btn{display:inline-flex;min-height:42px;align-items:center;gap:8px;padding:9px 12px;color:var(--primary);font-weight:700;font-size:14px}.photo{width:34%;min-width:300px;position:relative;overflow:hidden;background:var(--inset)}.photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 63%;display:block}.photo:after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,#ffffff00 48%,#092f2b13)}.browse{margin-top:27px}.browse-head{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:14px}.browse h2{font:700 23px/1.2 'Raleway',sans-serif;letter-spacing:-.03em;margin:0}.browse-sub{color:var(--muted);margin:5px 0 0;font-size:14px}.mode-search{background:var(--surface);border:1px solid var(--border);border-radius:9px;padding:16px 17px 17px}.mode-row{display:flex;align-items:center;gap:16px;margin-bottom:14px}.mode-label{font-weight:700;font-size:14px;color:var(--ink)}.segmented{display:inline-flex;border:1px solid var(--border);border-radius:7px;background:var(--inset);padding:3px;gap:2px}.segmented button{border:0;background:transparent;color:var(--muted);border-radius:5px;padding:7px 18px;min-height:36px;font-size:14px;font-weight:700;cursor:pointer}.segmented button.selected{background:var(--primary);color:#fff;box-shadow:0 1px 2px #092f2b25}.search-grid{display:grid;grid-template-columns:1fr 160px;gap:10px;align-items:end}.field label{display:block;color:var(--ink);font-size:13px;font-weight:700;margin:0 0 5px}.search-input{height:43px;border:1px solid var(--border);border-radius:7px;background:#fff;display:flex;align-items:center;gap:10px;padding:0 12px}.search-input .icon{font-size:17px;color:var(--muted);flex:0 0 auto}.search-input input{border:0;outline:none;width:100%;min-width:0;color:var(--ink);background:transparent;font-size:14px}.search-input input::placeholder{color:#687b74;opacity:1}.search-btn{height:43px;border:0;border-radius:7px;background:var(--primary);color:#fff;font-weight:700;padding:0 16px;cursor:pointer}.search-btn .icon{font-size:16px;margin-right:5px}.lower{display:grid;grid-template-columns:minmax(0,1fr) 292px;gap:34px;margin-top:27px}.results-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}.results-header h2{font:700 21px/1.2 'Raleway',sans-serif;margin:0;letter-spacing:-.02em}.results-scope{font:600 13px 'Yantramanav',sans-serif;color:var(--muted)}.empty-result{min-height:204px;border:1px solid var(--border);border-radius:9px;background:var(--surface);display:flex;align-items:center;justify-content:center;text-align:center;padding:24px}.empty-result-inner{max-width:400px}.empty-mark{width:40px;height:40px;margin:0 auto 12px;border-radius:9px;background:var(--inset);display:grid;place-items:center;color:var(--primary);font-size:20px}.empty-result h3{font:700 18px/1.25 'Raleway',sans-serif;margin:0;color:var(--ink)}.empty-result p{margin:6px 0 14px;color:var(--muted);font-size:14px}.empty-result .primary-btn{min-height:38px;padding:8px 14px}.rightcol{padding-left:24px;border-left:1px solid var(--border)}.side-section{padding:0 0 18px}.side-section+.side-section{padding-top:18px;border-top:1px solid var(--border)}.side-section h3{font:700 17px 'Raleway',sans-serif;margin:0 0 10px;color:var(--ink)}.saved-empty{color:var(--muted);font-size:14px;margin:0 0 8px}.text-link{font-weight:700;color:var(--primary);font-size:14px}.activity-row{min-height:46px;display:flex;align-items:center;justify-content:space-between;gap:10px;border-bottom:1px solid #dce6e1;padding:9px 0}.activity-row:last-child{border-bottom:0}.activity-main{display:flex;align-items:center;gap:10px;font-weight:600;font-size:14px}.activity-main .icon{width:20px;font-size:17px;color:var(--primary)}.activity-row .arrow{font-size:15px;color:var(--muted)}.microcopy{margin-top:20px;color:var(--muted);font-size:13px}.mobilebar{display:none}.search-input:focus-within{outline:3px solid var(--focus);outline-offset:2px}.primary-btn:focus-visible,.quiet-btn:focus-visible,.nav-link:focus-visible,.account-btn:focus-visible,.search-btn:focus-visible,.segmented button:focus-visible{outline:3px solid var(--focus);outline-offset:3px}\n@media(max-width:1050px){.sidebar{width:218px}.main{margin-left:218px;padding:0 25px 40px}.photo{width:31%;min-width:250px}.lower{grid-template-columns:minmax(0,1fr) 250px;gap:22px}.rightcol{padding-left:18px}}\n@media(max-width:780px){.sidebar{display:none}.main{margin-left:0;padding:0 18px 32px}.mobilebar{height:60px;position:sticky;top:0;z-index:5;display:flex;align-items:center;justify-content:space-between;background:var(--nav);color:#fff;padding:0 18px}.mobile-brand{font:700 16px 'Raleway',sans-serif;display:flex;align-items:center;gap:9px}.mobile-mark{width:30px;height:30px;border-radius:6px;background:var(--gold);color:var(--nav);display:grid;place-items:center;font-weight:800}.mobile-menu{border:1px solid #ffffff54;background:#123c37;color:#fff;border-radius:7px;padding:8px 12px;font-weight:600}.mobile-links{display:none;background:#123c37;color:#fff;padding:8px 16px;gap:4px;position:sticky;top:60px;z-index:4}.mobile-links a{padding:10px 8px;border-bottom:1px solid #ffffff20;font-weight:600}.mobile-links:target{display:grid}.topbar{height:56px;margin-bottom:19px}.intro{min-height:unset}.intro-copy{padding:20px}.intro h1{font-size:25px}.intro p{font-size:14px}.photo{width:31%;min-width:180px}.intro-actions{gap:4px}.primary-btn{padding:8px 12px}.quiet-btn{padding:8px}.browse{margin-top:22px}.search-grid{grid-template-columns:minmax(0,1fr) 116px}.lower{grid-template-columns:1fr;gap:22px}.rightcol{border-left:0;border-top:1px solid var(--border);padding:18px 0 0;display:grid;grid-template-columns:1fr 1fr;gap:20px}.side-section+.side-section{border-top:0;padding-top:0}.empty-result{min-height:174px}}\n@media(max-width:520px){.topbar{height:48px}.top-actions .toplink{display:none}.crumb{font-size:13px}.intro{display:block}.intro-copy{padding:19px 18px}.intro h1{font-size:23px}.photo{width:100%;height:105px;min-width:0}.intro-actions{flex-wrap:wrap}.mode-search{padding:13px}.mode-row{display:block}.mode-label{display:block;margin-bottom:8px}.segmented{width:100%}.segmented button{flex:1}.search-grid{grid-template-columns:1fr}.search-btn{width:100%}.lower{margin-top:22px}.rightcol{grid-template-columns:1fr}.side-section+.side-section{border-top:1px solid var(--border);padding-top:15px}.empty-result{padding:20px 15px}.results-header h2{font-size:19px}.results-scope{font-size:12px}}\n</style>\n<div class=\"shell\" data-kid=\"1\" data-name=\"page layout container\">\n    <aside aria-label=\"Buyer workspace navigation\" class=\"sidebar\" data-kid=\"1-1\" data-name=\"sidebar navigation panel\">\n        <a aria-label=\"Easy Ride buyer workspace home\" class=\"brand\" data-kid=\"1-1-1\" data-name=\"brand logo link\" href=\"/dashboard/buyer\">\n            <span class=\"brandmark\" data-kid=\"1-1-1-1\" data-name=\"brand mark monogram\">\n                ER\n            </span>\n            <span data-kid=\"1-1-1-2\" data-name=\"brand name group container\">\n                <span class=\"brandname\" data-kid=\"1-1-1-2-1\" data-name=\"brand name text\">\n                    Easy Ride\n                </span>\n                <span class=\"branddesc\" data-kid=\"1-1-1-2-2\" data-name=\"brand description subtitle\">\n                    Buyer workspace\n                </span>\n            </span>\n        </a>\n        <nav data-kid=\"1-1-2\" data-name=\"sidebar main navigation\">\n            <div class=\"group\" data-kid=\"1-1-2-1\" data-name=\"explore navigation group\">\n                <div class=\"group-title\" data-kid=\"1-1-2-1-1\" data-name=\"explore group label\">\n                    Explore\n                </div>\n                <a aria-current=\"page\" class=\"nav-link active\" data-kid=\"1-1-2-1-2\" data-name=\"overview navigation link (active)\" href=\"/dashboard/buyer\">\n                    <i class=\"icon icon-car-front\" data-kid=\"1-1-2-1-2-1\" data-name=\"car front icon\">\n                    </i>\n                    Overview\n                </a>\n                <a class=\"nav-link\" data-kid=\"1-1-2-1-3\" data-name=\"favorites navigation link\" href=\"/favorites\">\n                    <i class=\"icon icon-heart\" data-kid=\"1-1-2-1-3-1\" data-name=\"heart icon\">\n                    </i>\n                    Favorites\n                </a>\n            </div>\n            <div class=\"group\" data-kid=\"1-1-2-2\" data-name=\"your activity navigation group\">\n                <div class=\"group-title\" data-kid=\"1-1-2-2-1\" data-name=\"your activity group label\">\n                    Your activity\n                </div>\n                <a class=\"nav-link\" data-kid=\"1-1-2-2-2\" data-name=\"offers navigation link\" href=\"/offers\">\n                    <i class=\"icon icon-badge-dollar-sign\" data-kid=\"1-1-2-2-2-1\" data-name=\"dollar badge icon\">\n                    </i>\n                    Offers\n                </a>\n                <a class=\"nav-link\" data-kid=\"1-1-2-2-3\" data-name=\"bookings navigation link\" href=\"/bookings\">\n                    <i class=\"icon icon-calendar-days\" data-kid=\"1-1-2-2-3-1\" data-name=\"calendar days icon\">\n                    </i>\n                    Bookings\n                </a>\n                <a class=\"nav-link\" data-kid=\"1-1-2-2-4\" data-name=\"messages navigation link\" href=\"/messages\">\n                    <i class=\"icon icon-message-circle\" data-kid=\"1-1-2-2-4-1\" data-name=\"message circle icon\">\n                    </i>\n                    Messages\n                </a>\n                <a class=\"nav-link\" data-kid=\"1-1-2-2-5\" data-name=\"notifications navigation link\" href=\"/notifications\">\n                    <i class=\"icon icon-bell\" data-kid=\"1-1-2-2-5-1\" data-name=\"bell icon\">\n                    </i>\n                    Notifications\n                </a>\n            </div>\n            <div class=\"group\" data-kid=\"1-1-2-3\" data-name=\"help navigation group\">\n                <div class=\"group-title\" data-kid=\"1-1-2-3-1\" data-name=\"help group label\">\n                    Help\n                </div>\n                <a class=\"nav-link\" data-kid=\"1-1-2-3-2\" data-name=\"support navigation link\" href=\"/support\">\n                    <i class=\"icon icon-circle-help\" data-kid=\"1-1-2-3-2-1\" data-name=\"help circle icon\">\n                    </i>\n                    Support\n                </a>\n            </div>\n        </nav>\n        <div class=\"sidebar-bottom\" data-kid=\"1-1-3\" data-name=\"sidebar bottom section\">\n            <div class=\"account\" data-kid=\"1-1-3-1\" data-name=\"account summary block\">\n                <span class=\"account-icon\" data-kid=\"1-1-3-1-1\" data-name=\"account avatar icon\">\n                    <i class=\"icon icon-user-round\" data-kid=\"1-1-3-1-1-1\" data-name=\"user circle icon\">\n                    </i>\n                </span>\n                <span data-kid=\"1-1-3-1-2\" data-name=\"account name group container\">\n                    <strong data-kid=\"1-1-3-1-2-1\" data-name=\"account name text\">\n                        Buyer account\n                    </strong>\n                    <small data-kid=\"1-1-3-1-2-2\" data-name=\"account subtitle text\">\n                        Profile and preferences\n                    </small>\n                </span>\n            </div>\n            <a class=\"nav-link\" data-kid=\"1-1-3-2\" data-name=\"profile navigation link\" href=\"/dashboard/profile\">\n                <i class=\"icon icon-user-round\" data-kid=\"1-1-3-2-1\" data-name=\"user circle icon\">\n                </i>\n                Profile\n            </a>\n            <a class=\"nav-link\" data-kid=\"1-1-3-3\" data-name=\"settings navigation link\" href=\"/dashboard/settings\">\n                <i class=\"icon icon-settings\" data-kid=\"1-1-3-3-1\" data-name=\"settings gear icon\">\n                </i>\n                Settings\n            </a>\n            <a class=\"nav-link\" data-kid=\"1-1-3-4\" data-name=\"log out navigation link\" href=\"/login\">\n                <i class=\"icon icon-log-out\" data-kid=\"1-1-3-4-1\" data-name=\"log out icon\">\n                </i>\n                Log out\n            </a>\n        </div>\n    </aside>\n    <header class=\"mobilebar\" data-kid=\"1-2\" data-name=\"mobile top nav bar\">\n        <a class=\"mobile-brand\" data-kid=\"1-2-1\" data-name=\"mobile brand link\" href=\"/dashboard/buyer\">\n            <span class=\"mobile-mark\" data-kid=\"1-2-1-1\" data-name=\"mobile brand mark monogram\">\n                ER\n            </span>\n            Easy Ride\n        </a>\n        <a aria-controls=\"mobile-menu\" class=\"mobile-menu\" data-kid=\"1-2-2\" data-name=\"mobile menu toggle link\" href=\"#mobile-menu\">\n            Menu\n        </a>\n    </header>\n    <nav aria-label=\"Buyer navigation\" class=\"mobile-links\" data-kid=\"1-3\" data-name=\"mobile navigation menu\" id=\"mobile-menu\">\n        <a data-kid=\"1-3-1\" data-name=\"mobile overview nav link\" href=\"/dashboard/buyer\">\n            Overview\n        </a>\n        <a data-kid=\"1-3-2\" data-name=\"mobile favorites nav link\" href=\"/favorites\">\n            Favorites\n        </a>\n        <a data-kid=\"1-3-3\" data-name=\"mobile offers nav link\" href=\"/offers\">\n            Offers\n        </a>\n        <a data-kid=\"1-3-4\" data-name=\"mobile bookings nav link\" href=\"/bookings\">\n            Bookings\n        </a>\n        <a data-kid=\"1-3-5\" data-name=\"mobile messages nav link\" href=\"/messages\">\n            Messages\n        </a>\n        <a data-kid=\"1-3-6\" data-name=\"mobile notifications nav link\" href=\"/notifications\">\n            Notifications\n        </a>\n        <a data-kid=\"1-3-7\" data-name=\"mobile support nav link\" href=\"/support\">\n            Support\n        </a>\n        <a data-kid=\"1-3-8\" data-name=\"mobile profile nav link\" href=\"/dashboard/profile\">\n            Profile\n        </a>\n        <a data-kid=\"1-3-9\" data-name=\"mobile settings nav link\" href=\"/dashboard/settings\">\n            Settings\n        </a>\n    </nav>\n    <main class=\"main\" data-kid=\"1-4\" data-name=\"main content area\">\n        <div class=\"topbar\" data-kid=\"1-4-1\" data-name=\"top bar\">\n            <div class=\"crumb\" data-kid=\"1-4-1-1\" data-name=\"breadcrumb trails\">\n                Workspace\n                <span aria-hidden=\"true\" data-kid=\"1-4-1-1-1\" data-name=\"breadcrumb separator\">\n                    /\n                </span>\n                <b data-kid=\"1-4-1-1-2\" data-name=\"current breadcrumb page\">\n                    Buyer\n                </b>\n            </div>\n            <div class=\"top-actions\" data-kid=\"1-4-1-2\" data-name=\"top actions container\">\n                <a class=\"toplink\" data-kid=\"1-4-1-2-1\" data-name=\"list vehicle action link\" href=\"/create-listing\">\n                    List a vehicle\n                </a>\n                <a class=\"account-btn\" data-kid=\"1-4-1-2-2\" data-name=\"account button link\" href=\"/dashboard/profile\">\n                    <i class=\"icon icon-user-round\" data-kid=\"1-4-1-2-2-1\" data-name=\"user circle icon\">\n                    </i>\n                    <span data-kid=\"1-4-1-2-2-2\" data-name=\"account button label\">\n                        Account\n                    </span>\n                </a>\n            </div>\n        </div>\n        <div class=\"content\" data-kid=\"1-4-2\" data-name=\"page content container\">\n            <section aria-labelledby=\"intro-title\" class=\"intro\" data-kid=\"1-4-2-1\" data-name=\"intro hero section\">\n                <div class=\"intro-copy\" data-kid=\"1-4-2-1-1\" data-name=\"intro copy container\">\n                    <h1 data-kid=\"1-4-2-1-1-1\" data-name=\"hero headline text\" id=\"intro-title\">\n                        Find your next vehicle\n                    </h1>\n                    <p data-kid=\"1-4-2-1-1-2\" data-name=\"hero supporting description\">\n                        Explore vehicles for sale or rent, save your favourites, and connect with trusted sellers.\n                    </p>\n                    <div class=\"intro-actions\" data-kid=\"1-4-2-1-1-3\" data-name=\"hero action buttons container\">\n                        <a class=\"primary-btn\" data-kid=\"1-4-2-1-1-3-1\" data-name=\"primary browse vehicles call-to-action\" href=\"/marketplace?mode=buy\">\n                            Browse vehicles\n                            <i class=\"icon icon-arrow-up-right\" data-kid=\"1-4-2-1-1-3-1-1\" data-name=\"arrow up right icon\">\n                            </i>\n                        </a>\n                        <a class=\"quiet-btn\" data-kid=\"1-4-2-1-1-3-2\" data-name=\"secondary list a vehicle link\" href=\"/create-listing\">\n                            List a vehicle\n                            <i class=\"icon icon-arrow-right\" data-kid=\"1-4-2-1-1-3-2-1\" data-name=\"arrow right icon\">\n                            </i>\n                        </a>\n                    </div>\n                </div>\n                <div class=\"photo\" data-kid=\"1-4-2-1-2\" data-name=\"hero photo container\">\n                    <img alt=\"A Toyota Hilux parked beside an open road\" data-kid=\"1-4-2-1-2-1\" data-name=\"hero vehicle photo\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/images/pexels-dilrubasaricimen-7534335.jpg\"/>\n                </div>\n            </section>\n            <section aria-labelledby=\"browse-title\" class=\"browse\" data-kid=\"1-4-2-2\" data-name=\"browse marketplace section\">\n                <div class=\"browse-head\" data-kid=\"1-4-2-2-1\" data-name=\"browse section header row\">\n                    <div data-kid=\"1-4-2-2-1-1\" data-name=\"browse title group\">\n                        <h2 data-kid=\"1-4-2-2-1-1-1\" data-name=\"browse section heading\" id=\"browse-title\">\n                            Browse marketplace\n                        </h2>\n                        <p class=\"browse-sub\" data-kid=\"1-4-2-2-1-1-2\" data-name=\"browse subtitle text\">\n                            Search listings by vehicle or location.\n                        </p>\n                    </div>\n                </div>\n                <div class=\"mode-search\" data-kid=\"1-4-2-2-2\" data-name=\"search panel container\">\n                    <div class=\"mode-row\" data-kid=\"1-4-2-2-2-1\" data-name=\"mode selection row\">\n                        <span class=\"mode-label\" data-kid=\"1-4-2-2-2-1-1\" data-name=\"mode label text\">\n                            I’m looking to\n                        </span>\n                        <div aria-label=\"Choose listing type\" class=\"segmented\" data-kid=\"1-4-2-2-2-1-2\" data-name=\"listing type segmented control\" role=\"group\">\n                            <button aria-pressed=\"true\" class=\"selected\" data-kid=\"1-4-2-2-2-1-2-1\" data-name=\"buy mode segment button\" type=\"button\">\n                                Buy\n                            </button>\n                            <button aria-pressed=\"false\" data-kid=\"1-4-2-2-2-1-2-2\" data-name=\"rent mode segment button\" type=\"button\">\n                                Rent\n                            </button>\n                        </div>\n                    </div>\n                    <div class=\"search-grid\" data-kid=\"1-4-2-2-2-2\" data-name=\"search input grid false\">\n                        <div class=\"field\" data-kid=\"1-4-2-2-2-2-1\" data-name=\"search vehicles field\">\n                            <label data-kid=\"1-4-2-2-2-2-1-1\" data-name=\"search vehicles field label\" for=\"vehicle-search\">\n                                Search vehicles\n                            </label>\n                            <div class=\"search-input\" data-kid=\"1-4-2-2-2-2-1-2\" data-name=\"search input container with icon\">\n                                <i class=\"icon icon-search\" data-kid=\"1-4-2-2-2-2-1-2-1\" data-name=\"search icon\">\n                                </i>\n                                <input data-kid=\"1-4-2-2-2-2-1-2-2\" data-name=\"search input field\" id=\"vehicle-search\" placeholder=\"Make, model, or location\" type=\"search\"/>\n                            </div>\n                        </div>\n                        <button class=\"search-btn\" data-kid=\"1-4-2-2-2-2-2\" data-name=\"search submit button\" type=\"button\">\n                            <i class=\"icon icon-search\" data-kid=\"1-4-2-2-2-2-2-1\" data-name=\"search icon\">\n                            </i>\n                            Search\n                        </button>\n                    </div>\n                </div>\n            </section>\n            <div class=\"lower\" data-kid=\"1-4-2-3\" data-name=\"lower content grid\">\n                <section aria-labelledby=\"results-title\" data-kid=\"1-4-2-3-1\" data-name=\"results section\">\n                    <div class=\"results-header\" data-kid=\"1-4-2-3-1-1\" data-name=\"results header row\">\n                        <h2 data-kid=\"1-4-2-3-1-1-1\" data-name=\"results section heading\" id=\"results-title\">\n                            Vehicles for sale\n                        </h2>\n                        <span class=\"results-scope\" data-kid=\"1-4-2-3-1-1-2\" data-name=\"results scope label\">\n                            Marketplace listings\n                        </span>\n                    </div>\n                    <div class=\"empty-result\" data-kid=\"1-4-2-3-1-2\" data-name=\"empty results card\">\n                        <div class=\"empty-result-inner\" data-kid=\"1-4-2-3-1-2-1\" data-name=\"empty result inner container\">\n                            <div class=\"empty-mark\" data-kid=\"1-4-2-3-1-2-1-1\" data-name=\"empty state icon badge\">\n                                <i class=\"icon icon-car-front\" data-kid=\"1-4-2-3-1-2-1-1-1\" data-name=\"car front icon\">\n                                </i>\n                            </div>\n                            <h3 data-kid=\"1-4-2-3-1-2-1-2\" data-name=\"empty state headline\">\n                                No vehicles available just yet\n                            </h3>\n                            <p data-kid=\"1-4-2-3-1-2-1-3\" data-name=\"empty state description\">\n                                Check back soon as sellers add more vehicles to the marketplace.\n                            </p>\n                            <a class=\"primary-btn\" data-kid=\"1-4-2-3-1-2-1-4\" data-name=\"empty state call-to-action button\" href=\"/marketplace?mode=buy\">\n                                Browse the marketplace\n                                <i class=\"icon icon-arrow-right\" data-kid=\"1-4-2-3-1-2-1-4-1\" data-name=\"arrow right icon\">\n                                </i>\n                            </a>\n                        </div>\n                    </div>\n                    <p class=\"microcopy\" data-kid=\"1-4-2-3-1-3\" data-name=\"microcopy note text\">\n                        Buying and renting are both available from the marketplace search.\n                    </p>\n                </section>\n                <aside aria-label=\"Your marketplace activity\" class=\"rightcol\" data-kid=\"1-4-2-3-2\" data-name=\"right activity column\">\n                    <section class=\"side-section\" data-kid=\"1-4-2-3-2-1\" data-name=\"saved vehicles section\">\n                        <h3 data-kid=\"1-4-2-3-2-1-1\" data-name=\"saved vehicles heading\">\n                            Saved vehicles\n                        </h3>\n                        <p class=\"saved-empty\" data-kid=\"1-4-2-3-2-1-2\" data-name=\"saved empty state text\">\n                            No vehicles saved yet.\n                        </p>\n                        <a class=\"text-link\" data-kid=\"1-4-2-3-2-1-3\" data-name=\"open favorites text link\" href=\"/favorites\">\n                            Open Favorites\n                            <span aria-hidden=\"true\" data-kid=\"1-4-2-3-2-1-3-1\" data-name=\"arrow character\">\n                                →\n                            </span>\n                        </a>\n                    </section>\n                    <section class=\"side-section\" data-kid=\"1-4-2-3-2-2\" data-name=\"your activity section\">\n                        <h3 data-kid=\"1-4-2-3-2-2-1\" data-name=\"your activity heading\">\n                            Your activity\n                        </h3>\n                        <a class=\"activity-row\" data-kid=\"1-4-2-3-2-2-2\" data-name=\"offers activity row link\" href=\"/offers\">\n                            <span class=\"activity-main\" data-kid=\"1-4-2-3-2-2-2-1\" data-name=\"activity main label container\">\n                                <i class=\"icon icon-badge-dollar-sign\" data-kid=\"1-4-2-3-2-2-2-1-1\" data-name=\"dollar badge icon\">\n                                </i>\n                                Offers\n                            </span>\n                            <i class=\"icon icon-chevron-right arrow\" data-kid=\"1-4-2-3-2-2-2-2\" data-name=\"chevron right arrow icon\">\n                            </i>\n                        </a>\n                        <a class=\"activity-row\" data-kid=\"1-4-2-3-2-2-3\" data-name=\"bookings activity row link\" href=\"/bookings\">\n                            <span class=\"activity-main\" data-kid=\"1-4-2-3-2-2-3-1\" data-name=\"activity main label container\">\n                                <i class=\"icon icon-calendar-days\" data-kid=\"1-4-2-3-2-2-3-1-1\" data-name=\"calendar days icon\">\n                                </i>\n                                Bookings\n                            </span>\n                            <i class=\"icon icon-chevron-right arrow\" data-kid=\"1-4-2-3-2-2-3-2\" data-name=\"chevron right arrow icon\">\n                            </i>\n                        </a>\n                    </section>\n                </aside>\n            </div>\n        </div>\n    </main>\n</div>\n",
