{
  "name": "easy-ride",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "set-admin": "node scripts/set-admin-claim.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
