    },
    "var_77c2a0476754": {
      "type": "variant",
      "label": "Inventory-first · Marketplace",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 2760,
        "y": 0,
        "w": 1280,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n</style>\n<div class=\"min-h-screen bg-[#F3F6F2] text-[#19251F] [font-family:Inter,Arial,sans-serif]\" data-kid=\"1\" data-name=\"page layout container\">\n    <header class=\"border-b border-white/10 bg-[#052E16] text-white\" data-kid=\"1-1\" data-name=\"site header bar\">\n        <div class=\"mx-auto flex h-[72px] max-w-[1440px] items-center justify-between gap-8 px-8\" data-kid=\"1-1-1\" data-name=\"header content row\">\n            <a aria-label=\"Easy Ride home\" class=\"flex shrink-0 items-center gap-3\" data-kid=\"1-1-1-1\" data-name=\"brand logo link\" href=\"/\">\n                <span class=\"flex h-10 w-10 items-center justify-center rounded-xl bg-[#0B5D3B] text-white\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo icon badge\">\n                    <i aria-hidden=\"true\" class=\"icon-car-front text-[24px]\" data-kid=\"1-1-1-1-1-1\" data-name=\"car front icon\">\n                    </i>\n                </span>\n                <span class=\"text-[20px] font-bold tracking-tight\" data-kid=\"1-1-1-1-2\" data-name=\"brand wordmark text\">\n                    Easy\n                    <span class=\"text-[#E5BE42]\" data-dynamic=\"true\" data-kid=\"1-1-1-1-2-1\" data-name=\"brand accent word\" data-reason=\"text rewritten by script's typewriter effect from initial partial value to full 'Ride'\">\n                        Ride\n                    </span>\n                </span>\n            </a>\n            <nav aria-label=\"Main navigation\" class=\"flex h-full items-center gap-7 text-[14px] font-medium text-white/80\" data-kid=\"1-1-1-2\" data-name=\"main navigation bar\">\n                <a class=\"transition hover:text-white\" data-kid=\"1-1-1-2-1\" data-name=\"home nav link\" href=\"/\">\n                    Home\n                </a>\n                <a aria-current=\"page\" class=\"relative flex h-full items-center text-white\" data-kid=\"1-1-1-2-2\" data-name=\"marketplace nav link (active)\" href=\"/marketplace\">\n                    Marketplace\n                    <span class=\"absolute inset-x-0 bottom-0 h-[3px] rounded-t bg-[#E5BE42]\" data-kid=\"1-1-1-2-2-1\" data-name=\"active nav underline indicator\">\n                    </span>\n                </a>\n                <a class=\"transition hover:text-white\" data-kid=\"1-1-1-2-3\" data-name=\"map nav link\" href=\"/map\">\n                    Map\n                </a>\n                <a class=\"transition hover:text-white\" data-kid=\"1-1-1-2-4\" data-name=\"sell/rent nav link\" href=\"/create-listing\">\n                    Sell/Rent\n                </a>\n                <a class=\"transition hover:text-white\" data-kid=\"1-1-1-2-5\" data-name=\"about nav link\" href=\"/about\">\n                    About\n                </a>\n                <a class=\"transition hover:text-white\" data-kid=\"1-1-1-2-6\" data-name=\"contact nav link\" href=\"/support\">\n                    Contact\n                </a>\n            </nav>\n            <div class=\"flex shrink-0 items-center gap-3\" data-kid=\"1-1-1-3\" data-name=\"header auth actions group\">\n                <a class=\"rounded-lg px-4 py-2.5 text-[14px] font-semibold text-white/90 hover:bg-white/10\" data-kid=\"1-1-1-3-1\" data-name=\"login link\" href=\"/login\">\n                    Login\n                </a>\n                <a class=\"rounded-lg bg-[#0B5D3B] px-4 py-2.5 text-[14px] font-bold text-white hover:bg-[#084B30]\" data-kid=\"1-1-1-3-2\" data-name=\"sign up link\" href=\"/register\">\n                    Sign Up\n                </a>\n            </div>\n        </div>\n    </header>\n    <main class=\"mx-auto max-w-[1440px] px-8 pb-12 pt-9\" data-kid=\"1-2\" data-name=\"main content wrapper\">\n        <section aria-labelledby=\"page-title\" data-kid=\"1-2-1\" data-name=\"page title and search section\">\n            <div class=\"flex flex-wrap items-end justify-between gap-5\" data-kid=\"1-2-1-1\" data-name=\"page heading and type toggle row\">\n                <div data-kid=\"1-2-1-1-1\" data-name=\"page heading block\">\n                    <h1 class=\"text-[34px] font-bold leading-tight tracking-[-0.035em] text-[#15231B]\" data-kid=\"1-2-1-1-1-1\" data-name=\"page title heading\" id=\"page-title\">\n                        Vehicles for sale\n                    </h1>\n                    <p class=\"mt-2 text-[15px] leading-6 text-[#58685F]\" data-kid=\"1-2-1-1-1-2\" data-name=\"page subtitle text\">\n                        Compare the listed price, vehicle details and seller location before you get in touch.\n                    </p>\n                </div>\n                <div aria-label=\"Listing type\" class=\"inline-flex items-center rounded-xl border border-[#D6E0D9] bg-white p-1\" data-kid=\"1-2-1-1-2\" data-name=\"listing type toggle group\" role=\"group\">\n                    <button aria-pressed=\"false\" class=\"min-h-10 rounded-lg px-4 text-[14px] font-semibold text-[#53645A] hover:bg-[#F2F6F3]\" data-kid=\"1-2-1-1-2-1\" data-name=\"all vehicles toggle button\" type=\"button\">\n                        All vehicles\n                    </button>\n                    <button aria-pressed=\"true\" class=\"min-h-10 rounded-lg bg-[#0B5D3B] px-5 text-[14px] font-bold text-white shadow-sm\" data-kid=\"1-2-1-1-2-2\" data-name=\"buy toggle button\" type=\"button\">\n                        Buy\n                    </button>\n                    <button aria-pressed=\"false\" class=\"min-h-10 rounded-lg px-4 text-[14px] font-semibold text-[#53645A] hover:bg-[#F2F6F3]\" data-kid=\"1-2-1-1-2-3\" data-name=\"rent toggle button\" type=\"button\">\n                        Rent\n                    </button>\n                </div>\n            </div>\n            <label class=\"mt-6 flex min-h-[54px] w-full items-center gap-3 rounded-xl border border-[#D3DED6] bg-white px-4 shadow-sm focus-within:border-[#0B5D3B] focus-within:ring-2 focus-within:ring-[#0B5D3B]/15\" data-kid=\"1-2-1-2\" data-name=\"search input field\">\n                <i aria-hidden=\"true\" class=\"icon-search shrink-0 text-[19px] text-[#0B5D3B]\" data-kid=\"1-2-1-2-1\" data-name=\"search icon\">\n                </i>\n                <span class=\"sr-only\" data-kid=\"1-2-1-2-2\" data-name=\"search screen-reader label\">\n                    Search vehicles\n                </span>\n                <input aria-label=\"Search vehicles\" class=\"min-w-0 flex-1 bg-transparent text-[15px] text-[#19251F] outline-none placeholder:text-[#748279]\" data-kid=\"1-2-1-2-3\" data-name=\"search text input\" placeholder=\"Search by make, model or city\" type=\"search\"/>\n                <span class=\"hidden border-l border-[#E4EAE5] pl-4 text-[13px] text-[#748279] sm:block\" data-kid=\"1-2-1-2-4\" data-name=\"results update hint text\">\n                    Results update as you search\n                </span>\n            </label>\n            <p class=\"mt-3 flex items-center gap-2 text-[13px] leading-5 text-[#58685F]\" data-kid=\"1-2-1-3\" data-name=\"rental availability note\">\n                <i aria-hidden=\"true\" class=\"icon-calendar-days shrink-0 text-[15px] text-[#0B5D3B]\" data-kid=\"1-2-1-3-1\" data-name=\"calendar days icon\">\n                </i>\n                Rental dates are requests; availability is confirmed with the vehicle owner.\n            </p>\n        </section>\n        <section aria-label=\"Vehicle results and filters\" class=\"mt-8 grid items-start gap-7 lg:grid-cols-[250px_minmax(0,1fr)]\" data-kid=\"1-2-2\" data-name=\"results and filters grid\">\n            <aside aria-label=\"Vehicle filters\" class=\"rounded-xl border border-[#D8E1DB] bg-white px-4\" data-kid=\"1-2-2-1\" data-name=\"filters sidebar panel\">\n                <div class=\"flex items-center justify-between border-b border-[#E7ECE8] py-4\" data-kid=\"1-2-2-1-1\" data-name=\"filters header row\">\n                    <h2 class=\"flex items-center gap-2 text-[16px] font-bold text-[#1A2920]\" data-kid=\"1-2-2-1-1-1\" data-name=\"filters heading with icon\">\n                        <i aria-hidden=\"true\" class=\"icon-list-filter text-[17px] text-[#0B5D3B]\" data-kid=\"1-2-2-1-1-1-1\" data-name=\"list filter icon\">\n                        </i>\n                        Filters\n                    </h2>\n                    <button class=\"text-[13px] font-semibold text-[#0B5D3B] underline decoration-[#0B5D3B]/35 underline-offset-4\" data-kid=\"1-2-2-1-1-2\" data-name=\"clear all filters button\" type=\"button\">\n                        Clear all\n                    </button>\n                </div>\n                <div class=\"divide-y divide-[#E7ECE8]\" data-kid=\"1-2-2-1-2\" data-name=\"filters fieldset container\">\n                    <label class=\"block py-3.5\" data-kid=\"1-2-2-1-2-1\" data-name=\"location filter field\">\n                        <span class=\"mb-1.5 block text-[13px] font-semibold text-[#43534A]\" data-kid=\"1-2-2-1-2-1-1\" data-name=\"location filter label\">\n                            Location\n                        </span>\n                        <select class=\"min-h-10 w-full rounded-lg border border-[#D8E1DB] bg-white px-3 text-[14px] text-[#243329] outline-none focus:border-[#0B5D3B] focus:ring-2 focus:ring-[#0B5D3B]/15\" data-kid=\"1-2-2-1-2-1-2\" data-name=\"location filter select\">\n                            <option data-kid=\"1-2-2-1-2-1-2-1\" data-name=\"location option - all\">\n                                All locations\n                            </option>\n                            <option data-kid=\"1-2-2-1-2-1-2-2\" data-name=\"location option - Gweru\">\n                                Gweru\n                            </option>\n                            <option data-kid=\"1-2-2-1-2-1-2-3\" data-name=\"location option - Harare\">\n                                Harare\n                            </option>\n                            <option data-kid=\"1-2-2-1-2-1-2-4\" data-name=\"location option - Mutare\">\n                                Mutare\n                            </option>\n                        </select>\n                    </label>\n                    <div class=\"grid grid-cols-2 gap-2 py-3.5\" data-kid=\"1-2-2-1-2-2\" data-name=\"make and model filter row\">\n                        <label class=\"block min-w-0\" data-kid=\"1-2-2-1-2-2-1\" data-name=\"make filter field\">\n                            <span class=\"mb-1.5 block text-[13px] font-semibold text-[#43534A]\" data-kid=\"1-2-2-1-2-2-1-1\" data-name=\"make filter label\">\n                                Make\n                            </span>\n                            <select class=\"min-h-10 w-full rounded-lg border border-[#D8E1DB] bg-white px-2 text-[14px] text-[#243329] outline-none focus:border-[#0B5D3B]\" data-kid=\"1-2-2-1-2-2-1-2\" data-name=\"make filter select\">\n                                <option data-kid=\"1-2-2-1-2-2-1-2-1\" data-name=\"make option - any\">\n                                    Any make\n                                </option>\n                                <option data-kid=\"1-2-2-1-2-2-1-2-2\" data-name=\"make option - BMW\">\n                                    BMW\n                                </option>\n                                <option data-kid=\"1-2-2-1-2-2-1-2-3\" data-name=\"make option - Ford\">\n                                    Ford\n                                </option>\n                                <option data-kid=\"1-2-2-1-2-2-1-2-4\" data-name=\"make option - Mazda\">\n                                    Mazda\n                                </option>\n                                <option data-kid=\"1-2-2-1-2-2-1-2-5\" data-name=\"make option - Toyota\">\n                                    Toyota\n                                </option>\n                            </select>\n                        </label>\n                        <label class=\"block min-w-0\" data-kid=\"1-2-2-1-2-2-2\" data-name=\"model filter field\">\n                            <span class=\"mb-1.5 block text-[13px] font-semibold text-[#43534A]\" data-kid=\"1-2-2-1-2-2-2-1\" data-name=\"model filter label\">\n                                Model\n                            </span>\n                            <select class=\"min-h-10 w-full rounded-lg border border-[#D8E1DB] bg-white px-2 text-[14px] text-[#243329] outline-none focus:border-[#0B5D3B]\" data-kid=\"1-2-2-1-2-2-2-2\" data-name=\"model filter select\">\n                                <option data-kid=\"1-2-2-1-2-2-2-2-1\" data-name=\"model option - any\">\n                                    Any model\n                                </option>\n                                <option data-kid=\"1-2-2-1-2-2-2-2-2\" data-name=\"model option - 3 Series\">\n                                    3 Series\n                                </option>\n                                <option data-kid=\"1-2-2-1-2-2-2-2-3\" data-name=\"model option - Axio\">\n                                    Axio\n                                </option>\n                                <option data-kid=\"1-2-2-1-2-2-2-2-4\" data-name=\"model option - Demio\">\n                                    Demio\n                                </option>\n                                <option data-kid=\"1-2-2-1-2-2-2-2-5\" data-name=\"model option - Ranger\">\n                                    Ranger\n                                </option>\n                            </select>\n                        </label>\n                    </div>\n                    <div class=\"grid grid-cols-2 gap-2 py-3.5\" data-kid=\"1-2-2-1-2-3\" data-name=\"price range filter row\">\n                        <label class=\"block min-w-0\" data-kid=\"1-2-2-1-2-3-1\" data-name=\"min price filter field\">\n                            <span class=\"mb-1.5 block text-[13px] font-semibold text-[#43534A]\" data-kid=\"1-2-2-1-2-3-1-1\" data-name=\"min price filter label\">\n                                Min price (USD)\n                            </span>\n                            <select class=\"min-h-10 w-full rounded-lg border border-[#D8E1DB] bg-white px-2 text-[13px] text-[#243329] outline-none focus:border-[#0B5D3B]\" data-kid=\"1-2-2-1-2-3-1-2\" data-name=\"min price filter select\">\n                                <option data-kid=\"1-2-2-1-2-3-1-2-1\" data-name=\"min price option - none\">\n                                    No minimum\n                                </option>\n                                <option data-kid=\"1-2-2-1-2-3-1-2-2\" data-name=\"min price option - 1000\">\n                                    USD 1,000\n                                </option>\n                                <option data-kid=\"1-2-2-1-2-3-1-2-3\" data-name=\"min price option - 2500\">\n                                    USD 2,500\n                                </option>\n                                <option data-kid=\"1-2-2-1-2-3-1-2-4\" data-name=\"min price option - 5000\">\n                                    USD 5,000\n                                </option>\n                                <option data-kid=\"1-2-2-1-2-3-1-2-5\" data-name=\"min price option - 10000\">\n                                    USD 10,000\n                                </option>\n                                <option data-kid=\"1-2-2-1-2-3-1-2-6\" data-name=\"min price option - 15000\">\n                                    USD 15,000\n                                </option>\n                                <option data-kid=\"1-2-2-1-2-3-1-2-7\" data-name=\"min price option - 25000\">\n                                    USD 25,000\n                                </option>\n                                <option data-kid=\"1-2-2-1-2-3-1-2-8\" 