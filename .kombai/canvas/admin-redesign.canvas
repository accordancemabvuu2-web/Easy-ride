    "var_1420a3c62132": {
      "type": "variant",
      "label": "Account detail — suspension confirmation",
      "parentId": "var_ac36566bd3a1",
      "themeId": null,
      "rect": {
        "x": 3080,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n\n*,*::before,*::after{box-sizing:border-box}\n:root{\n  --forest:#08281D;--green:#0B5D3B;--green-dark:#0A4E32;--green-soft:#EAF3EE;--green-line:#CFE2D7;\n  --gold:#C9A227;--canvas:#F4F6F5;--surface:#FFFFFF;--ink:#10201A;--ink-2:#4C5C54;--ink-3:#7B8A82;\n  --line:#E3E9E5;--line-2:#EEF2EF;--mono:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;\n}\nhtml,body{margin:0;padding:0;height:100%}\nbody{font-family:'Inter',-apple-system,'Segoe UI',Arial,sans-serif;background:var(--canvas);color:var(--ink);font-size:14px;line-height:1.45;-webkit-font-smoothing:antialiased;overflow:hidden}\nbutton{font-family:inherit;font-size:inherit;color:inherit}\na{color:inherit;text-decoration:none}\n[class^=\"icon-\"],[class*=\" icon-\"]{line-height:1;display:inline-block}\n:focus-visible{outline:2px solid var(--green);outline-offset:2px}\n.tnum{font-variant-numeric:tabular-nums}\n.mono{font-family:var(--mono);font-size:12px;letter-spacing:-.01em}\n.app{position:relative;width:1440px;height:900px;display:flex;overflow:hidden;background:var(--canvas)}\n\n.sidebar{width:288px;flex:0 0 288px;height:900px;background:var(--forest);color:#fff;display:flex;flex-direction:column}\n.brand{height:88px;flex:0 0 88px;display:flex;align-items:center;gap:12px;padding:0 20px;border-bottom:1px solid rgba(255,255,255,.08)}\n.brand-mark{width:38px;height:38px;border-radius:10px;background:linear-gradient(160deg,#E2C466,#C9A227);color:#08281D;display:grid;place-items:center;font-size:13.5px;font-weight:700;letter-spacing:.02em}\n.brand-name{font-size:15px;font-weight:600;letter-spacing:-.01em}\n.brand-sub{font-size:11.5px;color:rgba(255,255,255,.5);margin-top:1px}\n.nav{flex:1;padding:14px 12px 8px;overflow:hidden}\n.nav-group{margin-bottom:14px}\n.nav-label{font-size:10.5px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.36);padding:0 10px 6px}\n.nav-item{display:flex;align-items:center;gap:10px;height:40px;padding:0 10px;border-radius:8px;color:rgba(255,255,255,.74);font-size:13.5px;font-weight:500}\n.nav-item i{font-size:16px;color:rgba(255,255,255,.5)}\n.nav-item .lbl{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.nav-item:hover{background:rgba(255,255,255,.07);color:#fff}\n.nav-item.active{background:#fff;color:var(--forest);font-weight:600;box-shadow:0 1px 2px rgba(0,0,0,.2)}\n.nav-item.active i{color:var(--green)}\n.nav-count{margin-left:auto;min-width:22px;padding:1px 7px;border-radius:999px;background:rgba(255,255,255,.11);color:rgba(255,255,255,.75);font-size:11.5px;font-weight:600;text-align:center}\n.nav-item.active .nav-count{background:var(--green-soft);color:var(--green)}\n.nav-priv{padding-top:12px;border-top:1px solid rgba(255,255,255,.1)}\n.nav-priv .nav-label{display:flex;align-items:center;gap:6px;color:rgba(255,255,255,.48)}\n.nav-priv .nav-label i{font-size:11px;color:var(--gold)}\n.sidebar-foot{border-top:1px solid rgba(255,255,255,.08);padding:12px}\n.me{display:flex;align-items:center;gap:10px;padding:8px;border-radius:10px}\n.me:hover{background:rgba(255,255,255,.07)}\n.sidebar .avatar{background:rgba(255,255,255,.14);color:#fff}\n.me-name{font-size:13px;font-weight:600}\n.me-role{font-size:11.5px;color:rgba(255,255,255,.5)}\n.logout{margin-left:auto;font-size:15px;color:rgba(255,255,255,.42)}\n\n.main{flex:1;min-width:0;height:900px;display:flex;flex-direction:column}\n.topbar{height:64px;flex:0 0 64px;background:#fff;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 24px}\n.crumbs{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--ink-3)}\n.crumbs .sep{color:#C6D0CA}\n.crumbs strong{color:var(--ink);font-weight:500}\n.topbar-right{display:flex;align-items:center;gap:14px}\n.role-chip{display:inline-flex;align-items:center;gap:6px;height:26px;padding:0 10px;border-radius:999px;border:1px solid #E7DBB2;background:#FBF7E8;color:#6D5716;font-size:12px;font-weight:500}\n.role-chip i{font-size:12px;color:#A98A22}\n.profile{display:flex;align-items:center;gap:8px;height:34px;padding:0 8px 0 6px;border:1px solid transparent;border-radius:999px;background:transparent;cursor:pointer;font-size:13px;font-weight:500}\n.profile:hover{background:#F1F4F2}\n.profile i{font-size:13px;color:var(--ink-3)}\n.avatar{width:30px;height:30px;border-radius:999px;background:var(--green-soft);color:var(--green);display:grid;place-items:center;font-size:11.5px;font-weight:600;flex:0 0 auto}\n.avatar.sm{width:26px;height:26px;font-size:10.5px}\n.avatar.lg{width:56px;height:56px;font-size:17px}\n\n.page{flex:1;min-height:0;padding:24px;display:flex;flex-direction:column;gap:16px}\n.panel{background:var(--surface);border:1px solid var(--line);border-radius:12px}\n\n.btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;height:36px;padding:0 14px;border:1px solid transparent;border-radius:8px;background:transparent;font-size:13px;font-weight:500;cursor:pointer;transition:background .12s ease,border-color .12s ease,color .12s ease}\n.btn i{font-size:15px}\n.btn-sm{height:32px;font-size:12.5px;padding:0 11px}\n.btn-primary{background:var(--green);color:#fff}\n.btn-primary:hover{background:var(--green-dark)}\n.btn-outline{border-color:#D6DFD9;background:#fff;color:var(--ink)}\n.btn-outline:hover{background:#F6F8F7;border-color:#C2D0C8}\n.btn-quiet{color:var(--ink-2)}\n.btn-quiet:hover{background:#EFF3F1;color:var(--ink)}\n.btn-danger{background:#B42318;color:#fff}\n.btn-danger:hover{background:#982016}\n.btn-danger-outline{border-color:#E8C7C2;background:#fff;color:#98271C}\n.btn-danger-outline:hover{background:#FDF1EF}\n.link{display:inline-flex;align-items:center;gap:5px;font-size:12.5px;font-weight:500;color:var(--green)}\n.link i{font-size:13px}\n\n.crumb{height:32px;flex:0 0 32px;display:flex;align-items:center;gap:8px;font-size:13px;color:var(--ink-3)}\n.crumb a{display:inline-flex;align-items:center;gap:6px;color:var(--ink-2);font-weight:500}\n.crumb a:hover{color:var(--green)}\n.crumb a i{font-size:14px}\n.crumb .sep{color:#C6D0CA}\n\n.hero{height:144px;flex:0 0 144px;display:flex;align-items:center;justify-content:space-between;padding:0 24px}\n.hero-left{display:flex;align-items:center;gap:16px;min-width:0}\n.hero-name-row{display:flex;align-items:center;gap:10px}\n.hero-name-row h1{margin:0;font-size:22px;font-weight:600;letter-spacing:-.02em}\n.hero-meta{display:flex;align-items:center;gap:16px;margin-top:7px;font-size:13px;color:var(--ink-2)}\n.hero-meta span{display:inline-flex;align-items:center;gap:6px}\n.hero-meta i{font-size:14px;color:var(--ink-3)}\n.hero-right{display:flex;flex-direction:column;gap:9px;min-width:430px}\n.kv-inline{display:grid;grid-template-columns:118px 1fr;gap:12px;font-size:12.5px}\n.kv-inline .k{color:var(--ink-3)}\n.kv-inline .v{color:var(--ink)}\n\n.tabs{height:40px;flex:0 0 40px;display:flex;align-items:stretch;gap:24px;border-bottom:1px solid var(--line)}\n.tab{display:inline-flex;align-items:center;gap:7px;font-size:13.5px;font-weight:500;color:var(--ink-3);border-bottom:2px solid transparent;margin-bottom:-1px;padding:0 1px}\n.tab i{font-size:14px}\n.tab.active{color:var(--ink);border-bottom-color:var(--green);font-weight:600}\n.tab:hover{color:var(--ink)}\n\n.detail{flex:1;min-height:0;display:flex;flex-direction:column;padding:20px 24px 0}\n.detail-grid{flex:1;min-height:0;display:grid;grid-template-columns:1fr 1fr;gap:56px}\n.field-group h3{margin:0 0 6px;font-size:13px;font-weight:600}\n.frow{display:grid;grid-template-columns:156px 1fr;gap:16px;align-items:center;min-height:38px;border-bottom:1px solid var(--line-2);font-size:13.5px}\n.frow .k{color:var(--ink-3);font-size:12.5px}\n.frow .v{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.detail-foot{height:76px;flex:0 0 76px;display:flex;align-items:center;justify-content:space-between;border-top:1px solid var(--line);margin-top:14px}\n.detail-foot .t{font-size:13.5px;font-weight:600}\n.detail-foot .n{font-size:12.5px;color:var(--ink-3);margin-top:2px}\n\n.pill{display:inline-flex;align-items:center;gap:6px;height:24px;padding:0 9px;border-radius:999px;font-size:12px;font-weight:500;white-space:nowrap}\n.pill .dot{width:6px;height:6px;border-radius:999px;background:currentColor;flex:0 0 auto}\n.pill-active{background:#EAF4EE;color:#14664A}\n.pill-suspended{background:#FBEBE9;color:#96271C}\n.pill-neutral{background:#F0F3F1;color:#54645C}\n\n/* dialog */\n.scrim{position:absolute;inset:0;background:rgba(6,24,18,.44)}\n.dialog{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:560px;background:#fff;border-radius:14px;box-shadow:0 28px 70px -14px rgba(4,20,14,.42);overflow:hidden}\n.dlg-head{display:flex;align-items:flex-start;gap:12px;padding:20px 20px 0}\n.dlg-icon{width:34px;height:34px;border-radius:9px;background:#FBEBE9;color:#96271C;display:grid;place-items:center;font-size:17px;flex:0 0 auto}\n.dlg-head h2{margin:0;font-size:18px;font-weight:600;letter-spacing:-.015em}\n.dlg-head p{margin:3px 0 0;font-size:12.5px;color:var(--ink-3)}\n.dlg-close{margin-left:auto;width:28px;height:28px;border:0;border-radius:7px;background:transparent;color:var(--ink-3);cursor:pointer;display:grid;place-items:center;font-size:15px}\n.dlg-close:hover{background:#F1F4F2}\n.dlg-body{padding:16px 20px 4px}\n.target{display:flex;align-items:center;gap:12px;padding:11px 14px;border:1px solid var(--line);border-radius:10px;background:#FAFBFA}\n.target .who-name{font-size:14px;font-weight:600}\n.target .who-mail{font-size:12.5px;color:var(--ink-3)}\n.mono.small{font-size:11.5px;color:var(--ink-3);margin-top:2px}\n.transition{display:flex;align-items:center;gap:16px;margin-top:12px;padding:11px 14px;border:1px solid var(--line-2);border-radius:10px}\n.transition > i{font-size:15px;color:var(--ink-3)}\n.t-state{display:flex;flex-direction:column;gap:5px}\n.t-label{font-size:11.5px;color:var(--ink-3)}\n.consequence{margin:13px 0 0;font-size:12.5px;color:var(--ink-2);line-height:1.5}\n.r-label{display:flex;align-items:center;gap:8px;margin-top:15px;font-size:12.5px;font-weight:500}\n.req{font-size:11px;font-weight:500;color:#96271C;background:#FBEBE9;border-radius:999px;padding:1px 7px}\n.ta{width:100%;height:80px;margin-top:7px;padding:9px 12px;border:1px solid #D9E1DC;border-radius:8px;font-family:inherit;font-size:13px;line-height:1.5;color:var(--ink);resize:none}\n.ta:focus{outline:none;border-color:var(--green);box-shadow:0 0 0 3px rgba(11,93,59,.12)}\n.r-meta{display:flex;justify-content:space-between;margin-top:6px;font-size:11.5px;color:var(--ink-3)}\n.dlg-foot{display:flex;justify-content:flex-end;gap:8px;padding:15px 20px;border-top:1px solid var(--line);margin-top:14px;background:#FAFBFA}\n\n@media (prefers-reduced-motion: reduce){*{transition:none !important;animation:none !important}}\n</style>\n<div class=\"app\" data-kid=\"1\" data-name=\"application shell container\">\n<aside class=\"sidebar\" data-kid=\"1-1\" data-name=\"dark sidebar panel\">\n<div class=\"brand\" data-kid=\"1-1-1\" data-name=\"brand header block\">\n<div class=\"brand-mark\" data-dynamic=\"true\" data-kid=\"1-1-1-1\" data-name=\"brand monogram logo\" data-reason=\"letter icon glyphs injected by lucide font loader script\">ER</div>\n<div data-kid=\"1-1-1-2\" data-name=\"brand text wrapper\">\n<div class=\"brand-name\" data-kid=\"1-1-1-2-1\" data-name=\"brand product name\">Easy Ride</div>\n<div class=\"brand-sub\" data-kid=\"1-1-1-2-2\" data-name=\"brand tagline subtitle\">Administration</div>\n</div>\n</div>\n<nav class=\"nav\" data-kid=\"1-1-2\" data-name=\"main sidebar navigation\">\n<div class=\"nav-group\" data-kid=\"1-1-2-1\" data-name=\"operations navigation group\">\n<div class=\"nav-label\" data-kid=\"1-1-2-1-1\" data-name=\"operations section label\