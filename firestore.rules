rules_version = "2";

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function owns(field) {
      return signedIn() && resource.data[field] == request.auth.uid;
    }

    function ownsNew(field) {
      return signedIn() && request.resource.data[field] == request.auth.uid;
    }

    match /users/{userId} {
      allow create: if signedIn()
        && userId == request.auth.uid
        && request.resource.data.role in ["buyer", "seller", "dealer"];

      allow read: if signedIn() && (userId == request.auth.uid || isAdmin());

      allow update: if isAdmin()
        || (signedIn()
          && userId == request.auth.uid
          && request.resource.data.role == resource.data.role);

      allow delete: if isAdmin();
    }

    match /listings/{listingId} {
      allow create: if ownsNew("ownerId")
        && request.resource.data.status == "pending";

      allow read: if isAdmin()
        || (signedIn() && resource.data.ownerId == request.auth.uid)
        || resource.data.status == "active";

      allow update: if isAdmin()
        || (owns("ownerId")
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.status == resource.data.status)
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["views"])
          && request.resource.data.views == resource.data.views + 1)
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["favoritesCount"])
          && (
            request.resource.data.favoritesCount == resource.data.favoritesCount + 1
            || request.resource.data.favoritesCount == resource.data.favoritesCount - 1
          ));

      allow delete: if isAdmin() || owns("ownerId");
    }

    match /favorites/{favoriteId} {
      allow create: if ownsNew("userId")
        && favoriteId == request.auth.uid + "_" + request.resource.data.listingId;
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if false;
    }

    match /listingEvents/{eventId} {
      allow create: if signedIn()
        && (request.resource.data.userId == request.auth.uid
          || request.resource.data.buyerId == request.auth.uid
          || request.resource.data.userId == null
          || isAdmin());
      allow read: if isAdmin()
        || (signedIn() && resource.data.sellerId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /dealers/{dealerId} {
      allow create: if ownsNew("ownerId");
      allow read: if true;
      allow update: if isAdmin() || owns("ownerId");
      allow delete: if isAdmin() || owns("ownerId");
    }

    match /reports/{reportId} {
      allow create: if ownsNew("reportedBy");
      allow read: if isAdmin() || owns("reportedBy");
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /supportTickets/{ticketId} {
      allow create: if ownsNew("userId");
      allow read: if isAdmin() || owns("userId");
      allow update: if isAdmin() || (owns("userId")
        && request.resource.data.userId == resource.data.userId);
      allow delete: if isAdmin();
    }

    match /verificationRequests/{requestId} {
      allow create: if ownsNew("userId");
      allow read: if isAdmin() || owns("userId");
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow create: if signedIn()
        && request.resource.data.renterId == request.auth.uid
        && request.resource.data.status == "pending";

      allow read: if signedIn()
        && (
          resource.data.renterId == request.auth.uid
          || resource.data.ownerId == request.auth.uid
          || isAdmin()
        );

      allow update: if signedIn()
        && (
          resource.data.renterId == request.auth.uid
          || resource.data.ownerId == request.auth.uid
          || isAdmin()
        );

      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == "pending";

      allow read: if signedIn()
        && (
          resource.data.userId == request.auth.uid
          || isAdmin()
        );

      allow update: if signedIn()
        && resource.data.userId == request.auth.uid;

      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid;

      allow read: if signedIn()
        && resource.data.userId == request.auth.uid;

      allow update: if signedIn()
        && resource.data.userId == request.auth.uid;

      allow delete: if false;
    }

    match /offers/{offerId} {
      allow create: if signedIn()
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.status == "pending";

      allow read: if signedIn()
        && (
          resource.data.buyerId == request.auth.uid
          || resource.data.sellerId == request.auth.uid
          || isAdmin()
        );

      allow update: if isAdmin()
        || (signedIn()
          && resource.data.sellerId == request.auth.uid
          && request.resource.data.buyerId == resource.data.buyerId
          && request.resource.data.sellerId == resource.data.sellerId)
        || (signedIn()
          && resource.data.buyerId == request.auth.uid
          && request.resource.data.buyerId == resource.data.buyerId
          && request.resource.data.sellerId == resource.data.sellerId
          && request.resource.data.status in ["withdrawn"]);

      allow delete: if isAdmin();
    }

    match /conversations/{conversationId} {
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participants;

      allow read: if signedIn()
        && request.auth.uid in resource.data.participants;

      allow update: if signedIn()
        && request.auth.uid in resource.data.participants;

      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.participants;

        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.participants;

        allow update: if signedIn()
          && request.auth.uid in get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.participants;

        allow delete: if isAdmin();
      }
    }
  }
}
