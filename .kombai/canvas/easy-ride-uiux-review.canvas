    "var_7c59a63c2a9b": {
      "type": "variant",
      "label": "Transaction-focused · Vehicle",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1380,
        "y": 0,
        "w": 1280,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n.easyride-screen { font-family: 'Inter', sans-serif; }\n.easyride-screen i { display: inline-flex; width: 1.2em; height: 1.2em; align-items: center; justify-content: center; flex: 0 0 auto; }\n.mobile-action-dock { display: none; }\n@media (max-width: 767px) {\n  .vehicle-layout { grid-template-columns: minmax(0, 1fr); }\n  .vehicle-photo { height: 300px; }\n  .mobile-action-dock { display: flex; }\n  .page-bottom-pad { padding-bottom: 104px; }\n}\n@media (max-width: 480px) {\n  .vehicle-photo { height: 250px; }\n}\n</style>\n<main class=\"easyride-screen min-h-screen bg-[#f8f9fa] text-[#202124] page-bottom-pad\" data-kid=\"1\" data-name=\"vehicle listing page main\">\n    <header class=\"sticky top-0 z-40 border-b border-[#e5e7eb] bg-white/95 backdrop-blur-sm\" data-kid=\"1-1\" data-name=\"sticky header bar\">\n        <div class=\"mx-auto flex h-[72px] max-w-[1320px] items-center justify-between gap-5 px-5 sm:px-8\" data-kid=\"1-1-1\" data-name=\"header inner layout\">\n            <a aria-label=\"Easy Ride home\" class=\"flex shrink-0 items-center gap-3\" data-kid=\"1-1-1-1\" data-name=\"brand logo link\" href=\"#\">\n                <span class=\"flex h-10 w-10 items-center justify-center rounded-xl bg-[#0b5d3b] text-white\" data-kid=\"1-1-1-1-1\" data-name=\"logo badge container\">\n                    <i class=\"icon-car-front text-[22px]\" data-kid=\"1-1-1-1-1-1\" data-name=\"car front icon\">\n                    </i>\n                </span>\n                <span class=\"text-[20px] font-extrabold tracking-[-0.04em] text-[#0b5d3b]\" data-kid=\"1-1-1-1-2\" data-name=\"brand name text\">\n                    Easy Ride\n                </span>\n            </a>\n            <nav aria-label=\"Main navigation\" class=\"hidden items-center gap-7 lg:flex\" data-kid=\"1-1-1-2\" data-name=\"main navigation bar\">\n                <a class=\"text-sm font-medium text-[#59665f] hover:text-[#0b5d3b]\" data-kid=\"1-1-1-2-1\" data-name=\"Home navigation link\" href=\"#\">\n                    Home\n                </a>\n                <a aria-current=\"page\" class=\"border-b-2 border-[#0b5d3b] py-[26px] text-sm font-bold text-[#0b5d3b]\" data-kid=\"1-1-1-2-2\" data-name=\"Marketplace current-page navigation link\" href=\"#\">\n                    Marketplace\n                </a>\n                <a class=\"text-sm font-medium text-[#59665f] hover:text-[#0b5d3b]\" data-kid=\"1-1-1-2-3\" data-name=\"Map navigation link\" href=\"#\">\n                    Map\n                </a>\n                <a class=\"text-sm font-medium text-[#59665f] hover:text-[#0b5d3b]\" data-kid=\"1-1-1-2-4\" data-name=\"Sell Rent navigation link\" href=\"#\">\n                    Sell / Rent\n                </a>\n                <a class=\"text-sm font-medium text-[#59665f] hover:text-[#0b5d3b]\" data-kid=\"1-1-1-2-5\" data-name=\"About navigation link\" href=\"#\">\n                    About\n                </a>\n            </nav>\n            <div class=\"flex shrink-0 items-center gap-2 sm:gap-3\" data-kid=\"1-1-1-3\" data-name=\"header actions group\">\n                <a class=\"rounded-full px-3 py-2.5 text-sm font-semibold text-[#3e4d46] hover:bg-[#f3f6f4] sm:px-4\" data-kid=\"1-1-1-3-1\" data-name=\"Log in link\" href=\"#\">\n                    Log in\n                </a>\n                <a class=\"hidden rounded-full border border-[#0b5d3b] px-4 py-2.5 text-sm font-bold text-[#0b5d3b] hover:bg-[#f3f8f5] sm:inline-flex\" data-kid=\"1-1-1-3-2\" data-name=\"Register link\" href=\"#\">\n                    Register\n                </a>\n                <button aria-label=\"Open menu\" class=\"inline-flex h-10 w-10 items-center justify-center rounded-xl border border-[#e5e7eb] text-[#0b5d3b] lg:hidden\" data-kid=\"1-1-1-3-3\" data-name=\"mobile menu open button\">\n                    <i class=\"icon-menu text-xl\" data-kid=\"1-1-1-3-3-1\" data-name=\"menu hamburger icon\">\n                    </i>\n                </button>\n            </div>\n        </div>\n    </header>\n    <div class=\"mx-auto max-w-[1200px] px-5 pt-7 sm:px-8 lg:pt-9\" data-kid=\"1-2\" data-name=\"page content wrapper\">\n        <a class=\"inline-flex items-center gap-2 text-sm font-semibold text-[#0b5d3b] hover:underline\" data-kid=\"1-2-1\" data-name=\"back to vehicles link\" href=\"#\">\n            <i class=\"icon-arrow-left text-base\" data-kid=\"1-2-1-1\" data-name=\"left arrow icon\">\n            </i>\n            Back to vehicles\n        </a>\n        <section aria-labelledby=\"vehicle-title\" class=\"mt-6 grid items-center gap-6 border-b border-[#dfe6e1] pb-7 lg:grid-cols-[minmax(0,1fr)_330px] lg:gap-10\" data-kid=\"1-2-2\" data-name=\"vehicle title and price header section\">\n            <div data-kid=\"1-2-2-1\" data-name=\"vehicle headline group\">\n                <div class=\"flex flex-wrap items-center gap-2.5\" data-kid=\"1-2-2-1-1\" data-name=\"listing status badges row\">\n                    <span class=\"rounded-full bg-[#e8f1ec] px-3 py-1.5 text-xs font-bold text-[#0b5d3b]\" data-kid=\"1-2-2-1-1-1\" data-name=\"For sale status badge\">\n                        For sale\n                    </span>\n                    <span class=\"rounded-full border border-[#c9a227]/40 bg-[#c9a227]/10 px-3 py-1.5 text-xs font-semibold text-[#755d12]\" data-kid=\"1-2-2-1-1-2\" data-name=\"Featured listing badge\">\n                        Featured listing\n                    </span>\n                </div>\n                <h1 class=\"mt-4 text-[34px] font-extrabold leading-[1.08] tracking-[-0.045em] text-[#16241d] sm:text-[42px]\" data-kid=\"1-2-2-1-2\" data-name=\"vehicle model headline\" id=\"vehicle-title\">\n                    2018 Toyota Axio\n                </h1>\n                <div class=\"mt-3 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-[#5c6962]\" data-kid=\"1-2-2-1-3\" data-name=\"vehicle quick specs row\">\n                    <span class=\"inline-flex items-center gap-2\" data-kid=\"1-2-2-1-3-1\" data-name=\"location spec chip\">\n                        <i class=\"icon-map-pin text-[#0b5d3b]\" data-kid=\"1-2-2-1-3-1-1\" data-name=\"map pin icon\">\n                        </i>\n                        Harare, Zimbabwe\n                    </span>\n                    <span class=\"inline-flex items-center gap-2\" data-kid=\"1-2-2-1-3-2\" data-name=\"mileage spec chip\">\n                        <i class=\"icon-gauge text-[#0b5d3b]\" data-kid=\"1-2-2-1-3-2-1\" data-name=\"gauge icon\">\n                        </i>\n                        78,000 km\n                    </span>\n                    <span class=\"inline-flex items-center gap-2\" data-kid=\"1-2-2-1-3-3\" data-name=\"transmission spec chip\">\n                        <i class=\"icon-settings-2 text-[#0b5d3b]\" data-kid=\"1-2-2-1-3-3-1\" data-name=\"settings icon\">\n                        </i>\n                        Automatic\n                    </span>\n                </div>\n            </div>\n            <div class=\"rounded-2xl border border-[#dfe6e1] bg-white p-5 shadow-[0_8px_24px_rgba(12,42,27,0.05)] sm:p-6\" data-kid=\"1-2-2-2\" data-name=\"ask price and actions card\">\n                <p class=\"text-xs font-semibold uppercase tracking-[0.12em] text-[#66736b]\" data-kid=\"1-2-2-2-1\" data-name=\"asking price label\">\n                    Asking price\n                </p>\n                <div class=\"mt-1 flex items-baseline gap-2\" data-kid=\"1-2-2-2-2\" data-name=\"price value row\">\n                    <span class=\"text-[32px] font-extrabold tracking-[-0.04em] text-[#0b5d3b]\" data-kid=\"1-2-2-2-2-1\" data-name=\"price amount text\">\n                        USD 8,500\n                    </span>\n                </div>\n                <p class=\"mt-1 text-sm leading-5 text-[#68756e]\" data-kid=\"1-2-2-2-3\" data-name=\"price assistance note\">\n                    Contact the seller to arrange a viewing or discuss an offer.\n                </p>\n                <button class=\"mt-5 flex min-h-12 w-full items-center justify-center gap-2 rounded-full bg-[#0b5d3b] px-5 py-3 text-sm font-bold text-white shadow-sm hover:bg-[#084b30]\" data-kid=\"1-2-2-2-4\" data-name=\"message seller button\">\n                    <i class=\"icon-message-circle text-lg\" data-kid=\"1-2-2-2-4-1\" data-name=\"message circle icon\">\n                    </i>\n                    Message seller\n                </button>\n                <button class=\"mt-2.5 w-full rounded-full px-4 py-2.5 text-sm font-semibold text-[#536159] hover:bg-[#f3f6f4]\" data-kid=\"1-2-2-2-5\" data-name=\"make an offer button\">\n                    Make an offer\n                    <i class=\"icon-arrow-up-right ml-1 text-sm\" data-kid=\"1-2-2-2-5-1\" data-name=\"up-right arrow icon\">\n                    </i>\n                </button>\n            </div>\n        </section>\n        <div class=\"vehicle-layout mt-7 grid items-start gap-8 lg:grid-cols-[minmax(0,1.65fr)_minmax(280px,0.72fr)] lg:gap-10\" data-kid=\"1-2-3\" data-name=\"vehicle layout grid\">\n            <section aria-label=\"Vehicle photos and details\" class=\"min-w-0\" data-kid=\"1-2-3-1\" data-name=\"vehicle photos and details column\">\n                <figure class=\"overflow-hidden rounded-2xl bg-[#e8ece9]\" data-kid=\"1-2-3-1-1\" data-name=\"vehicle photo figure\">\n                    <img alt=\"2018 Toyota Axio listed by Bright Cars\" class=\"vehicle-photo h-[460px] w-full object-cover object-center\" data-kid=\"1-2-3-1-1-1\" data-name=\"vehicle exterior photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1549924231-f129b911e442?auto=format&w=1400&q=80&fit=crop\"/>\n                    <figcaption class=\"flex items-center justify-between bg-white px-4 py-3 text-xs text-[#5c6962]\" data-kid=\"1-2-3-1-1-2\" data-name=\"photo caption bar\">\n                        <span class=\"font-medium\" data-kid=\"1-2-3-1-1-2-1\" data-name=\"photo description caption\">\n                            Toyota Axio · exterior photo\n                        </span>\n                        <span data-kid=\"1-2-3-1-1-2-2\" data-name=\"photo count text\">\n                            1 photo\n                        </span>\n                    </figcaption>\n                </figure>\n                <section aria-labelledby=\"vehicle-details-heading\" class=\"mt-8\" data-kid=\"1-2-3-1-2\" data-name=\"vehicle details section\">\n                    <h2 class=\"text-[23px] font-bold tracking-[-0.025em] text-[#16241d]\" data-kid=\"1-2-3-1-2-1\" data-name=\"vehicle details heading\" id=\"vehicle-details-heading\">\n                        Vehicle details\n                    </h2>\n                    <p class=\"mt-3 max-w-3xl text-[15px] leading-7 text-[#526058]\" data-kid=\"1-2-3-1-2-2\" data-name=\"vehicle details summary text\">\n                        A clean and reliable Toyota Axio with automatic transmission, excellent fuel economy and a well-maintained interior.\n                    </p>\n                    <dl class=\"mt-6 grid gap-x-8 sm:grid-cols-2\" data-kid=\"1-2-3-1-2-3\" data-name=\"details definition list grid\">\n                        <div class=\"flex items-center justify-between gap-3 border-b border-[#dfe6e1] py-4\" data-kid=\"1-2-3-1-2-3-1\" data-name=\"transmission detail row\">\n                            <dt class=\"text-sm text-[#69766f]\" data-kid=\"1-2-3-1-2-3-1-1\" data-name=\"transmission detail label\">\n                                Transmission\n                            </dt>\n                            <dd class=\"text-sm font-semibold text-[#202124]\" data-kid=\"1-2-3-1-2-3-1-2\" data-name=\"transmission detail value\">\n                                Automatic\n                            </dd>\n                        </div>\n                        <div class=\"flex items-center justify-between gap-3 border-b border-[#dfe6e1] py-4\" data-kid=\"1-2-3-1-2-3-2\" data-name=\"fuel type detail row\">\n                            <dt class=\"text-sm text-[#69766f]\" data-kid=\"1-2-3-1-2-3-2-1\" data-name=\"fuel type detail label\">\n                                Fuel type\n                            </dt>\n                            <dd class=\"text-sm font-semibold text-[#202124]\" data-kid=\"1-2-3-1-2-3-2-2\" data-name=\"fuel type detail value\">\n                                Petrol\n                            </dd>\n                        </div>\n                        <div class=\"flex items-center justify-between gap-3 border-b border-[#dfe6e1] py-4\" data-kid=\"1-2-3-1-2-3-3\" data-name=\"mileage detail row\">\n                            <dt class=\"text-sm text-[#69766f]\" data-kid=\"1-2-3-1-2-3-3-1\" data-name=\"mileage detail label\">\n                                Mileage\n                            </dt>\n                            <dd class=\"text-sm font-semibold text-[#202124]\" data-kid=\"1-2-3-1-2-3-3-2\" data-name=\"mileage detail value\">\n                                78,000 km\n                            </dd>\n                        </div>\n                        <div class=\"flex items-center justify-between gap-3 border-b border-[#dfe6e1] py-4\" data-kid=\"1-2-3-1-2-3-4\" data-name=\"condition detail row\">\n                            <dt class=\"text-sm text-[#69766f]\" data-kid=\"1-2-3-1-2-3-4-1\" data-name=\"condition detail label\">\n                                Condition\n                            </dt>\n                            <dd class=\"text-sm font-semibold text-[#202124]\" data-kid=\"1-2-3-1-2-3-4-2\" data-name=\"condition detail value\">\n                                Good\n                            </dd>\n                        </div>\n                    </dl>\n                </section>\n            </section>\n            <aside class=\"space-y-6\" data-kid=\"1-2-3-2\" data-name=\"right sidebar column\">\n                <section aria-labelledby=\"seller-heading\" class=\"border-t-2 border-[#0b5d3b] bg-white px-5 pb-5 pt-5 sm:px-6\" data-kid=\"1-2-3-2-1\" data-name=\"seller card section\">\n                    <p class=\"text-xs font-semibold uppercase tracking-[0.11em] text-[#68756e]\" data-kid=\"1-2-3-2-1-1\" data-name=\"seller section label\">\n                        Seller\n                    </p>\n                    <div class=\"mt-3 flex items-center justify-between gap-4\" data-kid=\"1-2-3-2-1-2\" data-name=\"seller identity row\">\n                        <div data-kid=\"1-2-3-2-1-2-1\" data-name=\"seller name group\">\n                            <h2 class=\"text-lg font-bold text-[#16241d]\" data-kid=\"1-2-3-2-1-2-1-1\" data-name=\"seller name heading\" id=\"seller-heading\">\n                                Bright Cars\n                            </h2>\n                            <p class=\"mt-1 text-sm text-[#68756e]\" data-kid=\"1-2-3-2-1-2-1-2\" data-name=\"seller dealer type label\">\n                                Dealer\n                            </p>\n                        </div>\n                        <span class=\"inline-flex items-center gap-1.5 rounded-full border border-[#bfd6c8] px-3 py-1.5 text-xs font-semibold text-[#0b5d3b]\" data-kid=\"1-2-3-2-1-2-2\" data-name=\"verified seller badge\">\n                            <i class=\"icon-badge-check text-base\" data-kid=\"1-2-3-2-1-2-2-1\" data-name=\"badge check icon\">\n                            </i>\n                            Verified\n                        </span>\n                    </div>\n                    <a class=\"mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-[#0b5d3b] hover:underline\" data-kid=\"1-2-3-2-1-3\" data-name=\"view seller profile link\" href=\"#\">\n                        View seller profile\n                        <i class=\"icon-arrow-up-right text-sm\" data-kid=\"1-2-3-2-1-3-1\" data-name=\"up-right arrow icon\">\n                        </i>\n                    </a>\n                </section>\n                <section aria-labelledby=\"contact-heading\" class=\"border-t border-[#dfe6e1] pt-5\" data-kid=\"1-2-3-2-2\" data-name=\"other contact methods section\">\n                    <h2 class=\"text-base font-bold text-[#16241d]\" data-kid=\"1-2-3-2-2-1\" data-name=\"other contact methods heading\" id=\"contact-heading\">\n                        Other ways to contact\n                    </h2>\n                    <div class=\"mt-3 divide-y divide-[#e6ebe8]\" data-kid=\"1-2-3-2-2-2\" data-name=\"contact options list\">\n                        <button class=\"flex min-h-12 w-full items-center justify-between gap-3 py-3 text-left text-sm font-semibold text-[#37463e] hover:text-[#0b5d3b]\" data-kid=\"1-2-3-2-2-2-1\" data-name=\"WhatsApp contact button\">\n                            <span class=\"flex items-center gap-3\" data-kid=\"1-2-3-2-2-2-1-1\" data-name=\"WhatsApp label group\">\n                                <i class=\"icon-message-circle text-lg text-[#68756e]\" data-kid=\"1-2-3-2-2-2-1-1-1\" data-name=\"message circle icon\">\n                                </i>\n                                WhatsApp\n                            </span>\n                            <span class=\"text-xs font-medium text-[#7a867f]\" data-kid=\"1-2-3-2-2-2-1-2\" data-name=\"sign in required note\">\n                                Sign in required\n                            </span>\n                        </button>\n                        <button class=\"flex min-h-12 w-full items-center justify-between gap-3 py-3 text-left text-sm font-semibold text-[#37463e] hover:text-[#0b5d3b]\" data-kid=\"1-2-3-2-2-2-2\" data-name=\"show phone number button\">\n                            <span class=\"flex items-center gap-3\" data-kid=\"1-2-3-2-2-2-2-1\" data-name=\"phone label group\">\n                                <i class=\"icon-phone text-lg text-[#68756e]\" data-kid=\"1-2-3-2-2-2-2-1-1\" data-name=\"phone icon\">\n                                </i>\n                                Show phone number\n                            </span>\n                            <i class=\"icon-chevron-right text-base text-[#8a958f]\" data-kid=\"1-2-3-2-2-2-2-2\" data-name=\"chevron right icon\">\n                            </i>\n                        </button>\n                        <button class=\"flex min-h-12 w-full items-center gap-3 py-3 text-left text-sm font-semibold text-[#37463e] hover:text-[#0b5d3b]\" data-kid=\"1-2-3-2-2-2-3\" data-name=\"save vehicle button\">\n                            <i class=\"icon-heart text-lg text-[#68756e]\" data-kid=\"1-2-3-2-2-2-3-1\" data-name=\"heart icon\">\n                            </i>\n                            Save vehicle\n                        </button>\n                    </div>\n                </section>\n                <a class=\"flex min-h-12 items-center justify-between gap-3 border-y border-[#dfe6e1] py-3 text-sm font-medium text-[#59665f] hover:text-[#0b5d3b]\" data-kid=\"1-2-3-2-3\" data-name=\"view on map link\" href=\"#\">\n                    <span class=\"inline-flex items-center gap-3\" data-kid=\"1-2-3-2-3-1\" data-name=\"map label group\">\n                        <i class=\"icon-map-pin text-lg\" data-kid=\"1-2-3-2-3-1-1\" data-name=\"map pin icon\">\n                        </i>\n                        View Harare on Google Maps\n                    </span>\n                    <i class=\"icon-arrow-up-right text-base\" data-kid=\"1-2-3-2-3-2\" data-name=\"up-right arrow icon\">\n                    </i>\n                </a>\n                <p class=\"border-l-2 border-[#c9a227] pl-4 text-sm leading-6 text-[#536159]\" data-kid=\"1-2-3-2-4\" data-name=\"safety warning note\">\n                    Never send money before inspecting the vehicle and confirming the seller's identity.\n                </p>\n                <button class=\"inline-flex min-h-10 items-center gap-2 text-sm text-[#7a5146] hover:text-[#8c3024]\" data-kid=\"1-2-3-2-5\" data-name=\"report listing button\">\n                    <i class=\"icon-flag text-base\" data-kid=\"1-2-3-2-5-1\" data-name=\"flag icon\">\n                    </i>\n                    Report this listing\n                </button>\n            </aside>\n        </div>\n    </div>\n    <footer class=\"mt-14 border-t border-[#dfe6e1] bg-white\" data-kid=\"1-3\" data-name=\"page footer bar\">\n        <div class=\"mx-auto flex max-w-[1200px] flex-wrap items-center justify-between gap-4 px-5 py-6 text-sm text-[#68756e] sm:px-8\" data-kid=\"1-3-1\" data-name=\"footer inner layout\">\n            <a class=\"font-bold text-[#0b5d3b]\" data-kid=\"1-3-1-1\" data-name=\"footer brand link\" href=\"#\">\n                Easy Ride\n            </a>\n            <p data-kid=\"1-3-1-2\" data-name=\"footer descriptive text\">\n                Arrange a viewing directly with the seller.\n            </p>\n            <a class=\"font-semibold text-[#0b5d3b] hover:underline\" data-kid=\"1-3-1-3\" data-name=\"browse more vehicles link\" href=\"#\">\n                Browse more vehicles\n            </a>\n        </div>\n    </footer>\n    <div class=\"mobile-action-dock fixed inset-x-0 bottom-0 z-50 items-center gap-3 border-t border-[#dfe6e1] bg-white/95 px-4 py-3 shadow-[0_-8px_24px_rgba(12,42,27,0.08)] backdrop-blur-sm\" data-kid=\"1-4\" data-name=\"mobile sticky action dock\">\n        <div class=\"min-w-0 flex-1\" data-kid=\"1-4-1\" data-name=\"mobile dock price group\">\n            <p class=\"text-[11px] text-[#68756e]\" data-kid=\"1-4-1-1\" data-name=\"mobile dock price label\">\n                Asking price\n            </p>\n            <p class=\"truncate text-lg font-extrabold text-[#0b5d3b]\" data-kid=\"1-4-1-2\" data-name=\"mobile dock price amount\">\n                USD 8,500\n            </p>\n        </div>\n        <button class=\"min-h-12 shrink-0 rounded-full bg-[#0b5d3b] px-5 text-sm font-bold text-white\" data-kid=\"1-4-2\" data-name=\"mobile dock message seller button\">\n            Message seller\n        </button>\n    </div>\n</main>\n",
      "comments": [],
      "created": "2026-10-14T10:21:29.109721+00:00",
      "modified": "2026-10-14T10:22:34.361534+00:00",
