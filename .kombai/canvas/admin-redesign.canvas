      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n\n*,*::before,*::after{box-sizing:border-box}\n:root{\n  --forest:#08281D;--green:#0B5D3B;--green-dark:#0A4E32;--green-soft:#EAF3EE;--green-line:#CFE2D7;\n  --gold:#C9A227;--canvas:#F4F6F5;--surface:#FFFFFF;--ink:#10201A;--ink-2:#4C5C54;--ink-3:#7B8A82;\n  --line:#E3E9E5;--line-2:#EEF2EF;--mono:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;\n}\nhtml,body{margin:0;padding:0;height:100%}\nbody{font-family:'Inter',-apple-system,'Segoe UI',Arial,sans-serif;background:var(--canvas);color:var(--ink);font-size:14px;line-height:1.45;-webkit-font-smoothing:antialiased;overflow:hidden}\nbutton{font-family:inherit;font-size:inherit;color:inherit}\na{color:inherit;text-decoration:none}\n[class^=\"icon-\"],[class*=\" icon-\"]{line-height:1;display:inline-block}\n:focus-visible{outline:2px solid var(--green);outline-offset:2px}\n.tnum{font-variant-numeric:tabular-nums}\n.mono{font-family:var(--mono);font-size:12px;letter-spacing:-.01em}\n.app{position:relative;width:1440px;height:900px;display:flex;overflow:hidden;background:var(--canvas)}\n\n.sidebar{width:288px;flex:0 0 288px;height:900px;background:var(--forest);color:#fff;display:flex;flex-direction:column}\n.brand{height:88px;flex:0 0 88px;display:flex;align-items:center;gap:12px;padding:0 20px;border-bottom:1px solid rgba(255,255,255,.08)}\n.brand-mark{width:38px;height:38px;border-radius:10px;background:linear-gradient(160deg,#E2C466,#C9A227);color:#08281D;display:grid;place-items:center;font-size:13.5px;font-weight:700;letter-spacing:.02em}\n.brand-name{font-size:15px;font-weight:600;letter-spacing:-.01em}\n.brand-sub{font-size:11.5px;color:rgba(255,255,255,.5);margin-top:1px}\n.nav{flex:1;padding:14px 12px 8px;overflow:hidden}\n.nav-group{margin-bottom:14px}\n.nav-label{font-size:10.5px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.36);padding:0 10px 6px}\n.nav-item{display:flex;align-items:center;gap:10px;height:40px;padding:0 10px;border-radius:8px;color:rgba(255,255,255,.74);font-size:13.5px;font-weight:500}\n.nav-item i{font-size:16px;color:rgba(255,255,255,.5)}\n.nav-item .lbl{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.nav-item:hover{background:rgba(255,255,255,.07);color:#fff}\n.nav-item.active{background:#fff;color:var(--forest);font-weight:600;box-shadow:0 1px 2px rgba(0,0,0,.2)}\n.nav-item.active i{color:var(--green)}\n.nav-count{margin-left:auto;min-width:22px;padding:1px 7px;border-radius:999px;background:rgba(255,255,255,.11);color:rgba(255,255,255,.75);font-size:11.5px;font-weight:600;text-align:center}\n.nav-item.active .nav-count{background:var(--green-soft);color:var(--green)}\n.nav-priv{padding-top:12px;border-top:1px solid rgba(255,255,255,.1)}\n.nav-priv .nav-label{display:flex;align-items:center;gap:6px;color:rgba(255,255,255,.48)}\n.nav-priv .nav-label i{font-size:11px;color:var(--gold)}\n.sidebar-foot{border-top:1px solid rgba(255,255,255,.08);padding:12px}\n.me{display:flex;align-items:center;gap:10px;padding:8px;border-radius:10px}\n.me:hover{background:rgba(255,255,255,.07)}\n.sidebar .avatar{background:rgba(255,255,255,.14);color:#fff}\n.me-name{font-size:13px;font-weight:600}\n.me-role{font-size:11.5px;color:rgba(255,255,255,.5)}\n.logout{margin-left:auto;font-size:15px;color:rgba(255,255,255,.42)}\n\n.main{flex:1;min-width:0;height:900px;display:flex;flex-direction:column}\n.topbar{height:64px;flex:0 0 64px;background:#fff;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 24px}\n.crumbs{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--ink-3)}\n.crumbs .sep{color:#C6D0CA}\n.crumbs strong{color:var(--ink);font-weight:500}\n.topbar-right{display:flex;align-items:center;gap:14px}\n.role-chip{display:inline-flex;align-items:center;gap:6px;height:26px;padding:0 10px;border-radius:999px;border:1px solid #E7DBB2;background:#FBF7E8;color:#6D5716;font-size:12px;font-weight:500}\n.role-chip i{font-size:12px;color:#A98A22}\n.profile{display:flex;align-items:center;gap:8px;height:34px;padding:0 8px 0 6px;border:1px solid transparent;border-radius:999px;background:transparent;cursor:pointer;font-size:13px;font-weight:500}\n.profile:hover{background:#F1F4F2}\n.profile i{font-size:13px;color:var(--ink-3)}\n.avatar{width:30px;height:30px;border-radius:999px;background:var(--green-soft);color:var(--green);display:grid;place-items:center;font-size:11.5px;font-weight:600;flex:0 0 auto}\n.avatar.sm{width:26px;height:26px;font-size:10.5px}\n.avatar.lg{width:56px;height:56px;font-size:17px}\n\n.page{flex:1;min-height:0;padding:24px;display:flex;flex-direction:column;gap:16px}\n.page-head{height:56px;flex:0 0 56px;display:flex;align-items:flex-end;justify-content:space-between}\n.page-head h1{margin:0;font-size:26px;line-height:1.2;font-weight:600;letter-spacing:-.022em}\n.page-head .meta{font-size:13px;color:var(--ink-3);padding-bottom:3px}\n.panel{background:var(--surface);border:1px solid var(--line);border-radius:12px}\n.sheet{box-shadow:0 1px 2px rgba(6,40,29,.04),0 10px 24px -16px rgba(6,40,29,.28)}\n\n.btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;height:36px;padding:0 14px;border:1px solid transparent;border-radius:8px;background:transparent;font-size:13px;font-weight:500;cursor:pointer;transition:background .12s ease,border-color .12s ease,color .12s ease}\n.btn i{font-size:15px}\n.btn-sm{height:32px;font-size:12.5px;padding:0 11px}\n.btn-primary{background:var(--green);color:#fff}\n.btn-primary:hover{background:var(--green-dark)}\n.btn-outline{border-color:#D6DFD9;background:#fff;color:var(--ink)}\n.btn-outline:hover{background:#F6F8F7;border-color:#C2D0C8}\n.btn-quiet{color:var(--ink-2)}\n.btn-quiet:hover{background:#EFF3F1;color:var(--ink)}\n.btn-danger{background:#B42318;color:#fff}\n.btn-danger-outline{border-color:#E8C7C2;background:#fff;color:#98271C}\n.link{display:inline-flex;align-items:center;gap:5px;font-size:12.5px;font-weight:500;color:var(--green)}\n.link i{font-size:13px}\n.link:hover{text-decoration:underline}\n\n/* tabs */\n.tabs{height:40px;flex:0 0 40px;display:flex;align-items:stretch;gap:24px;border-bottom:1px solid var(--line)}\n.tab{display:inline-flex;align-items:center;gap:7px;font-size:13.5px;font-weight:500;color:var(--ink-3);border-bottom:2px solid transparent;margin-bottom:-1px;padding:0 1px}\n.tab i{font-size:14px}\n.tab.active{color:var(--ink);border-bottom-color:var(--green);font-weight:600}\n.tab:hover{color:var(--ink)}\n\n/* filters */\n.filters{height:72px;flex:0 0 72px;display:flex;align-items:center;gap:12px;padding:0 16px}\n.field{display:flex;flex-direction:column;gap:5px;width:192px;flex:0 0 auto}\n.field.grow{flex:1;min-width:0;width:auto}\n.field label{font-size:11.5px;font-weight:500;color:var(--ink-3)}\n.input-wrap,.select-wrap{position:relative;display:flex;align-items:center}\n.input-wrap i{position:absolute;left:10px;font-size:14px;color:var(--ink-3);pointer-events:none}\ninput[type=text],select{height:34px;width:100%;border:1px solid #D9E1DC;border-radius:8px;background:#fff;padding:0 10px;font-family:inherit;font-size:13px;color:var(--ink);appearance:none}\ninput[type=text]{padding-left:31px}\ninput::placeholder{color:#98A69E}\ninput:focus,select:focus{border-color:var(--green);outline:none;box-shadow:0 0 0 3px rgba(11,93,59,.12)}\n.select-wrap i{position:absolute;right:10px;font-size:13px;color:var(--ink-3);pointer-events:none}\n.filter-tail{margin-left:auto;display:flex;align-items:center;gap:8px;font-size:12.5px;color:var(--ink-3)}\n\n/* table */\n.table-wrap{overflow:hidden}\n.tbl{width:100%;border-collapse:collapse;table-layout:fixed}\n.tbl th{height:40px;padding:0 16px;text-align:left;font-size:12px;font-weight:500;color:var(--ink-3);border-bottom:1px solid var(--line);background:#FAFBFA}\n.tbl th.right{text-align:right}\n.tbl td{height:48px;padding:0 16px;border-bottom:1px solid var(--line-2);font-size:13.5px;vertical-align:middle}\n.tbl tbody tr:hover{background:#F7FAF8}\n.tbl tbody tr:last-child td{border-bottom:0}\n.tbl td.right{text-align:right}\n.who{display:flex;align-items:center;gap:10px;min-width:0}\n.who > div{min-width:0}\n.who-name{font-size:13.5px;font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.who-mail{font-size:12px;color:var(--ink-3);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.type-main{font-size:13.5px}\n.type-sub{display:flex;align-items:center;gap:5px;font-size:12px;color:var(--ink-3);margin-top:1px}\n.type-sub i{font-size:12px}\n.row-action{display:inline-flex;align-items:center;gap:4px;font-size:13px;font-weight:500;color:var(--green)}\n.row-action i{font-size:13px}\n.tbl tbody tr:hover .row-action{text-decoration:underline}\n\n/* pager */\n.pager{height:56px;flex:0 0 56px;display:flex;align-items:center;justify-content:space-between;font-size:12.5px;color:var(--ink-3)}\n.pager-info .tnum{color:var(--ink-2)}\n.pager-nav{display:flex;align-items:center;gap:4px}\n.pg{min-width:28px;height:28px;padding:0 8px;border:1px solid transparent;border-radius:7px;background:transparent;font-size:12.5px;color:var(--ink-2);cursor:pointer;display:inline-flex;align-items:center;justify-content:center}\n.pg:hover{background:#EDF2EF}\n.pg.is-current{background:var(--green);color:#fff;font-weight:600}\n.pg:disabled{color:#B9C6BF;cursor:not-allowed}\n.pg-dots{padding:0 4px;color:var(--ink-3)}\n\n.pill{display:inline-flex;align-items:center;gap:6px;height:24px;padding:0 9px;border-radius:999px;font-size:12px;font-weight:500;white-space:nowrap}\n.pill .dot{width:6px;height:6px;border-radius:999px;background:currentColor;flex:0 0 auto}\n.pill-active{background:#EAF4EE;color:#14664A}\n.pill-pending{background:#FDF3E1;color:#8A5403}\n.pill-suspended{background:#FBEBE9;color:#96271C}\n.pill-neutral{background:#F0F3F1;color:#54645C}\n\n@media (prefers-reduced-motion: reduce){*{transition:none !important;animation:none !important}}\n</style>\n<div class=\"app\" data-kid=\"1\" data-name=\"admin dashboard app shell\">\n<aside class=\"sidebar\" data-kid=\"1-1\" data-name=\"dark forest sidebar navigation\">\n<div class=\"brand\" data-kid=\"1-1-1\" data-name=\"brand header with logo and name\">\n<div class=\"brand-mark\" data-kid=\"1-1-1-1\" data-name=\"gold brand monogram badge\">ER</div>\n<div data-kid=\"1-1-1-2\" data-name=\"brand text block\">\n<div class=\"brand-name\" data-kid=\"1-1-1-2-1\" data-name=\"brand name\">Easy Ride</div>\n<div class=\"brand-sub\" data-kid=\"1-1-1-2-2\" data-name=\"brand subtitle\">Administration</div>\n</div>\n</div>\n<nav class=\"nav\" data-kid=\"1-1-2\" data-name=\"vertical navigation menu\">\n<div class=\"nav-group\" data-kid=\"1-1-2-1\" data-name=\"Operations nav group\">\n<div class=\"nav-label\" data-kid=\"1-1-2-1-1\" data-name=\"nav group label\">Operations</div>\n<a class=\"nav-item\" data-kid=\"1-1-2-1-2\" data-name=\"Overview nav item\" href=\"#\"><i class=\"icon-gauge\" data-kid=\"1-1-2-1-2-1\" data-name=\"gauge dashboard icon\"></i><span class=\"lbl\" data-kid=\"1-1-2-1-2-2\" data-name=\"nav item label text\">Overview</span></a>\n<a class=\"nav-item\" data-kid=\"1-1-2-1-3\" data-name=\"Support nav item with badge\" href=\"#\"><i class=\"icon-headphones\" data-kid=\"1-1-2-1-3-1\" data-name=\"headphones support icon\"></i><span class=\"lbl\" data-kid=\"1-1-2-1-3-2\" data-name=\"nav item label text\">Support</span><span class=\"nav-count tnum\" data-kid=\"1-1-2-1-3-3\" data-name=\"ticket count badge\">7</span></a>\n</div>\n<div class=\"nav-group\" data-kid=\"1-1-2-2\" data-name=\"Marketplace nav group\">\n<div class=\"nav-label\" data-kid=\"1-1-2-2-1\" data-name=\"nav group label\">Marketplace</div>\n<a class=\"nav-item\" data-kid=\"1-1-2-2-2\" data-name=\"Listings nav item with badge\" href=\"#\"><i class=\"icon-car\" data-kid=\"1-1-2-2-2-1\" data-name=\"car listing icon\"></i><span class=\"lbl\" data-kid=\"1-1-2-2-2-2\" data-name=\"nav item label text\">Listings</span><span class=\"nav-count tnum\" data-kid=\"1-1-2-2-2-3\" data-name=\"item count badge\">23</span></a>\n<a class=\"nav-item\" data-kid=\"1-1-2-2-3\" data-name=\"Verification nav item with badge\" href=\"#\"><i class=\"icon-shield-check\" data-kid=\"1-1-2-2-3-1\" data-name=\"shield check verification icon\"></i><span class=\"lbl\" data-kid=\"1-1-2-2-3-2\" data-name=\"nav item label text\">Verification</span><span class=\"nav-count tnum\" data-kid=\"1-1-2-2-3-3\" data-name=\"verification count badge\">9</span></a>\n<a class=\"nav-item\" data-kid=\"1-1-2-2-4\" data-name=\"Reports nav item with badge\" href=\"#\"><i class=\"icon-flag\" data-kid=\"1-1-2-2-4-1\" data-name=\"flag report icon\"></i><span class=\"lbl\" data-kid=\"1-1-2-2-4-2\" data-name=\"nav item label text\">Reports</span><span class=\"nav-count tnum\" data-kid=\"1-1-2-2-4-3\" data-name=\"report count badge\">4</span></a>\n</div>\n<div class=\"nav-group\" data-kid=\"1-1-2-3\" data-name=\"Transactions nav group\">\n<div class=\"nav-label\" data-kid=\"1-1-2-3-1\" data-name=\"nav group label\">Transactions</div>\n<a class=\"nav-item\" data-kid=\"1-1-2-3-2\" data-name=\"Bookings nav item with badge\" href=\"#\"><i class=\"icon-calendar-days\" data-kid=\"1-1-2-3-2-1\" data-name=\"calendar bookings icon\"></i><span class=\"lbl\" data-kid=\"1-1-2-3-2-2\" data-name=\"nav item label text\">Bookings</span><span class=\"nav-count tnum\" data-kid=\"1-1-2-3-2-3\" data-name=\"booking count badge\">12</span></a>\n<a class=\"nav-item\" data-kid=\"1-1-2-3-3\" data-name=\"Offers nav item with badge\" href=\"#\"><i class=\"icon-handshake\" data-kid=\"1-1-2-3-3-1\" data-name=\"handshake offers icon\"></i><span class=\"lbl\" data-kid=\"1-1-2-3-3-2\" data-name=\"nav item label text\">Offers</span><span class=\"nav-count tnum\" data-kid=\"1-1-2-3-3-3\" data-name=\"offers count badge\">9</span></a>\n<a class=\"nav-item\" data-kid=\"1-1-2-3-4\" data-name=\"Payments nav item\" href=\"#\"><i class=\"icon-credit-card\" data-kid=\"1-1-2-3-4-1\" data-name=\"credit card payments icon\"></i><span class=\"lbl\" data-kid=\"1-1-2-3-4-2\" data-name=\"nav item label text\">Payments</span></a>\n<a class=\"nav-item\" data-kid=\"1-1-2-3-5\" data-name=\"Disputes nav item\" href=\"#\"><i class=\"icon-scale\" data-kid=\"1-1-2-3-5-1\" data-name=\"scale disputes icon\"></i><span class=\"lbl\" data-kid=\"1-1-2-3-5-2\" data-name=\"nav item label text\">Disputes</span></a>\n</div>\n<div class=\"nav-group\" data-kid=\"1-1-2-4\" data-name=\"Administration nav group\">\n<div class=\"nav-label\" data-kid=\"1-1-2-4-1\" data-name=\"nav group label\">Administration</div>\n<a class=\"nav-item\" data-kid=\"1-1-2-4-2\" data-name=\"Audit logs nav item\" href=\"#\"><i class=\"icon-history\" data-kid=\"1-1-2-4-2-1\" data-name=\"history audit icon\"></i><span class=\"lbl\" data-kid=\"1-1-2-4-2-2\" data-name=\"nav item label text\">Audit logs</span></a>\n</div>\n<div class=\"nav-priv\" data-kid=\"1-1-2-5\" data-name=\"Super administrator privileged nav section\">\n<div class=\"nav-label\" data-kid=\"1-1-2-5-1\" data-name=\"shield icon\"><i class=\"icon-shield\" data-kid=\"1-1-2-5-1-1\"></i>Super administrator</div>\n<a aria-current=\"page\" class=\"nav-item active\" data-kid=\"1-1-2-5-2\" data-name=\"Accounts active nav item\" href=\"#\"><i class=\"icon-users\" data-kid=\"1-1-2-5-2-1\" data-name=\"users accounts icon\"></i><span class=\"lbl\" data-kid=\"1-1-2-5-2-2\" data-name=\"nav item label text\">Accounts</span></a>\n<a class=\"nav-item\" data-kid=\"1-1-2-5-3\" data-name=\"Administrators nav item\" href=\"#\"><i class=\"icon-lock\" data-kid=\"1-1-2-5-3-1\" data-name=\"lock administrator icon\"></i><span class=\"lbl\" data-kid=\"1-1-2-5-3-2\" data-name=\"nav item label text\">Administrators</span></a>\n</div>\n</nav>\n<div class=\"sidebar-foot\" data-kid=\"1-1-3\" data-name=\"sidebar footer\">\n<div class=\"me\" data-kid=\"1-1-3-1\" data-name=\"current user profile row\">\n<span class=\"avatar\" data-kid=\"1-1-3-1-1\" data-name=\"user avatar initials\">TM</span>\n<div data-kid=\"1-1-3-1-2\" data-name=\"user name and role block\">\n<div class=\"me-name\" data-kid=\"1-1-3-1-2-1\" data-name=\"signed-in user name\">Tarisai Mudimu</div>\n<div class=\"me-role\" data-kid=\"1-1-3-1-2-2\" data-name=\"user role text\">Super administrator</div>\n</div>\n<i class=\"icon-log-out logout\" data-kid=\"1-1-3-1-3\" data-name=\"log out icon button\"></i>\n</div>\n</div>\n</aside>\n<div class=\"main\" data-kid=\"1-2\" data-name=\"main content area\">\n<header class=\"topbar\" data-kid=\"1-2-1\" data-name=\"top header bar\">\n<div class=\"crumbs\" data-kid=\"1-2-1-1\" data-name=\"breadcrumb navigation\"><span data-kid=\"1-2-1-1-1\" data-name=\"breadcrumb parent text\">Administration</span><span class=\"sep\" data-kid=\"1-2-1-1-2\" data-name=\"breadcrumb separator\">/</span><strong data-kid=\"1-2-1-1-3\" data-name=\"breadcrumb current page label\">Accounts</strong></div>\n<div class=\"topbar-right\" data-kid=\"1-2-1-2\" data-name=\"topbar right controls\">\n<span class=\"role-chip\" data-kid=\"1-2-1-2-1\" data-name=\"role badge chip\"><i class=\"icon-shield-check\" data-kid=\"1-2-1-2-1-1\" data-name=\"shield check role icon\"></i>Super administrator</span>\n<button class=\"profile\" data-kid=\"1-2-1-2-2\" data-name=\"profile dropdown button\"><span class=\"avatar sm\" data-kid=\"1-2-1-2-2-1\" data-name=\"profile avatar initials\">TM</span>Tarisai Mudimu<i class=\"icon-chevron-down\" data-kid=\"1-2-1-2-2-2\" data-name=\"dropdown chevron icon\"></i></button>\n</div>\n</header>\n<div class=\"page\" data-kid=\"1-2-2\" data-name=\"page content container\">\n<div class=\"page-head\" data-kid=\"1-2-2-1\" data-name=\"page head with title and count\">\n<h1 data-kid=\"1-2-2-1-1\" data-name='page headline \"Users\"'>Users</h1>\n<span class=\"meta tnum\" data-kid=\"1-2-2-1-2\" data-name=\"account count meta text\">2,481 accounts</span>\n</div>\n<div class=\"tabs\" data-kid=\"1-2-2-2\" data-name=\"tabs bar\">\n<a class=\"tab active\" data-kid=\"1-2-2-2-1\" data-name=\"Directory active tab\" href=\"#\">Directory</a>\n<a class=\"tab\" data-kid=\"1-2-2-2-2\" data-name=\"Oversight tab\" href=\"#\"><i class=\"icon-shield\" data-kid=\"1-2-2-2-2-1\" data-name=\"shield icon\"></i>Oversight</a>\n</div>\n<section aria-label=\"Filters\" class=\"panel filters\" data-kid=\"1-2-2-3\" data-name=\"filters panel\">\n<div class=\"field grow\" data-kid=\"1-2-2-3-1\" data-name=\"search field\">\n<label data-kid=\"1-2-2-3-1-1\" data-name=\"search field label\" for=\"user-search\">Search</label>\n<div class=\"input-wrap\" data-kid=\"1-2-2-3-1-2\" data-name=\"search input with icon\">\n<i class=\"icon-search\" data-kid=\"1-2-2-3-1-2-1\" data-name=\"search magnifier icon\"></i>\n<input data-kid=\"1-2-2-3-1-2-2\" data-name=\"search text input\" id=\"user-search\" placeholder=\"Name, email or account ID\" type=\"text\"/>\n</div>\n</div>\n<div class=\"field\" data-kid=\"1-2-2-3-2\" data-name=\"account type filter field\">\n<label data-kid=\"1-2-2-3-2-1\" data-name=\"account type label\" for=\"type-filter\">Account type</label>\n<div class=\"select-wrap\" data-kid=\"1-2-2-3-2-2\" data-name=\"account type select with icon\">\n<select data-kid=\"1-2-2-3-2-2-1\" data-name=\"account type dropdown\" id=\"type-filter\">\n<option data-kid=\"1-2-2-3-2-2-1-1\" data-name=\"All types option\">All types</option>\n<option data-kid=\"1-2-2-3-2-2-1-2\" data-name=\"Buyer option\">Buyer</option>\n<option data-kid=\"1-2-2-3-2-2-1-3\" data-name=\"Private seller option\">Private seller</option>\n<option data-kid=\"1-2-2-3-2-2-1-4\" data-name=\"Dealer option\">Dealer</option>\n<option data-kid=\"1-2-2-3-2-2-1-5\" data-name=\"Administrator option\">Administrator</option>\n<option data-kid=\"1-2-2-3-2-2-1-6\" data-name=\"Super administrator option\">Super ad