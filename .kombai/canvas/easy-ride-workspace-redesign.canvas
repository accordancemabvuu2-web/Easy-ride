      "themeId": null,
      "rect": {
        "x": 1540,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Alfa+Slab+One&family=Cabin:wght@400;500;600;700&family=Mulish:wght@400;500;600;700;800&display=swap');\n:root{--color-nav:#123A2A;--color-page:#F8F4EA;--color-surface:#FFFEFA;--color-inset:#EFE9DA;--color-ink:#243127;--color-muted:#5E675B;--color-border:#DAD5C6;--color-primary:#0C6346;--color-gold:#BE8A24;--color-success:#28764B;--color-warning:#946618;--color-error:#AB4439;--color-info:#3F7282;--color-neutral:#697068;--color-focus:#E3AD35;--font-body:'Mulish',sans-serif;--font-ui:'Cabin',sans-serif;--font-display:'Alfa Slab One',serif;}\n</style>\n<div class=\"min-h-screen bg-[var(--color-page)] font-[var(--font-body)] text-[var(--color-ink)]\" data-kid=\"1\" data-name=\"page layout container\">\n    <aside class=\"fixed inset-y-0 left-0 z-20 flex w-[264px] flex-col bg-[var(--color-nav)] px-5 py-6 text-[#FFFEFA]\" data-kid=\"1-1\" data-name=\"sidebar navigation panel\">\n        <div class=\"flex items-center gap-3 border-b border-white/12 px-2 pb-7\" data-kid=\"1-1-1\" data-name=\"sidebar brand header\">\n            <div class=\"grid size-11 place-items-center rounded-[10px] border border-[#BE8A24]/60 bg-[#FFFEFA]/5 text-lg text-[#E3AD35]\" data-kid=\"1-1-1-1\" data-name=\"brand monogram tile\" style=\"font-family:var(--font-display)\">\n                ER\n            </div>\n            <div data-kid=\"1-1-1-2\" data-name=\"brand name block\">\n                <div class=\"text-[17px] font-extrabold tracking-[-0.04em]\" data-kid=\"1-1-1-2-1\" data-name=\"brand name title\">\n                    Easy Ride\n                </div>\n                <div class=\"mt-0.5 text-sm text-[#D2D9CE]\" data-kid=\"1-1-1-2-2\" data-name=\"brand subtitle text\">\n                    Dealer workspace\n                </div>\n            </div>\n        </div>\n        <div class=\"mt-7 px-3 text-[12px] font-bold uppercase tracking-[0.12em] text-[#BFC9BB]\" data-kid=\"1-1-2\" data-name=\"workspace section label\">\n            Workspace\n        </div>\n        <nav aria-label=\"Dealer workspace navigation\" class=\"mt-3 space-y-1\" data-kid=\"1-1-3\" data-name=\"main workspace navigation\">\n            <a class=\"flex min-h-11 items-center gap-3 rounded-[7px] bg-[#FFFEFA]/12 px-3.5 text-[15px] font-bold text-white ring-1 ring-inset ring-white/10\" data-kid=\"1-1-3-1\" data-name=\"overview nav link (active)\" href=\"/dealer/dashboard\">\n                <i aria-hidden=\"true\" class=\"icon-layout-dashboard text-[19px] text-[#E3AD35]\" data-kid=\"1-1-3-1-1\" data-name=\"dashboard layout icon\" style=\"color:#E3AD35\">\n                </i>\n                <span data-kid=\"1-1-3-1-2\" data-name=\"overview nav label\">\n                    Overview\n                </span>\n            </a>\n            <a class=\"flex min-h-11 items-center gap-3 rounded-[7px] px-3.5 text-[15px] font-semibold text-[#E1E6DD] hover:bg-white/8\" data-kid=\"1-1-3-2\" data-name=\"inventory nav link\" href=\"/dealer/inventory\">\n                <i aria-hidden=\"true\" class=\"icon-car-front text-[19px] text-[#D7DFD4]\" data-kid=\"1-1-3-2-1\" data-name=\"car front icon\" style=\"color:#D7DFD4\">\n                </i>\n                <span data-kid=\"1-1-3-2-2\" data-name=\"inventory nav label\">\n                    Inventory\n                </span>\n            </a>\n            <a class=\"flex min-h-11 items-center gap-3 rounded-[7px] px-3.5 text-[15px] font-semibold text-[#E1E6DD] hover:bg-white/8\" data-kid=\"1-1-3-3\" data-name=\"analytics nav link\" href=\"/dealer/analytics\">\n                <i aria-hidden=\"true\" class=\"icon-chart-no-axes-column-increasing text-[19px] text-[#D7DFD4]\" data-kid=\"1-1-3-3-1\" data-name=\"bar chart icon\" style=\"color:#D7DFD4\">\n                </i>\n                <span data-kid=\"1-1-3-3-2\" data-name=\"analytics nav label\">\n                    Analytics\n                </span>\n            </a>\n        </nav>\n        <div class=\"mt-8 px-3 text-[12px] font-bold uppercase tracking-[0.12em] text-[#BFC9BB]\" data-kid=\"1-1-4\" data-name=\"account section label\">\n            Account\n        </div>\n        <nav aria-label=\"Dealer account navigation\" class=\"mt-3 space-y-1\" data-kid=\"1-1-5\" data-name=\"account navigation\">\n            <a class=\"flex min-h-11 items-center gap-3 rounded-[7px] px-3.5 text-[15px] font-semibold text-[#E1E6DD] hover:bg-white/8\" data-kid=\"1-1-5-1\" data-name=\"profile nav link\" href=\"/dealer/profile\">\n                <i aria-hidden=\"true\" class=\"icon-user-round text-[19px]\" data-kid=\"1-1-5-1-1\" data-name=\"user profile icon\" style=\"color:#D7DFD4\">\n                </i>\n                <span data-kid=\"1-1-5-1-2\" data-name=\"profile nav label\">\n                    Profile\n                </span>\n            </a>\n            <a class=\"flex min-h-11 items-center gap-3 rounded-[7px] px-3.5 text-[15px] font-semibold text-[#E1E6DD] hover:bg-white/8\" data-kid=\"1-1-5-2\" data-name=\"verification nav link\" href=\"/verification\">\n                <i aria-hidden=\"true\" class=\"icon-shield-check text-[19px]\" data-kid=\"1-1-5-2-1\" data-name=\"shield check icon\" style=\"color:#D7DFD4\">\n                </i>\n                <span data-kid=\"1-1-5-2-2\" data-name=\"verification nav label\">\n                    Verification\n                </span>\n            </a>\n        </nav>\n        <div class=\"mt-auto border-t border-white/12 pt-5\" data-kid=\"1-1-6\" data-name=\"sidebar footer block\">\n            <a class=\"flex min-h-12 items-center justify-center gap-2 rounded-[7px] bg-[#BE8A24] px-4 font-bold text-[#243127] shadow-[0_2px_0_rgba(0,0,0,0.18)] outline-offset-4 focus-visible:outline-2 focus-visible:outline-[var(--color-focus)]\" data-kid=\"1-1-6-1\" data-name=\"add vehicle call-to-action button\" href=\"/create-listing\">\n                <i aria-hidden=\"true\" class=\"icon-plus text-[18px]\" data-kid=\"1-1-6-1-1\" data-name=\"plus icon\" style=\"color:#243127\">\n                </i>\n                <span data-kid=\"1-1-6-1-2\" data-name=\"add vehicle button label\">\n                    Add vehicle\n                </span>\n            </a>\n            <div class=\"mt-5 flex items-center gap-3 rounded-[8px] px-2 py-2\" data-kid=\"1-1-6-2\" data-name=\"user account summary row\">\n                <div class=\"grid size-10 shrink-0 place-items-center rounded-full bg-[#E8D9B4] font-[var(--font-ui)] text-sm font-bold text-[#123A2A]\" data-kid=\"1-1-6-2-1\" data-name=\"user avatar monogram\">\n                    ER\n                </div>\n                <div class=\"min-w-0\" data-kid=\"1-1-6-2-2\" data-name=\"user account text block\">\n                    <div class=\"truncate text-sm font-bold text-white\" data-kid=\"1-1-6-2-2-1\" data-name=\"account name title\">\n                        Dealer account\n                    </div>\n                    <div class=\"truncate text-[13px] text-[#C5CEC1]\" data-kid=\"1-1-6-2-2-2\" data-name=\"account role subtitle\">\n                        Easy Ride partner\n                    </div>\n                </div>\n                <i aria-hidden=\"true\" class=\"icon-chevrons-up-down ml-auto text-[17px] text-[#C5CEC1]\" data-kid=\"1-1-6-2-3\" data-name=\"account menu chevron icon\" style=\"color:#C5CEC1\">\n                </i>\n            </div>\n        </div>\n    </aside>\n    <main class=\"ml-[264px] min-h-screen px-10 pb-12 pt-8 xl:px-12\" data-kid=\"1-2\" data-name=\"main content area\">\n        <div class=\"mx-auto max-w-[1120px]\" data-kid=\"1-2-1\" data-name=\"main content layout wrapper\">\n            <div class=\"mb-8 flex items-center justify-between border-b border-[var(--color-border)] pb-4\" data-kid=\"1-2-1-1\" data-name=\"top toolbar bar\">\n                <div class=\"flex items-center gap-2 text-[14px] font-semibold text-[var(--color-muted)]\" data-kid=\"1-2-1-1-1\" data-name=\"breadcrumb navigation\">\n                    <span data-kid=\"1-2-1-1-1-1\" data-name=\"breadcrumb root label\">\n                        Dealer workspace\n                    </span>\n                    <span class=\"text-[#A59F8F]\" data-kid=\"1-2-1-1-1-2\" data-name=\"breadcrumb separator\">\n                        /\n                    </span>\n                    <span class=\"text-[var(--color-ink)]\" data-kid=\"1-2-1-1-1-3\" data-name=\"breadcrumb current page\">\n                        Overview\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-4\" data-kid=\"1-2-1-1-2\" data-name=\"toolbar actions group\">\n                    <a aria-label=\"Notifications\" class=\"relative grid size-11 place-items-center rounded-[8px] border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-ink)] outline-offset-2 focus-visible:outline-2 focus-visible:outline-[var(--color-focus)]\" data-kid=\"1-2-1-1-2-1\" data-name=\"notifications button\" href=\"/notifications\">\n                        <i aria-hidden=\"true\" class=\"icon-bell text-[19px]\" data-kid=\"1-2-1-1-2-1-1\" data-name=\"notification bell icon\" style=\"color:#243127\">\n                        </i>\n                    </a>\n                    <div class=\"hidden items-center gap-3 sm:flex\" data-kid=\"1-2-1-1-2-2\" data-name=\"toolbar user chip\">\n                        <div class=\"grid size-10 place-items-center rounded-full bg-[#E6DFCE] font-[var(--font-ui)] text-sm font-bold text-[var(--color-nav)]\" data-kid=\"1-2-1-1-2-2-1\" data-name=\"toolbar user avatar\">\n                            ER\n                        </div>\n                        <div data-kid=\"1-2-1-1-2-2-2\" data-name=\"toolbar user details\">\n                            <div class=\"text-sm font-bold\" data-kid=\"1-2-1-1-2-2-2-1\" data-name=\"toolbar user name\">\n                                Dealer account\n                            </div>\n                            <div class=\"text-[13px] text-[var(--color-muted)]\" data-kid=\"1-2-1-1-2-2-2-2\" data-name=\"toolbar user role\">\n                                Dealer\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <header class=\"flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between\" data-kid=\"1-2-1-2\" data-name=\"page header section\">\n                <div class=\"max-w-[720px]\" data-kid=\"1-2-1-2-1\" data-name=\"page title block\">\n                    <h1 class=\"font-[var(--font-ui)] text-[36px] font-bold leading-[1.12] tracking-[-0.045em] text-[var(--color-ink)]\" data-kid=\"1-2-1-2-1-1\" data-name=\"page headline\">\n                        Dealer dashboard\n                    </h1>\n                    <p class=\"mt-3 text-[16px] leading-7 text-[var(--color-muted)]\" data-kid=\"1-2-1-2-1-2\" data-name=\"page description text\">\n                        Track your inventory, review listing status, and see recorded activity.\n                    </p>\n                </div>\n                <a class=\"inline-flex min-h-11 items-center justify-center gap-2 rounded-[7px] border border-[var(--color-border)] bg-[var(--color-surface)] px-4 font-bold text-[var(--color-nav)] outline-offset-2 focus-visible:outline-2 focus-visible:outline-[var(--color-focus)]\" data-kid=\"1-2-1-2-2\" data-name=\"open inventory secondary button\" href=\"/dealer/inventory\">\n                    <i aria-hidden=\"true\" class=\"icon-car-front text-[18px]\" data-kid=\"1-2-1-2-2-1\" data-name=\"car front icon\" style=\"color:#123A2A\">\n                    </i>\n                    <span data-kid=\"1-2-1-2-2-2\" data-name=\"open inventory button label\">\n                        Open inventory\n                    </span>\n                </a>\n            </header>\n            <div class=\"mt-9 grid items-start gap-7 lg:grid-cols-[minmax(0,1.7fr)_minmax(290px,0.8fr)]\" data-kid=\"1-2-1-3\" data-name=\"dashboard content grid\">\n                <section class=\"overflow-hidden rounded-[12px] border border-[var(--color-border)] bg-[var(--color-surface)]\" data-kid=\"1-2-1-3-1\" data-name=\"inventory card section\">\n                    <div class=\"flex flex-wrap items-center justify-between gap-4 border-b border-[var(--color-border)] px-6 py-5\" data-kid=\"1-2-1-3-1-1\" data-name=\"inventory card header\">\n                        <div data-kid=\"1-2-1-3-1-1-1\" data-name=\"inventory card title block\">\n                            <h2 class=\"font-[var(--font-ui)] text-[22px] font-bold tracking-[-0.025em]\" data-kid=\"1-2-1-3-1-1-1-1\" data-name=\"inventory card heading\">\n                                Your inventory\n                            </h2>\n                            <p class=\"mt-1 text-[14px] text-[var(--color-muted)]\" data-kid=\"1-2-1-3-1-1-1-2\" data-name=\"inventory card subtitle\">\n                                Vehicle listings and their current review state\n                            </p>\n                        </div>\n                        <a class=\"min-h-11 inline-flex items-center gap-1.5 px-1 text-[14px] font-bold text-[var(--color-primary)] underline decoration-transparent underline-offset-4 hover:decoration-current focus-visible:outline-2 focus-visible:outline-[var(--color-focus)]\" data-kid=\"1-2-1-3-1-1-2\" data-name=\"manage inventory link\" href=\"/dealer/inventory\">\n                            Manage inventory\n                            <i aria-hidden=\"true\" class=\"icon-arrow-up-right text-[16px]\" data-kid=\"1-2-1-3-1-1-2-1\" data-name=\"arrow up right icon\" style=\"color:#0C6346\">\n                            </i>\n                        </a>\n                    </div>\n                    <div class=\"grid grid-cols-2 border-b border-[var(--color-border)] bg-[#F6F1E6]\" data-kid=\"1-2-1-3-1-2\" data-name=\"inventory stats bar\">\n                        <div class=\"flex items-center justify-between border-r border-[var(--color-border)] px-6 py-4\" data-kid=\"1-2-1-3-1-2-1\" data-name=\"active listings stat\">\n                            <span class=\"text-[14px] font-semibold text-[var(--color-muted)]\" data-kid=\"1-2-1-3-1-2-1-1\" data-name=\"active listings stat label\">\n                                Active listings\n                            </span>\n                            <span class=\"font-[var(--font-ui)] text-[18px] font-bold text-[var(--color-success)]\" data-dynamic=\"true\" data-kid=\"1-2-1-3-1-2-1-2\" data-name=\"active listings stat value\" data-reason=\"count text populated from live listing data\">\n                                0\n                            </span>\n                        </div>\n                        <div class=\"flex items-center justify-between px-6 py-4\" data-kid=\"1-2-1-3-1-2-2\" data-name=\"pending review stat\">\n                            <span class=\"text-[14px] font-semibold text-[var(--color-muted)]\" data-kid=\"1-2-1-3-1-2-2-1\" data-name=\"pending review stat label\">\n                                Pending review\n                            </span>\n                            <span class=\"font-[var(--font-ui)] text-[18px] font-bold text-[var(--color-warning)]\" data-dynamic=\"true\" data-kid=\"1-2-1-3-1-2-2-2\" data-name=\"pending review stat value\" data-reason=\"count text populated from live listing data\">\n                                0\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"flex min-h-[286px] flex-col items-center justify-center px-8 py-10 text-center\" data-kid=\"1-2-1-3-1-3\" data-name=\"empty inventory state\">\n                        <i aria-hidden=\"true\" class=\"icon-car-front text-[32px] text-[var(--color-muted)]\" data-kid=\"1-2-1-3-1-3-1\" data-name=\"empty state car icon\" style=\"color:#697068\">\n                        </i>\n                        <h3 class=\"mt-5 font-[var(--font-ui)] text-[23px] font-bold tracking-[-0.025em]\" data-kid=\"1-2-1-3-1-3-2\" data-name=\"empty state heading\">\n                            No vehicles listed yet\n                        </h3>\n                        <p class=\"mt-2 max-w-[390px] text-[15px] leading-6 text-[var(--color-muted)]\" data-kid=\"1-2-1-3-1-3-3\" data-name=\"empty state description\">\n                            Add a vehicle to start building your inventory. Its listing status will appear here as it moves through review.\n                        </p>\n                        <a class=\"mt-6 inline-flex min-h-11 items-center justify-center gap-2 rounded-[7px] bg-[var(--color-primary)] px-5 font-bold text-white outline-offset-2 hover:bg-[#094F39] focus-visible:outline-2 focus-visible:outline-[var(--color-focus)]\" data-kid=\"1-2-1-3-1-3-4\" data-name=\"add first vehicle call-to-action\" href=\"/create-listing\">\n                            <i aria-hidden=\"true\" class=\"icon-plus text-[18px]\" data-kid=\"1-2-1-3-1-3-4-1\" data-name=\"plus icon\" style=\"color:#FFFFFF\">\n                            </i>\n                            <span data-kid=\"1-2-1-3-1-3-4-2\" data-name=\"add first vehicle button label\">\n                                Add your first vehicle\n                            </span>\n                        </a>\n                    </div>\n                </section>\n                <aside class=\"space-y-6\" data-kid=\"1-2-1-3-2\" data-name=\"right sidebar column\">\n                    <section class=\"rounded-[12px] border border-[var(--color-border)] bg-[var(--color-surface)] px-5 py-5\" data-kid=\"1-2-1-3-2-1\" data-name=\"recorded activity card\">\n                        <h2 class=\"font-[var(--font-ui)] text-[20px] font-bold tracking-[-0.02em]\" data-kid=\"1-2-1-3-2-1-1\" data-name=\"recorded activity heading\">\n                            Recorded activity\n                        </h2>\n                        <p class=\"mt-2 text-[14px] leading-6 text-[var(--color-muted)]\" data-kid=\"1-2-1-3-2-1-2\" data-name=\"recorded activity description\">\n                            Views, contacts, favorites, and conversion are grouped in dealer analytics once listing activity is recorded.\n                        </p>\n                        <a class=\"mt-4 inline-flex min-h-11 items-center gap-2 font-bold text-[var(--color-primary)] underline decoration-[var(--color-border)] underline-offset-4 hover:decoration-current focus-visible:outline-2 focus-visible:outline-[var(--color-focus)]\" data-kid=\"1-2-1-3-2-1-3\" data-name=\"open dealer analytics link\" href=\"/dealer/analytics\">\n                            Open dealer analytics\n                            <i aria-hidden=\"true\" class=\"icon-arrow-right text-[16px]\" data-kid=\"1-2-1-3-2-1-3-1\" data-name=\"arrow right icon\" style=\"color:#0C6346\">\n                            </i>\n                        </a>\n                    </section>\n                    <section class=\"rounded-[12px] bg-[var(--color-inset)] px-5 py-5\" data-kid=\"1-2-1-3-2-2\" data-name=\"dealer tools card\">\n                        <h2 class=\"font-[var(--font-ui)] text-[18px] font-bold\" data-kid=\"1-2-1-3-2-2-1\" data-name=\"dealer tools heading\">\n                            Dealer tools\n                        </h2>\n                        <div class=\"mt-3 divide-y divide-[#DAD5C6]\" data-kid=\"1-2-1-3-2-2-2\" data-name=\"dealer tools list\">\n                            <a class=\"flex min-h-11 items-center justify-between gap-3 py-2.5 text-[14px] font-semibold text-[var(--color-ink)]\" data-kid=\"1-2-1-3-2-2-2-1\" data-name=\"business profile tool link\" href=\"/dealer/profile\">\n                                <span class=\"flex items-center gap-2.5\" data-kid=\"1-2-1-3-2-2-2-1-1\" data-name=\"business profile tool label\">\n                                    <i aria-hidden=\"true\" class=\"icon-user-round text-[17px]\" data-kid=\"1-2-1-3-2-2-2-1-1-1\" data-name=\"user profile icon\" style=\"color:#5E675B\">\n                                    </i>\n                                    Business profile\n                                </span>\n                                <i aria-hidden=\"true\" class=\"icon-arrow-up-right text-[16px]\" data-kid=\"1-2-1-3-2-2-2-1-2\" data-name=\"arrow up right icon\" style=\"color:#697068\">\n                                </i>\n                            </a>\n                            <a class=\"flex min-h-11 items-center justify-between gap-3 py-2.5 text-[14px] font-semibold text-[var(--color-ink)]\" data-kid=\"1-2-1-3-2-2-2-2\" data-name=\"verification tool link\" href=\"/verification\">\n                                <span class=\"flex items-center gap-2.5\" data-kid=\"1-2-1-3-2-2-2-2-1\" data-name=\"verification tool label\">\n                                    <i aria-hidden=\"true\" class=\"icon-shield-check text-[17px]\" data-kid=\"1-2-1-3-2-2-2-2-1-1\" data-name=\"shield check icon\" style=\"color:#5E675B\">\n                                    </i>\n                                    Verification\n                                </span>\n                                <i aria-hidden=\"true\" class=\"icon-arrow-up-right text-[16px]\" data-kid=\"1-2-1-3-2-2-2-2-2\" data-name=\"arrow up right icon\" style=\"color:#697068\">\n                                </i>\n                            </a>\n                        </div>\n                    </section>\n                </aside>\n            </div>\n            <footer class=\"mt-12 flex flex-wrap items-center justify-between gap-3 border-t border-[var(--color-border)] pt-5 text-[13px] text-[var(--color-muted)]\" data-kid=\"1-2-1-4\" data-name=\"page footer bar\">\n                <span data-kid=\"1-2-1-4-1\" data-name=\"footer workspace label\">\n                    Easy Ride dealer workspace\n                </span>\n                <a class=\"font-semibold text-[var(--color-primary)] underline underline-offset-4\" data-kid=\"1-2-1-4-2\" data-name=\"manage verification footer link\" href=\"/verification\">\n                    Manage verification\n                </a>\n            </footer>\n        </div>\n    </main>\n</div>\n",
      "comments": [],
      "created": "2026-10-16T12:28:13.585410+00:00",
      "modified": "2026-10-16T12:28:50.408357+00:00",
      "id": "var_c011cd5a4061",
      "contentHeight": 1000
    },
    "var_28aa2549847d": {
      "type": "variant",
      "label": "02 · Vehicle ledger — Dealer",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 3080,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Raleway:wght@500;600;700;800&family=Source+Sans+3:wght@400;500;600;700&family=Yantramanav:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/regular/style.css');\n:root{--nav:#092F2B;--page:#EFF4F1;--surface:#FFFFFF;--inset:#E3EDE8;--ink:#142C27;--muted:#50655F;--border:#CBDAD2;--primary:#146D55;--gold:#D0A43A;--success:#257653;--warning:#966919;--error:#B0443C;--info:#39738B;--neutral:#63726D;--focus:#E5B743;}\n.workspace{background:var(--page);color:var(--ink);font-family:'Source Sans 3',sans-serif;min-height:100vh;padding:0 0 38px;}\n.topbar{height:72px;background:var(--surface);border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;padding:0 34px;}\n.brand{display:flex;gap:12px;align-items:center;color:var(--ink);text-decoration:none;}\n.brandmark{width:38px;height:38px;background:var(--gold);color:var(--nav);display:grid;place-items:center;font:800 14px 'Raleway',sans-serif;letter-spacing:-.07em;border-radius:8px;}\n.brandname{font:800 17px 'Raleway',sans-serif;letter-spacing:-.035em;}\n.topmeta{display:flex;align-items:center;gap:18px;color:var(--muted);font-size:14px;}\n.crumb{border-left:1px solid var(--border);padding-left:18px;}\n.avatar{width:36px;height:36px;border-radius:50%;background:var(--inset);color:var(--nav);display:grid;place-items:center;font-weight:700;}\n.layout{display:grid;grid-template-columns:256px minmax(0,1fr);max-width:1440px;margin:0 auto;min-height:calc(100vh - 72px);}\n.sidebar{background:var(--nav);color:#F4F8F6;padding:24px 16px 20px;display:flex;flex-direction:column;}\n.sidebarBrand{display:flex;gap:11px;align-items:center;padding:4px 10px 22px;border-bottom:1px solid #FFFFFF24;}\n.sidebarBrand .brandmark{background:var(--gold);}\n.sidebarBrand .brandname{color:#fff;}\n.sidebarRole{display:block;color:#BBD1C9;font:600 13px 'Source Sans 3',sans-serif;margin-top:3px;}\n.navGroup{padding:23px 8px 0;}\n.navLabel{font-size:12px;text-transform:uppercase;letter-spacing:.12em;color:#A9C0B7;font-weight:700;padding:0 10px 8px;}\n.navlink{min-height:44px;color:#D4E2DC;text-decoration:none;display:flex;align-items:center;gap:12px;padding:0 11px;border-radius:7px;font-size:15px;font-weight:600;margin:3px 0;}\n.navlink i{width:20px;height:20px;font-size:19px;color:currentColor;display:inline-grid;place-items:center;}\n.navlink:hover{background:#FFFFFF12;color:#fff;}\n.navlink.active{background:#FFFFFF19;color:#fff;position:relative;}\n.navlink.active:before{content:'';position:absolute;left:-8px;top:11px;height:22px;width:3px;background:var(--gold);border-radius:0 2px 2px 0;}\n.addlink{color:#fff;background:#146D55;border:1px solid #FFFFFF25;}\n.sideBottom{margin-top:auto;padding:18px 8px 0;border-top:1px solid #FFFFFF24;}\n.sideBottom a{color:#D4E2DC;text-decoration:none;min-height:44px;display:flex;align-items:center;gap:12px;padding:0 11px;font-size:15px;}\n.sideBottom i{font-size:19px;width:20px;height:20px;display:inline-grid;place-items:center;}\n.main{padding:34px 42px 22px;min-width:0;}\n.breadcrumb{font-size:14px;color:var(--muted);margin-bottom:17px;}\n.breadcrumb strong{font-weight:600;color:var(--ink);}\n.headrow{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;padding-bottom:26px;border-bottom:1px solid var(--border);}\n.title{margin:0;color:var(--ink);font:700 34px/1.1 'Raleway',sans-serif;letter-spacing:-.04em;}\n.intro{margin:9px 0 0;color:var(--muted);font-size:16px;line-height:1.45;max-width:660px;}\n.primaryButton{min-height:46px;padding:0 18px;border:0;border-radius:6px;background:var(--primary);color:#fff;text-decoration:none;font:700 15px 'Source Sans 3',sans-serif;display:inline-flex;align-items:center;gap:9px;white-space:nowrap;}\n.primaryButton i{font-size:19px;width:20px;height:20px;display:inline-grid;place-items:center;color:currentColor;}\n.primaryButton:focus-visible,.navlink:focus-visible,.plainLink:focus-visible,.mobileMenu summary:focus-visible{outline:3px solid var(--focus);outline-offset:3px;}\n.columns{display:grid;grid-template-columns:minmax(0,1fr) 268px;gap:30px;padding-top:28px;align-items:start;}\n.inventory{min-width:0;}\n.sectionHead{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:14px;}\n.sectionHead h2,.performance h2{font:700 21px/1.2 'Raleway',sans-serif;margin:0;letter-spacing:-.025em;color:var(--ink);}\n.scope{color:var(--muted);font-size:14px;}\n.filterline{display:flex;align-items:center;gap:8px;border-bottom:1px solid var(--border);padding:4px 0 15px;margin-bottom:0;}\n.filter{color:var(--muted);font:600 14px 'Source Sans 3',sans-serif;text-decoration:none;padding:8px 11px;border-radius:5px;}\n.filter.selected{background:var(--inset);color:var(--nav);}\n.empty{min-height:302px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:24px 30px;}\n.emptyIcon{width:54px;height:54px;display:grid;place-items:center;color:var(--primary);background:var(--inset);border-radius:50%;margin-bottom:14px;}\n.emptyIcon i{font-size:25px;width:27px;height:27px;display:grid;place-items:center;}\n.empty h3{font:700 21px/1.2 'Raleway',sans-serif;margin:0;color:var(--ink);}\n.empty p{font-size:15px;color:var(--muted);line-height:1.5;max-width:390px;margin:8px 0 17px;}\n.textAction{color:var(--primary);font-weight:700;font-size:15px;text-decoration:none;border-bottom:1px solid currentColor;padding:2px 0;}\n.performance{border-left:1px solid var(--border);padding-left:24px;min-height:260px;}\n.performanceHead{display:flex;align-items:center;justify-content:space-between;gap:8px;padding-bottom:15px;border-bottom:1px solid var(--border);}\n.performance h2{font-size:18px;}\n.plainLink{color:var(--primary);font-size:14px;font-weight:700;text-decoration:none;white-space:nowrap;}\n.measureList{list-style:none;margin:0;padding:0;}\n.measureList li{display:flex;align-items:center;justify-content:space-between;gap:10px;min-height:48px;border-bottom:1px solid var(--border);font-size:15px;}\n.measureList li span:first-child{color:var(--ink);}\n.measureList li span:last-child{color:var(--muted);font:500 14px 'Yantramanav',sans-serif;}\n.performanceNote{margin-top:14px;color:var(--muted);font-size:14px;line-height:1.45;}\n.mobileMenu{display:none;}\n.tokenReference{max-width:1440px;margin:0 auto;padding:18px 34px 0;border-top:1px solid var(--border);}\n.tokenTitle{font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);font-weight:700;margin:0 0 11px;}\n.tokens{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px 18px;}\n.token{display:flex;gap:8px;align-items:center;min-width:0;font-size:13px;color:var(--muted);}\n.swatch{width:16px;height:16px;flex:0 0 16px;border:1px solid #142C2730;border-radius:3px;}\n.token b{color:var(--ink);font-weight:600;}\n.token code{font:500 12px 'Yantramanav',sans-serif;color:var(--muted);}\n@media(max-width:900px){.layout{grid-template-columns:minmax(0,1fr)}.sidebar{display:none}.topbar{height:62px;padding:0 18px}.layout{min-height:calc(100vh - 62px)}.mobileMenu{display:block;background:var(--surface);border-bottom:1px solid var(--border);padding:10px 16px;}.mobileMenu summary{min-height:44px;display:flex;align-items:center;gap:10px;list-style:none;color:var(--ink);font-weight:700;cursor:pointer;}.mobileMenu summary::-webkit-details-marker{display:none}.mobileLinks{padding:6px 0 12px;display:grid;grid-template-columns:1fr 1fr;gap:4px 10px}.mobileLinks a{min-height:44px;padding:11px 12px;border-radius:5px;color:var(--ink);text-decoration:none;}.mobileLinks a.current{background:var(--inset);font-weight:700}.main{padding:24px 20px}.columns{grid-template-columns:1fr;gap:24px}.performance{border-left:0;border-top:1px solid var(--border);padding:20px 0 0;min-height:auto}.tokens{grid-template-columns:repeat(3,minmax(0,1fr));}.headrow{align-items:flex-start;}.title{font-size:30px;}}\n@media(max-width:560px){.topmeta .crumb{display:none}.topmeta{gap:10px}.brandname{font-size:15px}.headrow{display:block}.headrow .primaryButton{margin-top:18px}.title{font-size:28px}.main{padding:20px 16px}.empty{min-height:260px;padding:20px 8px}.filterline{overflow-x:auto}.tokens{grid-template-columns:repeat(2,minmax(0,1fr));}.tokenReference{padding:16px}.mobileLinks{grid-template-columns:1fr;}}\n</style>\n<div class=\"workspace\" data-kid=\"1\" data-name=\"page layout container\">\n    <header class=\"topbar\" data-kid=\"1-1\" data-name=\"top application bar\">\n        <a aria-label=\"Easy Ride home\" class=\"brand\" data-kid=\"1-1-1\" data-name=\"brand logo link\" href=\"/\">\n            <span class=\"brandmark\" data-kid=\"1-1-1-1\" data-name=\"brand monogram mark\">\n                ER\n            </span>\n            <span class=\"brandname\" data-kid=\"1-1-1-2\" data-name=\"brand name text\">\n                EASY RIDE\n            </span>\n        </a>\n        <div class=\"topmeta\" data-kid=\"1-1-2\" data-name=\"top bar metadata group\">\n            <span class=\"crumb\" data-kid=\"1-1-2-1\" data-name=\"workspace crumb label\">\n                Dealer workspace\n            </span>\n            <span aria-label=\"Signed-in dealer\" class=\"avatar\" data-kid=\"1-1-2-2\" data-name=\"signed-in dealer avatar\">\n                D\n            </span>\n        </div>\n    </header>\n    <details class=\"mobileMenu\" data-kid=\"1-2\" data-name=\"mobile navigation disclosure\">\n        <summary data-kid=\"1-2-1\" data-name=\"mobile menu summary header\">\n            <i aria-hidden=\"true\" class=\"ph ph-list\" data-kid=\"1-2-1-1\" data-name=\"menu list icon\" style=\"font-size:21px;width:22px;height:22px;color:var(--primary);display:inline-grid;place-items:center\">\n            </i>\n            Dealer navigation\n            <span data-kid=\"1-2-1-2\" data-name=\"mobile menu open indicator label\" style=\"margin-left:auto;color:var(--muted);font-weight:500\">\n                Open\n            </span>\n        </summary>\n        <nav aria-label=\"Dealer workspace\" class=\"mobileLinks\" data-kid=\"1-2-2\" data-name=\"mobile navigation link group\">\n            <a class=\"current\" data-kid=\"1-2-2-1\" data-name=\"mobile navigation overview link\" href=\"/dealer/dashboard\">\n                Overview\n            </a>\n            <a data-kid=\"1-2-2-2\" data-name=\"mobile navigation inventory link\" href=\"/dealer/inventory\">\n                Inventory\n            </a>\n            <a data-kid=\"1-2-2-3\" data-name=\"mobile navigation add vehicle link\" href=\"/create-listing\">\n                Add Vehicle\n            </a>\n            <a data-kid=\"1-2-2-4\" data-name=\"mobile navigation analytics link\" href=\"/dealer/analytics\">\n                Analytics\n            </a>\n            <a data-kid=\"1-2-2-5\" data-name=\"mobile navigation profile link\" href=\"/dealer/profile\">\n                Profile\n            </a>\n            <a data-kid=\"1-2-2-6\" data-name=\"mobile navigation verification link\" href=\"/verification\">\n                Verification\n            </a>\n        </nav>\n    </details>\n    <div class=\"layout\" data-kid=\"1-3\" data-name=\"sidebar plus main content layout\">\n        <aside aria-label=\"Dealer workspace navigation\" class=\"sidebar\" data-kid=\"1-3-1\" data-name=\"sidenav navigation panel\">\n            <div class=\"sidebarBrand\" data-kid=\"1-3-1-1\" data-name=\"sidenav brand cluster\">\n                <span class=\"brandmark\" data-kid=\"1-3-1-1-1\" data-name=\"sidenav brand monogram mark\">\n                    ER\n                </span>\n                <div data-kid=\"1-3-1-1-2\" data-name=\"sidenav brand text block\">\n                    <div class=\"brandname\" data-kid=\"1-3-1-1-2-1\" data-name=\"sidenav brand name text\">\n                        EASY RIDE\n                    </div>\n                    <span class=\"sidebarRole\" data-kid=\"1-3-1-1-2-2\" data-name=\"sidenav role subtitle\">\n                        Dealer workspace\n                    </span>\n                </div>\n            </div>\n            <nav aria-label=\"Work\" class=\"navGroup\" data-kid=\"1-3-1-2\" data-name=\"work navigation group\">\n                <div class=\"navLabel\" data-kid=\"1-3-1-2-1\" data-name=\"work section label\">\n                    Work\n                </div>\n                <a aria-current=\"page\" class=\"navlink active\" data-kid=\"1-3-1-2-2\" data-name=\"active overview navigation link\" href=\"/dealer/dashboard\">\n                    <i aria-hidden=\"true\" class=\"ph ph-squares-four\" data-kid=\"1-3-1-2-2-1\" data-name=\"overview grid icon\">\n                    </i>\n                    Overview\n                </a>\n                <a class=\"navlink\" data-kid=\"1-3-1-2-3\" data-name=\"inventory navigation link\" href=\"/dealer/inventory\">\n                    <i aria-hidden=\"true\" class=\"ph ph-car-profile\" data-kid=\"1-3-1-2-3-1\" data-name=\"car profile icon\">\n                    </i>\n                    Inventory\n                </a>\n                <a class=\"navlink addlink\" data-kid=\"1-3-1-2-4\" data-name=\"add vehicle navigation link\" href=\"/create-listing\">\n                    <i aria-hidden=\"true\" class=\"ph ph-plus\" data-kid=\"1-3-1-2-4-1\" data-name=\"plus icon\">\n                    </i>\n                    Add Vehicle\n                </a>\n                <a class=\"navlink\" data-kid=\"1-3-1-2-5\" data-name=\"analytics navigation link\" href=\"/dealer/analytics\">\n                    <i aria-hidden=\"true\" class=\"ph ph-chart-line-up\" data-kid=\"1-3-1-2-5-1\" data-name=\"line chart icon\">\n                    </i>\n                    Analytics\n                </a>\n            </nav>\n            <nav aria-label=\"Account\" class=\"navGroup\" data-kid=\"1-3-1-3\" data-name=\"account navigation group\">\n                <div class=\"navLabel\" data-kid=\"1-3-1-3-1\" data-name=\"account section label\">\n                    Account\n                </div>\n                <a class=\"navlink\" data-kid=\"1-3-1-3-2\" data-name=\"profile navigation link\" href=\"/dealer/profile\">\n                    <i aria-hidden=\"true\" class=\"ph ph-identification-card\" data-kid=\"1-3-1-3-2-1\" data-name=\"identification card icon\">\n                    </i>\n                    Profile\n                </a>\n                <a class=\"navlink\" data-kid=\"1-3-1-3-3\" data-name=\"verification navigation link\" href=\"/verification\">\n                    <i aria-hidden=\"true\" class=\"ph ph-seal-check\" data-kid=\"1-3-1-3-3-1\" data-name=\"seal check icon\">\n                    </i>\n                    Verification\n                </a>\n            </nav>\n            <div class=\"sideBottom\" data-kid=\"1-3-1-4\" data-name=\"sidenav bottom actions\">\n                <a data-kid=\"1-3-1-4-1\" data-name=\"support navigation link\" href=\"/support\">\n                    <i aria-hidden=\"true\" class=\"ph ph-chat-circle-dots\" data-kid=\"1-3-1-4-1-1\" data-name=\"chat circle dots icon\">\n                    </i>\n                    Support\n                </a>\n            </div>\n        </aside>\n        <main class=\"main\" data-kid=\"1-3-2\" data-name=\"main content region\">\n            <div class=\"breadcrumb\" data-kid=\"1-3-2-1\" data-name=\"breadcrumb navigation\">\n                Dealer workspace\n                <span aria-hidden=\"true\" data-kid=\"1-3-2-1-1\" data-name=\"breadcrumb separator icon\">\n                    /\n                </span>\n                <strong data-kid=\"1-3-2-1-2\" data-name=\"current page breadcrumb label\">\n                    Overview\n                </strong>\n            </div>\n            <section aria-labelledby=\"page-title\" class=\"headrow\" data-kid=\"1-3-2-2\" data-name=\"page header row\">\n                <div data-kid=\"1-3-2-2-1\" data-name=\"page header text block\">\n                    <h1 class=\"title\" data-kid=\"1-3-2-2-1-1\" data-name=\"page headline\" id=\"page-title\">\n                        Your dealer workspace\n                    </h1>\n                    <p class=\"intro\" data-kid=\"1-3-2-2-1-2\" data-name=\"page intro text\">\n                        Manage your vehicle inventory and follow performance from one place.\n                    </p>\n                </div>\n                <a class=\"primaryButton\" data-kid=\"1-3-2-2-2\" data-name=\"primary add vehicle call-to-action\" href=\"/create-listing\">\n                    <i aria-hidden=\"true\" class=\"ph ph-plus\" data-kid=\"1-3-2-2-2-1\" data-name=\"plus icon\">\n                    </i>\n                    Add Vehicle\n                </a>\n            </section>\n            <div class=\"columns\" data-kid=\"1-3-2-3\" data-name=\"two-column main content grid\">\n                <section aria-labelledby=\"inventory-heading\" class=\"inventory\" data-kid=\"1-3-2-3-1\" data-name=\"inventory section\">\n                    <div class=\"sectionHead\" data-kid=\"1-3-2-3-1-1\" data-name=\"inventory section header\">\n                        <h2 data-kid=\"1-3-2-3-1-1-1\" data-name=\"inventory section title\" id=\"inventory-heading\">\n                            Inventory\n                        </h2>\n                        <span class=\"scope\" data-kid=\"1-3-2-3-1-1-2\" data-name=\"inventory scope label\">\n                            Your listed vehicles\n                        </span>\n                    </div>\n                    <div aria-label=\"Inventory status filter\" class=\"filterline\" data-kid=\"1-3-2-3-1-2\" data-name=\"inventory status filter bar\" role=\"group\">\n                        <span aria-current=\"true\" class=\"filter selected\" data-kid=\"1-3-2-3-1-2-1\" data-name=\"all vehicles filter tab\">\n                            All vehicles\n                        </span>\n                        <span class=\"filter\" data-kid=\"1-3-2-3-1-2-2\" data-name=\"active vehicles filter tab\">\n                            Active\n                        </span>\n                        <span class=\"filter\" data-kid=\"1-3-2-3-1-2-3\" data-name=\"pending vehicles filter tab\">\n                            Pending\n                        </span>\n                    </div>\n                    <div class=\"empty\" data-kid=\"1-3-2-3-1-3\" data-name=\"inventory empty state card\">\n                        <span aria-hidden=\"true\" class=\"emptyIcon\" data-kid=\"1-3-2-3-1-3-1\" data-name=\"empty state icon badge\">\n                            <i class=\"ph ph-car-profile\" data-kid=\"1-3-2-3-1-3-1-1\" data-name=\"car profile icon\">\n                            </i>\n                        </span>\n                        <h3 data-kid=\"1-3-2-3-1-3-2\" data-name=\"empty state headline\">\n                            No vehicles listed yet\n                        </h3>\n                        <p data-kid=\"1-3-2-3-1-3-3\" data-name=\"empty state description text\">\n                            Add your first vehicle to start building your dealer inventory. Your listings and their current status will appear here.\n                        </p>\n                        <a class=\"textAction\" data-kid=\"1-3-2-3-1-3-4\" data-name=\"add first vehicle text action\" href=\"/create-listing\">\n                            Add your first vehicle\n                        </a>\n                    </div>\n                </section>\n                <aside aria-labelledby=\"performance-heading\" class=\"performance\" data-kid=\"1-3-2-3-2\" data-name=\"performance sidebar panel\">\n                    <div class=\"performanceHead\" data-kid=\"1-3-2-3-2-1\" data-name=\"performance section header\">\n                        <h2 data-kid=\"1-3-2-3-2-1-1\" data-name=\"performance section title\" id=\"performance-heading\">\n                            Performance\n                        </h2>\n                        <a class=\"plainLink\" data-kid=\"1-3-2-3-2-1-2\" data-name=\"view analytics link\" href=\"/dealer/analytics\">\n                            View analytics\n                            <span aria-hidden=\"true\" data-kid=\"1-3-2-3-2-1-2-1\" data-name=\"arrow icon\">\n                                →\n                            </span>\n                        </a>\n                    </div>\n                    <ul class=\"measureList\" data-kid=\"1-3-2-3-2-2\" data-name=\"performance metrics list\">\n                        <li data-kid=\"1-3-2-3-2-2-1\" data-name=\"vehicle views metric row\">\n                            <span data-kid=\"1-3-2-3-2-2-1-1\" data-name=\"metric label\">\n                                Vehicle views\n                            </span>\n                            <span data-kid=\"1-3-2-3-2-2-1-2\" data-name=\"metric value\">\n                                In Analytics\n                            </span>\n                        </li>\n                        <li data-kid=\"1-3-2-3-2-2-2\" data-name=\"contacts metric row\">\n                            <span data-kid=\"1-3-2-3-2-2-2-1\" data-name=\"metric label\">\n                                Contacts\n                            </span>\n                            <span data-kid=\"1-3-2-3-2-2-2-2\" data-name=\"metric value\">\n                                In Analytics\n                            </span>\n                        </li>\n                        <li data-kid=\"1-3-2-3-2-2-3\" data-name=\"favorites metric row\">\n                            <span data-kid=\"1-3-2-3-2-2-3-1\" data-name=\"metric label\">\n                                Favorites\n                            </span>\n                            <span data-kid=\"1-3-2-3-2-2-3-2\" data-name=\"metric value\">\n                                In Analytics\n                            </span>\n                        </li>\n                        <li data-kid=\"1-3-2-3-2-2-4\" data-name=\"conversion rate metric row\">\n                            <span data-kid=\"1-3-2-3-2-2-4-1\" data-name=\"metric label\">\n                                Conversion rate\n                            </span>\n                            <span data-kid=\"1-3-2-3-2-2-4-2\" data-name=\"metric value\">\n                                In Analytics\n                            </span>\n                        </li>\n                    </ul>\n                    <p class=\"performanceNote\" data-kid=\"1-3-2-3-2-3\" data-name=\"performance explanatory note\">\n                        Track views, contacts, favorites, and conversion in your dealer analytics.\n                    </p>\n                </aside>\n            </div>\n        </main>\n    </div>\n    <section aria-label=\"Color palette reference\" class=\"tokenReference\" data-kid=\"1-4\" data-name=\"color token reference section\">\n        <h2 class=\"tokenTitle\" data-kid=\"1-4-1\" data-name=\"color token reference title\">\n            Vehicle ledger · color tokens\n        </h2>\n        <div class=\"tokens\" data-kid=\"1-4-2\" data-name=\"color token grid\">\n            <div class=\"token\" data-kid=\"1-4-2-1\" data-name=\"nav color token item\">\n                <span class=\"swatch\" data-kid=\"1-4-2-1-1\" data-name=\"nav color swatch\" style=\"background:#092F2B\">\n                </span>\n                <b data-kid=\"1-4-2-1-2\" data-name=\"nav token name\">\n                    Nav\n                </b>\n                <code data-kid=\"1-4-2-1-3\" data-name=\"nav token hex code\">\n                    #092F2B\n                </code>\n            </div>\n            <div class=\"token\" data-kid=\"1-4-2-2\" data-name=\"page color token item\">\n                <span class=\"swatch\" data-kid=\"1-4-2-2-1\" data-name=\"page color swatch\" style=\"background:#EFF4F1\">\n                </span>\n                <b data-kid=\"1-4-2-2-2\" data-name=\"page token name\">\n                    Page\n                </b>\n                <code data-kid=\"1-4-2-2-3\" data-name=\"page token hex code\">\n                    #EFF4F1\n                </code>\n            </div>\n            <div class=\"token\" data-kid=\"1-4-2-3\" data-name=\"surface color token item\">\n                <span class=\"swatch\" data-kid=\"1-4-2-3-1\" data-name=\"surface color swatch\" style=\"background:#FFFFFF\">\n                </span>\n                <b data-kid=\"1-4-2-3-2\" data-name=\"surface token name\">\n                    Surface\n                </b>\n                <code data-kid=\"1-4-2-3-3\" data-name=\"surface token hex code\">\n                    #FFFFFF\n                </code>\n            </div>\n            <div class=\"token\" data-kid=\"1-4-2-4\" data-name=\"inset color token item\">\n                <span class=\"swatch\" data-kid=\"1-4-2-4-1\" data-name=\"inset color swatch\" style=\"background:#E3EDE8\">\n                </span>\n                <b data-kid=\"1-4-2-4-2\" data-name=\"inset token name\">\n                    Inset\n                </b>\n                <code data-kid=\"1-4-2-4-3\" data-name=\"inset token hex code\">\n                    #E3EDE8\n                </code>\n            </div>\n            <div class=\"token\" data-kid=\"1-4-2-5\" data-name=\"ink color token item\">\n                <span class=\"swatch\" data-kid=\"1-4-2-5-1\" data-name=\"ink color swatch\" style=\"background:#142C27\">\n                </span>\n                <b data-kid=\"1-4-2-5-2\" data-name=\"ink token name\">\n                    Ink\n                </b>\n                <code data-kid=\"1-4-2-5-3\" data-name=\"ink token hex code\">\n                    #142C27\n                </code>\n            </div>\n            <div class=\"token\" data-kid=\"1-4-2-6\" data-name=\"muted color token item\">\n                <span class=\"swatch\" data-kid=\"1-4-2-6-1\" data-name=\"muted color swatch\" style=\"background:#50655F\">\n                </span>\n                <b data-kid=\"1-4-2-6-2\" data-name=\"muted token name\">\n                    Muted\n                </b>\n                <code data-kid=\"1-4-2-6-3\" data-name=\"muted token hex code\">\n                    #50655F\n                </code>\n            </div>\n            <div class=\"token\" data-kid=\"1-4-2-7\" data-name=\"border color token item\">\n                <span class=\"swatch\" data-kid=\"1-4-2-7-1\" data-name=\"border color swatch\" style=\"background:#CBDAD2\">\n                </span>\n                <b data-kid=\"1-4-2-7-2\" data-name=\"border token name\">\n                    Border\n                </b>\n                <code data-kid=\"1-4-2-7-3\" data-name=\"border token hex code\">\n                    #CBDAD2\n                </code>\n            </div>\n            <div class=\"token\" data-kid=\"1-4-2-8\" data-name=\"primary color token item\">\n                <span class=\"swatch\" data-kid=\"1-4-2-8-1\" data-name=\"primary color swatch\" style=\"background:#146D55\">\n                </span>\n                <b data-kid=\"1-4-2-8-2\" data-name=\"primary token name\">\n                    Primary\n                </b>\n                <code data-kid=\"1-4-2-8-3\" data-name=\"primary token hex code\">\n                    #146D55\n                </code>\n            </div>\n            <div class=\"token\" data-kid=\"1-4-2-9\" data-name=\"gold color token item\">\n                <span class=\"swatch\" data-kid=\"1-4-2-9-1\" data-name=\"gold color swatch\" style=\"background:#D0A43A\">\n                </span>\n                <b data-kid=\"1-4-2-9-2\" data-name=\"gold token name\">\n                    Gold\n                </b>\n                <code data-kid=\"1-4-2-9-3\" data-name=\"gold token hex code\">\n                    #D0A43A\n                </code>\n            </div>\n            <div class=\"token\" data-kid=\"1-4-2-10\" data-name=\"success color token item\">\n                <span class=\"swatch\" data-kid=\"1-4-2-10-1\" data-name=\"success color swatch\" style=\"background:#257653\">\n                </span>\n                <b data-kid=\"1-4-2-10-2\" data-name=\"success token name\">\n                    Success\n                </b>\n                <code data-kid=\"1-4-2-10-3\" data-name=\"success token hex code\">\n                    #257653\n                </code>\n            </div>\n            <div class=\"token\" data-kid=\"1-4-2-11\" data-name=\"warning color token item\">\n                <span class=\"swatch\" data-kid=\"1-4-2-11-1\" data-name=\"warning color swatch\" style=\"background:#966919\">\n                </span>\n                <b data-kid=\"1-4-2-11-2\" data-name=\"warning token name\">\n                    Warning\n                </b>\n                <code data-kid=\"1-4-2-11-3\" data-name=\"warning token hex code\">\n                    #966919\n                </code>\n            </div>\n            <div class=\"token\" data-kid=\"1-4-2-12\" data-name=\"error color token item\">\n                <span class=\"swatch\" data-kid=\"1-4-2-12-1\" data-name=\"error color swatch\" style=\"background:#B0443C\">\n                </span>\n                <b data-kid=\"1-4-2-12-2\" data-name=\"error token name\">\n                    Error\n                </b>\n                <code data-kid=\"1-4-2-12-3\" data-name=\"error token hex code\">\n                    #B0443C\n                </code>\n            </div>\n            <div class=\"token\" data-kid=\"1-4-2-13\" data-name=\"info color token item\">\n                <span class=\"swatch\" data-kid=\"1-4-2-13-1\" data-name=\"info color swatch\" style=\"background:#39738B\">\n                </span>\n                <b data-kid=\"1-4-2-13-2\" data-name=\"info token name\">\n                    Info\n                </b>\n                <code data-kid=\"1-4-2-13-3\" data-name=\"info token hex code\">\n                    #39738B\n                </code>\n            </div>\n            <div class=\"token\" data-kid=\"1-4-2-14\" data-name=\"neutral color token item\">\n                <span class=\"swatch\" data-kid=\"1-4-2-14-1\" data-name=\"neutral color swatch\" style=\"background:#63726D\">\n                </span>\n                <b data-kid=\"1-4-2-14-2\" data-name=\"neutral token name\">\n                    Neutral\n                </b>\n                <code data-kid=\"1-4-2-14-3\" data-name=\"neutral token hex code\">\n                    #63726D\n                </code>\n            </div>\n            <div class=\"token\" data-kid=\"1-4-2-15\" data-name=\"focus color token item\">\n                <span class=\"swatch\" data-kid=\"1-4-2-15-1\" data-name=\"focus color swatch\" style=\"background:#E5B743\">\n                </span>\n                <b data-kid=\"1-4-2-15-2\" data-name=\"focus token name\">\n                    Focus\n                </b>\n                <code data-kid=\"1-4-2-15-3\" data-name=\"focus token hex code\">\n                    #E5B743\n                </code>\n            </div>\n        </div>\n    </section>\n</div>\n",
      "comments": [],
      "created": "2026-10-16T12:28:17.028162+00:00",
