nk with badge\" href=\"#\"><i class=\"icon-flag\" data-kid=\"1-1-2-2-4-1\" data-name=\"flag icon\"></i><span class=\"lbl\" data-kid=\"1-1-2-2-4-2\" data-name=\"reports navigation link label\">Reports</span><span class=\"nav-count tnum\" data-kid=\"1-1-2-2-4-3\" data-name=\"reports count badge\">4</span></a>\n</div>\n<div class=\"nav-group\" data-kid=\"1-1-2-3\" data-name=\"transactions navigation group\">\n<div class=\"nav-label\" data-kid=\"1-1-2-3-1\" data-name=\"transactions navigation group label\">Transactions</div>\n<a class=\"nav-item\" data-kid=\"1-1-2-3-2\" data-name=\"bookings navigation link with badge\" href=\"#\"><i class=\"icon-calendar-days\" data-kid=\"1-1-2-3-2-1\" data-name=\"calendar days icon\"></i><span class=\"lbl\" data-kid=\"1-1-2-3-2-2\" data-name=\"bookings navigation link label\">Bookings</span><span class=\"nav-count tnum\" data-kid=\"1-1-2-3-2-3\" data-name=\"bookings count badge\">12</span></a>\n<a class=\"nav-item\" data-kid=\"1-1-2-3-3\" data-name=\"offers navigation link with badge\" href=\"#\"><i class=\"icon-handshake\" data-kid=\"1-1-2-3-3-1\" data-name=\"handshake icon\"></i><span class=\"lbl\" data-kid=\"1-1-2-3-3-2\" data-name=\"offers navigation link label\">Offers</span><span class=\"nav-count tnum\" data-kid=\"1-1-2-3-3-3\" data-name=\"offers count badge\">9</span></a>\n<a class=\"nav-item\" data-kid=\"1-1-2-3-4\" data-name=\"payments navigation link\" href=\"#\"><i class=\"icon-credit-card\" data-kid=\"1-1-2-3-4-1\" data-name=\"credit card icon\"></i><span class=\"lbl\" data-kid=\"1-1-2-3-4-2\" data-name=\"payments navigation link label\">Payments</span></a>\n<a class=\"nav-item\" data-kid=\"1-1-2-3-5\" data-name=\"disputes navigation link\" href=\"#\"><i class=\"icon-scale\" data-kid=\"1-1-2-3-5-1\" data-name=\"scale icon\"></i><span class=\"lbl\" data-kid=\"1-1-2-3-5-2\" data-name=\"disputes navigation link label\">Disputes</span></a>\n</div>\n<div class=\"nav-group\" data-kid=\"1-1-2-4\" data-name=\"administration navigation group\">\n<div class=\"nav-label\" data-kid=\"1-1-2-4-1\" data-name=\"administration navigation group label\">Administration</div>\n<a class=\"nav-item\" data-kid=\"1-1-2-4-2\" data-name=\"audit logs navigation link\" href=\"#\"><i class=\"icon-history\" data-kid=\"1-1-2-4-2-1\" data-name=\"history icon\"></i><span class=\"lbl\" data-kid=\"1-1-2-4-2-2\" data-name=\"audit logs navigation link label\">Audit logs</span></a>\n</div>\n<div class=\"nav-priv\" data-kid=\"1-1-2-5\" data-name=\"super administrator navigation group\">\n<div class=\"nav-label\" data-kid=\"1-1-2-5-1\" data-name=\"super administrator group label with shield icon\"><i class=\"icon-shield\" data-kid=\"1-1-2-5-1-1\" data-name=\"shield icon\"></i>Super administrator</div>\n<a class=\"nav-item\" data-kid=\"1-1-2-5-2\" data-name=\"accounts navigation link\" href=\"#\"><i class=\"icon-users\" data-kid=\"1-1-2-5-2-1\" data-name=\"users icon\"></i><span class=\"lbl\" data-kid=\"1-1-2-5-2-2\" data-name=\"accounts navigation link label\">Accounts</span></a>\n<a class=\"nav-item\" data-kid=\"1-1-2-5-3\" data-name=\"administrators navigation link\" href=\"#\"><i class=\"icon-lock\" data-kid=\"1-1-2-5-3-1\" data-name=\"lock icon\"></i><span class=\"lbl\" data-kid=\"1-1-2-5-3-2\" data-name=\"administrators navigation link label\">Administrators</span></a>\n</div>\n</nav>\n<div class=\"sidebar-foot\" data-kid=\"1-1-3\" data-name=\"sidebar user footer\">\n<div class=\"me\" data-kid=\"1-1-3-1\" data-name=\"current user profile row\">\n<span class=\"avatar\" data-kid=\"1-1-3-1-1\" data-name=\"current user avatar initials\">TM</span>\n<div data-kid=\"1-1-3-1-2\" data-name=\"current user name and role wrapper\">\n<div class=\"me-name\" data-kid=\"1-1-3-1-2-1\" data-name=\"current user name text\">Tarisai Mudimu</div>\n<div class=\"me-role\" data-kid=\"1-1-3-1-2-2\" data-name=\"current user role text\">Super administrator</div>\n</div>\n<i class=\"icon-log-out logout\" data-kid=\"1-1-3-1-3\" data-name=\"logout icon button\"></i>\n</div>\n</div>\n</aside>\n<div class=\"main\" data-kid=\"1-2\" data-name=\"main content column\">\n<header class=\"topbar\" data-kid=\"1-2-1\" data-name=\"topbar header\">\n<div class=\"crumbs\" data-kid=\"1-2-1-1\" data-name=\"breadcrumb navigation\"><span data-kid=\"1-2-1-1-1\" data-name=\"breadcrumb parent segment\">Marketplace</span><span class=\"sep\" data-kid=\"1-2-1-1-2\" data-name=\"breadcrumb separator\">/</span><strong data-kid=\"1-2-1-1-3\" data-name=\"breadcrumb current page segment\">Verification</strong></div>\n<div class=\"topbar-right\" data-kid=\"1-2-1-2\" data-name=\"topbar right actions container\">\n<span class=\"role-chip\" data-kid=\"1-2-1-2-1\" data-name=\"role indicator chip\"><i class=\"icon-shield-check\" data-kid=\"1-2-1-2-1-1\" data-name=\"shield check icon\"></i>Super administrator</span>\n<button class=\"profile\" data-kid=\"1-2-1-2-2\" data-name=\"profile dropdown button\"><span class=\"avatar sm\" data-kid=\"1-2-1-2-2-1\" data-name=\"profile avatar initials\">TM</span>Tarisai Mudimu<i class=\"icon-chevron-down\" data-kid=\"1-2-1-2-2-2\" data-name=\"profile chevron down icon\"></i></button>\n</div>\n</header>\n<div class=\"page\" data-kid=\"1-2-2\" data-name=\"page content area\">\n<div class=\"page-head\" data-kid=\"1-2-2-1\" data-name=\"page header row\">\n<h1 data-kid=\"1-2-2-1-1\" data-name=\"page title heading\">Verification</h1>\n<span class=\"meta tnum\" data-kid=\"1-2-2-1-2\" data-name=\"page pending count meta\">9 requests pending</span>\n</div>\n<section aria-label=\"Filters\" class=\"panel toolbar\" data-kid=\"1-2-2-2\" data-name=\"filters toolbar panel\">\n<div class=\"field grow\" data-kid=\"1-2-2-2-1\" data-name=\"search filter field\">\n<label data-kid=\"1-2-2-2-1-1\" data-name=\"search field label\" for=\"ver-search\">Search</label>\n<div class=\"input-wrap\" data-kid=\"1-2-2-2-1-2\" data-name=\"search input wrapper\">\n<i class=\"icon-search\" data-kid=\"1-2-2-2-1-2-1\" data-name=\"search icon\"></i>\n<input data-kid=\"1-2-2-2-1-2-2\" data-name=\"search input field\" id=\"ver-search\" placeholder=\"Name, email or request ID\" type=\"text\"/>\n</div>\n</div>\n<div class=\"field\" data-kid=\"1-2-2-2-2\" data-name=\"request type filter field\">\n<label data-kid=\"1-2-2-2-2-1\" data-name=\"request type field label\" for=\"ver-type\">Request type</label>\n<div class=\"select-wrap\" data-kid=\"1-2-2-2-2-2\" data-name=\"request type select wrapper\">\n<select data-kid=\"1-2-2-2-2-2-1\" data-name=\"request type select dropdown\" id=\"ver-type\">\n<option data-kid=\"1-2-2-2-2-2-1-1\" data-name=\"all types option\">All types</option>\n<option data-kid=\"1-2-2-2-2-2-1-2\" data-name=\"identity option\">Identity</option>\n<option data-kid=\"1-2-2-2-2-2-1-3\" data-name=\"private seller option\">Private seller</option>\n<option data-kid=\"1-2-2-2-2-2-1-4\" data-name=\"dealer option\">Dealer</option>\n</select>\n<i class=\"icon-chevron-down\" data-kid=\"1-2-2-2-2-2-2\" data-name=\"select chevron down icon\"></i>\n</div>\n</div>\n<div class=\"filter-tail\" data-kid=\"1-2-2-2-3\" data-name=\"filter results count tail\"><span class=\"tnum\" data-kid=\"1-2-2-2-3-1\" data-name=\"results count text\">9 results</span></div>\n</section>\n<div class=\"workspace\" data-kid=\"1-2-2-3\" data-name=\"workspace grid with list and detail\">\n<section aria-label=\"Verification requests\" class=\"panel qcol\" data-kid=\"1-2-2-3-1\" data-name=\"pending requests list panel\">\n<div class=\"qhead\" data-kid=\"1-2-2-3-1-1\" data-name=\"requests list header\">\n<h2 data-kid=\"1-2-2-3-1-1-1\" data-name=\"requests list title\">Pending requests</h2>\n<span class=\"cnt tnum\" data-kid=\"1-2-2-3-1-1-2\" data-name=\"requests list count\">9 requests</span>\n</div>\n<div aria-current=\"true\" class=\"qrow selected\" data-kid=\"1-2-2-3-1-2\" data-name=\"selected request row\">\n<div class=\"qi\" data-kid=\"1-2-2-3-1-2-1\" data-name=\"request row name and email wrapper\">\n<div class=\"qt\" data-kid=\"1-2-2-3-1-2-1-1\" data-name=\"request applicant name\">Rudo Chikafu</div>\n<div class=\"qm\" data-kid=\"1-2-2-3-1-2-1-2\" data-name=\"request applicant email\">rudo.chikafu@yahoo.com</div>\n</div>\n<span class=\"qtype\" data-kid=\"1-2-2-3-1-2-2\" data-name=\"request type label\">Private seller</span>\n<span class=\"qmark\" data-kid=\"1-2-2-3-1-2-3\" data-name=\"selected state checkmark badge\"><i class=\"icon-check\" data-kid=\"1-2-2-3-1-2-3-1\" data-name=\"checkmark icon\"></i></span>\n</div>\n<div class=\"qrow\" data-kid=\"1-2-2-3-1-3\" data-name=\"request list row\">\n<div class=\"qi\" data-kid=\"1-2-2-3-1-3-1\" data-name=\"request row name and email wrapper\">\n<div class=\"qt\" data-kid=\"1-2-2-3-1-3-1-1\" data-name=\"request applicant name\">Zim Auto Traders</div>\n<div class=\"qm\" data-kid=\"1-2-2-3-1-3-1-2\" data-name=\"request applicant email\">sales@zimautotraders.co.zw</div>\n</div>\n<span class=\"qtype\" data-kid=\"1-2-2-3-1-3-2\" data-name=\"request type label\">Dealer</span>\n</div>\n<div class=\"qrow\" data-kid=\"1-2-2-3-1-4\" data-name=\"request list row\">\n<div class=\"qi\" data-kid=\"1-2-2-3-1-4-1\" data-name=\"request row name and email wrapper\">\n<div class=\"qt\" data-kid=\"1-2-2-3-1-4-1-1\" data-name=\"request applicant name\">Nyasha Dube</div>\n<div class=\"qm\" data-kid=\"1-2-2-3-1-4-1-2\" data-name=\"request applicant email\">nyasha.dube@gmail.com</div>\n</div>\n<span class=\"qtype\" data-kid=\"1-2-2-3-1-4-2\" data-name=\"request type label\">Identity</span>\n</div>\n<div class=\"qrow\" data-kid=\"1-2-2-3-1-5\" data-name=\"request list row\">\n<div class=\"qi\" data-kid=\"1-2-2-3-1-5-1\" data-name=\"request row name and email wrapper\">\n<div class=\"qt\" data-kid=\"1-2-2-3-1-5-1-1\" data-name=\"request applicant name\">Mbare Motors</div>\n<div class=\"qm\" data-kid=\"1-2-2-3-1-5-1-2\" data-name=\"request applicant email\">office@mbaremotors.co.zw</div>\n</div>\n<span class=\"qtype\" data-kid=\"1-2-2-3-1-5-2\" data-name=\"request type label\">Dealer</span>\n</div>\n<div class=\"qrow\" data-kid=\"1-2-2-3-1-6\" data-name=\"request list row\">\n<div class=\"qi\" data-kid=\"1-2-2-3-1-6-1\" data-name=\"request row name and email wrapper\">\n<div class=\"qt\" data-kid=\"1-2-2-3-1-6-1-1\" data-name=\"request applicant name\">Kudzai Chuma</div>\n<div class=\"qm\" data-kid=\"1-2-2-3-1-6-1-2\" data-name=\"request applicant email\">kudzai.chuma@gmail.com</div>\n</div>\n<span class=\"qtype\" data-kid=\"1-2-2-3-1-6-2\" data-name=\"request type label\">Identity</span>\n</div>\n<div class=\"qrow\" data-kid=\"1-2-2-3-1-7\" data-name=\"request list row\">\n<div class=\"qi\" data-kid=\"1-2-2-3-1-7-1\" data-name=\"request row name and email wrapper\">\n<div class=\"qt\" data-kid=\"1-2-2-3-1-7-1-1\" data-name=\"request applicant name\">Farai Mutasa</div>\n<div class=\"qm\" data-kid=\"1-2-2-3-1-7-1-2\" data-name=\"request applicant email\">farai.mutasa@outlook.com</div>\n</div>\n<span class=\"qtype\" data-kid=\"1-2-2-3-1-7-2\" data-name=\"request type label\">Private seller</span>\n</div>\n<div class=\"qrow\" data-kid=\"1-2-2-3-1-8\" data-name=\"request list row\">\n<div class=\"qi\" data-kid=\"1-2-2-3-1-8-1\" data-name=\"request row name and email wrapper\">\n<div class=\"qt\" data-kid=\"1-2-2-3-1-8-1-1\" data-name=\"request applicant name\">Tafadzwa Marufu</div>\n<div class=\"qm\" data-kid=\"1-2-2-3-1-8-1-2\" data-name=\"request applicant email\">tafadzwa.marufu@gmail.com</div>\n</div>\n<span class=\"qtype\" data-kid=\"1-2-2-3-1-8-2\" data-name=\"request type label\">Identity</span>\n</div>\n<div class=\"qnav\" data-kid=\"1-2-2-3-1-9\" data-name=\"list pagination bar\">\n<span class=\"tnum\" data-kid=\"1-2-2-3-1-9-1\" data-name=\"pagination range text\">1–7 of 9</span>\n<span class=\"nav-btns\" data-kid=\"1-2-2-3-1-9-2\" data-name=\"pagination button container\">\n<button aria-label=\"Previous page\" class=\"iconbtn\" data-kid=\"1-2-2-3-1-9-2-1\" data-name=\"previous page button (disabled)\" disabled=\"\"><i class=\"icon-chevron-left\" data-kid=\"1-2-2-3-1-9-2-1-1\" data-name=\"chevron left icon\"></i></button>\n<button aria-label=\"Next page\" class=\"iconbtn\" data-kid=\"1-2-2-3-1-9-2-2\" data-name=\"next page button\"><i class=\"icon-chevron-right\" data-kid=\"1-2-2-3-1-9-2-2-1\" data-name=\"chevron right icon\"></i></button>\n</span>\n</div>\n</section>\n<section aria-label=\"Selected request\" class=\"panel detail\" data-kid=\"1-2-2-3-2\" data-name=\"selected request detail panel\">\n<div class=\"dhead\" data-kid=\"1-2-2-3-2-1\" data-name=\"detail header row\">\n<span class=\"avatar lg\" data-kid=\"1-2-2-3-2-1-1\" data-name=\"requester avatar initials\">RC</span>\n<div class=\"dh-main\" data-kid=\"1-2-2-3-2-1-2\" data-name=\"requester main info wrapper\">\n<div class=\"dh-name\" data-kid=\"1-2-2-3-2-1-2-1\" data-name=\"requester name and status row\">\n<h2 data-kid=\"1-2-2-3-2-1-2-1-1\" data-name=\"requester name heading\">Rudo Chikafu</h2>\n<span class=\"pill pill-neutral\" data-kid=\"1-2-2-3-2-1-2-1-2\" data-name=\"requester type pill badge\">Private seller</span>\n<span class=\"pill pill-pending\" data-kid=\"1-2-2-3-2-1-2-1-3\" data-name=\"request status pill badge\"><span class=\"dot\" data-kid=\"1-2-2-3-2-1-2-1-3-1\" data-name=\"status indicator dot\"></span>Pending</span>\n</div>\n<div class=\"dh-mail\" data-kid=\"1-2-2-3-2-1-2-2\" data-name=\"requester email text\">rudo.chikafu@yahoo.com</div>\n</div>\n<span class=\"mono\" data-kid=\"1-2-2-3-2-1-3\" data-name=\"compact request ID label\">Request 5c9b18e4</span>\n</div>\n<div class=\"dbody\" data-kid=\"1-2-2-3-2-2\" data-name=\"detail body scroll area\">\n<div data-kid=\"1-2-2-3-2-2-1\" data-name=\"request metadata section\">\n<div class=\"group-h\" data-kid=\"1-2-2-3-2-2-1-1\" data-name=\"request section heading\">Request</div>\n<div class=\"grid3\" data-kid=\"1-2-2-3-2-2-1-2\" data-name=\"request metadata grid\">\n<div class=\"eg\" data-kid=\"1-2-2-3-2-2-1-2-1\" data-name=\"request ID field\"><div class=\"k\" data-kid=\"1-2-2-3-2-2-1-2-1-1\" data-name=\"request ID field label\">Request ID</div><div class=\"v mono\" data-kid=\"1-2-2-3-2-2-1-2-1-2\" data-name=\"full request ID value\">5c9b18e4-77a2-4d0b-9f61-31c8e0a4b5d7</div></div>\n<div class=\"eg\" data-kid=\"1-2-2-3-2-2-1-2-2\" data-name=\"request type field\"><div class=\"k\" data-kid=\"1-2-2-3-2-2-1-2-2-1\" data-name=\"request type field label\">Type</div><div class=\"v\" data-kid=\"1-2-2-3-2-2-1-2-2-2\" data-name=\"request type value\">Private seller</div></div>\n<div class=\"eg\" data-kid=\"1-2-2-3-2-2-1-2-3\" data-name=\"submission date field\"><div class=\"k\" data-kid=\"1-2-2-3-2-2-1-2-3-1\" data-name=\"submitted field label\">Submitted</div><div class=\"v\" data-kid=\"1-2-2-3-2-2-1-2-3-2\" data-name=\"submission date value\">21 Nov 2026, 14:26</div></div>\n</div>\n</div>\n<div data-kid=\"1-2-2-3-2-2-2\" data-name=\"applicant notes section\">\n<div class=\"group-h\" data-kid=\"1-2-2-3-2-2-2-1\" data-name=\"applicant notes section heading\">Applicant notes</div>\n<p class=\"notes\" data-kid=\"1-2-2-3-2-2-2-2\" data-name=\"applicant notes text\">Selling two vehicles from my personal stock. ID and proof of address uploaded.</p>\n</div>\n<div data-kid=\"1-2-2-3-2-2-3\" data-name=\"linked account section\">\n<div class=\"group-h\" data-kid=\"1-2-2-3-2-2-3-1\" data-name=\"linked account section heading\">Linked account</div>\n<div class=\"linked\" data-kid=\"1-2-2-3-2-2-3-2\" data-name=\"linked account card\">\n<span class=\"avatar\" data-kid=\"1-2-2-3-2-2-3-2-1\" data-name=\"linked account avatar\">RC</span>\n<div class=\"li\" data-kid=\"1-2-2-3-2-2-3-2-2\" data-name=\"linked account info wrapper\">\n<div class=\"ln\" data-kid=\"1-2-2-3-2-2-3-2-2-1\" data-name=\"linked account name\">Rudo Chikafu</div>\n<div class=\"lm\" data-kid=\"1-2-2-3-2-2-3-2-2-2\" data-name=\"linked account meta text\">Buyer account, 6f2a91c4-2d18-4b7e-9c31-8a5d7d3b</div>\n</div>\n<span class=\"pill pill-active\" data-kid=\"1-2-2-3-2-2-3-2-3\" data-name=\"account status pill badge\"><span class=\"dot\" data-kid=\"1-2-2-3-2-2-3-2-3-1\" data-name=\"status indicator dot\"></span>Active</span>\n<a class=\"link\" data-kid=\"1-2-2-3-2-2-3-2-4\" data-name=\"link to open account\" href=\"#\">Open account<i class=\"icon-arrow-right\" data-kid=\"1-2-2-3-2-2-3-2-4-1\" data-name=\"right arrow icon\"></i></a>\n</div>\n</div>\n<div data-kid=\"1-2-2-3-2-2-4\" data-name=\"documents section\">\n<div class=\"group-h\" data-kid=\"1-2-2-3-2-2-4-1\" data-name=\"documents section heading\">Documents submitted</div>\n<div class=\"doclist\" data-kid=\"1-2-2-3-2-2-4-2\" data-name=\"documents list container\">\n<div class=\"doc\" data-kid=\"1-2-2-3-2-2-4-2-1\" data-name=\"document row (ID)\">\n<i class=\"icon-file-text\" data-kid=\"1-2-2-3-2-2-4-2-1-1\" data-name=\"document file icon\"></i>\n<span class=\"dn\" data-kid=\"1-2-2-3-2-2-4-2-1-2\" data-name=\"document name text\">Government-issued ID</span>\n<span class=\"dm\" data-kid=\"1-2-2-3-2-2-4-2-1-3\" data-name=\"document meta text\">Attached to request</span>\n<a class=\"link\" data-kid=\"1-2-2-3-2-2-4-2-1-4\" data-name=\"document open link\" href=\"#\">Open<i class=\"icon-arrow-up-right\" data-kid=\"1-2-2-3-2-2-4-2-1-4-1\" data-name=\"external link icon\"></i></a>\n</div>\n<div class=\"doc\" data-kid=\"1-2-2-3-2-2-4-2-2\" data-name=\"document row (address)\">\n<i class=\"icon-file-text\" data-kid=\"1-2-2-3-2-2-4-2-2-1\" data-name=\"document file icon\"></i>\n<span class=\"dn\" data-kid=\"1-2-2-3-2-2-4-2-2-2\" data-name=\"document name text\">Proof of address</span>\n<span class=\"dm\" data-kid=\"1-2-2-3-2-2-4-2-2-3\" data-name=\"document meta text\">Attached to request</span>\n<a class=\"link\" data-kid=\"1-2-2-3-2-2-4-2-2-4\" data-name=\"document open link\" href=\"#\">Open<i class=\"icon-arrow-up-right\" data-kid=\"1-2-2-3-2-2-4-2-2-4-1\" data-name=\"external link icon\"></i></a>\n</div>\n</div>\n</div>\n<div class=\"decision-note\" data-kid=\"1-2-2-3-2-2-5\" data-name=\"decision info callout\">\n<i class=\"icon-info\" data-kid=\"1-2-2-3-2-2-5-1\" data-name=\"info icon\"></i>\n<div data-kid=\"1-2-2-3-2-2-5-2\" data-name=\"decision explanation text wrapper\">\n<div class=\"dt\" data-kid=\"1-2-2-3-2-2-5-2-1\" data-name=\"decision callout title\">What approval does</div>\n<div class=\"db\" data-kid=\"1-2-2-3-2-2-5-2-2\" data-name=\"decision callout description\">Adds seller capability to the linked account and records the decision in the audit trail.</div>\n</div>\n</div>\n</div>\n<div class=\"dfoot\" data-kid=\"1-2-2-3-2-3\" data-name=\"detail footer action bar\">\n<span class=\"mono\" data-kid=\"1-2-2-3-2-3-1\" data-name=\"footer request ID label\" style=\"color:#7B8A82\">Request 5c9b18e4</span>\n<div class=\"dactions\" data-kid=\"1-2-2-3-2-3-2\" data-name=\"decision actions button group\">\n<button class=\"btn btn-outline\" data-kid=\"1-2-2-3-2-3-2-1\" data-name=\"reject request outline button\">Reject request</button>\n<button class=\"btn btn-primary\" data-kid=\"1-2-2-3-2-3-2-2\" data-name=\"approve seller request primary button\"><i class=\"icon-check\" data-kid=\"1-2-2-3-2-3-2-2-1\" data-name=\"checkmark icon\"></i>Approve seller request</button>\n</div>\n</div>\n</section>\n</div>\n</div>\n</div>\n</div>",
