      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Red+Hat+Text:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n:root{--nav:#063F2F;--page:#F4F7F3;--surface:#FFFFFF;--inset:#EAF0E9;--ink:#17251E;--muted:#52665B;--border:#CEDBD0;--primary:#0B5D3B;--gold:#C9A227;--success:#24764C;--warning:#9A6814;--error:#AC3F35;--info:#356F8A;--neutral:#66716C;--focus:#E3B72F}\nbody{margin:0;background:var(--page);color:var(--ink);font-family:'Red Hat Text',sans-serif}\n.workspace{min-height:100vh;background:var(--page);color:var(--ink);font-family:'Red Hat Text',sans-serif}\na,button,input{font:inherit}a{color:inherit;text-decoration:none}button{cursor:pointer}.icon{display:inline-flex;width:20px;height:20px;align-items:center;justify-content:center;font-size:18px;line-height:1;color:currentColor;flex:none}.sidebar{position:fixed;inset:0 auto 0 0;width:264px;background:var(--nav);color:#fff;padding:24px 16px 18px;display:flex;flex-direction:column;z-index:30}.brand{display:flex;align-items:center;gap:12px;padding:2px 10px 24px}.brand-mark{width:43px;height:43px;display:grid;place-items:center;color:var(--nav);background:var(--gold);font-size:20px;font-weight:700;letter-spacing:-.06em;border-radius:8px;box-shadow:inset 0 -3px 0 #6d5010}.brand-name{font-weight:700;font-size:18px;letter-spacing:-.035em;line-height:1.1}.brand-note{margin-top:4px;font-size:13px;color:#d2dfd7}.workspace-tag{display:flex;align-items:center;gap:11px;margin:0 4px 25px;padding:12px 12px;border-top:1px solid #ffffff28;border-bottom:1px solid #ffffff28;color:#f4f7f3}.workspace-tag .icon{color:var(--gold)}.workspace-tag strong{font-size:14px;font-weight:600}.nav-groups{flex:1;overflow:auto;scrollbar-color:#8caa9a transparent;scrollbar-width:thin}.nav-group{margin:0 0 24px}.nav-label{margin:0 12px 9px;color:#d8e2dc;font-size:13px;font-weight:600}.nav-link{position:relative;display:flex;align-items:center;gap:12px;min-height:46px;margin:3px 0;padding:0 12px;border-radius:6px;color:#e5eee8;font-size:14px;font-weight:500;transition:background .16s,color .16s}.nav-link .icon{color:#becfc4}.nav-link:hover{background:#ffffff12;color:#fff}.nav-link.active{background:#fff;color:var(--nav);font-weight:700}.nav-link.active .icon{color:var(--primary)}.nav-link.active::after{content:'';position:absolute;right:11px;width:6px;height:6px;background:var(--gold);border-radius:50%}.sidebar-bottom{border-top:1px solid #ffffff2b;padding-top:12px}.sidebar-bottom .nav-link{min-height:44px}.signout{color:#f3cbc5}.signout .icon{color:#e9b4aa}.app-main{margin-left:264px;min-height:100vh;min-width:0}.topbar{height:68px;padding:0 44px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--border);background:var(--page)}.crumb{display:flex;align-items:center;gap:10px;font-size:14px;color:var(--muted)}.crumb strong{font-weight:600;color:var(--ink)}.crumb-sep{color:#97a99e}.top-actions{display:flex;align-items:center;gap:12px}.icon-button{height:44px;width:44px;display:grid;place-items:center;border:1px solid var(--border);border-radius:7px;background:var(--surface);color:var(--nav)}.account-button{height:44px;display:flex;align-items:center;gap:10px;padding:0 11px;border:1px solid var(--border);border-radius:7px;background:var(--surface);color:var(--ink);font-size:14px;font-weight:600}.account-mark{width:28px;height:28px;border-radius:50%;display:grid;place-items:center;background:#dfe8e1;color:var(--nav);font-size:12px;font-weight:700}.topbar .icon{width:18px;height:18px;font-size:17px}.content{width:min(100%,1230px);margin:0 auto;padding:34px 44px 56px}.page-intro{display:flex;justify-content:space-between;align-items:flex-end;gap:28px;margin:0 0 23px}.page-intro h1{margin:0;color:var(--ink);font:52px/.92 'Bebas Neue',sans-serif;letter-spacing:.015em}.page-intro p{margin:10px 0 0;color:var(--muted);font-size:15px;line-height:1.5}.list-vehicle{min-height:46px;display:inline-flex;align-items:center;gap:10px;padding:0 17px;border:1px solid var(--primary);border-radius:5px;background:var(--primary);color:#fff;font-weight:700;font-size:14px;white-space:nowrap;transition:background .16s}.list-vehicle:hover{background:var(--nav)}.list-vehicle .icon{width:17px;height:17px;font-size:17px}.discover-tools{display:flex;align-items:flex-end;gap:22px;padding:19px 20px;background:var(--inset);border:1px solid var(--border);border-radius:8px}.mode-control{flex:none}.field-label{display:block;margin:0 0 8px;color:var(--ink);font-size:13px;font-weight:700}.segment{height:46px;display:inline-flex;align-items:center;padding:3px;border:1px solid #bdcdc1;border-radius:5px;background:#dfe8df}.segment button{height:38px;min-width:93px;padding:0 16px;border:0;border-radius:3px;background:transparent;color:var(--muted);font-size:14px;font-weight:600}.segment button[aria-pressed=true]{background:var(--primary);color:#fff;box-shadow:0 1px 2px #173b2b25}.search-field{flex:1;min-width:220px}.search-row{display:flex;align-items:center;min-height:46px;background:var(--surface);border:1px solid #b9c9bd;border-bottom:2px solid #9baea1;border-radius:5px;overflow:hidden}.search-row .icon{width:44px;color:var(--muted);font-size:17px}.search-row input{min-width:0;flex:1;height:44px;border:0;outline:0;background:transparent;color:var(--ink);font-size:14px}.search-row input::placeholder{color:#697a70;opacity:1}.search-submit{height:42px;min-width:46px;margin-right:2px;border:0;border-radius:3px;background:var(--primary);color:white}.search-submit .icon{color:white;width:42px}.activity-strip{display:flex;align-items:center;gap:0;margin:18px 0 28px;padding:0;background:transparent}.activity-lead{margin-right:16px;color:var(--muted);font-size:13px;font-weight:600}.activity-link{min-height:44px;display:inline-flex;align-items:center;gap:8px;padding:0 14px;border-left:1px solid var(--border);color:var(--ink);font-size:14px;font-weight:600;transition:color .16s}.activity-link:hover{color:var(--primary);text-decoration:underline;text-underline-offset:3px}.activity-link .icon{width:17px;font-size:16px;color:var(--primary)}.main-grid{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:24px;align-items:start}.results-header{display:flex;align-items:flex-end;justify-content:space-between;gap:12px;margin:0 0 13px}.results-header h2{margin:0;font-size:22px;line-height:1.2;letter-spacing:-.025em;font-weight:700}.results-header p{margin:5px 0 0;color:var(--muted);font-size:14px}.browse-link{min-height:44px;display:inline-flex;align-items:center;gap:7px;color:var(--primary);font-size:14px;font-weight:700;white-space:nowrap}.browse-link:hover{text-decoration:underline;text-underline-offset:3px}.empty-state{min-height:218px;padding:29px 32px;background:var(--surface);border:1px solid var(--border);border-radius:8px;display:flex;align-items:center;gap:25px}.empty-art{width:90px;height:90px;flex:none;display:grid;place-items:center;border-radius:50%;background:var(--inset);color:var(--primary)}.empty-art .icon{width:38px;height:38px;font-size:36px}.empty-copy h3{margin:0;font-size:19px;letter-spacing:-.02em}.empty-copy p{max-width:430px;margin:7px 0 15px;color:var(--muted);font-size:14px;line-height:1.5}.empty-action{min-height:44px;display:inline-flex;align-items:center;gap:8px;padding:0 15px;border-radius:5px;background:var(--primary);color:white;font-size:14px;font-weight:700}.empty-action:hover{background:var(--nav)}.empty-action .icon{width:16px;height:16px;font-size:15px}.aside-panel{background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:19px 18px 12px}.aside-panel h2{margin:0 0 13px;font-size:18px;letter-spacing:-.02em}.activity-row{min-height:52px;display:flex;align-items:center;justify-content:space-between;gap:12px;border-top:1px solid var(--border);color:var(--ink);font-size:14px;font-weight:600}.activity-row:first-of-type{border-top:0}.activity-row .row-start{display:flex;align-items:center;gap:10px}.activity-row .icon{color:var(--muted);width:17px;font-size:16px}.activity-row .arrow{color:var(--muted);width:15px;font-size:14px}.aside-help{margin-top:15px;padding:15px 16px;background:var(--nav);border-radius:7px;color:#fff}.aside-help h3{margin:0;font-size:15px}.aside-help p{margin:6px 0 12px;color:#d6e2da;font-size:13px;line-height:1.45}.aside-help a{min-height:40px;display:inline-flex;align-items:center;gap:7px;color:#f4d77e;font-weight:700;font-size:13px}.mobile-header,.mobile-dialog{display:none}.color-spec{position:absolute;left:-10000px;width:1px;height:1px;overflow:hidden}\n:where(a,button,input,summary):focus-visible{outline:3px solid var(--focus);outline-offset:3px;z-index:2}\n@media(max-width:1050px){.sidebar{width:232px}.app-main{margin-left:232px}.topbar{padding-inline:26px}.content{padding-inline:26px}.main-grid{grid-template-columns:minmax(0,1fr) 270px}.discover-tools{gap:14px;padding:16px}.activity-strip{flex-wrap:wrap}}\n@media(max-width:800px){.sidebar{display:none}.app-main{margin-left:0;padding-top:62px}.mobile-header{position:fixed;inset:0 0 auto 0;height:62px;z-index:50;display:flex;align-items:center;justify-content:space-between;padding:0 16px;background:var(--nav);color:#fff;border-bottom:1px solid #ffffff24}.mobile-brand{display:flex;align-items:center;gap:10px;font-size:16px;font-weight:700}.mobile-brand .brand-mark{width:34px;height:34px;font-size:17px}.mobile-menu{height:44px;min-width:44px;display:grid;place-items:center;border:1px solid #ffffff5a;border-radius:5px;background:transparent;color:#fff}.mobile-menu .icon{font-size:20px}.topbar{height:56px;padding-inline:18px}.content{padding:25px 18px 40px}.page-intro{align-items:flex-start;flex-direction:column;gap:17px}.page-intro h1{font-size:46px}.discover-tools{align-items:stretch;flex-direction:column;gap:15px}.mode-control{width:100%}.segment{display:flex;width:100%}.segment button{flex:1}.search-field{min-width:0}.activity-strip{align-items:flex-start;flex-direction:column;gap:0;margin:17px 0 24px}.activity-lead{margin:0 0 7px}.activity-link{width:100%;border-left:0;border-top:1px solid var(--border);padding:0 2px}.main-grid{grid-template-columns:1fr;gap:20px}.empty-state{min-height:190px;padding:22px;gap:17px}.empty-art{width:66px;height:66px}.empty-art .icon{font-size:28px}.results-header{align-items:flex-start;flex-direction:column}.browse-link{min-height:38px}.aside-help{margin-top:10px}.mobile-dialog{position:fixed;inset:auto 10px 10px 10px;width:auto;max-width:none;max-height:calc(100dvh - 78px);margin:0;padding:0;border:0;border-radius:12px;background:var(--nav);color:#fff;overflow-y:auto;box-shadow:0 18px 48px #061b12a8}.mobile-dialog[open]{display:block}.mobile-dialog::backdrop{background:#0b2018a8;backdrop-filter:blur(2px)}.drawer-inner{padding:17px 15px 16px}.drawer-head{display:flex;align-items:center;justify-content:space-between;padding:2px 8px 14px;border-bottom:1px solid #ffffff35}.drawer-title{font-weight:700;font-size:15px}.drawer-close{width:44px;height:44px;display:grid;place-items:center;border:1px solid #ffffff55;border-radius:5px;background:transparent;color:#fff}.drawer-close .icon{font-size:19px}.drawer-nav{padding-top:14px}.drawer-nav .nav-group{margin-bottom:18px}.drawer-nav .nav-label{margin-bottom:6px}.drawer-nav .nav-link{min-height:48px}.drawer-foot{border-top:1px solid #ffffff35;padding-top:10px}.mobile-dialog :where(a,button):focus-visible{outline-color:var(--focus)}.hero-photo{height:154px}.hero-copy h2{font-size:30px}}\n@media(max-width:480px){.top-actions{gap:7px}.account-button{padding-inline:8px}.account-button .account-label{display:none}.crumb{font-size:13px}.content{padding-inline:14px}.page-intro h1{font-size:42px}.page-intro p{font-size:14px}.list-vehicle{width:100%;justify-content:center}.activity-strip{margin-top:14px}.empty-state{align-items:flex-start;flex-direction:column}.empty-copy p{margin-bottom:13px}.results-header h2{font-size:20px}.mobile-dialog{inset:auto 8px 8p