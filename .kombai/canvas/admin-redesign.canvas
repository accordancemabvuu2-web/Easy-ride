ess status cell\"><span class=\"pill pill-active\" data-kid=\"1-2-2-4-1-3-7-3-1\" data-name=\"active status pill\"><span class=\"dot\" data-kid=\"1-2-2-4-1-3-7-3-1-1\" data-name=\"status pill dot\"></span>Active</span></td>\n<td data-kid=\"1-2-2-4-1-3-7-4\" data-name=\"user ID cell\"><span class=\"mono\" data-kid=\"1-2-2-4-1-3-7-4-1\" data-name=\"truncated UUID text\">1f04d7ba…6c93</span></td>\n<td class=\"right\" data-kid=\"1-2-2-4-1-3-7-5\" data-name=\"row action cell\"><a class=\"row-action\" data-kid=\"1-2-2-4-1-3-7-5-1\" data-name=\"View action link with chevron\" href=\"#\">View<i class=\"icon-chevron-right\" data-kid=\"1-2-2-4-1-3-7-5-1-1\" data-name=\"chevron right icon\"></i></a></td>\n</tr>\n<tr data-kid=\"1-2-2-4-1-3-8\" data-name=\"account row for Kudzai Chuma\">\n<td data-kid=\"1-2-2-4-1-3-8-1\" data-name=\"account cell with avatar\">\n<div class=\"who\" data-kid=\"1-2-2-4-1-3-8-1-1\" data-name=\"user identity cell\"><span class=\"avatar\" data-kid=\"1-2-2-4-1-3-8-1-1-1\" data-name=\"user avatar initials\">KC</span>\n<div data-kid=\"1-2-2-4-1-3-8-1-1-2\" data-name=\"name and email block\"><div class=\"who-name\" data-kid=\"1-2-2-4-1-3-8-1-1-2-1\" data-name=\"user display name\">Kudzai Chuma</div><div class=\"who-mail\" data-kid=\"1-2-2-4-1-3-8-1-1-2-2\" data-name=\"user email\">kudzai.chuma@gmail.com</div></div>\n</div>\n</td>\n<td data-kid=\"1-2-2-4-1-3-8-2\" data-name=\"account type cell\"><div class=\"type-main\" data-kid=\"1-2-2-4-1-3-8-2-1\" data-name='type label \"Buyer\"'>Buyer</div></td>\n<td data-kid=\"1-2-2-4-1-3-8-3\" data-name=\"access status cell\"><span class=\"pill pill-active\" data-kid=\"1-2-2-4-1-3-8-3-1\" data-name=\"active status pill\"><span class=\"dot\" data-kid=\"1-2-2-4-1-3-8-3-1-1\" data-name=\"status pill dot\"></span>Active</span></td>\n<td data-kid=\"1-2-2-4-1-3-8-4\" data-name=\"user ID cell\"><span class=\"mono\" data-kid=\"1-2-2-4-1-3-8-4-1\" data-name=\"truncated UUID text\">8d5172aa…e0b6</span></td>\n<td class=\"right\" data-kid=\"1-2-2-4-1-3-8-5\" data-name=\"row action cell\"><a class=\"row-action\" data-kid=\"1-2-2-4-1-3-8-5-1\" data-name=\"View action link with chevron\" href=\"#\">View<i class=\"icon-chevron-right\" data-kid=\"1-2-2-4-1-3-8-5-1-1\" data-name=\"chevron right icon\"></i></a></td>\n</tr>\n<tr data-kid=\"1-2-2-4-1-3-9\" data-name=\"account row for Simba Mhlanga\">\n<td data-kid=\"1-2-2-4-1-3-9-1\" data-name=\"account cell with avatar\">\n<div class=\"who\" data-kid=\"1-2-2-4-1-3-9-1-1\" data-name=\"user identity cell\"><span class=\"avatar\" data-kid=\"1-2-2-4-1-3-9-1-1-1\" data-name=\"user avatar initials\">SM</span>\n<div data-kid=\"1-2-2-4-1-3-9-1-1-2\" data-name=\"name and email block\"><div class=\"who-name\" data-kid=\"1-2-2-4-1-3-9-1-1-2-1\" data-name=\"user display name\">Simba Mhlanga</div><div class=\"who-mail\" data-kid=\"1-2-2-4-1-3-9-1-1-2-2\" data-name=\"user email\">simba.mhlanga@easyride.co.zw</div></div>\n</div>\n</td>\n<td data-kid=\"1-2-2-4-1-3-9-2\" data-name=\"account type cell\"><div class=\"type-main\" data-kid=\"1-2-2-4-1-3-9-2-1\" data-name='type label \"Administrator\"'>Administrator</div><div class=\"type-sub\" data-kid=\"1-2-2-4-1-3-9-2-2\" data-name=\"Operations sub-label\"><i class=\"icon-lock\" data-kid=\"1-2-2-4-1-3-9-2-2-1\" data-name=\"lock icon\"></i>Operations</div></td>\n<td data-kid=\"1-2-2-4-1-3-9-3\" data-name=\"access status cell\"><span class=\"pill pill-active\" data-kid=\"1-2-2-4-1-3-9-3-1\" data-name=\"active status pill\"><span class=\"dot\" data-kid=\"1-2-2-4-1-3-9-3-1-1\" data-name=\"status pill dot\"></span>Active</span></td>\n<td data-kid=\"1-2-2-4-1-3-9-4\" data-name=\"user ID cell\"><span class=\"mono\" data-kid=\"1-2-2-4-1-3-9-4-1\" data-name=\"truncated UUID text\">0b93f6c2…71ad</span></td>\n<td class=\"right\" data-kid=\"1-2-2-4-1-3-9-5\" data-name=\"row action cell\"><a class=\"row-action\" data-kid=\"1-2-2-4-1-3-9-5-1\" data-name=\"View action link with chevron\" href=\"#\">View<i class=\"icon-chevron-right\" data-kid=\"1-2-2-4-1-3-9-5-1-1\" data-name=\"chevron right icon\"></i></a></td>\n</tr>\n</tbody>\n</table>\n</section>\n<div class=\"pager\" data-kid=\"1-2-2-5\" data-name=\"table pager bar\">\n<span class=\"pager-info\" data-kid=\"1-2-2-5-1\" data-name=\"pager results summary text\">Showing <span class=\"tnum\" data-kid=\"1-2-2-5-1-1\" data-name='visible range \"1–24\"'>1–24</span> of <span class=\"tnum\" data-kid=\"1-2-2-5-1-2\" data-name='total results \"2'>2,481</span></span>\n<div class=\"pager-nav\" data-kid=\"1-2-2-5-2\" data-name=\"pager navigation controls\">\n<button aria-label=\"Previous page\" class=\"pg\" data-kid=\"1-2-2-5-2-1\" data-name=\"previous page button (disabled)\" disabled=\"\"><i class=\"icon-chevron-left\" data-kid=\"1-2-2-5-2-1-1\" data-name=\"chevron left icon\"></i></button>\n<button aria-current=\"page\" class=\"pg is-current\" data-kid=\"1-2-2-5-2-2\" data-name=\"current page 1 button\">1</button>\n<button class=\"pg\" data-kid=\"1-2-2-5-2-3\" data-name=\"page 2 button\">2</button>\n<button class=\"pg\" data-kid=\"1-2-2-5-2-4\" data-name=\"page 3 button\">3</button>\n<span class=\"pg-dots\" data-kid=\"1-2-2-5-2-5\" data-name=\"page ellipsis\">…</span>\n<button class=\"pg\" data-kid=\"1-2-2-5-2-6\" data-name=\"last page button (104)\">104</button>\n<button aria-label=\"Next page\" class=\"pg\" data-kid=\"1-2-2-5-2-7\" data-name=\"next page button\"><i class=\"icon-chevron-right\" data-kid=\"1-2-2-5-2-7-1\" data-name=\"chevron right icon\"></i></button>\n</div>\n</div>\n</div>\n</div>\n</div>",
