      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Alfa+Slab+One&family=Cabin:wght@400;500;600;700&family=Mulish:wght@400;500;600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n:root{--nav:#123A2A;--page:#F8F4EA;--surface:#FFFEFA;--inset:#EFE9DA;--ink:#243127;--muted:#5E675B;--border:#DAD5C6;--primary:#0C6346;--gold:#BE8A24;--success:#28764B;--warning:#946618;--error:#AB4439;--info:#3F7282;--neutral:#697068;--focus:#E3AD35}\nbody{margin:0;background:var(--page);color:var(--ink);font-family:'Cabin',sans-serif;font-size:15px;line-height:1.5}\n.workspace{min-height:100vh;background:var(--page)}\n.sidebar{position:fixed;z-index:5;inset:0 auto 0 0;width:264px;background:var(--nav);color:#fff;padding:24px 16px 18px;display:flex;flex-direction:column}\n.brand{display:flex;align-items:center;gap:12px;padding:4px 10px 22px;border-bottom:1px solid #ffffff20}\n.brand-mark{width:42px;height:42px;border-radius:11px;background:var(--gold);color:var(--nav);display:grid;place-items:center;font-family:'Mulish',sans-serif;font-size:15px;font-weight:900;letter-spacing:-.04em}\n.brand-name{font-family:'Mulish',sans-serif;font-size:17px;font-weight:800;letter-spacing:-.03em;line-height:1.15}.brand-sub{margin-top:4px;color:#d6ddcf;font-size:13px}\n.workspace-role{margin:18px 7px 16px;padding:11px 12px;border-radius:8px;background:#ffffff10;border:1px solid #ffffff1c;display:flex;align-items:center;gap:10px;color:#f7f4e9;font-weight:700}.role-dot{width:8px;height:8px;border-radius:50%;background:var(--gold);box-shadow:0 0 0 3px #be8a2430}\n.nav-groups{overflow-y:auto;padding:0 2px}.group-label{margin:18px 10px 7px;color:#c9d0c0;font-size:13px;font-weight:600;letter-spacing:.02em}.nav-link{height:44px;margin:2px 0;padding:0 11px;display:flex;align-items:center;gap:12px;border-radius:7px;text-decoration:none;color:#e6e9df;font-weight:600;font-size:14px;position:relative}.nav-link i{width:18px;height:18px;font-size:18px;color:#c9d0c0;display:grid;place-items:center}.nav-link.active{background:#f4f0e6;color:var(--nav);font-weight:700}.nav-link.active i{color:var(--primary)}.nav-link.active::after{content:'';position:absolute;right:12px;width:6px;height:6px;border-radius:50%;background:var(--gold)}.nav-link:hover{background:#ffffff12;color:#fff}.nav-divider{height:1px;background:#ffffff20;margin:18px 9px 8px}.sidebar-bottom{margin-top:auto;padding:12px 2px 0;border-top:1px solid #ffffff20}.sidebar-bottom .nav-link{font-weight:500}\n.main{margin-left:264px;min-height:100vh;padding:0 42px 48px}.topbar{height:76px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--border);margin:0 -42px 29px;padding:0 42px;background:var(--page)}.crumb{display:flex;align-items:center;gap:9px;color:var(--muted);font-size:14px}.crumb strong{font-weight:700;color:var(--ink)}.top-actions{display:flex;align-items:center;gap:12px}.top-link{display:flex;align-items:center;gap:8px;text-decoration:none;color:var(--ink);font-weight:600;padding:9px 12px;border-radius:7px}.top-link i{font-size:17px;color:var(--primary)}.top-profile{width:42px;height:42px;border:1px solid var(--border);border-radius:50%;background:var(--surface);display:grid;place-items:center;color:var(--nav);font-size:19px}\n.content{max-width:1120px;margin:0 auto}.intro{display:flex;justify-content:space-between;align-items:center;margin:0 0 18px}.intro h1{font-family:'Mulish',sans-serif;font-size:25px;line-height:1.2;letter-spacing:-.035em;margin:0;font-weight:800;color:var(--ink)}.intro p{margin:5px 0 0;color:var(--muted);font-size:14px}.hero{height:204px;border:1px solid var(--border);border-radius:12px;background:var(--surface);display:grid;grid-template-columns:1.22fr .78fr;overflow:hidden}.hero-copy{padding:27px 30px;display:flex;flex-direction:column;justify-content:center}.hero h2{font-family:'Alfa Slab One',serif;font-size:30px;line-height:1.16;font-weight:400;letter-spacing:-.02em;margin:0;color:var(--ink)}.hero-copy p{max-width:530px;margin:10px 0 17px;color:var(--muted);font-size:15px;line-height:1.55}.hero-actions{display:flex;gap:10px;align-items:center}.button{min-height:44px;padding:0 17px;display:inline-flex;align-items:center;justify-content:center;gap:9px;border-radius:7px;text-decoration:none;font-family:'Cabin',sans-serif;font-size:14px;font-weight:700;border:1px solid transparent}.button-primary{background:var(--primary);color:#fff}.button-primary i{font-size:17px}.button-quiet{background:transparent;color:var(--primary);border-color:var(--border)}.hero-media{position:relative;min-width:0;background:var(--inset)}.hero-media::before{content:'';position:absolute;inset:0;background:linear-gradient(90deg,var(--surface) 0%,#fffefa00 28%);z-index:1;pointer-events:none}.hero-media img{width:100%;height:100%;object-fit:cover;object-position:right 68%;display:block}\n.explore{margin-top:28px}.explore-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px}.explore-head h2,.section-title{font-family:'Mulish',sans-serif;font-size:21px;line-height:1.25;letter-spacing:-.025em;font-weight:800;color:var(--ink);margin:0}.mode-control{display:inline-flex;align-items:center;padding:4px;border:1px solid var(--border);border-radius:8px;background:var(--surface);gap:3px}.mode-button{height:40px;min-width:110px;padding:0 15px;border-radius:5px;text-decoration:none;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:700;color:var(--muted)}.mode-button.selected{background:var(--nav);color:#fff}.search-row{display:flex;align-items:end;gap:12px;margin-bottom:22px}.search-field{flex:1;min-width:0}.search-field label{display:block;margin:0 0 7px;color:var(--ink);font-size:14px;font-weight:700}.input-wrap{height:48px;display:flex;align-items:center;gap:11px;padding:0 14px;background:var(--surface);border:1px solid var(--border);border-radius:7px}.input-wrap i{font-size:18px;color:var(--muted);flex:none}.input-wrap input{width:100%;border:0;outline:0;background:transparent;color:var(--ink);font:500 14px 'Cabin',sans-serif}.input-wrap input::placeholder{color:#77796d;opacity:1}.search-hint{height:48px;display:flex;align-items:center;padding:0 14px;border:1px solid var(--border);border-radius:7px;color:var(--muted);font-size:13px;background:#f3eee1;white-space:nowrap}.results-layout{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:30px;align-items:start}.results-head{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:13px}.results-head h3{font-family:'Mulish',sans-serif;font-size:18px;line-height:1.3;margin:0;font-weight:800}.results-head span{font-size:13px;color:var(--muted)}.empty-state{min-height:214px;border:1px dashed #c9c1af;border-radius:10px;background:#f4efe3;display:flex;align-items:center;justify-content:center;flex-direction:column;text-align:center;padding:24px}.empty-mark{width:42px;height:42px;margin-bottom:9px;border-radius:50%;display:grid;place-items:center;background:var(--surface);color:var(--primary);font-size:20px}.empty-state h4{margin:0;color:var(--ink);font-family:'Mulish',sans-serif;font-weight:800;font-size:17px}.empty-state p{max-width:370px;margin:7px 0 15px;color:var(--muted);font-size:14px;line-height:1.5}.activity{padding:0;border-left:1px solid var(--border);padding-left:24px}.activity h3{font-family:'Mulish',sans-serif;font-size:18px;font-weight:800;margin:0 0 5px}.activity-intro{margin:0 0 14px;color:var(--muted);font-size:14px}.activity-row{min-height:54px;display:flex;align-items:center;justify-content:space-between;border-top:1px solid var(--border);gap:12px}.activity-row span:first-child{font-weight:600;color:var(--ink)}.activity-empty{font-size:13px;color:var(--neutral)}.activity-row i{font-size:16px;color:var(--muted)}.activity-foot{margin-top:12px;color:var(--muted);font-size:13px;line-height:1.5}\n.mobile-header{display:none}.button:focus-visible,.nav-link:focus-visible,.mode-button:focus-visible,.top-link:focus-visible,.top-profile:focus-visible,.input-wrap:focus-within{outline:3px solid var(--focus);outline-offset:3px}\n@media(max-width:1100px){.main{padding-right:28px;padding-left:28px}.topbar{margin-left:-28px;margin-right:-28px;padding:0 28px}.results-layout{grid-template-columns:minmax(0,1fr) 260px;gap:22px}.activity{padding-left:19px}}\n@media(max-width:920px){.sidebar{display:none}.mobile-header{height:62px;display:flex;align-items:center;justify-content:space-between;padding:0 20px;background:var(--nav);color:#fff}.mobile-brand{display:flex;align-items:center;gap:10px;font-family:'Mulish',sans-serif;font-weight:800}.mobile-brand-mark{width:34px;height:34px;border-radius:9px;background:var(--gold);color:var(--nav);display:grid;place-items:center;font-size:13px}.mobile-menu{width:44px;height:44px;border:1px solid #ffffff55;border-radius:7px;background:transparent;color:#fff;font-size:20px;display:grid;place-items:center}.main{margin:0;padding:0 24px 36px}.topbar{height:60px;margin:0 -24px 23px;padding:0 24px}.content{max-width:none}.hero{grid-template-columns:1.1fr .9fr}.results-layout{grid-template-columns:1fr;gap:26px}.activity{border-left:0;border-top:1px solid var(--border);padding:19px 0 0}.activity-rows{display:grid;grid-template-columns:repeat(3,1fr);gap:0 18px}.activity-foot{margin-top:8px}}\n@media(max-width:600px){.main{padding:0 16px 30px}.topbar{margin-left:-16px;margin-right:-16px;padding:0 16px;height:56px;margin-bottom:18px}.crumb{font-size:13px}.top-link{font-size:0;padding:9px}.top-link i{font-size:18px}.top-profile{width:38px;height:38px}.intro{margin-bottom:14px}.intro h1{font-size:22px}.hero{height:auto;grid-template-columns:1fr}.hero-copy{padding:22px 20px}.hero h2{font-size:27px}.hero-copy p{margin:9px 0 14px}.hero-media{height:118px;order:2}.hero-media::before{background:linear-gradient(180deg,var(--surface),#fffefa00 55%)}.explore{margin-top:22px}.explore-head{align-items:flex-start;gap:12px;flex-direction:column}.mode-control{width:100%}.mode-button{flex:1}.search-row{display:block}.search-hint{display:none}.input-wrap{height:48px}.results-head{align-items:flex-start;gap:8px;flex-direction:column}.empty-state{min-height:195px}.activity-rows{grid-template-columns:1fr}.activity-row{min-height:49px}.activity-foot{font-size:13px}}\n</style>\n<div class=\"workspace\" data-kid=\"1\" data-name=\"page layout container\">\n    <aside aria-label=\"Buyer workspace navigation\" class=\"sidebar\" data-kid=\"1-1\" data-name=\"buyer workspace sidebar navigation\">\n        <div class=\"brand\" data-kid=\"1-1-1\" data-name=\"brand identity block\">\n            <span class=\"brand-mark\" data-kid=\"1-1-1-1\" data-name=\"brand monogram badge\">\n                ER\n            </span>\n            <div data-kid=\"1-1-1-2\" data-name=\"brand name block container\">\n                <div class=\"brand-name\" data-kid=\"1-1-1-2-1\" data-name=\"brand name text\">\n                    Easy Ride\n                </div>\n                <div class=\"brand-sub\" data-kid=\"1-1-1-2-2\" data-name=\"brand account subtitle\">\n                    Personal account\n                </div>\n            </div>\n        </div>\n        <div class=\"workspace-role\" data-kid=\"1-1-2\" data-name=\"user role indicator badge\">\n            <span class=\"role-dot\" data-kid=\"1-1-2-1\" data-name=\"role status dot\">\n            </span>\n            <span data-kid=\"1-1-2-2\" data-name=\"role label text\">\n                Buyer workspace\n            </span>\n        </div>\n        <nav aria-label=\"Main navigation\" class=\"nav-groups\" data-kid=\"1-1-3\" data-name=\"main navigation menu\">\n            <div class=\"group-label\" data-kid=\"1-1-3-1\" data-name=\"nav group label Explore\">\n                Explore\n            </div>\n            <a aria-current=\"page\" class=\"nav-link active\" data-kid=\"1-1-3-2\" data-name=\"nav link Dashboard (active)\" href=\"#dashboard\">\n                <i class=\"icon-layout-dashboard\" data-kid=\"1-1-3-2-1\" data-name=\"dashboard layout icon\">\n                </i>\n                <span data-kid=\"1-1-3-2-2\" data-name=\"nav link label Dashboard\">\n                    Dashboard\n                </span>\n            </a>\n            <div class=\"group-label\" data-kid=\"1-1-3-3\" data-name=\"nav group label Your activity\">\n                Your activity\n            </div>\n            <a class=\"nav-link\" data-kid=\"1-1-3-4\" data-name=\"nav link Favorites\" href=\"#favorites\">\n                <i class=\"icon-heart\" data-kid=\"1-1-3-4-1\" data-name=\"heart icon\">\n                </i>\n                <span data-kid=\"1-1-3-4-2\" data-name=\"nav link label Favorites\">\n                    Favorites\n                </span>\n            </a>\n            <a class=\"nav-link\" data-kid=\"1-1-3-5\" data-name=\"nav link Offers\" href=\"#offers\">\n                <i class=\"icon-hand-coins\" data-kid=\"1-1-3-5-1\" data-name=\"hand coins icon\">\n                </i>\n                <span data-kid=\"1-1-3-5-2\" data-name=\"nav link label Offers\">\n                    Offers\n                </span>\n            </a>\n            <a class=\"nav-link\" data-kid=\"1-1-3-6\" data-name=\"nav link Bookings\" href=\"#bookings\">\n                <i class=\"icon-calendar-days\" data-kid=\"1-1-3-6-1\" data-name=\"calendar icon\">\n                </i>\n                <span data-kid=\"1-1-3-6-2\" data-name=\"nav link label Bookings\">\n                    Bookings\n                </span>\n            </a>\n            <a class=\"nav-link\" data-kid=\"1-1-3-7\" data-name=\"nav link Messages\" href=\"#messages\">\n                <i class=\"icon-message-circle\" data-kid=\"1-1-3-7-1\" data-name=\"message circle icon\">\n                </i>\n                <span data-kid=\"1-1-3-7-2\" data-name=\"nav link label Messages\">\n                    Messages\n                </span>\n            </a>\n            <div class=\"group-label\" data-kid=\"1-1-3-8\" data-name=\"nav group label Account and support\">\n                Account & support\n            </div>\n            <a class=\"nav-link\" data-kid=\"1-1-3-9\" data-name=\"nav link Profile\" href=\"#profile\">\n                <i class=\"icon-circle-user-round\" data-kid=\"1-1-3-9-1\" data-name=\"user avatar icon\">\n                </i>\n                <span data-kid=\"1-1-3-9-2\" data-name=\"nav link label Profile\">\n                    Profile\n                </span>\n            </a>\n            <a class=\"nav-link\" data-kid=\"1-1-3-10\" data-name=\"nav link Settings\" href=\"#settings\">\n                <i class=\"icon-settings-2\" data-kid=\"1-1-3-10-1\" data-name=\"settings gear icon\">\n                </i>\n                <span data-kid=\"1-1-3-10-2\" data-name=\"nav link label Settings\">\n                    Settings\n                </span>\n            </a>\n            <a class=\"nav-link\" data-kid=\"1-1-3-11\" data-name=\"nav link Support\" href=\"#support\">\n                <i class=\"icon-life-buoy\" data-kid=\"1-1-3-11-1\" data-name=\"life buoy icon\">\n                </i>\n                <span data-kid=\"1-1-3-11-2\" data-name=\"nav link label Support\">\n                    Support\n                </span>\n            </a>\n        </nav>\n        <div class=\"sidebar-bottom\" data-kid=\"1-1-4\" data-name=\"sidebar bottom section\">\n            <a class=\"nav-link\" data-kid=\"1-1-4-1\" data-name=\"logout link\" href=\"#logout\">\n                <i class=\"icon-log-out\" data-kid=\"1-1-4-1-1\" data-name=\"log out icon\">\n                </i>\n                <span data-kid=\"1-1-4-1-2\" data-name=\"logout link label\">\n                    Log out\n                </span>\n            </a>\n        </div>\n    </aside>\n    <header class=\"mobile-header\" data-kid=\"1-2\" data-name=\"mobile header bar\">\n        <div class=\"mobile-brand\" data-kid=\"1-2-1\" data-name=\"mobile brand block\">\n            <span class=\"mobile-brand-mark\" data-kid=\"1-2-1-1\" data-name=\"mobile brand monogram\">\n                ER\n            </span>\n            <span data-kid=\"1-2-1-2\" data-name=\"mobile brand name text\">\n                Easy Ride\n            </span>\n        </div>\n        <button aria-label=\"Open navigation\" class=\"mobile-menu\" data-kid=\"1-2-2\" data-name=\"mobile menu toggle button\">\n            <i class=\"icon-menu\" data-kid=\"1-2-2-1\" data-name=\"hamburger menu icon\">\n            </i>\n        </button>\n    </header>\n    <main class=\"main\" data-kid=\"1-3\" data-name=\"main content area\">\n        <div class=\"topbar\" data-kid=\"1-3-1\" data-name=\"page top bar\">\n            <div class=\"crumb\" data-kid=\"1-3-1-1\" data-name=\"breadcrumb navigation\">\n                <span data-kid=\"1-3-1-1-1\" data-name=\"breadcrumb root segment\">\n                    Personal\n                </span>\n                <span aria-hidden=\"true\" data-kid=\"1-3-1-1-2\" data-name=\"breadcrumb separator\">\n                    /\n                </span>\n                <strong data-kid=\"1-3-1-1-3\" data-name=\"breadcrumb current page label\">\n                    Dashboard\n                </strong>\n            </div>\n            <div class=\"top-actions\" data-kid=\"1-3-1-2\" data-name=\"top bar action controls\">\n                <a class=\"top-link\" data-kid=\"1-3-1-2-1\" data-name=\"help and support link\" href=\"#support\">\n                    <i class=\"icon-life-buoy\" data-kid=\"1-3-1-2-1-1\" data-name=\"life buoy icon\">\n                    </i>\n                    <span data-kid=\"1-3-1-2-1-2\" data-name=\"help link label\">\n                        Help & support\n                    </span>\n                </a>\n                <a aria-label=\"Open profile\" class=\"top-profile\" data-kid=\"1-3-1-2-2\" data-name=\"user profile avatar button\" href=\"#profile\">\n                    <i class=\"icon-user-round\" data-kid=\"1-3-1-2-2-1\" data-name=\"user round icon\">\n                    </i>\n                </a>\n            </div>\n        </div>\n        <div class=\"content\" data-kid=\"1-3-2\" data-name=\"page content wrapper\">\n            <div class=\"intro\" data-kid=\"1-3-2-1\" data-name=\"page intro header\">\n                <div data-kid=\"1-3-2-1-1\" data-name=\"intro text block\">\n                    <h1 data-kid=\"1-3-2-1-1-1\" data-name=\"page heading Dashboard\">\n                        Dashboard\n                    </h1>\n                    <p data-kid=\"1-3-2-1-1-2\" data-name=\"page intro description\">\n                        Your saved vehicles and marketplace activity in one place.\n                    </p>\n                </div>\n            </div>\n            <section aria-label=\"Vehicle discovery\" class=\"hero\" data-kid=\"1-3-2-2\" data-name=\"vehicle discovery hero section\">\n                <div class=\"hero-copy\" data-kid=\"1-3-2-2-1\" data-name=\"hero copy block\">\n                    <h2 data-kid=\"1-3-2-2-1-1\" data-name=\"hero headline text\">\n                        Find your next ride.\n                    </h2>\n                    <p data-kid=\"1-3-2-2-1-2\" data-name=\"hero supporting text\">\n                        Explore vehicles for sale or rent, save your favourites, and connect with trusted sellers.\n                    </p>\n                    <div class=\"hero-actions\" data-kid=\"1-3-2-2-1-3\" data-name=\"hero action buttons\">\n                        <a class=\"button button-primary\" data-kid=\"1-3-2-2-1-3-1\" data-name=\"primary browse vehicles call-to-action button\" href=\"#marketplace\">\n                            Browse vehicles\n                            <i class=\"icon-arrow-up-right\" data-kid=\"1-3-2-2-1-3-1-1\" data-name=\"arrow up-right icon\">\n                            </i>\n                        </a>\n                        <a class=\"button button-quiet\" data-kid=\"1-3-2-2-1-3-2\" data-name=\"quiet list a vehicle button\" href=\"#create-listing\">\n                            List a vehicle\n                        </a>\n                    </div>\n                </div>\n                <div class=\"hero-media\" data-kid=\"1-3-2-2-2\" data-name=\"hero media image panel\">\n                    <img alt=\"A Toyota pickup on an open road\" data-kid=\"1-3-2-2-2-1\" data-name=\"hero vehicle image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/images/pexels-dilrubasaricimen-7534335.jpg\"/>\n                </div>\n            </section>\n            <section aria-labelledby=\"explore-title\" class=\"explore\" data-kid=\"1-3-2-3\" data-name=\"explore vehicles section\">\n                <div class=\"explore-head\" data-kid=\"1-3-2-3-1\" data-name=\"explore section header\">\n                    <h2 data-kid=\"1-3-2-3-1-1\" data-name=\"explore section title\" id=\"explore-title\">\n                        Explore vehicles\n                    </h2>\n                    <div aria-label=\"Choose listings to explore\" class=\"mode-control\" data-kid=\"1-3-2-3-1-2\" data-name=\"buy/rent mode toggle control\">\n                        <a aria-current=\"true\" class=\"mode-button selected\" data-kid=\"1-3-2-3-1-2-1\" data-name=\"buy vehicles mode option (selected)\" href=\"#buy\">\n                            Buy vehicles\n                        </a>\n                        <a class=\"mode-button\" data-kid=\"1-3-2-3-1-2-2\" data-name=\"rent vehicles mode option\" href=\"#rent\">\n                            Rent vehicles\n                        </a>\n                    </div>\n                </div>\n                <div class=\"search-row\" data-kid=\"1-3-2-3-2\" data-name=\"search row\">\n                    <div class=\"search-field\" data-kid=\"1-3-2-3-2-1\" data-name=\"vehicle search input field\">\n                        <label data-kid=\"1-3-2-3-2-1-1\" data-name=\"search field label\" for=\"vehicle-search\">\n                            Search vehicles\n                        </label>\n                        <div class=\"input-wrap\" data-kid=\"1-3-2-3-2-1-2\" data-name=\"search input wrapper\">\n                            <i class=\"icon-search\" data-kid=\"1-3-2-3-2-1-2-1\" data-name=\"search magnifier icon\">\n                            </i>\n                            <input aria-label=\"Search vehicles by make, model or location\" data-kid=\"1-3-2-3-2-1-2-2\" data-name=\"vehicle search input\" id=\"vehicle-search\" placeholder=\"Make, model or location\" type=\"search\"/>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"results-layout\" data-kid=\"1-3-2-3-3\" data-name=\"results layout container\">\n                    <section aria-labelledby=\"results-title\" class=\"results\" data-kid=\"1-3-2-3-3-1\" data-name=\"results section\">\n                        <div class=\"results-head\" data-kid=\"1-3-2-3-3-1-1\" data-name=\"results header\">\n                            <h3 data-kid=\"1-3-2-3-3-1-1-1\" data-name=\"results section title\" id=\"results-title\">\n                                Vehicles for sale\n                            </h3>\n                        </div>\n                        <div class=\"empty-state\" data-kid=\"1-3-2-3-3-1-2\" data-name=\"empty state card\">\n                            <span class=\"empty-mark\" data-kid=\"1-3-2-3-3-1-2-1\" data-name=\"empty state icon container\">\n                                <i class=\"icon-car-front\" data-kid=\"1-3-2-3-3-1-2-1-1\" data-name=\"car front icon\">\n                                </i>\n                            </span>\n                            <h4 data-kid=\"1-3-2-3-3-1-2-2\" data-name=\"empty state headline\">\n                                No vehicles are available yet\n                            </h4>\n                            <p data-kid=\"1-3-2-3-3-1-2-3\" data-name=\"empty state description\">\n                                Check back soon as sellers add more vehicles.\n                            </p>\n                        </div>\n                    </section>\n                    <section aria-labelledby=\"activity-title\" class=\"activity\" data-kid=\"1-3-2-3-3-2\" data-name=\"activity sidebar section\">\n                        <h3 data-kid=\"1-3-2-3-3-2-1\" data-name=\"activity section title\" id=\"activity-title\">\n                            Your activity\n                        </h3>\n                        <p class=\"activity-intro\" data-kid=\"1-3-2-3-3-2-2\" data-name=\"activity section intro text\">\n                            Your saved vehicles and transactions will appear here.\n                        </p>\n                        <div class=\"activity-rows\" data-kid=\"1-3-2-3-3-2-3\" data-name=\"activity rows list\">\n                            <div class=\"activity-row\" data-kid=\"1-3-2-3-3-2-3-1\" data-name=\"activity row Favorites\">\n                                <span data-kid=\"1-3-2-3-3-2-3-1-1\" data-name=\"activity row label\">\n                                    Favorites\n                                </span>\n                                <span class=\"activity-empty\" data-kid=\"1-3-2-3-3-2-3-1-2\" data-name=\"activity row empty status\">\n                                    Nothing saved yet\n                                </span>\n                            </div>\n                            <div class=\"activity-row\" data-kid=\"1-3-2-3-3-2-3-2\" data-name=\"activity row Offers\">\n                                <span data-kid=\"1-3-2-3-3-2-3-2-1\" data-name=\"activity row label\">\n                                    Offers\n                                </span>\n                                <span class=\"activity-empty\" data-kid=\"1-3-2-3-3-2-3-2-2\" data-name=\"activity row empty status\">\n                                    No offers yet\n                                </span>\n                            </div>\n                            <div class=\"activity-row\" data-kid=\"1-3-2-3-3-2-3-3\" data-name=\"activity row Bookings\">\n                                <span data-kid=\"1-3-2-3-3-2-3-3-1\" data-name=\"activity row label\">\n                                    Bookings\n                                </span>\n                                <span class=\"activity-empty\" data-kid=\"1-3-2-3-3-2-3-3-2\" data-name=\"activity row empty status\">\n                                    No bookings yet\n                                </span>\n                            </div>\n                        </div>\n                        <p class=\"activity-foot\" data-kid=\"1-3-2-3-3-2-4\" data-name=\"activity footer note\">\n                            Messages appear here when you start a conversation with a seller.\n                        </p>\n                    </section>\n                </div>\n            </section>\n        </div>\n    </main>\n</div>\n",
