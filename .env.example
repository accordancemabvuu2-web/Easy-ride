# Frontend API base URL. Include the agreed version prefix.
NEXT_PUBLIC_API_BASE_URL=https://easy-ride-backend-adyr.onrender.com/api/v1

# Public base URL for videos stored in Cloudflare R2.
# Example: https://media.example.com
# Public R2 domain used by the hero video.
NEXT_PUBLIC_MEDIA_BASE_URL=https://pub-9c95999dffa64e63a418ca19ce18d047.r2.dev

# Override this for local development:
# NEXT_PUBLIC_API_BASE_URL=https://staging-api.example.com/api/v1
# NEXT_PUBLIC_API_BASE_URL=http://localhost:4567/api/v1

# Optional public client configuration used by existing frontend features.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_ENABLE_GOOGLE_MAPS=false
