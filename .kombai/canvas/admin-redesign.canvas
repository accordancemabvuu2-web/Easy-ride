      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n\n*,*::before,*::after{box-sizing:border-box}\n:root{\n  --forest:#08281D;--green:#0B5D3B;--green-dark:#0A4E32;--green-soft:#EAF3EE;--green-line:#CFE2D7;\n  --gold:#C9A227;--canvas:#F4F6F5;--surface:#FFFFFF;--ink:#10201A;--ink-2:#4C5C54;--ink-3:#7B8A82;\n  --line:#E3E9E5;--line-2:#EEF2EF;--mono:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;\n}\nhtml,body{margin:0;padding:0;height:100%}\nbody{font-family:'Inter',-apple-system,'Segoe UI',Arial,sans-serif;background:var(--canvas);color:var(--ink);font-size:14px;line-height:1.45;-webkit-font-smoothing:antialiased;overflow:hidden}\nbutton{font-family:inherit;font-size:inherit;color:inherit}\na{color:inherit;text-decoration:none}\n[class^=\"icon-\"],[class*=\" icon-\"]{line-height:1;display:inline-block}\n:focus-visible{outline:2px solid var(--green);outline-offset:2px}\n.tnum{font-variant-numeric:tabular-nums}\n.mono{font-family:var(--mono);font-size:12px;letter-spacing:-.01em}\n.app{position:relative;width:1440px;height:900px;display:flex;overflow:hidden;background:var(--canvas)}\n\n.sidebar{width:288px;flex:0 0 288px;height:900px;background:var(--forest);color:#fff;display:flex;flex-direction:column}\n.brand{height:88px;flex:0 0 88px;display:flex;align-items:center;gap:12px;padding:0 20px;border-bottom:1px solid rgba(255,255,255,.08)}\n.brand-mark{width:38px;height:38px;border-radius:10px;background:linear-gradient(160deg,#E2C466,#C9A227);color:#08281D;display:grid;place-items:center;font-size:13.5px;font-weight:700;letter-spacing:.02em}\n.brand-name{font-size:15px;font-weight:600;letter-spacing:-.01em}\n.brand-sub{font-size:11.5px;color:rgba(255,255,255,.5);margin-top:1px}\n.nav{flex:1;padding:14px 12px 8px;overflow:hidden}\n.nav-group{margin-bottom:14px}\n.nav-label{font-size:10.5px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.36);padding:0 10px 6px}\n.nav-item{display:flex;align-items:center;gap:10px;height:40px;padding:0 10px;border-radius:8px;color:rgba(255,255,255,.74);font-size:13.5px;font-weight:500}\n.nav-item i{font-size:16px;color:rgba(255,255,255,.5)}\n.nav-item .lbl{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.nav-item:hover{background:rgba(255,255,255,.07);color:#fff}\n.nav-item.active{background:#fff;color:var(--forest);font-weight:600;box-shadow:0 1px 2px rgba(0,0,0,.2)}\n.nav-item.active i{color:var(--green)}\n.nav-count{margin-left:auto;min-width:22px;padding:1px 7px;border-radius:999px;background:rgba(255,255,255,.11);color:rgba(255,255,255,.75);font-size:11.5px;font-weight:600;text-align:center}\n.nav-item.active .nav-count{background:var(--green-soft);color:var(--green)}\n.nav-priv{padding-top:12px;border-top:1px solid rgba(255,255,255,.1)}\n.nav-priv .nav-label{display:flex;align-items:center;gap:6px;color:rgba(255,255,255,.48)}\n.nav-priv .nav-label i{font-size:11px;color:var(--gold)}\n.sidebar-foot{border-top:1px solid rgba(255,255,255,.08);padding:12px}\n.me{display:flex;align-items:center;gap:10px;padding:8px;border-radius:10px}\n.me:hover{background:rgba(255,255,255,.07)}\n.sidebar .avatar{background:rgba(255,255,255,.14);color:#fff}\n.me-name{font-size:13px;font-weight:600}\n.me-role{font-size:11.5px;color:rgba(255,255,255,.5)}\n.logout{margin-left:auto;font-size:15px;color:rgba(255,255,255,.42)}\n\n.main{flex:1;min-width:0;height:900px;display:flex;flex-direction:column}\n.topbar{height:64px;flex:0 0 64px;background:#fff;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 24px}\n.crumbs{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--ink-3)}\n.crumbs .sep{color:#C6D0CA}\n.crumbs strong{color:var(--ink);font-weight:500}\n.topbar-right{display:flex;align-items:center;gap:14px}\n.role-chip{display:inline-flex;align-items:center;gap:6px;height:26px;padding:0 10px;border-radius:999px;border:1px solid #E7DBB2;background:#FBF7E8;color:#6D5716;font-size:12px;font-weight:500}\n.role-chip i{font-size:12px;color:#A98A22}\n.profile{display:flex;align-items:center;gap:8px;height:34px;padding:0 8px 0 6px;border:1px solid transparent;border-radius:999px;background:transparent;cursor:pointer;font-size:13px;font-weight:500}\n.profile:hover{background:#F1F4F2}\n.profile i{font-size:13px;color:var(--ink-3)}\n.avatar{width:30px;height:30px;border-radius:999px;background:var(--green-soft);color:var(--green);display:grid;place-items:center;font-size:11.5px;font-weight:600;flex:0 0 auto}\n.avatar.sm{width:26px;height:26px;font-size:10.5px}\n\n.page{flex:1;min-height:0;padding:24px;display:flex;flex-direction:column;gap:16px}\n.page-head{height:56px;flex:0 0 56px;display:flex;align-items:flex-end;justify-content:space-between}\n.page-head h1{margin:0;font-size:26px;line-height:1.2;font-weight:600;letter-spacing:-.022em}\n.page-head .meta{font-size:13px;color:var(--ink-3);padding-bottom:3px}\n.panel{background:var(--surface);border:1px solid var(--line);border-radius:12px}\n\n.btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;height:36px;padding:0 14px;border:1px solid transparent;border-radius:8px;background:transparent;font-size:13px;font-weight:500;cursor:pointer;transition:background .12s ease,border-color .12s ease,color .12s ease}\n.btn i{font-size:15px}\n.btn-sm{height:32px;font-size:12.5px;padding:0 11px}\n.btn-primary{background:var(--green);color:#fff}\n.btn-primary:hover{background:var(--green-dark)}\n.btn-outline{border-color:#D6DFD9;background:#fff;color:var(--ink)}\n.btn-outline:hover{background:#F6F8F7;border-color:#C2D0C8}\n.btn-quiet{color:var(--ink-2)}\n.btn-quiet:hover{background:#EFF3F1;color:var(--ink)}\n.btn-danger-outline{border-color:#E8C7C2;background:#fff;color:#98271C}\n.btn-danger-outline:hover{background:#FDF1EF}\n.danger-text{color:#98271C}\n.danger-text:hover{background:#FBEBE9;color:#98271C}\n\n/* toolbar */\n.toolbar{height:72px;flex:0 0 72px;display:flex;align-items:center;gap:12px;padding:0 16px}\n.field{display:flex;flex-direction:column;gap:5px;width:192px;flex:0 0 auto}\n.field.grow{flex:1;min-width:0;width:auto}\n.field label{font-size:11.5px;font-weight:500;color:var(--ink-3)}\n.input-wrap,.select-wrap{position:relative;display:flex;align-items:center}\n.input-wrap i{position:absolute;left:10px;font-size:14px;color:var(--ink-3);pointer-events:none}\ninput[type=text],select{height:34px;width:100%;border:1px solid #D9E1DC;border-radius:8px;background:#fff;padding:0 10px;font-family:inherit;font-size:13px;color:var(--ink);appearance:none}\ninput[type=text]{padding-left:31px}\ninput::placeholder{color:#98A69E}\ninput:focus,select:focus{border-color:var(--green);outline:none;box-shadow:0 0 0 3px rgba(11,93,59,.12)}\n.select-wrap i{position:absolute;right:10px;font-size:13px;color:var(--ink-3);pointer-events:none}\n.filter-tail{margin-left:auto;display:flex;align-items:center;gap:8px;font-size:12.5px;color:var(--ink-3)}\n\n/* workspace */\n.workspace{flex:1;min-height:0;display:grid;grid-template-columns:352px 1fr;gap:16px}\n.qcol{display:flex;flex-direction:column;overflow:hidden}\n.qhead{height:48px;flex:0 0 48px;padding:0 14px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line-2)}\n.qhead h2{margin:0;font-size:13px;font-weight:600}\n.qhead .cnt{font-size:12px;color:var(--ink-3)}\n.qrow{display:flex;align-items:center;gap:12px;height:104px;padding:0 14px;border-bottom:1px solid var(--line-2)}\n.qrow:hover{background:#F7FAF8}\n.qrow img{width:60px;height:64px;border-radius:7px;object-fit:cover;object-position:center 55%;flex:0 0 auto;background:#E8EDEA}\n.qi{flex:1;min-width:0}\n.qrow .qt{font-size:13.5px;font-weight:500;line-height:1.3;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.qrow .qm{font-size:12px;color:var(--ink-3);margin-top:3px}\n.qrow .qp{font-size:13px;font-weight:600;margin-top:5px}\n.qrow.selected{background:rgba(11,93,59,.06);box-shadow:inset 0 0 0 1px var(--green-line)}\n.qmark{width:18px;height:18px;border-radius:999px;background:var(--green);color:#fff;display:grid;place-items:center;font-size:10px;flex:0 0 auto}\n.qnav{height:48px;flex:0 0 48px;display:flex;align-items:center;justify-content:space-between;padding:0 14px;font-size:12px;color:var(--ink-3)}\n.qnav .nav-btns{display:flex;gap:4px}\n.iconbtn{width:26px;height:26px;border:1px solid var(--line);border-radius:6px;background:#fff;display:grid;place-items:center;color:var(--ink-2);font-size:13px}\n.iconbtn:disabled{color:#B9C6BF;cursor:not-allowed}\n\n/* evidence */\n.evidence{display:flex;flex-direction:column;overflow:hidden}\n.ev-head{height:56px;flex:0 0 56px;padding:0 20px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line-2)}\n.ev-head h2{margin:0;font-size:19px;font-weight:600;letter-spacing:-.015em}\n.ev-sub{display:flex;gap:14px;margin-top:3px;font-size:12px;color:var(--ink-3)}\n.ev-body{flex:1;min-height:0;padding:14px 20px 0;display:flex;flex-direction:column;gap:12px}\n.ev-img{width:100%;height:272px;border-radius:8px;object-fit:cover;object-position:center 52%;background:#E8EDEA}\n.specs{display:flex;flex-wrap:wrap;gap:6px}\n.spec{height:24px;display:inline-flex;align-items:center;padding:0 8px;border:1px solid var(--line);border-radius:6px;font-size:12px;color:var(--ink-2);background:#FAFBFA}\n.evgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px 24px}\n.eg .k{font-size:11.5px;color:var(--ink-3)}\n.eg .v{font-size:13.5px;margin-top:2px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.desc{font-size:13px;color:var(--ink-2);line-height:1.55;max-width:640px}\n.desc .k{font-size:11.5px;color:var(--ink-3);display:block;margin-bottom:4px}\n.ev-foot{height:64px;flex:0 0 64px;margin-top:auto;padding:0 20px;display:flex;align-items:center;justify-content:space-between;border-top:1px solid var(--line)}\n.ev-actions{display:flex;align-items:center;gap:8px}\n\n/* pills */\n.pill{display:inline-flex;align-items:center;gap:6px;height:24px;padding:0 9px;border-radius:999px;font-size:12px;font-weight:500;white-space:nowrap}\n.pill .dot{width:6px;height:6px;border-radius:999px;background:currentColor;flex:0 0 auto}\n.pill-pending{background:#FDF3E1;color:#8A5403}\n.pill-neutral{background:#F0F3F1;color:#54645C}\n\n@media (prefers-reduced-motion: reduce){*{transition:none !important;animation:none !important}}\n</style>\n<div class=\"app\" data-kid=\"1\" data-name=\"app layout container\">\n<aside class=\"sidebar\" data-kid=\"1-1\" data-name=\"sidebar navigation panel\">\n<div class=\"brand\" data-kid=\"1-1-1\" data-name=\"brand identity header\">\n<div class=\"brand-mark\" data-kid=\"1-1-1-1\" data-name=\"brand monogram mark\">ER</div>\n<div data-kid=\"1-1-1-2\" data-name=\"brand name wrapper\">\n<div class=\"brand-name\" data-kid=\"1-1-1-2-1\" data-name=\"brand name text\">Easy Ride</div>\n<div class=\"brand-sub\" data-kid=\"1-1-1-2-2\" data-name=\"brand subtitle text\">Administration</div>\n</div>\n</div>\n<nav class=\"nav\" data-kid=\"1-1-2\" data-name=\"main navigation sections\">\n<div class=\"nav-group\" data-kid=\"1-1-2-1\" data-name=\"Operations navigation group\">\n<div class=\"nav-label\" data-kid=\"1-1-2-1-1\" data-name=\"Operations group label\">Operations</div>\n<a class=\"nav-item\" data-kid=\"1-1-2-1-2\" data-name=\"Overview navigation link\" href=\"#\"><i class=\"icon-gauge\" data-kid=\"1-1-2-1-2-1\" data-name=\"gauge icon\"></i><span class=\"lbl\" data-kid=\"1-1-2-1-2-2\" data-name=\"Overview nav label\">Overview</span></a>\n<a class=\"nav-item\" data-kid=\"1-1-2-1-3\" data-name=\"Support navigation link\" href=\"#\"><i class=\"icon-headphones\" data-kid=\"1-1-2-1-3-1\" data-name=\"headphones icon\"></i><span class=\"lbl\" data-kid=\"1-1-2-1-3-2\" data-name=\"Support nav label\">Support</span><span class=\"nav-count tnum\" data-kid=\"1-1-2-1-3-3\" data-name=\"Support pending count badge\">7</span></a>\n</div>\n<div class=\"nav-group\" data-kid=\"1-1-2-2\" data-name=\"Marketplace navigation group\">\n<div class=\"nav-label\" data-kid=\"1-1-2-2-1\" data-name=\"Marketplace group label\">Marketplace</div>\n<a aria-current=\"page\" class=\"nav-item active\" data-kid=\"1-1-2-2-2\" data-name=\"Listings navigation link\" href=\"#\"><i class=\"icon-car\" data-kid=\"1-1-2-2-2-1\" data-name=\"car icon\"></i><span class=\"lbl\" data-kid=\"1-1-2-2-2-2\" data-name=\"Listings nav label\">Listings</span><span class=\"nav-count tnum\" data-kid=\"1-1-2-2-2-3\" data-name=\"Listings pending count badge\">23</span></a>\n<a class=\"nav-item\" data-kid=\"1-1-2-2-3\" data-name=\"Verification navigation link\" href=\"#\"><i class=\"icon-shield-check\" data-kid=\"1-1-2-2-3-1\" data-name=\"shield check icon\"></i><span class=\"lbl\" data-kid=\"1-1-2-2-3-2\" data-name=\"Verification nav label\">Verification</span><span class=\"nav-count tnum\" data-kid=\"1-1-2-2-3-3\" data-name=\"Verification pending count badge\">9</span></a>\n<a class=\"nav-item\" data-kid=\"1-1-2-2-4\" data-name=\"Reports navigation link\" href=\"#\"><i class=\"icon-flag\" data-kid=\"1-1-2-2-4-1\" data-name=\"flag icon\"></i><span class=\"lbl\" data-kid=\"1-1-2-2-4-2\" data-name=\"Reports nav label\">Reports</span><span class=\"nav-count tnum\" data-kid=\"1-1-2-2-4-3\" data-name=\"Reports pending count badge\">4</span></a>\n</div>\n<div class=\"nav-group\" data-kid=\"1-1-2-3\" data-name=\"Transactions navigation group\">\n<div class=\"nav-label\" data-kid=\"1-1-2-3-1\" data-name=\"Transactions group label\">Transactions</div>\n<a class=\"nav-item\" data-kid=\"1-1-2-3-2\" data-name=\"Bookings navigation link\" href=\"#\"><i class=\"icon-calendar-days\" data-kid=\"1-1-2-3-2-1\" data-name=\"calendar days icon\"></i><span class=\"lbl\" data-kid=\"1-1-2-3-2-2\" data-name=\"Bookings nav label\">Bookings</span><