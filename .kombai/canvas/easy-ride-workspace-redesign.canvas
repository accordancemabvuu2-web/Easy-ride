    "var_11fcb0f85639": {
      "type": "variant",
      "label": "03 · Warm operations — Admin",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 4620,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Alfa+Slab+One&family=Cabin:wght@400;500;600;700&family=Mulish:wght@400;500;600;700;800&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/boxicons@2.1.4/css/boxicons.min.css\");\n:root{--nav:#123A2A;--page:#F8F4EA;--surface:#FFFEFA;--inset:#EFE9DA;--ink:#243127;--muted:#5E675B;--border:#DAD5C6;--primary:#0C6346;--gold:#BE8A24;--success:#28764B;--warning:#946618;--error:#AB4439;--info:#3F7282;--neutral:#697068;--focus:#E3AD35}\nbody{margin:0;background:var(--page);color:var(--ink);font-family:'Cabin',sans-serif;min-height:100vh}\nbutton,a{font:inherit}a{color:inherit;text-decoration:none}button:focus-visible,a:focus-visible{outline:3px solid var(--focus);outline-offset:3px}\n.app{min-height:100vh}.sidebar{position:fixed;inset:0 auto 0 0;width:268px;background:var(--nav);color:var(--surface);padding:22px 16px 16px;display:flex;flex-direction:column;z-index:20;overflow-y:auto}.brand{display:flex;align-items:center;gap:12px;padding:3px 9px 22px;border-bottom:1px solid rgba(255,254,250,.14)}.brand-mark{width:40px;height:40px;display:grid;place-items:center;border:1px solid rgba(227,173,53,.72);border-radius:12px;color:var(--focus);font-family:'Alfa Slab One',serif;font-size:16px;letter-spacing:-.06em}.brand-title{font-family:'Mulish',sans-serif;font-weight:800;font-size:17px;letter-spacing:-.03em}.brand-sub{display:block;margin-top:3px;font-size:12px;color:rgba(255,254,250,.62)}.workspace{margin:17px 2px 17px;padding:12px;border:1px solid rgba(255,254,250,.16);border-radius:10px;background:rgba(255,254,250,.055)}.workspace-label{font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,254,250,.62)}.workspace-name{display:flex;align-items:center;gap:9px;margin-top:7px;font-family:'Mulish',sans-serif;font-weight:800;font-size:14px}.workspace-name i{font-size:17px;color:var(--focus)}.nav{display:flex;flex:1;flex-direction:column;gap:4px}.nav-group{margin:8px 0 2px}.nav-group-label{padding:0 12px 6px;color:rgba(255,254,250,.52);font-size:11px;font-weight:700;letter-spacing:.09em;text-transform:uppercase}.nav-link{display:flex;align-items:center;gap:11px;min-height:42px;padding:0 12px;border-radius:8px;color:rgba(255,254,250,.77);font-size:14px;font-weight:600;transition:background-color .16s ease,color .16s ease}.nav-link i{width:18px;font-size:19px;line-height:1;color:rgba(255,254,250,.74)}.nav-link:hover{background:rgba(255,254,250,.08);color:var(--surface)}.nav-link.active{background:rgba(255,254,250,.12);color:var(--surface)}.nav-link.active i{color:var(--focus)}.nav-link.active .nav-dot{width:6px;height:6px;margin-left:auto;border-radius:99px;background:var(--gold)}.sidebar-footer{border-top:1px solid rgba(255,254,250,.14);padding-top:14px;margin-top:10px}.admin-profile{display:flex;align-items:center;gap:10px;padding:8px 8px 11px}.profile-mark{width:34px;height:34px;border-radius:50%;background:var(--inset);color:var(--nav);display:grid;place-items:center;font-family:'Mulish',sans-serif;font-weight:800;font-size:12px}.profile-name{font-weight:700;font-size:13px}.profile-role{font-size:12px;color:rgba(255,254,250,.58);margin-top:2px}.logout{display:flex;align-items:center;gap:11px;min-height:42px;padding:0 11px;color:rgba(255,254,250,.76);font-size:13px;font-weight:600}.logout i{font-size:18px}.main{margin-left:268px;min-height:100vh;padding:25px 42px 34px}.topbar{height:48px;display:flex;align-items:center;justify-content:space-between;margin-bottom:28px}.crumbs{display:flex;align-items:center;gap:9px;color:var(--muted);font-size:13px}.crumbs span:first-child{color:var(--ink);font-weight:700}.crumbs i{font-size:16px;color:var(--neutral)}.top-right{display:flex;align-items:center;gap:12px}.workspace-chip{display:flex;align-items:center;gap:8px;height:38px;padding:0 12px;border:1px solid var(--border);border-radius:8px;background:var(--surface);font-family:'Mulish',sans-serif;font-size:12px;font-weight:700}.workspace-chip i{font-size:17px;color:var(--primary)}.avatar{width:36px;height:36px;display:grid;place-items:center;border-radius:50%;background:#E6E9DF;color:var(--nav);font-family:'Mulish',sans-serif;font-weight:800;font-size:12px}.intro{display:flex;justify-content:space-between;align-items:flex-end;gap:26px;padding-bottom:23px;border-bottom:1px solid var(--border)}.intro-copy{max-width:740px}.kicker{display:flex;align-items:center;gap:8px;color:var(--primary);font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase}.kicker .mark{width:7px;height:7px;border-radius:50%;background:var(--gold)}h1,h2,h3,p{margin:0}h1{margin-top:8px;font-family:'Mulish',sans-serif;font-size:32px;line-height:1.15;letter-spacing:-.045em;font-weight:800;color:var(--ink)}.intro-copy p{margin-top:9px;color:var(--muted);font-size:15px;line-height:1.55}.header-action{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:46px;padding:0 17px;border-radius:8px;background:var(--primary);color:#fff;font-size:14px;font-weight:700;white-space:nowrap;transition:background-color .16s ease}.header-action:hover{background:var(--nav)}.header-action i{font-size:19px}.content-grid{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(280px,.9fr);gap:22px;margin-top:24px;align-items:start}.queue{background:var(--surface);border:1px solid var(--border);border-radius:12px;overflow:hidden}.section-head{display:flex;justify-content:space-between;align-items:flex-start;gap:14px;padding:20px 22px 17px;border-bottom:1px solid var(--border)}.section-head h2,.section-title{font-family:'Mulish',sans-serif;font-size:18px;line-height:1.25;font-weight:800;letter-spacing:-.02em}.section-head p{margin-top:5px;color:var(--muted);font-size:13px;line-height:1.45}.text-link{display:inline-flex;align-items:center;gap:5px;color:var(--primary);font-size:13px;font-weight:700;white-space:nowrap}.text-link i{font-size:17px}.table-head{display:grid;grid-template-columns:minmax(0,1fr) 132px 144px;gap:14px;padding:11px 22px;background:var(--inset);color:var(--muted);font-size:11px;font-weight:700;letter-spacing:.07em;text-transform:uppercase}.empty-state{min-height:208px;display:flex;align-items:center;justify-content:center;text-align:center;padding:30px 24px}.empty-inner{max-width:370px}.empty-icon{width:46px;height:46px;display:grid;place-items:center;margin:0 auto 14px;border-radius:12px;background:#E8EFE6;color:var(--primary)}.empty-icon i{font-size:23px}.empty-state h3{font-family:'Mulish',sans-serif;font-size:16px;font-weight:800}.empty-state p{margin-top:6px;color:var(--muted);font-size:14px;line-height:1.5}.empty-state a{display:inline-flex;align-items:center;gap:7px;margin-top:14px;color:var(--primary);font-size:13px;font-weight:700}.empty-state a i{font-size:17px}.side-panel{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:20px 20px 6px}.side-panel h2{font-family:'Mulish',sans-serif;font-size:17px;font-weight:800;letter-spacing:-.02em}.side-panel-intro{margin-top:5px;color:var(--muted);font-size:13px;line-height:1.45}.queue-link{display:flex;align-items:center;gap:12px;min-height:65px;border-bottom:1px solid var(--border)}.queue-link:last-child{border-bottom:0}.queue-icon{width:34px;height:34px;flex:0 0 auto;display:grid;place-items:center;border-radius:9px;background:var(--inset);color:var(--primary)}.queue-icon i{font-size:18px}.queue-copy{min-width:0;flex:1}.queue-copy strong{display:block;font-family:'Mulish',sans-serif;font-size:13px;font-weight:800}.queue-copy span{display:block;margin-top:3px;color:var(--muted);font-size:12px;line-height:1.35}.chevron{font-size:18px;color:var(--neutral)}.bottom-grid{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(280px,.9fr);gap:22px;margin-top:22px;align-items:start}.activity{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:20px 22px}.activity-head{display:flex;align-items:center;justify-content:space-between;gap:12px}.activity-head h2{font-family:'Mulish',sans-serif;font-size:17px;font-weight:800}.activity-empty{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:16px 0 4px;color:var(--muted);font-size:13px}.activity-empty .text-link{font-size:12px}.quick-note{border-left:3px solid var(--gold);padding:3px 0 3px 14px;color:var(--muted);font-size:13px;line-height:1.55}.quick-note strong{display:block;margin-bottom:4px;color:var(--ink);font-family:'Mulish',sans-serif;font-size:13px}.menu-button,.scrim{display:none}\n@media(max-width:1100px){.main{padding:24px 28px}.content-grid,.bottom-grid{grid-template-columns:minmax(0,1fr) minmax(250px,.82fr);gap:16px}.sidebar{width:250px}.main{margin-left:250px}}\n@media(max-width:760px){.sidebar{width:min(320px,calc(100vw - 48px));transform:translateX(-105%);transition:transform .22s ease;box-shadow:0 15px 44px rgba(15,31,23,.25)}body.drawer-open .sidebar{transform:translateX(0)}.scrim{position:fixed;inset:0;z-index:19;display:block;background:rgba(17,31,23,.38);opacity:0;visibility:hidden;transition:opacity .2s ease,visibility .2s ease}body.drawer-open .scrim{opacity:1;visibility:visible}.main{margin-left:0;padding:16px 18px 28px}.menu-button{display:grid;place-items:center;width:44px;height:44px;border:1px solid var(--border);border-radius:9px;background:var(--surface);color:var(--nav)}.topbar{height:44px;gap:12px;margin-bottom:22px}.crumbs{flex:1}.workspace-chip{display:none}.intro{align-items:flex-start;flex-direction:column;padding-bottom:19px}.intro-copy p{max-width:560px}.header-action{width:100%}.content-grid,.bottom-grid{grid-template-columns:1fr;gap:14px;margin-top:16px}.section-head{padding:17px 16px 14px}.table-head{grid-template-columns:minmax(0,1fr) 105px;padding:10px 16px}.table-head span:last-child{display:none}.empty-state{min-height:190px;padding:24px 16px}.side-panel{padding:17px 16px 4px}.activity{padding:17px 16px}.activity-empty{align-items:flex-start;flex-direction:column}.nav-link{min-height:46px}.logout{min-height:46px}}\n@media(max-width:420px){h1{font-size:28px}.main{padding-left:14px;padding-right:14px}.table-head{grid-template-columns:minmax(0,1fr) 92px;font-size:10px}.section-head{align-items:flex-start;flex-direction:column}.section-head .text-link{min-height:40px}.intro-copy p{font-size:14px}}\n</style>\n<div class=\"app\" data-kid=\"1\" data-name=\"admin dashboard layout container\">\n    <button aria-label=\"Close admin navigation\" class=\"scrim\" data-kid=\"1-1\" data-name=\"mobile navigation scrim overlay\" onclick=\"document.body.classList.remove('drawer-open')\">\n    </button>\n    <aside aria-label=\"Admin workspace navigation\" class=\"sidebar\" data-kid=\"1-2\" data-name=\"admin sidebar navigation\">\n        <a aria-label=\"Easy Ride admin overview\" class=\"brand\" data-kid=\"1-2-1\" data-name=\"brand home link to admin overview\" href=\"/admin\">\n            <span class=\"brand-mark\" data-kid=\"1-2-1-1\" data-name=\"brand monogram mark\">\n                ER\n            </span>\n            <span data-kid=\"1-2-1-2\" data-name=\"brand text block\">\n                <span class=\"brand-title\" data-kid=\"1-2-1-2-1\" data-name=\"brand name text\">\n                    Easy Ride\n                </span>\n                <span class=\"brand-sub\" data-kid=\"1-2-1-2-2\" data-name=\"brand tagline text\">\n                    Marketplace operations\n                </span>\n            </span>\n        </a>\n        <div class=\"workspace\" data-kid=\"1-2-2\" data-name=\"workspace badge container\">\n            <div class=\"workspace-label\" data-kid=\"1-2-2-1\" data-name=\"workspace label caption\">\n                Current workspace\n            </div>\n            <div class=\"workspace-name\" data-kid=\"1-2-2-2\" data-name=\"current workspace name row\">\n                <i class=\"bx bx-shield-quarter\" data-kid=\"1-2-2-2-1\" data-name=\"shield workspace icon\">\n                </i>\n                <span data-kid=\"1-2-2-2-2\" data-name=\"workspace name text\">\n                    Administration\n                </span>\n            </div>\n        </div>\n        <nav aria-label=\"Primary navigation\" class=\"nav\" data-kid=\"1-2-3\" data-name=\"primary admin navigation\">\n            <a aria-current=\"page\" class=\"nav-link active\" data-kid=\"1-2-3-1\" data-name=\"overview nav link (active)\" href=\"/admin\">\n                <i class=\"bx bx-grid-alt\" data-kid=\"1-2-3-1-1\" data-name=\"overview grid icon\">\n                </i>\n                <span data-kid=\"1-2-3-1-2\" data-name=\"nav link label text\">\n                    Overview\n                </span>\n                <span aria-hidden=\"true\" class=\"nav-dot\" data-kid=\"1-2-3-1-3\" data-name=\"active state indicator dot\">\n                </span>\n            </a>\n            <div class=\"nav-group\" data-kid=\"1-2-3-2\" data-name=\"review navigation group\">\n                <div class=\"nav-group-label\" data-kid=\"1-2-3-2-1\" data-name=\"nav group label - Review\">\n                    Review\n                </div>\n                <a class=\"nav-link\" data-kid=\"1-2-3-2-2\" data-name=\"nav link to Listings\" href=\"/admin/listings\">\n                    <i class=\"bx bx-car\" data-kid=\"1-2-3-2-2-1\" data-name=\"car icon for Listings\">\n                    </i>\n                    <span data-kid=\"1-2-3-2-2-2\" data-name=\"nav link label text\">\n                        Listings\n                    </span>\n                </a>\n                <a class=\"nav-link\" data-kid=\"1-2-3-2-3\" data-name=\"nav link to Reports\" href=\"/admin/reports\">\n                    <i class=\"bx bx-flag\" data-kid=\"1-2-3-2-3-1\" data-name=\"flag icon for Reports\">\n                    </i>\n                    <span data-kid=\"1-2-3-2-3-2\" data-name=\"nav link label text\">\n                        Reports\n                    </span>\n                </a>\n                <a class=\"nav-link\" data-kid=\"1-2-3-2-4\" data-name=\"nav link to Verification\" href=\"/admin/verification\">\n                    <i class=\"bx bx-badge-check\" data-kid=\"1-2-3-2-4-1\" data-name=\"verified badge icon for Verification\">\n                    </i>\n                    <span data-kid=\"1-2-3-2-4-2\" data-name=\"nav link label text\">\n                        Verification\n                    </span>\n                </a>\n                <a class=\"nav-link\" data-kid=\"1-2-3-2-5\" data-name=\"nav link to Disputes\" href=\"/admin/disputes\">\n                    <i class=\"bx bx-error-circle\" data-kid=\"1-2-3-2-5-1\" data-name=\"error circle icon for Disputes\">\n                    </i>\n                    <span data-kid=\"1-2-3-2-5-2\" data-name=\"nav link label text\">\n                        Disputes\n                    </span>\n                </a>\n            </div>\n            <div class=\"nav-group\" data-kid=\"1-2-3-3\" data-name=\"transactions navigation group\">\n                <div class=\"nav-group-label\" data-kid=\"1-2-3-3-1\" data-name=\"nav group label - Transactions\">\n                    Transactions\n                </div>\n                <a class=\"nav-link\" data-kid=\"1-2-3-3-2\" data-name=\"nav link to Bookings\" href=\"/admin/bookings\">\n                    <i class=\"bx bx-calendar-check\" data-kid=\"1-2-3-3-2-1\" data-name=\"calendar check icon for Bookings\">\n                    </i>\n                    <span data-kid=\"1-2-3-3-2-2\" data-name=\"nav link label text\">\n                        Bookings\n                    </span>\n                </a>\n                <a class=\"nav-link\" data-kid=\"1-2-3-3-3\" data-name=\"nav link to Offers\" href=\"/admin/offers\">\n                    <i class=\"bx bx-purchase-tag-alt\" data-kid=\"1-2-3-3-3-1\" data-name=\"purchase tag icon for Offers\">\n                    </i>\n                    <span data-kid=\"1-2-3-3-3-2\" data-name=\"nav link label text\">\n                        Offers\n                    </span>\n                </a>\n                <a class=\"nav-link\" data-kid=\"1-2-3-3-4\" data-name=\"nav link to Payments\" href=\"/admin/payments\">\n                    <i class=\"bx bx-credit-card\" data-kid=\"1-2-3-3-4-1\" data-name=\"credit card icon for Payments\">\n                    </i>\n                    <span data-kid=\"1-2-3-3-4-2\" data-name=\"nav link label text\">\n                        Payments\n                    </span>\n                </a>\n            </div>\n            <div class=\"nav-group\" data-kid=\"1-2-3-4\" data-name=\"people and help navigation group\">\n                <div class=\"nav-group-label\" data-kid=\"1-2-3-4-1\" data-name=\"nav group label - People & help\">\n                    People & help\n                </div>\n                <a class=\"nav-link\" data-kid=\"1-2-3-4-2\" data-name=\"nav link to Users\" href=\"/admin/users\">\n                    <i class=\"bx bx-user\" data-kid=\"1-2-3-4-2-1\" data-name=\"user icon for Users\">\n                    </i>\n                    <span data-kid=\"1-2-3-4-2-2\" data-name=\"nav link label text\">\n                        Users\n                    </span>\n                </a>\n                <a class=\"nav-link\" data-kid=\"1-2-3-4-3\" data-name=\"nav link to Support\" href=\"/admin/support\">\n                    <i class=\"bx bx-conversation\" data-kid=\"1-2-3-4-3-1\" data-name=\"conversation icon for Support\">\n                    </i>\n                    <span data-kid=\"1-2-3-4-3-2\" data-name=\"nav link label text\">\n                        Support\n                    </span>\n                </a>\n            </div>\n            <div class=\"nav-group\" data-kid=\"1-2-3-5\" data-name=\"records navigation group\">\n                <div class=\"nav-group-label\" data-kid=\"1-2-3-5-1\" data-name=\"nav group label - Records\">\n                    Records\n                </div>\n                <a class=\"nav-link\" data-kid=\"1-2-3-5-2\" data-name=\"nav link to Audit logs\" href=\"/admin/audit-logs\">\n                    <i class=\"bx bx-history\" data-kid=\"1-2-3-5-2-1\" data-name=\"history icon for Audit logs\">\n                    </i>\n                    <span data-kid=\"1-2-3-5-2-2\" data-name=\"nav link label text\">\n                        Audit logs\n                    </span>\n                </a>\n            </div>\n        </nav>\n        <div class=\"sidebar-footer\" data-kid=\"1-2-4\" data-name=\"sidebar footer with profile and logout\">\n            <div class=\"admin-profile\" data-kid=\"1-2-4-1\" data-name=\"admin profile block\">\n                <span class=\"profile-mark\" data-kid=\"1-2-4-1-1\" data-name=\"admin profile avatar monogram\">\n                    ER\n                </span>\n                <span data-kid=\"1-2-4-1-2\" data-name=\"profile text block\">\n                    <span class=\"profile-name\" data-kid=\"1-2-4-1-2-1\" data-name=\"profile display name text\">\n                        Administrator\n                    </span>\n                    <span class=\"profile-role\" data-kid=\"1-2-4-1-2-2\" data-name=\"profile role text\">\n                        Easy Ride\n                    </span>\n                </span>\n            </div>\n            <button class=\"logout\" data-kid=\"1-2-4-2\" data-name=\"log out button\" type=\"button\">\n                <i class=\"bx bx-log-out\" data-kid=\"1-2-4-2-1\" data-name=\"logout door icon\">\n                </i>\n                <span data-kid=\"1-2-4-2-2\" data-name=\"logout button label text\">\n                    Log out\n                </span>\n            </button>\n        </div>\n    </aside>\n    <main class=\"main\" data-kid=\"1-3\" data-name=\"admin main content area\">\n        <div class=\"topbar\" data-kid=\"1-3-1\" data-name=\"top navigation bar\">\n            <button aria-controls=\"admin-nav\" aria-expanded=\"false\" aria-label=\"Open admin navigation\" class=\"menu-button\" data-kid=\"1-3-1-1\" data-name=\"mobile menu open button\" onclick=\"document.body.classList.toggle('drawer-open');this.setAttribute('aria-expanded',document.body.classList.contains('drawer-open'))\" type=\"button\">\n                <i class=\"bx bx-menu\" data-kid=\"1-3-1-1-1\" data-name=\"menu hamburger icon\" style=\"font-size:21px\">\n                </i>\n            </button>\n            <div class=\"crumbs\" data-kid=\"1-3-1-2\" data-name=\"breadcrumb trail\">\n                <span data-kid=\"1-3-1-2-1\" data-name=\"breadcrumb item - Workspace root\">\n                    Workspace\n                </span>\n                <i class=\"bx bx-chevron-right\" data-kid=\"1-3-1-2-2\" data-name=\"breadcrumb chevron separator icon\">\n                </i>\n                <span data-kid=\"1-3-1-2-3\" data-name=\"breadcrumb item - current page\">\n                    Overview\n                </span>\n            </div>\n            <div class=\"top-right\" data-kid=\"1-3-1-3\" data-name=\"top bar right cluster (user controls)\">\n                <span class=\"workspace-chip\" data-kid=\"1-3-1-3-1\" data-name=\"workspace role chip\">\n                    <i class=\"bx bx-shield-quarter\" data-kid=\"1-3-1-3-1-1\" data-name=\"chip shield icon\">\n                    </i>\n                    Administrator\n                </span>\n                <span class=\"avatar\" data-kid=\"1-3-1-3-2\" data-name=\"user avatar monogram\">\n                    ER\n                </span>\n            </div>\n        </div>\n        <header class=\"intro\" data-kid=\"1-3-2\" data-name=\"page header with intro and primary action\">\n            <div class=\"intro-copy\" data-kid=\"1-3-2-1\" data-name=\"page intro text block\">\n                <div class=\"kicker\" data-kid=\"1-3-2-1-1\" data-name=\"kicker row with marker\">\n                    <span class=\"mark\" data-kid=\"1-3-2-1-1-1\" data-name=\"kicker decorative dot mark\">\n                    </span>\n                    <span data-kid=\"1-3-2-1-1-2\" data-name=\"kicker section label text\">\n                        Marketplace operations\n                    </span>\n                </div>\n                <h1 data-kid=\"1-3-2-1-2\" data-name=\"page main headline (H1)\">\n                    Operations overview\n                </h1>\n                <p data-kid=\"1-3-2-1-3\" data-name=\"page intro description paragraph\">\n                    Review marketplace activity, resolve reported issues, and keep account decisions in one place.\n                </p>\n            </div>\n            <a class=\"header-action\" data-kid=\"1-3-2-2\" data-name=\"primary call-to-action button - Review listings\" href=\"/admin/listings\">\n                <i class=\"bx bx-list-check\" data-kid=\"1-3-2-2-1\" data-name=\"checklist CTA icon\">\n                </i>\n                <span data-kid=\"1-3-2-2-2\" data-name=\"CTA button label text\">\n                    Review listings\n                </span>\n            </a>\n        </header>\n        <div class=\"content-grid\" data-kid=\"1-3-3\" data-name=\"two-column content grid (queue + side panel)\">\n            <section aria-labelledby=\"review-heading\" class=\"queue\" data-kid=\"1-3-3-1\" data-name=\"pending listings review queue card\">\n                <div class=\"section-head\" data-kid=\"1-3-3-1-1\" data-name=\"section header with title and link\">\n                    <div data-kid=\"1-3-3-1-1-1\" data-name=\"section title and description block\">\n                        <h2 data-kid=\"1-3-3-1-1-1-1\" data-name=\"section title (H2) - pending listings\" id=\"review-heading\">\n                            Cars waiting for approval\n                        </h2>\n                        <p data-kid=\"1-3-3-1-1-1-2\" data-name=\"section description text\">\n                            Listings submitted for marketplace review.\n                        </p>\n                    </div>\n                    <a class=\"text-link\" data-kid=\"1-3-3-1-1-2\" data-name=\"open listings text link\" href=\"/admin/listings\">\n                        Open listings\n                        <i class=\"bx bx-right-arrow-alt\" data-kid=\"1-3-3-1-1-2-1\" data-name=\"text link arrow icon\">\n                        </i>\n                    </a>\n                </div>\n                <div class=\"table-head\" data-kid=\"1-3-3-1-2\" data-name=\"table column header row\">\n                    <span data-kid=\"1-3-3-1-2-1\" data-name=\"column header - Listing\">\n                        Listing\n                    </span>\n                    <span data-kid=\"1-3-3-1-2-2\" data-name=\"column header - Owner\">\n                        Owner\n                    </span>\n                    <span data-kid=\"1-3-3-1-2-3\" data-name=\"column header - Review\">\n                        Review\n                    </span>\n                </div>\n                <div class=\"empty-state\" data-kid=\"1-3-3-1-3\" data-name=\"empty listing review state\">\n                    <div class=\"empty-inner\" data-kid=\"1-3-3-1-3-1\" data-name=\"empty state inner content\">\n                        <span class=\"empty-icon\" data-kid=\"1-3-3-1-3-1-1\" data-name=\"empty state icon container\">\n                            <i class=\"bx bx-check-circle\" data-kid=\"1-3-3-1-3-1-1-1\" data-name=\"empty state check circle icon\">\n                            </i>\n                        </span>\n                        <h3 data-kid=\"1-3-3-1-3-1-2\" data-name=\"empty state headline text\">\n                            No cars pending approval\n                        </h3>\n                        <p data-kid=\"1-3-3-1-3-1-3\" data-name=\"empty state description text\">\n                            New listings awaiting review will appear here.\n                        </p>\n                        <a data-kid=\"1-3-3-1-3-1-4\" data-name=\"empty state call-to-action link to listings\" href=\"/admin/listings\">\n                            Go to listings\n                            <i class=\"bx bx-right-arrow-alt\" data-kid=\"1-3-3-1-3-1-4-1\" data-name=\"link arrow icon\">\n                            </i>\n                        </a>\n                    </div>\n                </div>\n            </section>\n            <aside aria-labelledby=\"other-queues\" class=\"side-panel\" data-kid=\"1-3-3-2\" data-name=\"other review queues side panel\">\n                <h2 data-kid=\"1-3-3-2-1\" data-name=\"side panel title (H2) - other queues\" id=\"other-queues\">\n                    Other review queues\n                </h2>\n                <p class=\"side-panel-intro\" data-kid=\"1-3-3-2-2\" data-name=\"side panel description text\">\n                    Open a queue to review its records.\n                </p>\n                <a class=\"queue-link\" data-kid=\"1-3-3-2-3\" data-name=\"queue link to Reports\" href=\"/admin/reports\">\n                    <span class=\"queue-icon\" data-kid=\"1-3-3-2-3-1\" data-name=\"queue icon badge container\">\n                        <i class=\"bx bx-flag\" data-kid=\"1-3-3-2-3-1-1\" data-name=\"queue flag icon\">\n                        </i>\n                    </span>\n                    <span class=\"queue-copy\" data-kid=\"1-3-3-2-3-2\" data-name=\"queue copy block\">\n                        <strong data-kid=\"1-3-3-2-3-2-1\" data-name=\"queue label text - Reports\">\n                            Reports\n                        </strong>\n                        <span data-kid=\"1-3-3-2-3-2-2\" data-name=\"queue description text\">\n                            Review reported listings\n                        </span>\n                    </span>\n                    <i class=\"bx bx-chevron-right chevron\" data-kid=\"1-3-3-2-3-3\" data-name=\"chevron right icon for queue link\">\n                    </i>\n                </a>\n                <a class=\"queue-link\" data-kid=\"1-3-3-2-4\" data-name=\"queue link to Verification\" href=\"/admin/verification\">\n                    <span class=\"queue-icon\" data-kid=\"1-3-3-2-4-1\" data-name=\"queue icon badge container\">\n                        <i class=\"bx bx-badge-check\" data-kid=\"1-3-3-2-4-1-1\" data-name=\"queue verification badge icon\">\n                        </i>\n                    </span>\n                    <span class=\"queue-copy\" data-kid=\"1-3-3-2-4-2\" data-name=\"queue copy block\">\n                        <strong data-kid=\"1-3-3-2-4-2-1\" data-name=\"queue label text - Verification\">\n                            Verification\n                        </strong>\n                        <span data-kid=\"1-3-3-2-4-2-2\" data-name=\"queue description text\">\n                            Review account requests\n                        </span>\n                    </span>\n                    <i class=\"bx bx-chevron-right chevron\" data-kid=\"1-3-3-2-4-3\" data-name=\"chevron right icon for queue link\">\n                    </i>\n                </a>\n                <a class=\"queue-link\" data-kid=\"1-3-3-2-5\" data-name=\"queue link to Support\" href=\"/admin/support\">\n                    <span class=\"queue-icon\" data-kid=\"1-3-3-2-5-1\" data-name=\"queue icon badge container\">\n                        <i class=\"bx bx-conversation\" data-kid=\"1-3-3-2-5-1-1\" data-name=\"queue conversation icon\">\n                        </i>\n                    </span>\n                    <span class=\"queue-copy\" data-kid=\"1-3-3-2-5-2\" data-name=\"queue copy block\">\n                        <strong data-kid=\"1-3-3-2-5-2-1\" data-name=\"queue label text - Support\">\n                            Support\n                        </strong>\n                        <span data-kid=\"1-3-3-2-5-2-2\" data-name=\"queue description text\">\n                            Open the support inbox\n                        </span>\n                    </span>\n                    <i class=\"bx bx-chevron-right chevron\" data-kid=\"1-3-3-2-5-3\" data-name=\"chevron right icon for queue link\">\n                    </i>\n                </a>\n                <a class=\"queue-link\" data-kid=\"1-3-3-2-6\" data-name=\"queue link to Disputes\" href=\"/admin/disputes\">\n                    <span class=\"queue-icon\" data-kid=\"1-3-3-2-6-1\" data-name=\"queue icon badge container\">\n                        <i class=\"bx bx-error-circle\" data-kid=\"1-3-3-2-6-1-1\" data-name=\"queue error circle icon\">\n                        </i>\n                    </span>\n                    <span class=\"queue-copy\" data-kid=\"1-3-3-2-6-2\" data-name=\"queue copy block\">\n                        <strong data-kid=\"1-3-3-2-6-2-1\" data-name=\"queue label text - Disputes\">\n                            Disputes\n                        </strong>\n                        <span data-kid=\"1-3-3-2-6-2-2\" data-name=\"queue description text\">\n                            Review booking disputes\n                        </span>\n                    </span>\n                    <i class=\"bx bx-chevron-right chevron\" data-kid=\"1-3-3-2-6-3\" data-name=\"chevron right icon for queue link\">\n                    </i>\n                </a>\n            </aside>\n        </div>\n        <div class=\"bottom-grid\" data-kid=\"1-3-4\" data-name=\"bottom two-column grid (activity + note)\">\n            <section class=\"activity\" data-kid=\"1-3-4-1\" data-name=\"recent activity card\">\n                <div class=\"activity-head\" data-kid=\"1-3-4-1-1\" data-name=\"activity header with title and link\">\n                    <h2 data-kid=\"1-3-4-1-1-1\" data-name=\"activity card title (H2)\">\n                        Recent activity\n                    </h2>\n                    <a class=\"text-link\" data-kid=\"1-3-4-1-1-2\" data-name=\"open audit logs text link\" href=\"/admin/audit-logs\">\n                        Open audit logs\n                        <i class=\"bx bx-right-arrow-alt\" data-kid=\"1-3-4-1-1-2-1\" data-name=\"text link arrow icon\">\n                        </i>\n                    </a>\n                </div>\n                <div class=\"activity-empty\" data-kid=\"1-3-4-1-2\" data-name=\"activity empty state row\">\n                    <span data-kid=\"1-3-4-1-2-1\" data-name=\"activity empty status text\">\n                        No recent activity yet.\n                    </span>\n                    <span data-kid=\"1-3-4-1-2-2\" data-name=\"activity empty hint text\">\n                        Recorded admin events will appear here.\n                    </span>\n                </div>\n            </section>\n            <aside class=\"quick-note\" data-kid=\"1-3-4-2\" data-name=\"informational quick note callout\">\n                <strong data-kid=\"1-3-4-2-1\" data-name=\"quick note title text\">\n                    Review records with context\n                </strong>\n                Each queue opens its dedicated review page, where the full record and available actions are shown.\n            </aside>\n        </div>\n    </main>\n</div>\n<script>\n    const adminMenuButton=document.querySelector('.menu-button');\nconst adminScrim=document.querySelector('.scrim');\nadminScrim.addEventListener('click',()=>{document.body.classList.remove('drawer-open');adminMenuButton.setAttribute('aria-expanded','false')});\ndocument.addEventListener('keydown',event=>{if(event.key==='Escape'&&document.body.classList.contains('drawer-open')){document.body.classList.remove('drawer-open');adminMenuButton.setAttribute('aria-expanded','false');adminMenuButton.focus()}});\n</script>\n",
      "comments": [],
      "created": "2026-10-16T12:28:19.760526+00:00",
      "modified": "2026-10-16T12:29:28.611560+00:00",
      "id": "var_11fcb0f85639",
      "contentHeight": 1000
    },
    "var_5187b9e02619": {
      "type": "variant",
      "label": "01 · Road-ready — Dealer",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 6160,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Red+Hat+Text:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n:root{--nav:#063F2F;--page:#F4F7F3;--surface:#FFFFFF;--inset:#EAF0E9;--ink:#17251E;--muted:#52665B;--border:#CEDBD0;--primary:#0B5D3B;--gold:#C9A227;--success:#24764C;--warning:#9A6814;--error:#AC3F35;--info:#356F8A;--neutral:#66716C;--focus:#E3B72F}\nbody{font-family:'Red Hat Text',sans-serif;color:var(--ink);background:var(--page);}\n.shell{min-height:100vh;background:var(--page);}\n.sidebar{position:fixed;inset:0 auto 0 0;width:264px;background:var(--nav);color:var(--surface);display:flex;flex-direction:column;padding:24px 18px 18px;z-index:30;}\n.brand{display:flex;align-items:center;gap:12px;padding:4px 9px 24px;border-bottom:1px solid rgba(255,255,255,.14);}\n.brand-mark{display:grid;place-items:center;width:42px;height:42px;border-radius:10px;background:var(--gold);color:var(--nav);font-family:'Bebas Neue',sans-serif;font-size:21px;letter-spacing:.03em;}\n.brand-name{font-size:16px;line-height:1.1;font-weight:700;letter-spacing:.015em;}\n.brand-sub{margin-top:4px;color:rgba(255,255,255,.63);font-size:13px;}\n.workspace-label{padding:22px 10px 7px;color:rgba(255,255,255,.56);font-size:12px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;}\n.nav-list{display:grid;gap:3px;}\n.nav-link{display:flex;align-items:center;gap:13px;min-height:46px;padding:0 12px;border-radius:8px;color:rgba(255,255,255,.78);text-decoration:none;font-size:14px;font-weight:600;}\n.nav-link i{width:19px;font-size:18px;color:rgba(255,255,255,.74);}\n.nav-link:hover{background:rgba(255,255,255,.08);color:var(--surface);}\n.nav-link[aria-current='page']{position:relative;background:rgba(255,255,255,.10);color:var(--surface);}\n.nav-link[aria-current='page']::before{content:'';position:absolute;left:-18px;top:11px;height:24px;width:3px;background:var(--gold);}\n.nav-link[aria-current='page'] i{color:var(--gold);}\n.sidebar-spacer{flex:1;}\n.add-vehicle{display:flex;align-items:center;justify-content:center;gap:9px;min-height:48px;margin:0 2px 16px;border-radius:8px;background:var(--gold);color:var(--nav);font-size:14px;font-weight:700;text-decoration:none;}\n.add-vehicle:hover{background:#D9B447;}\n.account-links{padding:12px 0;border-top:1px solid rgba(255,255,255,.14);border-bottom:1px solid rgba(255,255,255,.14);}\n.account-links .nav-link{min-height:42px;font-size:13px;}\n.profile-link{display:flex;align-items:center;gap:11px;padding:17px 7px 0;color:var(--surface);text-decoration:none;}\n.profile-mark{display:grid;place-items:center;width:34px;height:34px;border-radius:50%;border:1px solid rgba(255,255,255,.3);color:var(--gold);font-size:15px;}\n.profile-copy{min-width:0;}\n.profile-title{font-size:13px;font-weight:700;}\n.profile-sub{margin-top:2px;font-size:12px;color:rgba(255,255,255,.6);}\n.main{min-height:100vh;margin-left:264px;padding:0 42px 48px;}\n.topbar{height:72px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--border);}\n.breadcrumb{display:flex;align-items:center;gap:10px;font-size:13px;color:var(--muted);}\n.breadcrumb strong{color:var(--ink);font-weight:700;}\n.top-actions{display:flex;align-items:center;gap:16px;}\n.top-action{display:grid;place-items:center;width:42px;height:42px;border:1px solid var(--border);border-radius:8px;color:var(--ink);text-decoration:none;background:var(--surface);}\n.top-action i{font-size:18px;}\n.account-chip{display:flex;align-items:center;gap:10px;padding:4px 10px 4px 4px;border:1px solid var(--border);border-radius:8px;background:var(--surface);color:var(--ink);text-decoration:none;min-height:44px;}\n.account-avatar{display:grid;place-items:center;width:34px;height:34px;background:var(--inset);border-radius:6px;color:var(--nav);font-family:'Bebas Neue',sans-serif;font-size:18px;}\n.account-role{font-size:13px;font-weight:700;}\n.account-chevron{font-size:14px;color:var(--muted);margin-left:4px;}\n.page-intro{padding:34px 0 23px;display:flex;align-items:end;justify-content:space-between;gap:24px;}\n.page-title{font-family:'Bebas Neue',sans-serif;font-weight:400;font-size:42px;line-height:1;letter-spacing:.015em;color:var(--ink);margin:0;}\n.page-description{margin:9px 0 0;color:var(--muted);font-size:15px;line-height:1.5;}\n.intro-action{display:none;}\n.content-grid{display:grid;grid-template-columns:minmax(0,1.62fr) minmax(300px,.78fr);align-items:start;gap:22px;}\n.work-panel{min-height:440px;padding:25px 26px 28px;background:var(--surface);border:1px solid var(--border);border-radius:12px;}\n.panel-heading{display:flex;align-items:center;justify-content:space-between;gap:16px;padding-bottom:18px;border-bottom:1px solid var(--border);}\n.panel-title{margin:0;font-size:20px;line-height:1.25;font-weight:700;letter-spacing:-.02em;}\n.panel-meta{margin:5px 0 0;color:var(--muted);font-size:13px;}\n.text-link{display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:0 4px;color:var(--primary);font-size:14px;font-weight:700;text-decoration:none;white-space:nowrap;}\n.text-link i{font-size:16px;}\n.empty-state{min-height:340px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:30px 22px;}\n.empty-symbol{position:relative;display:grid;place-items:center;width:68px;height:68px;margin-bottom:19px;border-radius:14px;background:var(--inset);color:var(--nav);}\n.empty-symbol i{font-size:30px;}\n.empty-title{margin:0;font-family:'Bebas Neue',sans-serif;font-size:30px;font-weight:400;line-height:1.1;letter-spacing:.02em;color:var(--ink);}\n.empty-copy{max-width:390px;margin:9px 0 19px;color:var(--muted);font-size:14px;line-height:1.55;}\n.primary-action{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:46px;padding:0 18px;border-radius:7px;background:var(--primary);color:var(--surface);font-size:14px;font-weight:700;text-decoration:none;}\n.primary-action:hover{background:var(--nav);}\n.performance{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:24px 23px 20px;}\n.performance-heading{margin:0;font-family:'Bebas Neue',sans-serif;font-size:25px;font-weight:400;letter-spacing:.025em;}\n.performance-copy{margin:7px 0 19px;color:var(--muted);font-size:14px;line-height:1.5;}\n.measure-list{list-style:none;padding:0;margin:0;border-top:1px solid var(--border);}\n.measure-row{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:13px 0;border-bottom:1px solid var(--border);font-size:14px;color:var(--ink);}\n.measure-row:last-child{border-bottom:0;}\n.measure-row span:first-child{display:flex;align-items:center;gap:10px;}\n.measure-dot{width:7px;height:7px;border-radius:50%;background:var(--primary);}\n.measure-row:nth-child(2) .measure-dot{background:var(--gold);}\n.measure-row:nth-child(3) .measure-dot{background:var(--info);}\n.measure-row:nth-child(4) .measure-dot{background:var(--neutral);}\n.measure-note{font-size:12px;color:var(--muted);}\n.performance-link{display:flex;align-items:center;justify-content:space-between;min-height:46px;margin-top:14px;padding:0 14px;border:1px solid var(--border);border-radius:7px;color:var(--primary);font-size:14px;font-weight:700;text-decoration:none;}\n.performance-link i{font-size:17px;}\n.inventory-footer{margin-top:22px;display:flex;align-items:center;justify-content:space-between;gap:18px;padding:17px 21px;background:var(--inset);border-radius:9px;color:var(--ink);}\n.inventory-footer p{margin:0;font-size:14px;line-height:1.5;}\n.inventory-footer strong{font-weight:700;}\n.inventory-footer .text-link{flex:0 0 auto;}\n.mobile-header,.mobile-navigation{display:none;}\na:focus-visible,button:focus-visible,summary:focus-visible{outline:3px solid var(--focus);outline-offset:3px;}\n@media(max-width:1100px){.sidebar{width:236px;padding-left:15px;padding-right:15px}.main{margin-left:236px;padding-left:28px;padding-right:28px}.content-grid{grid-template-columns:minmax(0,1.2fr) minmax(280px,.8fr);gap:16px}.work-panel{padding:22px;}}\n@media(max-width:850px){.sidebar{display:none}.main{margin-left:0;padding:0 22px 36px}.topbar{display:none}.mobile-header{height:60px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--border);background:var(--page);}\n.mobile-brand{display:flex;align-items:center;gap:9px;text-decoration:none;color:var(--ink);font-weight:700;}\n.mobile-brand .brand-mark{width:34px;height:34px;font-size:18px;}\n.menu-details{position:relative;}\n.menu-details summary{display:grid;place-items:center;width:44px;height:44px;border:1px solid var(--border);border-radius:8px;list-style:none;background:var(--surface);color:var(--nav);cursor:pointer;}\n.menu-details summary::-webkit-details-marker{display:none;}\n.menu-details summary i{font-size:20px;}\n.mobile-drawer{position:fixed;z-index:50;top:60px;right:0;bottom:0;width:min(340px,88vw);overflow-y:auto;padding:20px 17px 22px;background:var(--nav);color:var(--surface);box-shadow:-18px 0 45px rgba(20,42,31,.20);}\n.mobile-drawer .nav-link{min-height:48px;}\n.mobile-drawer .account-links{margin-top:18px;}\n.mobile-drawer .add-vehicle{margin-top:18px;}\n.page-intro{padding:27px 0 20px;align-items:flex-start;}\n.content-grid{grid-template-columns:1fr;}\n.work-panel{min-height:390px;}\n.empty-state{min-height:285px;}\n.performance{display:grid;grid-template-columns:1fr;}\n.inventory-footer{align-items:flex-start;flex-direction:column;}\n}\n@media(max-width:520px){.main{padding-left:16px;padding-right:16px}.page-title{font-size:36px}.page-description{font-size:14px}.page-intro{padding-top:23px}.work-panel{padding:18px 16px;border-radius:10px}.panel-heading{align-items:flex-start;flex-direction:column;gap:8px}.text-link{min-height:40px}.performance{padding:19px 16px}.inventory-footer{padding:15px 16px}.account-chip .account-role{display:none;}}\n</style>\n<div class=\"shell\" data-kid=\"1\" data-name=\"page layout container\">\n    <aside aria-label=\"Dealer workspace navigation\" class=\"sidebar\" data-kid=\"1-1\" data-name=\"dealer workspace sidebar navigation\">\n        <a aria-label=\"Easy Ride dealer workspace home\" class=\"brand\" data-kid=\"1-1-1\" data-name=\"sidebar brand link to dashboard home\" href=\"/dealer/dashboard\">\n            <span class=\"brand-mark\" data-kid=\"1-1-1-1\" data-name=\"brand monogram logo tile\">\n                ER\n            </span>\n            <span data-kid=\"1-1-1-2\" data-name=\"brand name and subtitle wrapper\">\n                <span class=\"brand-name\" data-kid=\"1-1-1-2-1\" data-name=\"brand name text\">\n                    Easy Ride\n                </span>\n                <span class=\"brand-sub\" data-kid=\"1-1-1-2-2\" data-name=\"brand subtitle text\">\n                    Dealer workspace\n                </span>\n            </span>\n        </a>\n        <div class=\"workspace-label\" data-kid=\"1-1-2\" data-name=\"workspace section label\">\n            Workspace\n        </div>\n        <nav aria-label=\"Workspace\" class=\"nav-list\" data-kid=\"1-1-3\" data-name=\"workspace navigation group\">\n            <a aria-current=\"page\" class=\"nav-link\" data-kid=\"1-1-3-1\" data-name=\"overview navigation link (active page)\" href=\"/dealer/dashboard\">\n                <i class=\"icon-layout-dashboard\" data-kid=\"1-1-3-1-1\" data-name=\"dashboard layout icon\">\n                </i>\n                <span data-kid=\"1-1-3-1-2\" data-name=\"nav link label text\">\n                    Overview\n                </span>\n            </a>\n            <a class=\"nav-link\" data-kid=\"1-1-3-2\" data-name=\"inventory navigation link\" href=\"/dealer/inventory\">\n                <i class=\"icon-car-front\" data-kid=\"1-1-3-2-1\" data-name=\"car front icon\">\n                </i>\n                <span data-kid=\"1-1-3-2-2\" data-name=\"nav link label text\">\n                    Inventory\n                </span>\n            </a>\n            <a class=\"nav-link\" data-kid=\"1-1-3-3\" data-name=\"analytics navigation link\" href=\"/dealer/analytics\">\n                <i class=\"icon-chart-no-axes-column-increasing\" data-kid=\"1-1-3-3-1\" data-name=\"rising bar chart icon\">\n                </i>\n                <span data-kid=\"1-1-3-3-2\" data-name=\"nav link label text\">\n                    Analytics\n                </span>\n            </a>\n        </nav>\n        <div class=\"workspace-label\" data-kid=\"1-1-4\" data-name=\"account section label\">\n            Account\n        </div>\n        <nav aria-label=\"Account\" class=\"nav-list\" data-kid=\"1-1-5\" data-name=\"account navigation group\">\n            <a class=\"nav-link\" data-kid=\"1-1-5-1\" data-name=\"profile navigation link\" href=\"/dealer/profile\">\n                <i class=\"icon-user-round\" data-kid=\"1-1-5-1-1\" data-name=\"user profile icon\">\n                </i>\n                <span data-kid=\"1-1-5-1-2\" data-name=\"nav link label text\">\n                    Profile\n                </span>\n            </a>\n            <a class=\"nav-link\" data-kid=\"1-1-5-2\" data-name=\"verification navigation link\" href=\"/verification\">\n                <i class=\"icon-shield-check\" data-kid=\"1-1-5-2-1\" data-name=\"shield check icon\">\n                </i>\n                <span data-kid=\"1-1-5-2-2\" data-name=\"nav link label text\">\n                    Verification\n                </span>\n            </a>\n        </nav>\n        <div class=\"sidebar-spacer\" data-kid=\"1-1-6\" data-name=\"sidebar flexible spacer\">\n        </div>\n        <a class=\"add-vehicle\" data-kid=\"1-1-7\" data-name=\"add vehicle call-to-action button\" href=\"/create-listing\">\n            <i class=\"icon-plus\" data-kid=\"1-1-7-1\" data-name=\"plus icon\">\n            </i>\n            <span data-kid=\"1-1-7-2\" data-name=\"button label text\">\n                Add a vehicle\n            </span>\n        </a>\n        <a class=\"profile-link\" data-kid=\"1-1-8\" data-name=\"sidebar profile summary link\" href=\"/dealer/profile\">\n            <span class=\"profile-mark\" data-kid=\"1-1-8-1\" data-name=\"profile circular avatar\">\n                <i class=\"icon-user-round\" data-kid=\"1-1-8-1-1\" data-name=\"user profile icon\">\n                </i>\n            </span>\n            <span class=\"profile-copy\" data-kid=\"1-1-8-2\" data-name=\"profile text block\">\n                <span class=\"profile-title\" data-kid=\"1-1-8-2-1\" data-name=\"profile title text\">\n                    Dealer account\n                </span>\n                <span class=\"profile-sub\" data-kid=\"1-1-8-2-2\" data-name=\"profile subtitle text\">\n                    Profile & verification\n                </span>\n            </span>\n        </a>\n    </aside>\n    <main class=\"main\" data-kid=\"1-2\" data-name=\"main content area\">\n        <header class=\"mobile-header\" data-kid=\"1-2-1\" data-name=\"mobile top header bar\">\n            <a class=\"mobile-brand\" data-kid=\"1-2-1-1\" data-name=\"mobile brand link\" href=\"/dealer/dashboard\">\n                <span class=\"brand-mark\" data-kid=\"1-2-1-1-1\" data-name=\"mobile brand monogram tile\">\n                    ER\n                </span>\n                <span data-kid=\"1-2-1-1-2\" data-name=\"mobile brand name text\">\n                    Easy Ride · Dealer\n                </span>\n            </a>\n            <details class=\"menu-details\" data-kid=\"1-2-1-2\" data-name=\"mobile navigation drawer control\">\n                <summary aria-label=\"Open dealer navigation\" data-kid=\"1-2-1-2-1\" data-name=\"mobile menu toggle summary\">\n                    <i class=\"icon-menu\" data-kid=\"1-2-1-2-1-1\" data-name=\"menu hamburger icon\">\n                    </i>\n                </summary>\n                <div class=\"mobile-drawer\" data-kid=\"1-2-1-2-2\" data-name=\"mobile slide-out navigation drawer\">\n                    <div class=\"workspace-label\" data-kid=\"1-2-1-2-2-1\" data-name=\"mobile workspace section label\" style=\"padding-top:4px\">\n                        Workspace\n                    </div>\n                    <nav aria-label=\"Dealer navigation\" class=\"nav-list\" data-kid=\"1-2-1-2-2-2\" data-name=\"mobile navigation link group\">\n                        <a aria-current=\"page\" class=\"nav-link\" data-kid=\"1-2-1-2-2-2-1\" data-name=\"overview navigation link (active)\" href=\"/dealer/dashboard\">\n                            <i class=\"icon-layout-dashboard\" data-kid=\"1-2-1-2-2-2-1-1\" data-name=\"dashboard layout icon\">\n                            </i>\n                            <span data-kid=\"1-2-1-2-2-2-1-2\" data-name=\"nav link label text\">\n                                Overview\n                            </span>\n                        </a>\n                        <a class=\"nav-link\" data-kid=\"1-2-1-2-2-2-2\" data-name=\"inventory navigation link\" href=\"/dealer/inventory\">\n                            <i class=\"icon-car-front\" data-kid=\"1-2-1-2-2-2-2-1\" data-name=\"car front icon\">\n                            </i>\n                            <span data-kid=\"1-2-1-2-2-2-2-2\" data-name=\"nav link label text\">\n                                Inventory\n                            </span>\n                        </a>\n                        <a class=\"nav-link\" data-kid=\"1-2-1-2-2-2-3\" data-name=\"analytics navigation link\" href=\"/dealer/analytics\">\n                            <i class=\"icon-chart-no-axes-column-increasing\" data-kid=\"1-2-1-2-2-2-3-1\" data-name=\"rising bar chart icon\">\n                            </i>\n                            <span data-kid=\"1-2-1-2-2-2-3-2\" data-name=\"nav link label text\">\n                                Analytics\n                            </span>\n                        </a>\n                        <a class=\"nav-link\" data-kid=\"1-2-1-2-2-2-4\" data-name=\"profile navigation link\" href=\"/dealer/profile\">\n                            <i class=\"icon-user-round\" data-kid=\"1-2-1-2-2-2-4-1\" data-name=\"user profile icon\">\n                            </i>\n                            <span data-kid=\"1-2-1-2-2-2-4-2\" data-name=\"nav link label text\">\n                                Profile\n                            </span>\n                        </a>\n                        <a class=\"nav-link\" data-kid=\"1-2-1-2-2-2-5\" data-name=\"verification navigation link\" href=\"/verification\">\n                            <i class=\"icon-shield-check\" data-kid=\"1-2-1-2-2-2-5-1\" data-name=\"shield check icon\">\n                            </i>\n                            <span data-kid=\"1-2-1-2-2-2-5-2\" data-name=\"nav link label text\">\n                                Verification\n                            </span>\n                        </a>\n                    </nav>\n                    <a class=\"add-vehicle\" data-kid=\"1-2-1-2-2-3\" data-name=\"mobile add vehicle button\" href=\"/create-listing\">\n                        <i class=\"icon-plus\" data-kid=\"1-2-1-2-2-3-1\" data-name=\"plus icon\">\n                        </i>\n                        <span data-kid=\"1-2-1-2-2-3-2\" data-name=\"button label text\">\n                            Add a vehicle\n                        </span>\n                    </a>\n                </div>\n            </details>\n        </header>\n        <header class=\"topbar\" data-kid=\"1-2-2\" data-name=\"page top bar\">\n            <div class=\"breadcrumb\" data-kid=\"1-2-2-1\" data-name=\"breadcrumb navigation\">\n                <span data-kid=\"1-2-2-1-1\" data-name=\"breadcrumb workspace parent item\">\n                    Workspace\n                </span>\n                <i class=\"icon-chevron-right\" data-kid=\"1-2-2-1-2\" data-name=\"breadcrumb separator chevron\">\n                </i>\n                <strong data-kid=\"1-2-2-1-3\" data-name=\"breadcrumb current page label\">\n                    Dealer overview\n                </strong>\n            </div>\n            <div class=\"top-actions\" data-kid=\"1-2-2-2\" data-name=\"top bar action group\">\n                <a aria-label=\"View notifications\" class=\"top-action\" data-kid=\"1-2-2-2-1\" data-name=\"notifications button\" href=\"/notifications\">\n                    <i class=\"icon-bell\" data-kid=\"1-2-2-2-1-1\" data-name=\"bell notification icon\">\n                    </i>\n                </a>\n                <a class=\"account-chip\" data-kid=\"1-2-2-2-2\" data-name=\"account dropdown chip\" href=\"/dealer/profile\">\n                    <span class=\"account-avatar\" data-kid=\"1-2-2-2-2-1\" data-name=\"account avatar monogram\">\n                        ER\n                    </span>\n                    <span class=\"account-role\" data-kid=\"1-2-2-2-2-2\" data-name=\"account role label\">\n                        Dealer account\n                    </span>\n                    <i class=\"icon-chevron-down account-chevron\" data-kid=\"1-2-2-2-2-3\" data-name=\"account dropdown chevron icon\">\n                    </i>\n                </a>\n            </div>\n        </header>\n        <section class=\"page-intro\" data-kid=\"1-2-3\" data-name=\"page intro section\">\n            <div data-kid=\"1-2-3-1\" data-name=\"page heading block\">\n                <h1 class=\"page-title\" data-kid=\"1-2-3-1-1\" data-name=\"page main headline\">\n                    Your dealer workspace\n                </h1>\n                <p class=\"page-description\" data-kid=\"1-2-3-1-2\" data-name=\"page subtitle description\">\n                    Manage vehicle inventory and review your recorded performance.\n                </p>\n            </div>\n        </section>\n        <section aria-label=\"Dealer overview\" class=\"content-grid\" data-kid=\"1-2-4\" data-name=\"main content two-column grid\">\n            <section aria-labelledby=\"inventory-title\" class=\"work-panel\" data-kid=\"1-2-4-1\" data-name=\"inventory work panel\">\n                <div class=\"panel-heading\" data-kid=\"1-2-4-1-1\" data-name=\"panel heading bar\">\n                    <div data-kid=\"1-2-4-1-1-1\" data-name=\"panel title block\">\n                        <h2 class=\"panel-title\" data-kid=\"1-2-4-1-1-1-1\" data-name=\"panel title text\" id=\"inventory-title\">\n                            Your inventory\n                        </h2>\n                        <p class=\"panel-meta\" data-kid=\"1-2-4-1-1-1-2\" data-name=\"panel meta description\">\n                            Vehicle listings across your dealer account\n                        </p>\n                    </div>\n                    <a class=\"text-link\" data-kid=\"1-2-4-1-1-2\" data-name=\"manage inventory link\" href=\"/dealer/inventory\">\n                        Manage inventory\n                        <i class=\"icon-arrow-up-right\" data-kid=\"1-2-4-1-1-2-1\" data-name=\"upper-right arrow icon\">\n                        </i>\n                    </a>\n                </div>\n                <div class=\"empty-state\" data-kid=\"1-2-4-1-2\" data-name=\"inventory empty state placeholder\">\n                    <div aria-hidden=\"true\" class=\"empty-symbol\" data-kid=\"1-2-4-1-2-1\" data-name=\"empty state icon tile\">\n                        <i class=\"icon-car-front\" data-kid=\"1-2-4-1-2-1-1\" data-name=\"car front icon\">\n                        </i>\n                    </div>\n                    <h3 class=\"empty-title\" data-kid=\"1-2-4-1-2-2\" data-name=\"empty state heading\">\n                        No vehicles in your inventory yet\n                    </h3>\n                    <p class=\"empty-copy\" data-kid=\"1-2-4-1-2-3\" data-name=\"empty state copy text\">\n                        Add a vehicle to begin building your dealer inventory. Your listings and review status will appear here.\n                    </p>\n                    <a class=\"primary-action\" data-kid=\"1-2-4-1-2-4\" data-name=\"add first vehicle primary button\" href=\"/create-listing\">\n                        <i class=\"icon-plus\" data-kid=\"1-2-4-1-2-4-1\" data-name=\"plus icon\">\n                        </i>\n                        <span data-kid=\"1-2-4-1-2-4-2\" data-name=\"button label text\">\n                            Add your first vehicle\n                        </span>\n                    </a>\n                </div>\n            </section>\n            <aside aria-labelledby=\"performance-title\" class=\"performance\" data-kid=\"1-2-4-2\" data-name=\"performance measures panel\">\n                <h2 class=\"performance-heading\" data-kid=\"1-2-4-2-1\" data-name=\"performance panel heading\" id=\"performance-title\">\n                    Performance\n                </h2>\n                <p class=\"performance-copy\" data-kid=\"1-2-4-2-2\" data-name=\"performance panel description\">\n                    Explore the measures available for your listings.\n                </p>\n                <ul class=\"measure-list\" data-kid=\"1-2-4-2-3\" data-name=\"measures list\">\n                    <li class=\"measure-row\" data-kid=\"1-2-4-2-3-1\" data-name=\"views measure row\">\n                        <span data-kid=\"1-2-4-2-3-1-1\" data-name=\"measure name label\">\n                            <i class=\"measure-dot\" data-kid=\"1-2-4-2-3-1-1-1\" data-name=\"measure color dot\">\n                            </i>\n                            Views\n                        </span>\n                        <span class=\"measure-note\" data-kid=\"1-2-4-2-3-1-2\" data-name=\"measure note text\">\n                            Listing views\n                        </span>\n                    </li>\n                    <li class=\"measure-row\" data-kid=\"1-2-4-2-3-2\" data-name=\"contacts measure row\">\n                        <span data-kid=\"1-2-4-2-3-2-1\" data-name=\"measure name label\">\n                            <i class=\"measure-dot\" data-kid=\"1-2-4-2-3-2-1-1\" data-name=\"measure color dot\">\n                            </i>\n                            Contacts\n                        </span>\n                        <span class=\"measure-note\" data-kid=\"1-2-4-2-3-2-2\" data-name=\"measure note text\">\n                            Recorded contacts\n                        </span>\n                    </li>\n                    <li class=\"measure-row\" data-kid=\"1-2-4-2-3-3\" data-name=\"favorites measure row\">\n                        <span data-kid=\"1-2-4-2-3-3-1\" data-name=\"measure name label\">\n                            <i class=\"measure-dot\" data-kid=\"1-2-4-2-3-3-1-1\" data-name=\"measure color dot\">\n                            </i>\n                            Favorites\n                        </span>\n                        <span class=\"measure-note\" data-kid=\"1-2-4-2-3-3-2\" data-name=\"measure note text\">\n                            Saved by buyers\n                        </span>\n                    </li>\n                    <li class=\"measure-row\" data-kid=\"1-2-4-2-3-4\" data-name=\"conversion rate measure row\">\n                        <span data-kid=\"1-2-4-2-3-4-1\" data-name=\"measure name label\">\n                            <i class=\"measure-dot\" data-kid=\"1-2-4-2-3-4-1-1\" data-name=\"measure color dot\">\n                            </i>\n                            Conversion rate\n                        </span>\n                        <span class=\"measure-note\" data-kid=\"1-2-4-2-3-4-2\" data-name=\"measure note text\">\n                            View analytics\n                        </span>\n                    </li>\n                </ul>\n                <a class=\"performance-link\" data-kid=\"1-2-4-2-4\" data-name=\"open analytics link\" href=\"/dealer/analytics\">\n                    <span data-kid=\"1-2-4-2-4-1\" data-name=\"link label text\">\n                        Open dealer analytics\n                    </span>\n                    <i class=\"icon-arrow-right\" data-kid=\"1-2-4-2-4-2\" data-name=\"right arrow icon\">\n                    </i>\n                </a>\n            </aside>\n        </section>\n        <section aria-label=\"Inventory and analytics shortcuts\" class=\"inventory-footer\" data-kid=\"1-2-5\" data-name=\"inventory footer CTA banner\">\n            <p data-kid=\"1-2-5-1\" data-name=\"footer intro text\">\n                <strong data-kid=\"1-2-5-1-1\" data-name=\"footer text lead-in phrase\">\n                    Keep your workspace current.\n                </strong>\n                Add listings, review their status, and use analytics to check measured activity.\n            </p>\n            <a class=\"text-link\" data-kid=\"1-2-5-2\" data-name=\"go to inventory link\" href=\"/dealer/inventory\">\n                Go to inventory\n                <i class=\"icon-arrow-right\" data-kid=\"1-2-5-2-1\" data-name=\"right arrow icon\">\n                </i>\n            </a>\n        </section>\n    </main>\n</div>\n",
