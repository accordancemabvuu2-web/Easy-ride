
PORT=4567
NODE_ENV=development

MONGODB_URI=mongodb+srv://<USERNAME>:<URL_ENCODED_PASSWORD>@<CLUSTER_HOST>/easy_ride?retryWrites=true&w=majority
MONGODB_DB_NAME=easy_ride

FRONTEND_URL=http://localhost:3000
# Set PUBLIC_API_BASE_URL to the externally reachable API origin in production.
SWAGGER_ENABLED=true

JWT_ACCESS_SECRET=YOUR_RANDOM_SECRET_1
JWT_REFRESH_SECRET=YOUR_DIFFERENT_RANDOM_SECRET_2

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

LOG_LEVEL=info
BCRYPT_ROUNDS=12

