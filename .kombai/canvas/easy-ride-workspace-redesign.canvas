      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Red+Hat+Text:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n:root{--nav:#063F2F;--page:#F4F7F3;--surface:#FFFFFF;--inset:#EAF0E9;--ink:#17251E;--muted:#52665B;--border:#CEDBD0;--primary:#0B5D3B;--gold:#C9A227;--success:#24764C;--warning:#9A6814;--error:#AC3F35;--info:#356F8A;--neutral:#66716C;--focus:#E3B72F}\n.app{min-height:100vh;background:var(--page);color:var(--ink);font-family:'Red Hat Text',sans-serif;font-size:14px;line-height:1.45;display:flex}\n.sidebar{position:fixed;inset:0 auto 0 0;width:268px;background:var(--nav);color:#fff;padding:25px 17px 16px;display:flex;flex-direction:column;z-index:20}\n.brand{display:flex;align-items:center;gap:11px;padding:0 10px 25px;border-bottom:1px solid #FFFFFF20;color:#fff;text-decoration:none}\n.brand-mark{display:grid;place-items:center;width:42px;height:42px;background:var(--gold);color:var(--nav);font-size:16px;font-weight:700;border-radius:7px 12px 7px 12px;letter-spacing:-.04em}\n.brand-name{font-size:17px;font-weight:700;letter-spacing:-.02em}.brand-caption{display:block;color:#FFFFFFA6;font-size:13px;margin-top:2px}\n.role-chip{margin:17px 8px 22px;padding:11px 12px;border:1px solid #FFFFFF2B;border-radius:8px;display:flex;align-items:center;gap:10px;color:#E9F0EB;font-weight:600;min-height:48px}\n.role-chip .icon{color:#E3B72F;font-size:17px}.role-chip small{display:block;color:#AFC3B8;font-size:12px;font-weight:500}\n.nav{overflow:auto;min-height:0;scrollbar-width:thin;scrollbar-color:#FFFFFF40 transparent;padding:0 1px;flex:1}\n.nav-group{margin:0 0 20px}.nav-heading{margin:0 11px 7px;color:#AFC3B8;font-weight:700;font-size:12px;letter-spacing:.08em;text-transform:uppercase}\n.nav-link{height:46px;padding:0 11px;display:flex;align-items:center;gap:12px;border-radius:7px;text-decoration:none;color:#E1EAE5;font-weight:500;margin:2px 0;transition:background .16s,color .16s;position:relative}\n.nav-link .icon{width:19px;height:19px;font-size:18px;display:grid;place-items:center;color:#B7C9BF;flex:0 0 19px}\n.nav-link:hover{background:#FFFFFF12;color:#fff}.nav-link[aria-current=\"page\"]{background:#FFFFFF;color:var(--nav);font-weight:700}.nav-link[aria-current=\"page\"] .icon{color:var(--primary)}.nav-link[aria-current=\"page\"]:after{content:'';position:absolute;right:9px;width:5px;height:5px;border-radius:50%;background:var(--gold)}\n.nav-footer{border-top:1px solid #FFFFFF20;padding:13px 0 2px}.profile{display:flex;align-items:center;gap:10px;padding:8px 10px 9px;color:#fff}.avatar{height:35px;width:35px;border-radius:50%;display:grid;place-items:center;background:#FFFFFF19;color:#fff;font-weight:700;font-size:13px}.profile strong{display:block;font-size:13px}.profile small{display:block;color:#B3C5BC;font-size:12px;margin-top:1px}.logout{height:44px;display:flex;align-items:center;gap:11px;padding:0 10px;border-radius:7px;color:#F4E2DE;text-decoration:none;font-weight:600}.logout:hover{background:#AC3F352A}\n.main{margin-left:268px;width:calc(100% - 268px);min-width:0;padding:28px 42px 40px}.content{max-width:1240px;margin:0 auto}.topbar{display:flex;align-items:center;justify-content:space-between;margin-bottom:28px;color:var(--muted)}.crumb{display:flex;gap:9px;align-items:center}.crumb strong{color:var(--ink);font-weight:600}.top-actions{display:flex;align-items:center;gap:12px}.top-profile{height:44px;display:flex;align-items:center;gap:9px;padding:4px 11px 4px 4px;border:1px solid var(--border);border-radius:9px;background:var(--surface);color:var(--ink);font-weight:600}.top-profile .avatar{height:34px;width:34px;background:var(--inset);color:var(--nav)}\n.page-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin:0 0 25px}.page-heading h1{font-family:'Bebas Neue','Red Hat Text',sans-serif;font-size:44px;line-height:.98;letter-spacing:.015em;font-weight:400;margin:0;color:var(--ink)}.page-heading p{font-size:15px;color:var(--muted);margin:9px 0 0;max-width:600px}.heading-aside{display:flex;align-items:center;gap:8px;color:var(--muted);font-size:13px;padding-bottom:4px}.status-mark{width:8px;height:8px;border-radius:50%;background:var(--neutral)}\n.work-grid{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(285px,.9fr);gap:22px;align-items:start}.work-panel{background:var(--surface);border:1px solid var(--border);border-radius:11px;overflow:hidden}.panel-head{height:70px;padding:0 22px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--border);gap:14px}.panel-title{font-size:17px;font-weight:700;margin:0;color:var(--ink);letter-spacing:-.02em}.panel-caption{font-size:13px;color:var(--muted);margin:3px 0 0}.text-link{min-height:44px;display:inline-flex;align-items:center;gap:8px;color:var(--primary);font-weight:700;text-decoration:none;padding:0 4px}.text-link:hover{text-decoration:underline;text-underline-offset:3px}.empty-state{min-height:247px;padding:32px 26px;display:flex;align-items:center;justify-content:center;text-align:center}.empty-inner{max-width:420px}.empty-icon{font-size:31px;color:var(--neutral);margin-bottom:12px;display:inline-block}.empty-state h2{font-size:19px;letter-spacing:-.02em;margin:0;color:var(--ink)}.empty-state p{font-size:14px;color:var(--muted);margin:7px 0 18px}.button{min-height:46px;display:inline-flex;align-items:center;justify-content:center;gap:9px;padding:0 17px;border-radius:7px;background:var(--primary);color:#fff;font-weight:700;text-decoration:none;border:1px solid var(--primary);transition:background .15s,border-color .15s}.button:hover{background:#084B30;border-color:#084B30}.button:focus-visible,.nav-link:focus-visible,.text-link:focus-visible,.logout:focus-visible,.mobile-toggle:focus-visible,.top-profile:focus-visible{outline:3px solid var(--focus);outline-offset:3px}\n.shortcut-panel{background:var(--surface);border:1px solid var(--border);border-radius:11px;padding:0 17px}.shortcut-heading{padding:19px 5px 14px;border-bottom:1px solid var(--border)}.shortcut-list{list-style:none;margin:0;padding:4px 0}.shortcut-row{min-height:56px;display:flex;align-items:center;gap:12px;padding:4px 5px;border-bottom:1px solid var(--border);color:var(--ink);text-decoration:none;font-weight:600}.shortcut-row:last-child{border-bottom:0}.shortcut-row .row-icon{width:30px;height:30px;display:grid;place-items:center;color:var(--primary);font-size:17px;background:var(--inset);border-radius:6px;flex:0 0 30px}.shortcut-row .arrow{margin-left:auto;color:var(--muted);font-size:15px}.shortcut-row:hover .arrow{color:var(--primary);transform:translateX(2px)}\n.activity{margin-top:23px;background:var(--surface);border:1px solid var(--border);border-radius:11px}.activity-head{height:64px;padding:0 22px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--border)}.activity-empty{min-height:82px;padding:19px 22px;display:flex;align-items:center;justify-content:space-between;gap:18px}.activity-empty p{margin:0;color:var(--muted)}.activity-empty .text-link{white-space:nowrap}\n.footer-note{margin:25px 0 0;color:var(--muted);font-size:13px}\n.mobile-bar,.scrim,.mobile-toggle{display:none}\n@media(max-width:1000px){.sidebar{width:244px}.main{margin-left:244px;width:calc(100% - 244px);padding:26px 26px 34px}.work-grid{grid-template-columns:minmax(0,1.25fr) minmax(265px,.85fr);gap:16px}}\n@media(max-width:760px){.app{display:block;padding-top:60px}.mobile-bar{position:fixed;top:0;left:0;right:0;height:60px;background:var(--surface);border-bottom:1px solid var(--border);z-index:30;display:flex;align-items:center;justify-content:space-between;padding:0 14px}.mobile-brand{display:flex;align-items:center;gap:9px;color:var(--nav);font-weight:700}.mobile-brand .brand-mark{width:34px;height:34px;font-size:13px}.mobile-toggle{display:inline-flex;width:46px;height:46px;align-items:center;justify-content:center;border:1px solid var(--border);border-radius:8px;background:var(--surface);color:var(--nav);font-size:21px}.sidebar{position:fixed;top:0;bottom:0;left:0;width:min(320px,88vw);max-height:100dvh;overflow:hidden;transform:translateX(-105%);transition:transform .2s ease;z-index:50;box-shadow:0 18px 52px #17251E30}.sidebar.is-open{transform:translateX(0)}.nav{overflow-y:auto;overscroll-behavior:contain}.scrim{position:fixed;inset:0;background:#17251E65;z-index:40;display:none}.scrim.is-open{display:block}.main{margin:0;width:100%;padding:23px 18px 34px}.topbar{display:none}.page-heading{align-items:flex-start;margin-bottom:20px}.page-heading h1{font-size:38px}.heading-aside{display:none}.work-grid{grid-template-columns:1fr;gap:15px}.panel-head{padding:0 16px}.shortcut-panel{padding:0 14px}.activity{margin-top:16px}.activity-empty{align-items:flex-start;flex-direction:column;gap:6px}.footer-note{margin-top:18px}}\n@media(max-width:450px){.main{padding-left:14px;padding-right:14px}.page-heading h1{font-size:34px}.panel-head{height:auto;min-height:68px;align-items:flex-start;padding-top:12px;padding-bottom:12px}.panel-title{font-size:16px}.empty-state{min-height:220px;padding:26px 16px}.text-link{font-size:13px}}\n@media(prefers-reduced-motion:reduce){.sidebar,.nav-link,.button{transition:none}}\n</style>\n<div class=\"app\" data-kid=\"1\" data-name=\"admin application shell\">\n    <div class=\"mobile-bar\" data-kid=\"1-1\" data-name=\"mobile top bar\">\n        <div class=\"mobile-brand\" data-kid=\"1-1-1\" data-name=\"mobile brand label\">\n            <span class=\"brand-mark\" data-kid=\"1-1-1-1\" data-name=\"mobile brand monogram badge\">\n                ER\n            </span>\n            <span data-kid=\"1-1-1-2\" data-name=\"mobile brand name and section\">\n                Easy Ride\n                <span data-kid=\"1-1-1-2-1\" data-name=\"mobile admin section label\" style=\"font-weight:500;color:var(--muted)\">\n                    / Admin\n                </span>\n            </span>\n        </div>\n        <button aria-controls=\"admin-navigation\" aria-expanded=\"false\" aria-label=\"Open administration navigation\" class=\"mobile-toggle\" data-kid=\"1-1-2\" data-name=\"mobile navigation open toggle button\" type=\"button\">\n            <i aria-hidden=\"true\" class=\"icon-menu\" data-kid=\"1-1-2-1\" data-name=\"menu hamburger icon\">\n            </i>\n        </button>\n    </div>\n    <button aria-label=\"Close navigation\" class=\"scrim\" data-dynamic=\"true\" data-kid=\"1-2\" data-name=\"drawer scrim close button\" data-reason=\"aria-label is rewritten between open and closed states by the drawer toggle script\" tabindex=\"-1\" type=\"button\">\n    </button>\n    <aside aria-label=\"Administration navigation\" class=\"sidebar\" data-kid=\"1-3\" data-name=\"administration sidebar navigation\" id=\"admin-navigation\">\n        <a class=\"brand\" data-kid=\"1-3-1\" data-name=\"sidebar brand link\" href=\"/admin\">\n            <span class=\"brand-mark\" data-kid=\"1-3-1-1\" data-name=\"brand monogram badge\">\n                ER\n            </span>\n            <span data-kid=\"1-3-1-2\" data-name=\"brand name and caption wrapper\">\n                <span class=\"brand-name\" data-kid=\"1-3-1-2-1\" data-name=\"brand name text\">\n                    Easy Ride\n                </span>\n                <span class=\"brand-caption\" data-kid=\"1-3-1-2-2\" data-name=\"brand caption text\">\n                    Administration\n                </span>\n            </span>\n        </a>\n        <div class=\"role-chip\" data-kid=\"1-3-2\" data-name=\"administrator role badge widget\">\n            <i aria-hidden=\"true\" class=\"icon-shield-check icon\" data-kid=\"1-3-2-1\" data-name=\"shield-check role icon\">\n            </i>\n            <span data-kid=\"1-3-2-2\" data-name=\"role badge text block\">\n                <small data-kid=\"1-3-2-2-1\" data-name=\"role badge workspace label\">\n                    Workspace\n                </small>\n                Admin portal\n            </span>\n        </div>\n        <nav class=\"nav\" data-kid=\"1-3-3\" data-name=\"sidbar navigation groups\">\n            <div class=\"nav-group\" data-kid=\"1-3-3-1\" data-name=\"workspace navigation group\">\n                <p class=\"nav-heading\" data-kid=\"1-3-3-1-1\" data-name=\"workspace navigation group heading\">\n                    Workspace\n                </p>\n                <a aria-current=\"page\" class=\"nav-link\" data-kid=\"1-3-3-1-2\" data-name=\"overview nav link (active page)\" href=\"/admin\">\n                    <i aria-hidden=\"true\" class=\"icon-gauge icon\" data-kid=\"1-3-3-1-2-1\" data-name=\"gauge dashboard icon\">\n                    </i>\n                    <span data-kid=\"1-3-3-1-2-2\" data-name=\"overview nav link label\">\n                        Overview\n                    </span>\n                </a>\n            </div>\n            <div class=\"nav-group\" data-kid=\"1-3-3-2\" data-name=\"review navigation group\">\n                <p class=\"nav-heading\" data-kid=\"1-3-3-2-1\" data-name=\"review navigation group heading\">\n                    Review\n                </p>\n                <a class=\"nav-link\" data-kid=\"1-3-3-2-2\" data-name=\"listings nav link\" href=\"/admin/listings\">\n                    <i aria-hidden=\"true\" class=\"icon-car-front icon\" data-kid=\"1-3-3-2-2-1\" data-name=\"car icon\">\n                    </i>\n                    <span data-kid=\"1-3-3-2-2-2\" data-name=\"listings nav link label\">\n                        Listings\n                    </span>\n                </a>\n                <a class=\"nav-link\" data-kid=\"1-3-3-2-3\" data-name=\"reports nav link\" href=\"/admin/reports\">\n                    <i aria-hidden=\"true\" class=\"icon-flag-triangle-right icon\" data-kid=\"1-3-3-2-3-1\" data-name=\"report flag icon\">\n                    </i>\n                    <span data-kid=\"1-3-3-2-3-2\" data-name=\"reports nav link label\">\n                        Reports\n                    </span>\n                </a>\n                <a class=\"nav-link\" data-kid=\"1-3-3-2-4\" data-name=\"verification nav link\" href=\"/admin/verification\">\n                    <i aria-hidden=\"true\" class=\"icon-badge-check icon\" data-kid=\"1-3-3-2-4-1\" data-name=\"badge check icon\">\n                    </i>\n                    <span data-kid=\"1-3-3-2-4-2\" data-name=\"verification nav link label\">\n                        Verification\n                    </span>\n                </a>\n                <a class=\"nav-link\" data-kid=\"1-3-3-2-5\" data-name=\"disputes nav link\" href=\"/admin/disputes\">\n                    <i aria-hidden=\"true\" class=\"icon-scale icon\" data-kid=\"1-3-3-2-5-1\" data-name=\"scale justice icon\">\n                    </i>\n                    <span data-kid=\"1-3-3-2-5-2\" data-name=\"disputes nav link label\">\n                        Disputes\n                    </span>\n                </a>\n            </div>\n            <div class=\"nav-group\" data-kid=\"1-3-3-3\" data-name=\"marketplace navigation group\">\n                <p class=\"nav-heading\" data-kid=\"1-3-3-3-1\" data-name=\"marketplace navigation group heading\">\n                    Marketplace\n                </p>\n                <a class=\"nav-link\" data-kid=\"1-3-3-3-2\" data-name=\"users nav link\" href=\"/admin/users\">\n                    <i aria-hidden=\"true\" class=\"icon-users-round icon\" data-kid=\"1-3-3-3-2-1\" data-name=\"users group icon\">\n                    </i>\n                    <span data-kid=\"1-3-3-3-2-2\" data-name=\"users nav link label\">\n                        Users\n                    </span>\n                </a>\n                <a class=\"nav-link\" data-kid=\"1-3-3-3-3\" data-name=\"bookings nav link\" href=\"/admin/bookings\">\n                    <i aria-hidden=\"true\" class=\"icon-calendar-days icon\" data-kid=\"1-3-3-3-3-1\" data-name=\"calendar icon\">\n                    </i>\n                    <span data-kid=\"1-3-3-3-3-2\" data-name=\"bookings nav link label\">\n                        Bookings\n                    </span>\n                </a>\n                <a class=\"nav-link\" data-kid=\"1-3-3-3-4\" data-name=\"offers nav link\" href=\"/admin/offers\">\n                    <i aria-hidden=\"true\" class=\"icon-handshake icon\" data-kid=\"1-3-3-3-4-1\" data-name=\"handshake icon\">\n                    </i>\n                    <span data-kid=\"1-3-3-3-4-2\" data-name=\"offers nav link label\">\n                        Offers\n                    </span>\n                </a>\n                <a class=\"nav-link\" data-kid=\"1-3-3-3-5\" data-name=\"payments nav link\" href=\"/admin/payments\">\n                    <i aria-hidden=\"true\" class=\"icon-wallet-cards icon\" data-kid=\"1-3-3-3-5-1\" data-name=\"wallet icon\">\n                    </i>\n                    <span data-kid=\"1-3-3-3-5-2\" data-name=\"payments nav link label\">\n                        Payments\n                    </span>\n                </a>\n            </div>\n            <div class=\"nav-group\" data-kid=\"1-3-3-4\" data-name=\"records and help navigation group\">\n                <p class=\"nav-heading\" data-kid=\"1-3-3-4-1\" data-name=\"records and help navigation group heading\">\n                    Records & help\n                </p>\n                <a class=\"nav-link\" data-kid=\"1-3-3-4-2\" data-name=\"support nav link\" href=\"/admin/support\">\n                    <i aria-hidden=\"true\" class=\"icon-message-circle-question icon\" data-kid=\"1-3-3-4-2-1\" data-name=\"message question icon\">\n                    </i>\n                    <span data-kid=\"1-3-3-4-2-2\" data-name=\"support nav link label\">\n                        Support\n                    </span>\n                </a>\n                <a class=\"nav-link\" data-kid=\"1-3-3-4-3\" data-name=\"audit logs nav link\" href=\"/admin/audit-logs\">\n                    <i aria-hidden=\"true\" class=\"icon-history icon\" data-kid=\"1-3-3-4-3-1\" data-name=\"history icon\">\n                    </i>\n                    <span data-kid=\"1-3-3-4-3-2\" data-name=\"audit logs nav link label\">\n                        Audit logs\n                    </span>\n                </a>\n            </div>\n        </nav>\n        <div class=\"nav-footer\" data-kid=\"1-3-4\" data-name=\"sidebar footer\">\n            <div class=\"profile\" data-kid=\"1-3-4-1\" data-name=\"sidebar profile block\">\n                <span class=\"avatar\" data-kid=\"1-3-4-1-1\" data-name=\"profile avatar monogram\">\n                    ER\n                </span>\n                <span data-kid=\"1-3-4-1-2\" data-name=\"profile name and caption\">\n                    <strong data-kid=\"1-3-4-1-2-1\" data-name=\"profile display name\">\n                        Administrator\n                    </strong>\n                    <small data-kid=\"1-3-4-1-2-2\" data-name=\"profile role caption\">\n                        Admin account\n                    </small>\n                </span>\n            </div>\n            <a class=\"logout\" data-kid=\"1-3-4-2\" data-name=\"logout button\" href=\"/\">\n                <i aria-hidden=\"true\" class=\"icon-log-out\" data-kid=\"1-3-4-2-1\" data-name=\"log out door icon\">\n                </i>\n                <span data-kid=\"1-3-4-2-2\" data-name=\"logout button label\">\n                    Log out\n                </span>\n            </a>\n        </div>\n    </aside>\n    <main class=\"main\" data-kid=\"1-4\" data-name=\"main content area\">\n        <div class=\"content\" data-kid=\"1-4-1\" data-name=\"page content container\">\n            <div class=\"topbar\" data-kid=\"1-4-1-1\" data-name=\"page top bar\">\n                <div class=\"crumb\" data-kid=\"1-4-1-1-1\" data-name=\"breadcrumb trail\">\n                    <span data-kid=\"1-4-1-1-1-1\" data-name=\"breadcrumb workspace segment\">\n                        Workspace\n                    </span>\n                    <span aria-hidden=\"true\" data-kid=\"1-4-1-1-1-2\" data-name=\"breadcrumb separator\">\n                        /\n                    </span>\n                    <strong data-kid=\"1-4-1-1-1-3\" data-name=\"breadcrumb current page\">\n                        Overview\n                    </strong>\n                </div>\n                <div class=\"top-actions\" data-kid=\"1-4-1-1-2\" data-name=\"page top actions cluster\">\n                    <span data-kid=\"1-4-1-1-2-1\" data-name=\"operations description label\">\n                        Marketplace operations\n                    </span>\n                    <span class=\"top-profile\" data-kid=\"1-4-1-1-2-2\" data-name=\"page top profile chip\">\n                        <span class=\"avatar\" data-kid=\"1-4-1-1-2-2-1\" data-name=\"page profile avatar monogram\">\n                            ER\n                        </span>\n                        <span data-kid=\"1-4-1-1-2-2-2\" data-name=\"page profile name\">\n                            Administrator\n                        </span>\n                    </span>\n                </div>\n            </div>\n            <header class=\"page-heading\" data-kid=\"1-4-1-2\" data-name=\"page heading block\">\n                <div data-kid=\"1-4-1-2-1\" data-name=\"page heading text block\">\n                    <h1 data-kid=\"1-4-1-2-1-1\" data-name=\"page main headline\">\n                        Operations overview\n                    </h1>\n                    <p data-kid=\"1-4-1-2-1-2\" data-name=\"page headline description\">\n                        Review marketplace activity and manage the work that needs attention.\n                    </p>\n                </div>\n                <div class=\"heading-aside\" data-kid=\"1-4-1-2-2\" data-name=\"workspace status badge\">\n                    <span aria-hidden=\"true\" class=\"status-mark\" data-kid=\"1-4-1-2-2-1\" data-name=\"status indicator dot\">\n                    </span>\n                    <span data-kid=\"1-4-1-2-2-2\" data-name=\"workspace status label\">\n                        Admin workspace\n                    </span>\n                </div>\n            </header>\n            <div class=\"work-grid\" data-kid=\"1-4-1-3\" data-name=\"work panels grid\">\n                <section aria-labelledby=\"review-title\" class=\"work-panel\" data-kid=\"1-4-1-3-1\" data-name=\"approval review work panel\">\n                    <div class=\"panel-head\" data-kid=\"1-4-1-3-1-1\" data-name=\"panel header bar\">\n                        <div data-kid=\"1-4-1-3-1-1-1\" data-name=\"panel title block\">\n                            <h2 class=\"panel-title\" data-kid=\"1-4-1-3-1-1-1-1\" data-name=\"panel headline\" id=\"review-title\">\n                                Cars waiting for approval\n                            </h2>\n                            <p class=\"panel-caption\" data-kid=\"1-4-1-3-1-1-1-2\" data-name=\"panel caption text\">\n                                Listings submitted for marketplace review\n                            </p>\n                        </div>\n                        <a class=\"text-link\" data-kid=\"1-4-1-3-1-1-2\" data-name=\"review listings action link\" href=\"/admin/listings\">\n                            Review listings\n                            <i aria-hidden=\"true\" class=\"icon-arrow-up-right\" data-kid=\"1-4-1-3-1-1-2-1\" data-name=\"arrow up-right link icon\">\n                            </i>\n                        </a>\n                    </div>\n                    <div class=\"empty-state\" data-kid=\"1-4-1-3-1-2\" data-name=\"empty state body\">\n                        <div class=\"empty-inner\" data-kid=\"1-4-1-3-1-2-1\" data-name=\"empty state content\">\n                            <i aria-hidden=\"true\" class=\"icon-car-front empty-icon\" data-kid=\"1-4-1-3-1-2-1-1\" data-name=\"empty state car icon\">\n                            </i>\n                            <h2 data-kid=\"1-4-1-3-1-2-1-2\" data-name=\"empty state heading\">\n                                No cars pending approval\n                            </h2>\n                            <p data-kid=\"1-4-1-3-1-2-1-3\" data-name=\"empty state description\">\n                                There are no listings waiting for review.\n                            </p>\n                            <a class=\"button\" data-kid=\"1-4-1-3-1-2-1-4\" data-name=\"open listings call-to-action button\" href=\"/admin/listings\">\n                                <i aria-hidden=\"true\" class=\"icon-list-checks\" data-kid=\"1-4-1-3-1-2-1-4-1\" data-name=\"list-checks button icon\">\n                                </i>\n                                Open listings\n                            </a>\n                        </div>\n                    </div>\n                </section>\n                <section aria-labelledby=\"queue-title\" class=\"shortcut-panel\" data-kid=\"1-4-1-3-2\" data-name=\"marketplace queues shortcut panel\">\n                    <div class=\"shortcut-heading\" data-kid=\"1-4-1-3-2-1\" data-name=\"shortcut panel heading\">\n                        <h2 class=\"panel-title\" data-kid=\"1-4-1-3-2-1-1\" data-name=\"shortcut panel title\" id=\"queue-title\">\n                            Marketplace queues\n                        </h2>\n                        <p class=\"panel-caption\" data-kid=\"1-4-1-3-2-1-2\" data-name=\"shortcut panel caption\">\n                            Open a review area\n                        </p>\n                    </div>\n                    <nav aria-label=\"Marketplace review queues\" class=\"shortcut-list\" data-kid=\"1-4-1-3-2-2\" data-name=\"shortcut list navigation\">\n                        <a class=\"shortcut-row\" data-kid=\"1-4-1-3-2-2-1\" data-name=\"reports shortcut row link\" href=\"/admin/reports\">\n                            <span class=\"row-icon\" data-kid=\"1-4-1-3-2-2-1-1\" data-name=\"shortcut row icon wrapper\">\n                                <i aria-hidden=\"true\" class=\"icon-flag-triangle-right\" data-kid=\"1-4-1-3-2-2-1-1-1\" data-name=\"report flag shortcut icon\">\n                                </i>\n                            </span>\n                            <span data-kid=\"1-4-1-3-2-2-1-2\" data-name=\"reports shortcut label\">\n                                Reports\n                            </span>\n                            <i aria-hidden=\"true\" class=\"icon-arrow-right arrow\" data-kid=\"1-4-1-3-2-2-1-3\" data-name=\"arrow-right shortcut icon\">\n                            </i>\n                        </a>\n                        <a class=\"shortcut-row\" data-kid=\"1-4-1-3-2-2-2\" data-name=\"verification shortcut row link\" href=\"/admin/verification\">\n                            <span class=\"row-icon\" data-kid=\"1-4-1-3-2-2-2-1\" data-name=\"shortcut row icon wrapper\">\n                                <i aria-hidden=\"true\" class=\"icon-badge-check\" data-kid=\"1-4-1-3-2-2-2-1-1\" data-name=\"badge check shortcut icon\">\n                                </i>\n                            </span>\n                            <span data-kid=\"1-4-1-3-2-2-2-2\" data-name=\"verification shortcut label\">\n                                Verification\n                            </span>\n                            <i aria-hidden=\"true\" class=\"icon-arrow-right arrow\" data-kid=\"1-4-1-3-2-2-2-3\" data-name=\"arrow-right shortcut icon\">\n                            </i>\n                        </a>\n                        <a class=\"shortcut-row\" data-kid=\"1-4-1-3-2-2-3\" data-name=\"support shortcut row link\" href=\"/admin/support\">\n                            <span class=\"row-icon\" data-kid=\"1-4-1-3-2-2-3-1\" data-name=\"shortcut row icon wrapper\">\n                                <i aria-hidden=\"true\" class=\"icon-message-circle-question\" data-kid=\"1-4-1-3-2-2-3-1-1\" data-name=\"message question shortcut icon\">\n                                </i>\n                            </span>\n                            <span data-kid=\"1-4-1-3-2-2-3-2\" data-name=\"support shortcut label\">\n                                Support\n                            </span>\n                            <i aria-hidden=\"true\" class=\"icon-arrow-right arrow\" data-kid=\"1-4-1-3-2-2-3-3\" data-name=\"arrow-right shortcut icon\">\n                            </i>\n                        </a>\n                        <a class=\"shortcut-row\" data-kid=\"1-4-1-3-2-2-4\" data-name=\"disputes shortcut row link\" href=\"/admin/disputes\">\n                            <span class=\"row-icon\" data-kid=\"1-4-1-3-2-2-4-1\" data-name=\"shortcut row icon wrapper\">\n                                <i aria-hidden=\"true\" class=\"icon-scale\" data-kid=\"1-4-1-3-2-2-4-1-1\" data-name=\"scale justice shortcut icon\">\n                                </i>\n                            </span>\n                            <span data-kid=\"1-4-1-3-2-2-4-2\" data-name=\"disputes shortcut label\">\n                                Disputes\n                            </span>\n                            <i aria-hidden=\"true\" class=\"icon-arrow-right arrow\" data-kid=\"1-4-1-3-2-2-4-3\" data-name=\"arrow-right shortcut icon\">\n                            </i>\n                        </a>\n                    </nav>\n                </section>\n            </div>\n            <section aria-labelledby=\"activity-title\" class=\"activity\" data-kid=\"1-4-1-4\" data-name=\"recent admin activity panel\">\n                <div class=\"activity-head\" data-kid=\"1-4-1-4-1\" data-name=\"activity panel header\">\n                    <h2 class=\"panel-title\" data-kid=\"1-4-1-4-1-1\" data-name=\"activity panel title\" id=\"activity-title\">\n                        Recent admin activity\n                    </h2>\n                    <a class=\"text-link\" data-kid=\"1-4-1-4-1-2\" data-name=\"open audit logs link\" href=\"/admin/audit-logs\">\n                        Open audit logs\n                        <i aria-hidden=\"true\" class=\"icon-arrow-up-right\" data-kid=\"1-4-1-4-1-2-1\" data-name=\"arrow up-right link icon\">\n                        </i>\n                    </a>\n                </div>\n                <div class=\"activity-empty\" data-kid=\"1-4-1-4-2\" data-name=\"activity empty state\">\n                    <p data-kid=\"1-4-1-4-2-1\" data-name=\"activity empty heading text\">\n                        No recent activity yet.\n                    </p>\n                    <span data-kid=\"1-4-1-4-2-2\" data-name=\"activity empty caption text\" style=\"color:var(--muted);font-size:13px\">\n                        Audit events will appear here after they are recorded.\n                    </span>\n                </div>\n            </section>\n            <p class=\"footer-note\" data-kid=\"1-4-1-5\" data-name=\"page footer note\">\n                Marketplace records and account actions are available from the navigation.\n            </p>\n        </div>\n    </main>\n</div>\n<script>\n    const toggle=document.querySelector('.mobile-toggle');const drawer=document.querySelector('.sidebar');const scrim=document.querySelector('.scrim');let returnFocus=null;function closeDrawer(){drawer.classList.remove('is-open');scrim.classList.remove('is-open');toggle.setAttribute('aria-expanded','false');toggle.setAttribute('aria-label','Open administration navigation');if(returnFocus)returnFocus.focus()}toggle.addEventListener('click',()=>{returnFocus=document.activeElement;drawer.classList.add('is-open');scrim.classList.add('is-open');toggle.setAttribute('aria-expanded','true');toggle.setAttribute('aria-label','Close administration navigation');drawer.querySelector('a').focus()});scrim.addEventListener('click',closeDrawer);document.addEventListener('keydown',event=>{if(event.key==='Escape'&&drawer.classList.contains('is-open'))closeDrawer();if(event.key==='Tab'&&drawer.classList.contains('is-open')){const items=[...drawer.querySelectorAll('a,button,[tabindex=\"0\"]')];const first=items[0],last=items[items.length-1];if(event.shiftKey&&document.activeElement===first){event.preventDefault();last.focus()}else if(!event.shiftKey&&document.activeElement===last){event.preventDefault();first.focus()}}});\n</script>\n",
      "comments": [],
