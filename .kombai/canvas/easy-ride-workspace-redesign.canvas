    },
    "var_2a5c3054b6af": {
      "type": "variant",
      "label": "02 · Vehicle ledger — Admin",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 13860,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Raleway:wght@500;600;700;800&family=Source+Sans+3:wght@400;500;600;700&family=Yantramanav:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n:root {\n  --nav: #092F2B;\n  --page: #EFF4F1;\n  --surface: #FFFFFF;\n  --inset: #E3EDE8;\n  --ink: #142C27;\n  --muted: #50655F;\n  --border: #CBDAD2;\n  --primary: #146D55;\n  --gold: #D0A43A;\n  --success: #257653;\n  --warning: #966919;\n  --error: #B0443C;\n  --info: #39738B;\n  --neutral: #63726D;\n  --focus: #E5B743;\n  --nav-muted: #C4D4CE;\n  --font-display: 'Raleway', sans-serif;\n  --font-body: 'Source Sans 3', sans-serif;\n  --font-spec: 'Yantramanav', sans-serif;\n}\n* { box-sizing: border-box; }\nbody { margin: 0; background: var(--page); color: var(--ink); font: 16px/1.45 var(--font-body); }\na { color: inherit; text-decoration: none; }\nbutton, a, input, select { font: inherit; }\na:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible { outline: 3px solid var(--focus); outline-offset: 3px; }\n.app { min-height: 100vh; }\n.sidebar { position: fixed; z-index: 30; inset: 0 auto 0 0; width: 258px; display: flex; flex-direction: column; padding: 25px 17px 17px; background: var(--nav); color: white; }\n.brand { display: flex; align-items: center; gap: 12px; padding: 0 10px 23px; border-bottom: 1px solid rgba(255,255,255,.14); }\n.brand-mark { width: 42px; height: 42px; display: grid; place-items: center; background: var(--gold); color: var(--nav); font: 800 15px var(--font-display); letter-spacing: -.06em; border-radius: 9px 9px 9px 3px; }\n.brand-name { font: 800 17px/1.15 var(--font-display); letter-spacing: -.035em; }\n.brand-caption { margin-top: 4px; color: var(--nav-muted); font: 500 13px/1.1 var(--font-body); }\n.nav { flex: 1; overflow-y: auto; padding: 19px 0 14px; }\n.nav-group + .nav-group { margin-top: 19px; }\n.nav-label { padding: 0 13px 7px; color: #99B6AC; font: 700 11px/1.2 var(--font-body); letter-spacing: .11em; text-transform: uppercase; }\n.nav-link { display: flex; align-items: center; gap: 12px; min-height: 42px; margin: 2px 0; padding: 0 12px; border-radius: 7px; color: var(--nav-muted); font: 600 14px/1.2 var(--font-body); transition: background-color .16s ease, color .16s ease; }\n.nav-link i { width: 19px; height: 19px; flex: 0 0 19px; text-align: center; color: currentColor; font-size: 18px; }\n.nav-link:hover { color: white; background: rgba(255,255,255,.085); }\n.nav-link.active { color: white; background: rgba(255,255,255,.12); box-shadow: inset 3px 0 0 var(--gold); }\n.side-footer { border-top: 1px solid rgba(255,255,255,.14); padding-top: 14px; }\n.admin-profile { display: flex; align-items: center; gap: 11px; padding: 9px 10px 13px; }\n.profile-avatar { width: 36px; height: 36px; display: grid; place-items: center; border-radius: 50%; background: #D7E4DE; color: var(--nav); font: 700 12px var(--font-display); }\n.profile-name { color: white; font-weight: 700; font-size: 14px; }\n.profile-role { margin-top: 2px; color: var(--nav-muted); font-size: 12px; }\n.logout { display: flex; align-items: center; gap: 12px; min-height: 42px; padding: 0 12px; border-radius: 7px; color: #F3C8C4; font-weight: 600; font-size: 14px; }\n.logout i { font-size: 18px; }\n.main { min-height: 100vh; margin-left: 258px; }\n.topbar { height: 66px; display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 0 42px; background: var(--surface); border-bottom: 1px solid var(--border); }\n.crumb { display: flex; align-items: center; gap: 9px; color: var(--muted); font-size: 14px; }\n.crumb .current { color: var(--ink); font-weight: 700; }\n.top-actions { display: flex; align-items: center; gap: 11px; }\n.scope-chip { display: inline-flex; align-items: center; gap: 8px; padding: 7px 11px; border: 1px solid var(--border); border-radius: 6px; color: var(--muted); font-size: 13px; font-weight: 600; }\n.scope-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--primary); }\n.mobile-trigger { display: none; width: 44px; height: 44px; align-items: center; justify-content: center; border: 1px solid var(--border); border-radius: 7px; background: var(--surface); color: var(--ink); cursor: pointer; }\n.content { max-width: 1440px; margin: 0 auto; padding: 35px 42px 44px; }\n.page-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: 28px; }\nh1, h2, p { margin: 0; }\nh1 { font: 700 34px/1.12 var(--font-display); letter-spacing: -.035em; color: var(--ink); }\n.page-summary { max-width: 660px; margin-top: 9px; color: var(--muted); font-size: 16px; }\n.heading-side { display: flex; align-items: center; gap: 9px; padding-bottom: 2px; color: var(--muted); font-size: 14px; }\n.heading-side i { font-size: 18px; }\n.ledger { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; overflow: hidden; }\n.ledger-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; padding: 23px 25px 18px; border-bottom: 1px solid var(--border); }\n.ledger-title { font: 700 20px/1.2 var(--font-display); letter-spacing: -.02em; }\n.ledger-description { margin-top: 6px; color: var(--muted); font-size: 14px; }\n.text-link { display: inline-flex; align-items: center; gap: 8px; flex: 0 0 auto; min-height: 40px; padding: 0 7px; color: var(--primary); font-weight: 700; font-size: 14px; }\n.text-link i { font-size: 16px; transition: transform .15s ease; }\n.text-link:hover i { transform: translateX(3px); }\n.table-wrap { width: 100%; overflow-x: auto; }\ntable { width: 100%; border-collapse: collapse; min-width: 710px; }\nthead { background: #F7FAF8; }\nth { height: 44px; padding: 0 18px; text-align: left; color: var(--muted); font: 700 12px/1.2 var(--font-body); letter-spacing: .045em; }\nth:first-child, td:first-child { padding-left: 25px; }\nth:last-child, td:last-child { padding-right: 25px; text-align: right; }\n.empty-cell { height: 254px; padding: 0; }\n.empty-state { display: flex; min-height: 254px; flex-direction: column; align-items: center; justify-content: center; padding: 27px 22px; text-align: center; }\n.empty-mark { width: 46px; height: 46px; display: grid; place-items: center; border-radius: 50%; background: var(--inset); color: var(--primary); }\n.empty-mark i { font-size: 21px; }\n.empty-title { margin-top: 15px; font: 700 18px/1.2 var(--font-display); color: var(--ink); }\n.empty-copy { max-width: 455px; margin-top: 7px; color: var(--muted); font-size: 14px; }\n.empty-action { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 42px; margin-top: 17px; padding: 0 16px; border-radius: 6px; background: var(--primary); color: white; font-weight: 700; font-size: 14px; transition: background-color .15s ease; }\n.empty-action:hover { background: #0E5845; }\n.lower { display: grid; grid-template-columns: minmax(0,1.2fr) minmax(300px,.8fr); gap: 21px; margin-top: 22px; }\n.secondary-panel { padding: 20px 22px; background: var(--surface); border: 1px solid var(--border); border-radius: 10px; }\n.panel-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; }\n.panel-title { font: 700 18px/1.2 var(--font-display); letter-spacing: -.02em; }\n.panel-link { display: inline-flex; align-items: center; gap: 7px; min-height: 36px; color: var(--primary); font-size: 13px; font-weight: 700; }\n.activity-empty { display: flex; align-items: flex-start; gap: 12px; margin-top: 17px; padding: 14px 0 1px; border-top: 1px solid var(--border); }\n.activity-empty i { color: var(--neutral); font-size: 18px; margin-top: 1px; }\n.activity-empty strong { display: block; font-size: 14px; font-weight: 700; }\n.activity-empty span { display: block; margin-top: 3px; color: var(--muted); font-size: 13px; }\n.route-list { display: grid; grid-template-columns: 1fr 1fr; gap: 0 18px; margin-top: 12px; }\n.route-link { display: flex; align-items: center; justify-content: space-between; gap: 10px; min-height: 39px; border-top: 1px solid var(--border); color: var(--ink); font-size: 14px; font-weight: 600; }\n.route-link i { color: var(--muted); font-size: 15px; }\n.drawer-backdrop { display: none; }\n@media (max-width: 1080px) {\n  .content { padding: 29px 28px 36px; }\n  .topbar { padding: 0 28px; }\n  .lower { grid-template-columns: minmax(0,1fr) minmax(280px,.88fr); gap: 15px; }\n}\n@media (max-width: 820px) {\n  .sidebar { width: 274px; transform: translateX(-102%); transition: transform .2s ease; box-shadow: 12px 0 34px rgba(9,47,43,.16); }\n  .app.nav-open .sidebar { transform: translateX(0); }\n  .app.nav-open .drawer-backdrop { display: block; position: fixed; z-index: 20; inset: 0; background: rgba(20,44,39,.38); border: 0; }\n  .main { margin-left: 0; }\n  .topbar { height: 62px; padding: 0 18px; }\n  .mobile-trigger { display: inline-flex; }\n  .top-actions .scope-chip { display: none; }\n  .content { padding: 25px 18px 32px; }\n  .page-heading { align-items: flex-start; margin-bottom: 21px; }\n  h1 { font-size: 30px; }\n  .lower { grid-template-columns: 1fr; }\n}\n@media (max-width: 540px) {\n  .topbar { padding: 0 14px; }\n  .content { padding: 21px 14px 30px; }\n  .page-heading { display: block; }\n  .page-summary { font-size: 15px; }\n  .heading-side { margin-top: 15px; }\n  .ledger-head { padding: 18px 17px 14px; align-items: flex-start; }\n  .ledger-title { font-size: 18px; }\n  .ledger-description { font-size: 13px; }\n  .ledger-head .text-link { min-height: 42px; }\n  table { min-width: 0; }\n  thead { display: none; }\n  .empty-cell { display: block; width: 100%; }\n  .empty-state { min-height: 220px; }\n  .lower { margin-top: 16px; }\n  .route-list { grid-template-columns: 1fr; }\n  .secondary-panel { padding: 18px; }\n}\n</style>\n<div class=\"app\" data-kid=\"1\" data-name=\"admin dashboard app shell\" id=\"admin-app\">\n    <aside aria-label=\"Administration navigation\" class=\"sidebar\" data-kid=\"1-1\" data-name=\"fixed admin sidebar navigation\" id=\"admin-nav\">\n        <div class=\"brand\" data-kid=\"1-1-1\" data-name=\"brand header block\">\n            <div aria-hidden=\"true\" class=\"brand-mark\" data-kid=\"1-1-1-1\" data-name=\"brand monogram badge\">\n                ER\n            </div>\n            <div data-kid=\"1-1-1-2\" data-name=\"brand text group\">\n                <div class=\"brand-name\" data-kid=\"1-1-1-2-1\" data-name=\"brand name heading\">\n                    Easy Ride\n                </div>\n                <div class=\"brand-caption\" data-kid=\"1-1-1-2-2\" data-name=\"brand caption text\">\n                    Admin workspace\n                </div>\n            </div>\n        </div>\n        <nav aria-label=\"Admin sections\" class=\"nav\" data-kid=\"1-1-2\" data-name=\"sidbar nav sections\">\n            <div class=\"nav-group\" data-kid=\"1-1-2-1\" data-name=\"workspace nav group\">\n                <div class=\"nav-label\" data-kid=\"1-1-2-1-1\" data-name=\"nav group label - workspace\">\n                    Workspace\n                </div>\n                <a aria-current=\"page\" class=\"nav-link active\" data-kid=\"1-1-2-1-2\" data-name=\"active nav link - overview\" href=\"/admin\">\n                    <i aria-hidden=\"true\" class=\"icon-gauge\" data-kid=\"1-1-2-1-2-1\" data-name=\"gauge speedometer icon\">\n                    </i>\n                    <span data-kid=\"1-1-2-1-2-2\" data-name=\"nav link label - overview\">\n                        Overview\n                    </span>\n                </a>\n            </div>\n            <div class=\"nav-group\" data-kid=\"1-1-2-2\" data-name=\"review nav group\">\n                <div class=\"nav-label\" data-kid=\"1-1-2-2-1\" data-name=\"nav group label - review\">\n                    Review\n                </div>\n                <a class=\"nav-link\" data-kid=\"1-1-2-2-2\" data-name=\"nav link - listings\" href=\"/admin/listings\">\n                    <i aria-hidden=\"true\" class=\"icon-car-front\" data-kid=\"1-1-2-2-2-1\" data-name=\"car icon\">\n                    </i>\n                    <span data-kid=\"1-1-2-2-2-2\" data-name=\"nav link label - listings\">\n                        Listings\n                    </span>\n                </a>\n                <a class=\"nav-link\" data-kid=\"1-1-2-2-3\" data-name=\"nav link - reports\" href=\"/admin/reports\">\n                    <i aria-hidden=\"true\" class=\"icon-flag\" data-kid=\"1-1-2-2-3-1\" data-name=\"flag icon\">\n                    </i>\n                    <span data-kid=\"1-1-2-2-3-2\" data-name=\"nav link label - reports\">\n                        Reports\n                    </span>\n                </a>\n                <a class=\"nav-link\" data-kid=\"1-1-2-2-4\" data-name=\"nav link - verification\" href=\"/admin/verification\">\n                    <i aria-hidden=\"true\" class=\"icon-shield-check\" data-kid=\"1-1-2-2-4-1\" data-name=\"shield check icon\">\n                    </i>\n                    <span data-kid=\"1-1-2-2-4-2\" data-name=\"nav link label - verification\">\n                        Verification\n                    </span>\n                </a>\n                <a class=\"nav-link\" data-kid=\"1-1-2-2-5\" data-name=\"nav link - disputes\" href=\"/admin/disputes\">\n                    <i aria-hidden=\"true\" class=\"icon-triangle-alert\" data-kid=\"1-1-2-2-5-1\" data-name=\"warning triangle icon\">\n                    </i>\n                    <span data-kid=\"1-1-2-2-5-2\" data-name=\"nav link label - disputes\">\n                        Disputes\n                    </span>\n                </a>\n            </div>\n            <div class=\"nav-group\" data-kid=\"1-1-2-3\" data-name=\"marketplace nav group\">\n                <div class=\"nav-label\" data-kid=\"1-1-2-3-1\" data-name=\"nav group label - marketplace\">\n                    Marketplace\n                </div>\n                <a class=\"nav-link\" data-kid=\"1-1-2-3-2\" data-name=\"nav link - users\" href=\"/admin/users\">\n                    <i aria-hidden=\"true\" class=\"icon-users-round\" data-kid=\"1-1-2-3-2-1\" data-name=\"users group icon\">\n                    </i>\n                    <span data-kid=\"1-1-2-3-2-2\" data-name=\"nav link label - users\">\n                        Users\n                    </span>\n                </a>\n                <a class=\"nav-link\" data-kid=\"1-1-2-3-3\" data-name=\"nav link - bookings\" href=\"/admin/bookings\">\n                    <i aria-hidden=\"true\" class=\"icon-calendar-days\" data-kid=\"1-1-2-3-3-1\" data-name=\"calendar icon\">\n                    </i>\n                    <span data-kid=\"1-1-2-3-3-2\" data-name=\"nav link label - bookings\">\n                        Bookings\n                    </span>\n                </a>\n                <a class=\"nav-link\" data-kid=\"1-1-2-3-4\" data-name=\"nav link - offers\" href=\"/admin/offers\">\n                    <i aria-hidden=\"true\" class=\"icon-handshake\" data-kid=\"1-1-2-3-4-1\" data-name=\"handshake icon\">\n                    </i>\n                    <span data-kid=\"1-1-2-3-4-2\" data-name=\"nav link label - offers\">\n                        Offers\n                    </span>\n                </a>\n                <a class=\"nav-link\" data-kid=\"1-1-2-3-5\" data-name=\"nav link - payments\" href=\"/admin/payments\">\n                    <i aria-hidden=\"true\" class=\"icon-credit-card\" data-kid=\"1-1-2-3-5-1\" data-name=\"credit card icon\">\n                    </i>\n                    <span data-kid=\"1-1-2-3-5-2\" data-name=\"nav link label - payments\">\n                        Payments\n                    </span>\n                </a>\n            </div>\n            <div class=\"nav-group\" data-kid=\"1-1-2-4\" data-name=\"records and support nav group\">\n                <div class=\"nav-label\" data-kid=\"1-1-2-4-1\" data-name=\"nav group label - records and support\">\n                    Records & support\n                </div>\n                <a class=\"nav-link\" data-kid=\"1-1-2-4-2\" data-name=\"nav link - support\" href=\"/admin/support\">\n                    <i aria-hidden=\"true\" class=\"icon-message-circle\" data-kid=\"1-1-2-4-2-1\" data-name=\"message bubble icon\">\n                    </i>\n                    <span data-kid=\"1-1-2-4-2-2\" data-name=\"nav link label - support\">\n                        Support\n                    </span>\n                </a>\n                <a class=\"nav-link\" data-kid=\"1-1-2-4-3\" data-name=\"nav link - audit logs\" href=\"/admin/audit-logs\">\n                    <i aria-hidden=\"true\" class=\"icon-history\" data-kid=\"1-1-2-4-3-1\" data-name=\"historical clock icon\">\n                    </i>\n                    <span data-kid=\"1-1-2-4-3-2\" data-name=\"nav link label - audit logs\">\n                        Audit logs\n                    </span>\n                </a>\n            </div>\n        </nav>\n        <div class=\"side-footer\" data-kid=\"1-1-3\" data-name=\"sidebar footer\">\n            <div class=\"admin-profile\" data-kid=\"1-1-3-1\" data-name=\"admin profile row\">\n                <div aria-hidden=\"true\" class=\"profile-avatar\" data-kid=\"1-1-3-1-1\" data-name=\"profile avatar badge\">\n                    AD\n                </div>\n                <div data-kid=\"1-1-3-1-2\" data-name=\"profile text group\">\n                    <div class=\"profile-name\" data-kid=\"1-1-3-1-2-1\" data-name=\"profile name label\">\n                        Administrator\n                    </div>\n                    <div class=\"profile-role\" data-kid=\"1-1-3-1-2-2\" data-name=\"profile role text\">\n                        Easy Ride operations\n                    </div>\n                </div>\n            </div>\n            <a class=\"logout\" data-kid=\"1-1-3-2\" data-name=\"logout link\" href=\"/login\">\n                <i aria-hidden=\"true\" class=\"icon-log-out\" data-kid=\"1-1-3-2-1\" data-name=\"logout icon\">\n                </i>\n                <span data-kid=\"1-1-3-2-2\" data-name=\"logout link label\">\n                    Log out\n                </span>\n            </a>\n        </div>\n    </aside>\n    <button aria-label=\"Close navigation\" class=\"drawer-backdrop\" data-kid=\"1-2\" data-name=\"mobile drawer backdrop overlay\" onclick=\"closeAdminNav()\" type=\"button\">\n    </button>\n    <main class=\"main\" data-kid=\"1-3\" data-name=\"main admin content area\">\n        <header class=\"topbar\" data-kid=\"1-3-1\" data-name=\"top action bar\">\n            <div data-kid=\"1-3-1-1\" data-name=\"topbar leading group\" style=\"display:flex;align-items:center;gap:14px;min-width:0\">\n                <button aria-controls=\"admin-nav\" aria-expanded=\"false\" aria-label=\"Open admin navigation\" class=\"mobile-trigger\" data-dynamic=\"true\" data-kid=\"1-3-1-1-1\" data-name=\"mobile menu hamburger button\" data-reason=\"aria-label and aria-expanded attributes toggled by script on click\" id=\"menu-trigger\" onclick=\"toggleAdminNav()\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"icon-menu\" data-kid=\"1-3-1-1-1-1\" data-name=\"hamburger menu icon\" style=\"font-size:19px\">\n                    </i>\n                </button>\n                <div class=\"crumb\" data-kid=\"1-3-1-1-2\" data-name=\"breadcrumb navigation\">\n                    <span data-kid=\"1-3-1-1-2-1\" data-name=\"breadcrumb root - easy ride\">\n                        Easy Ride\n                    </span>\n                    <span aria-hidden=\"true\" data-kid=\"1-3-1-1-2-2\" data-name=\"breadcrumb separator slash\">\n                        /\n                    </span>\n                    <span class=\"current\" data-kid=\"1-3-1-1-2-3\" data-name=\"breadcrumb current page label\">\n                        Administration\n                    </span>\n                </div>\n            </div>\n            <div class=\"top-actions\" data-kid=\"1-3-1-2\" data-name=\"topbar action group\">\n                <span class=\"scope-chip\" data-kid=\"1-3-1-2-1\" data-name=\"active scope indicator chip\">\n                    <span aria-hidden=\"true\" class=\"scope-dot\" data-kid=\"1-3-1-2-1-1\" data-name=\"scope status dot\">\n                    </span>\n                    Admin workspace\n                </span>\n            </div>\n        </header>\n        <div class=\"content\" data-kid=\"1-3-2\" data-name=\"page content wrapper\">\n            <header class=\"page-heading\" data-kid=\"1-3-2-1\" data-name=\"page heading block\">\n                <div data-kid=\"1-3-2-1-1\" data-name=\"page title and summary group\">\n                    <h1 data-kid=\"1-3-2-1-1-1\" data-name=\"page main headline\">\n                        Operations overview\n                    </h1>\n                    <p class=\"page-summary\" data-kid=\"1-3-2-1-1-2\" data-name=\"page summary text\">\n                        Review marketplace listings and keep account activity in view.\n                    </p>\n                </div>\n                <div class=\"heading-side\" data-kid=\"1-3-2-1-2\" data-name=\"page heading side label\">\n                    <i aria-hidden=\"true\" class=\"icon-list-checks\" data-kid=\"1-3-2-1-2-1\" data-name=\"checklist icon\">\n                    </i>\n                    <span data-kid=\"1-3-2-1-2-2\" data-name=\"page heading workspace label\">\n                        Admin review workspace\n                    </span>\n                </div>\n            </header>\n            <section aria-labelledby=\"review-heading\" class=\"ledger\" data-kid=\"1-3-2-2\" data-name=\"listings review ledger section\">\n                <div class=\"ledger-head\" data-kid=\"1-3-2-2-1\" data-name=\"ledger header row\">\n                    <div data-kid=\"1-3-2-2-1-1\" data-name=\"ledger title group\">\n                        <h2 class=\"ledger-title\" data-kid=\"1-3-2-2-1-1-1\" data-name=\"ledger section title\" id=\"review-heading\">\n                            Listings awaiting review\n                        </h2>\n                        <p class=\"ledger-description\" data-kid=\"1-3-2-2-1-1-2\" data-name=\"ledger description text\">\n                            Review submitted vehicles using their owner, location, listing type, and current status.\n                        </p>\n                    </div>\n                    <a class=\"text-link\" data-kid=\"1-3-2-2-1-2\" data-name=\"open all listings text link\" href=\"/admin/listings\">\n                        Open all listings\n                        <i aria-hidden=\"true\" class=\"icon-arrow-up-right\" data-kid=\"1-3-2-2-1-2-1\" data-name=\"diagonal arrow icon\">\n                        </i>\n                    </a>\n                </div>\n                <div class=\"table-wrap\" data-kid=\"1-3-2-2-2\" data-name=\"ledger table wrapper\">\n                    <table aria-label=\"Listings awaiting review\" data-kid=\"1-3-2-2-2-1\" data-name=\"listings review table\">\n                        <thead data-kid=\"1-3-2-2-2-1-1\" data-name=\"table header\">\n                            <tr data-kid=\"1-3-2-2-2-1-1-1\" data-name=\"table header row\">\n                                <th data-kid=\"1-3-2-2-2-1-1-1-1\" data-name=\"table column header - vehicle\" scope=\"col\">\n                                    Vehicle\n                                </th>\n                                <th data-kid=\"1-3-2-2-2-1-1-1-2\" data-name=\"table column header - owner and city\" scope=\"col\">\n                                    Owner / city\n                                </th>\n                                <th data-kid=\"1-3-2-2-2-1-1-1-3\" data-name=\"table column header - type\" scope=\"col\">\n                                    Type\n                                </th>\n                                <th data-kid=\"1-3-2-2-2-1-1-1-4\" data-name=\"table column header - status\" scope=\"col\">\n                                    Status\n                                </th>\n                                <th data-kid=\"1-3-2-2-2-1-1-1-5\" data-name=\"table column header - action\" scope=\"col\">\n                                    Action\n                                </th>\n                            </tr>\n                        </thead>\n                        <tbody data-kid=\"1-3-2-2-2-1-2\" data-name=\"table body\">\n                            <tr data-kid=\"1-3-2-2-2-1-2-1\" data-name=\"row placeholder spanning all columns\">\n                                <td class=\"empty-cell\" colspan=\"5\" data-kid=\"1-3-2-2-2-1-2-1-1\" data-name=\"empty state cell container\">\n                                    <div class=\"empty-state\" data-kid=\"1-3-2-2-2-1-2-1-1-1\" data-name=\"empty state content\">\n                                        <div class=\"empty-mark\" data-kid=\"1-3-2-2-2-1-2-1-1-1-1\" data-name=\"empty state icon badge\">\n                                            <i aria-hidden=\"true\" class=\"icon-shield-check\" data-kid=\"1-3-2-2-2-1-2-1-1-1-1-1\" data-name=\"shield check icon\">\n                                            </i>\n                                        </div>\n                                        <h3 class=\"empty-title\" data-kid=\"1-3-2-2-2-1-2-1-1-1-2\" data-name=\"empty state title\">\n                                            No listings are awaiting review\n                                        </h3>\n                                        <p class=\"empty-copy\" data-kid=\"1-3-2-2-2-1-2-1-1-1-3\" data-name=\"empty state copy text\">\n                                            New vehicles submitted for approval will appear here with their owner, city, listing type, status, and review action.\n                                        </p>\n                                        <a class=\"empty-action\" data-kid=\"1-3-2-2-2-1-2-1-1-1-4\" data-name=\"open listings call-to-action button\" href=\"/admin/listings\">\n                                            Open listings\n                                            <i aria-hidden=\"true\" class=\"icon-arrow-right\" data-kid=\"1-3-2-2-2-1-2-1-1-1-4-1\" data-name=\"right arrow icon\">\n                                            </i>\n                                        </a>\n                                    </div>\n                                </td>\n                            </tr>\n                        </tbody>\n                    </table>\n                </div>\n            </section>\n            <div class=\"lower\" data-kid=\"1-3-2-3\" data-name=\"lower panels grid\">\n                <section aria-labelledby=\"audit-heading\" class=\"secondary-panel\" data-kid=\"1-3-2-3-1\" data-name=\"recent admin activity panel\">\n                    <div class=\"panel-top\" data-kid=\"1-3-2-3-1-1\" data-name=\"activity panel header\">\n                        <h2 class=\"panel-title\" data-kid=\"1-3-2-3-1-1-1\" data-name=\"activity panel title\" id=\"audit-heading\">\n                            Recent admin activity\n                        </h2>\n                        <a class=\"panel-link\" data-kid=\"1-3-2-3-1-1-2\" data-name=\"open audit logs link\" href=\"/admin/audit-logs\">\n                            Open audit logs\n                            <i aria-hidden=\"true\" class=\"icon-arrow-up-right\" data-kid=\"1-3-2-3-1-1-2-1\" data-name=\"diagonal arrow icon\">\n                            </i>\n                        </a>\n                    </div>\n                    <div class=\"activity-empty\" data-kid=\"1-3-2-3-1-2\" data-name=\"activity empty state block\">\n                        <i aria-hidden=\"true\" class=\"icon-history\" data-kid=\"1-3-2-3-1-2-1\" data-name=\"historical clock icon\">\n                        </i>\n                        <div data-kid=\"1-3-2-3-1-2-2\" data-name=\"activity empty text group\">\n                            <strong data-kid=\"1-3-2-3-1-2-2-1\" data-name=\"activity empty title\">\n                                No recent audit entries\n                            </strong>\n                            <span data-kid=\"1-3-2-3-1-2-2-2\" data-name=\"activity empty description\">\n                                Recorded admin events will appear here.\n                            </span>\n                        </div>\n                    </div>\n                </section>\n                <section aria-labelledby=\"other-queues-heading\" class=\"secondary-panel\" data-kid=\"1-3-2-3-2\" data-name=\"other review queues panel\">\n                    <div class=\"panel-top\" data-kid=\"1-3-2-3-2-1\" data-name=\"queues panel header\">\n                        <h2 class=\"panel-title\" data-kid=\"1-3-2-3-2-1-1\" data-name=\"queues panel title\" id=\"other-queues-heading\">\n                            Other review queues\n                        </h2>\n                    </div>\n                    <div class=\"route-list\" data-kid=\"1-3-2-3-2-2\" data-name=\"route links grid\">\n                        <a class=\"route-link\" data-kid=\"1-3-2-3-2-2-1\" data-name=\"route link - reports\" href=\"/admin/reports\">\n                            <span data-kid=\"1-3-2-3-2-2-1-1\" data-name=\"route link label - reports\">\n                                Reports\n                            </span>\n                            <i aria-hidden=\"true\" class=\"icon-arrow-up-right\" data-kid=\"1-3-2-3-2-2-1-2\" data-name=\"diagonal arrow icon\">\n                            </i>\n                        </a>\n                        <a class=\"route-link\" data-kid=\"1-3-2-3-2-2-2\" data-name=\"route link - verification\" href=\"/admin/verification\">\n                            <span data-kid=\"1-3-2-3-2-2-2-1\" data-name=\"route link label - verification\">\n                                Verification\n                            </span>\n                            <i aria-hidden=\"true\" class=\"icon-arrow-up-right\" data-kid=\"1-3-2-3-2-2-2-2\" data-name=\"diagonal arrow icon\">\n                            </i>\n                        </a>\n                        <a class=\"route-link\" data-kid=\"1-3-2-3-2-2-3\" data-name=\"route link - disputes\" href=\"/admin/disputes\">\n                            <span data-kid=\"1-3-2-3-2-2-3-1\" data-name=\"route link label - disputes\">\n                                Disputes\n                            </span>\n                            <i aria-hidden=\"true\" class=\"icon-arrow-up-right\" data-kid=\"1-3-2-3-2-2-3-2\" data-name=\"diagonal arrow icon\">\n                            </i>\n                        </a>\n                        <a class=\"route-link\" data-kid=\"1-3-2-3-2-2-4\" data-name=\"route link - support\" href=\"/admin/support\">\n                            <span data-kid=\"1-3-2-3-2-2-4-1\" data-name=\"route link label - support\">\n                                Support\n                            </span>\n                            <i aria-hidden=\"true\" class=\"icon-arrow-up-right\" data-kid=\"1-3-2-3-2-2-4-2\" data-name=\"diagonal arrow icon\">\n                            </i>\n                        </a>\n                    </div>\n                </section>\n            </div>\n        </div>\n    </main>\n</div>\n<script>\n    const app = document.getElementById('admin-app');\nconst trigger = document.getElementById('menu-trigger');\nfunction toggleAdminNav() {\n  const open = app.classList.toggle('nav-open');\n  trigger.setAttribute('aria-expanded', String(open));\n  trigger.setAttribute('aria-label', open ? 'Close admin navigation' : 'Open admin navigation');\n  if (open) document.querySelector('#admin-nav a').focus();\n}\nfunction closeAdminNav() {\n  app.classList.remove('nav-open');\n  trigger.setAttribute('aria-expanded', 'false');\n  trigger.setAttribute('aria-label', 'Open admin navigation');\n  trigger.focus();\n}\ndocument.addEventListener('keydown', (event) => { if (event.key === 'Escape' && app.classList.contains('nav-open')) closeAdminNav(); });\n</script>\n",
