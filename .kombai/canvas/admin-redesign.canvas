      },
      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n\n*,*::before,*::after{box-sizing:border-box}\n:root{\n  --forest:#08281D;--green:#0B5D3B;--green-dark:#0A4E32;--green-soft:#EAF3EE;--green-line:#CFE2D7;\n  --gold:#C9A227;--canvas:#F4F6F5;--surface:#FFFFFF;--ink:#10201A;--ink-2:#4C5C54;--ink-3:#7B8A82;\n  --line:#E3E9E5;--line-2:#EEF2EF;--mono:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;\n}\nhtml,body{margin:0;padding:0;height:100%}\nbody{font-family:'Inter',-apple-system,'Segoe UI',Arial,sans-serif;background:var(--canvas);color:var(--ink);font-size:14px;line-height:1.45;-webkit-font-smoothing:antialiased;overflow:hidden}\nbutton{font-family:inherit;font-size:inherit;color:inherit}\na{color:inherit;text-decoration:none}\n[class^=\"icon-\"],[class*=\" icon-\"]{line-height:1;display:inline-block}\n:focus-visible{outline:2px solid var(--green);outline-offset:2px}\n.tnum{font-variant-numeric:tabular-nums}\n.mono{font-family:var(--mono);font-size:12px;letter-spacing:-.01em}\n.app{position:relative;width:1440px;height:900px;display:flex;overflow:hidden;background:var(--canvas)}\n\n.sidebar{width:288px;flex:0 0 288px;height:900px;background:var(--forest);color:#fff;display:flex;flex-direction:column}\n.brand{height:88px;flex:0 0 88px;display:flex;align-items:center;gap:12px;padding:0 20px;border-bottom:1px solid rgba(255,255,255,.08)}\n.brand-mark{width:38px;height:38px;border-radius:10px;background:linear-gradient(160deg,#E2C466,#C9A227);color:#08281D;display:grid;place-items:center;font-size:13.5px;font-weight:700;letter-spacing:.02em}\n.brand-name{font-size:15px;font-weight:600;letter-spacing:-.01em}\n.brand-sub{font-size:11.5px;color:rgba(255,255,255,.5);margin-top:1px}\n.nav{flex:1;padding:14px 12px 8px;overflow:hidden}\n.nav-group{margin-bottom:14px}\n.nav-label{font-size:10.5px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.36);padding:0 10px 6px}\n.nav-item{display:flex;align-items:center;gap:10px;height:40px;padding:0 10px;border-radius:8px;color:rgba(255,255,255,.74);font-size:13.5px;font-weight:500}\n.nav-item i{font-size:16px;color:rgba(255,255,255,.5)}\n.nav-item .lbl{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.nav-item:hover{background:rgba(255,255,255,.07);color:#fff}\n.nav-item.active{background:#fff;color:var(--forest);font-weight:600;box-shadow:0 1px 2px rgba(0,0,0,.2)}\n.nav-item.active i{color:var(--green)}\n.nav-count{margin-left:auto;min-width:22px;padding:1px 7px;border-radius:999px;background:rgba(255,255,255,.11);color:rgba(255,255,255,.75);font-size:11.5px;font-weight:600;text-align:center}\n.nav-item.active .nav-count{background:var(--green-soft);color:var(--green)}\n.nav-priv{padding-top:12px;border-top:1px solid rgba(255,255,255,.1)}\n.nav-priv .nav-label{display:flex;align-items:center;gap:6px;color:rgba(255,255,255,.48)}\n.nav-priv .nav-label i{font-size:11px;color:var(--gold)}\n.sidebar-foot{border-top:1px solid rgba(255,255,255,.08);padding:12px}\n.me{display:flex;align-items:center;gap:10px;padding:8px;border-radius:10px}\n.me:hover{background:rgba(255,255,255,.07)}\n.sidebar .avatar{background:rgba(255,255,255,.14);color:#fff}\n.me-name{font-size:13px;font-weight:600}\n.me-role{font-size:11.5px;color:rgba(255,255,255,.5)}\n.logout{margin-left:auto;font-size:15px;color:rgba(255,255,255,.42)}\n\n.main{flex:1;min-width:0;height:900px;display:flex;flex-direction:column}\n.topbar{height:64px;flex:0 0 64px;background:#fff;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 24px}\n.crumbs{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--ink-3)}\n.crumbs .sep{color:#C6D0CA}\n.crumbs strong{color:var(--ink);font-weight:500}\n.topbar-right{display:flex;align-items:center;gap:14px}\n.role-chip{display:inline-flex;align-items:center;gap:6px;height:26px;padding:0 10px;border-radius:999px;border:1px solid #E7DBB2;background:#FBF7E8;color:#6D5716;font-size:12px;font-weight:500}\n.role-chip i{font-size:12px;color:#A98A22}\n.profile{display:flex;align-items:center;gap:8px;height:34px;padding:0 8px 0 6px;border:1px solid transparent;border-radius:999px;background:transparent;cursor:pointer;font-size:13px;font-weight:500}\n.profile:hover{background:#F1F4F2}\n.profile i{font-size:13px;color:var(--ink-3)}\n.avatar{width:30px;height:30px;border-radius:999px;background:var(--green-soft);color:var(--green);display:grid;place-items:center;font-size:11.5px;font-weight:600;flex:0 0 auto}\n.avatar.sm{width:26px;height:26px;font-size:10.5px}\n\n.page{flex:1;min-height:0;padding:24px;display:flex;flex-direction:column;gap:16px}\n.page-head{height:56px;flex:0 0 56px;display:flex;align-items:flex-end;justify-content:space-between}\n.page-head h1{margin:0;font-size:26px;line-height:1.2;font-weight:600;letter-spacing:-.022em}\n.page-head .meta{font-size:13px;color:var(--ink-3);padding-bottom:3px}\n.panel{background:var(--surface);border:1px solid var(--line);border-radius:12px}\n\n.btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;height:36px;padding:0 14px;border:1px solid transparent;border-radius:8px;background:transparent;font-size:13px;font-weight:500;cursor:pointer;transition:background .12s ease,border-color .12s ease,color .12s ease}\n.btn i{font-size:15px}\n.btn-sm{height:30px;font-size:12.5px;padding:0 10px}\n.btn-outline{border-color:#D6DFD9;background:#fff;color:var(--ink)}\n.btn-outline:hover{background:#F6F8F7;border-color:#C2D0C8}\n.btn-quiet{color:var(--ink-2)}\n.btn-quiet:hover{background:#EFF3F1;color:var(--ink)}\n.link{display:inline-flex;align-items:center;gap:5px;font-size:12.5px;font-weight:500;color:var(--green)}\n.link i{font-size:13px}\n.link:hover{text-decoration:underline}\n\n.tabs{height:40px;flex:0 0 40px;display:flex;align-items:stretch;gap:24px;border-bottom:1px solid var(--line)}\n.tab{display:inline-flex;align-items:center;gap:7px;font-size:13.5px;font-weight:500;color:var(--ink-3);border-bottom:2px solid transparent;margin-bottom:-1px;padding:0 1px}\n.tab i{font-size:14px}\n.tab.active{color:var(--ink);border-bottom-color:var(--green);font-weight:600}\n.tab:hover{color:var(--ink)}\n\n/* roster */\n.roster{height:208px;flex:0 0 208px;display:flex;flex-direction:column;overflow:hidden}\n.roster-head{height:40px;flex:0 0 40px;padding:0 16px;display:flex;align-items:center;gap:10px;border-bottom:1px solid var(--line-2)}\n.roster-head h2{margin:0;font-size:14px;font-weight:600;flex:1}\n.roster-head .cnt{font-size:12px;color:var(--ink-3)}\n\n.tbl{width:100%;border-collapse:collapse;table-layout:fixed}\n.tbl th{height:36px;padding:0 16px;text-align:left;font-size:12px;font-weight:500;color:var(--ink-3);border-bottom:1px solid var(--line);background:#FAFBFA}\n.tbl th.right{text-align:right}\n.tbl td{height:44px;padding:0 16px;border-bottom:1px solid var(--line-2);font-size:13.5px;vertical-align:middle}\n.tbl td.right{text-align:right}\n.tbl tbody tr:hover{background:#F7FAF8}\n.tbl tbody tr:last-child td{border-bottom:0}\n.tbl tbody tr.selected{background:rgba(11,93,59,.055)}\n.tbl tbody tr.selected .row-action{text-decoration:underline}\n.who{display:flex;align-items:center;gap:9px;min-width:0}\n.who-name{font-size:13.5px;font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.row-action{display:inline-flex;align-items:center;gap:4px;font-size:13px;font-weight:500;color:var(--green)}\n.row-action i{font-size:13px}\n.who .avatar{width:26px;height:26px;font-size:10.5px}\n\n/* audit */\n.ap{flex:1;min-height:0;display:flex;flex-direction:column;overflow:hidden}\n.ahead{height:48px;flex:0 0 48px;padding:0 16px;display:flex;align-items:center;gap:12px;border-bottom:1px solid var(--line-2)}\n.ahead h2{margin:0;font-size:14px;font-weight:600;flex:1}\n.mini-select{position:relative;display:flex;align-items:center}\n.mini-select select{height:30px;width:156px;border:1px solid #D9E1DC;border-radius:7px;background:#fff;padding:0 26px 0 9px;font-family:inherit;font-size:12.5px;color:var(--ink);appearance:none}\n.mini-select i{position:absolute;right:9px;font-size:12px;color:var(--ink-3);pointer-events:none}\n.a-row{display:grid;grid-template-columns:186px 194px 1fr 108px;align-items:center;height:40px;padding:0 16px;border-bottom:1px solid var(--line-2);font-size:13px}\n.a-row:hover{background:#F7FAF8}\n.a-row.sel{background:rgba(11,93,59,.055)}\n.a-actor{font-weight:500}\n.a-act{display:flex;align-items:center;gap:7px;color:var(--ink-2)}\n.a-act i{font-size:13px;color:var(--ink-3)}\n.a-target{color:var(--ink-2);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;padding-right:12px}\n.a-time{font-size:12.5px;color:var(--ink-3);text-align:right}\n.afoot{height:56px;flex:0 0 56px;display:flex;align-items:center;gap:12px;padding:0 16px;background:#F7FAF8;border-top:1px solid var(--line-2);margin-top:auto}\n.afoot .ico{font-size:15px;color:var(--green)}\n.afoot .es-t{font-size:12.5px;font-weight:600}\n.afoot .es-b{font-size:12.5px;color:var(--ink-2)}\n.afoot .es-meta{margin-left:auto;display:flex;align-items:center;gap:8px;font-size:11.5px;color:var(--ink-3)}\n\n.pill{display:inline-flex;align-items:center;gap:6px;height:24px;padding:0 9px;border-radius:999px;font-size:12px;font-weight:500;white-space:nowrap}\n.pill .dot{width:6px;height:6px;border-radius:999px;background:currentColor;flex:0 0 auto}\n.pill-active{background:#EAF4EE;color:#14664A}\n\n@media (prefers-reduced-motion: reduce){*{transition:none !important;animation:none !important}}\n</style>\n<div class=\"app\" data-kid=\"1\" data-name=\"admin dashboard app shell\">\n<aside class=\"sidebar\" data-kid=\"1-1\" data-name=\"sidebar navigation panel\">\n<div class=\"brand\" data-kid=\"1-1-1\" data-name=\"brand identity block\">\n<div class=\"brand-mark\" data-kid=\"1-1-1-1\" data-name=\"brand logo mark\">ER</div>\n<div data-kid=\"1-1-1-2\" data-name=\"brand text block\">\n<div class=\"brand-name\" data-kid=\"1-1-1-2-1\" data-name=\"product name\">Easy Ride</div>\n<div class=\"brand-sub\" data-kid=\"1-1-1-2-2\" data-name=\"product tagline\">Administration</div>\n</div>\n</div>\n<nav class=\"nav\" data-kid=\"1-1-2\" data-name=\"sidebar navigation menu\">\n<div class=\"nav-group\" data-kid=\"1-1-2-1\" data-name=\"operations nav group\">\n<div class=\"nav-label\" data-kid=\"1-1-2-1-1\" data-name=\"operations group label\">Operations</div>\n<a class=\"nav-item\" data-kid=\"1-1-2-1-2\" data-name=\"overview nav link\" href=\"#\"><i class=\"icon-gauge\" data-kid=\"1-1-2-1-2-1\" data-name=\"gauge icon\"></i><span class=\"lbl\" data-kid=\"1-1-2-1-2-2\" data-name=\"overview nav label\">Overview</span></a>\n<a class=\"nav-item\" data-kid=\"1-1-2-1-3\" data-name=\"support nav link\" href=\"#\"><i class=\"icon-headphones\" data-kid=\"1-1-2-1-3-1\" data-name=\"headphones icon\"></i><span class=\"lbl\" data-kid=\"1-1-2-1-3-2\" data-name=\"support nav label\">Support</span><span class=\"nav-count tnum\" data-kid=\"1-1-2-1-3-3\" data-name=\"support nav count badge\">7</span></a>\n</div>\n<div class=\"nav-group\" data-kid=\"1-1-2-2\" data-name=\"marketplace nav group\">\n<div class=\"nav-label\" data-kid=\"1-1-2-2-1\" data-name=\"marketplace group label\">Marketplace</div>\n<a class=\"nav-item\" data-kid=\"1-1-2-2-2\" data-name=\"listings nav link\" href=\"#\"><i class=\"icon-car\" data-kid=\"1-1-2-2-2-1\" data-name=\"car icon\"></i><span class=\"lbl\" data-kid=\"1-1-2-2-2-2\" data-name=\"listings nav label\">Listings</span><span class=\"nav-count tnum\" data-kid=\"1-1-2-2-2-3\" data-name=\"listings nav count badge\">23</span></a>\n<a class=\"nav-item\" data-kid=\"1-1-2-2-3\" data-name=\"verification nav link\" href=\"#\"><i class=\"icon-shield-check\" data-kid=\"1-1-2-2-3-1\" data-name=\"shield check icon\"></i><span class=\"lbl\" data-kid=\"1-1-2-2-3-2\" data-name=\"verification nav label\">Verification</span><span class=\"nav-count tnum\" data-kid=\"1-1-2-2-3-3\" data-name=\"verification nav count badge\">9</span></a>\n<a class=\"nav-item\" data-kid=\"1-1-2-2-4\" data-name=\"reports nav link\" href=\"#\"><i class=\"icon-flag\" data-kid=\"1-1-2-2-4-1\" data-name=\"flag icon\"></i><span class=\"lbl\" data-kid=\"1-1-2-2-4-2\" data-name=\"reports nav label\">Reports</span><span class=\"nav-count tnum\" data-kid=\"1-1-2-2-4-3\" data-name=\"reports nav count badge\">4</span></a>\n</div>\n<div class=\"nav-group\" data-kid=\"1-1-2-3\" data-name=\"transactions nav group\">\n<div class=\"nav-label\" data-kid=\"1-1-2-3-1\" data-name=\"transactions group label\">Transactions</div>\n<a class=\"nav-item\" data-kid=\"1-1-2-3-2\" data-name=\"bookings nav link\" href=\"#\"><i class=\"icon-calendar-days\" data-kid=\"1-1-2-3-2-1\" data-name=\"calendar icon\"></i><span class=\"lbl\" data-kid=\"1-1-2-3-2-2\" data-name=\"bookings nav label\">Bookings</span><span class=\"nav-count tnum\" data-kid=\"1-1-2-3-2-3\" data-name=\"bookings nav count badge\">12</span></a>\n<a class=\"nav-item\" data-kid=\"1-1-2-3-3\" data-name=\"offers nav link\" href=\"#\"><i class=\"icon-handshake\" data-kid=\"1-1-2-3-3-1\" data-name=\"handshake icon\"></i><span class=\"lbl\" data-kid=\"1-1-2-3-3-2\" data-name=\"offers nav label\">Offers</span><span class=\"nav-count tnum\" data-kid=\"1-1-2-3-3-3\" data-name=\"offers nav count badge\">9</span></a>\n<a class=\"nav-item\" data-kid=\"1-1-2-3-4\" data-name=\"payments nav link\" href=\"#\"><i class=\"icon-credit-card\" data-kid=\"1-1-2-3-4-1\" data-name=\"credit card icon\"></i><span class=\"lbl\" data-kid=\"1-1-2-3-4-2\" data-name=\"payments nav label\">Payments</span></a>\n<a class=\"nav-item\" data-kid=\"1-1-2-3-5\" data-name=\"disputes nav link\" href=\"#\"><i class=\"icon-scale\" data-kid=\"1-1-2-3-5-1\" data-name=\"scale icon\"></i><span class=\"lbl\" data-kid=\"1-1-2-3-5-2\" data-name=\"disputes nav label\">Disputes</span></a>\n</div>\n<div class=\"nav-group\" data-kid=\"1-1-2-4\" data-name=\"administration nav group\">\n<div class=\"nav-label\" data-kid=\"1-1-2-4-1\" data-name=\"administration group label\">Administration</div>\n<a class=\"nav-item\" data-kid=\"1-1-2-4-2\" data-name=\"audit logs nav link\" href=\"#\"><i class=\"icon-history\" data-kid=\"1-1-2-4-2-1\" data-name=\"history icon\"></i><span class=\"lbl\" data-kid=\"1-1-2-4-2-2\" data-name=\"audit logs nav label\">Audit logs</span></a>\n</div>\n<div class=\"nav-priv\" data-kid=\"1-1-2-5\" data-name=\"super admin nav group\">\n<div class=\"nav-label\" data-kid=\"1-1-2-5-1\" data-name=\"super admin group label\"><i class=\"icon-shield\" data-kid=\"1-1-2-5-1-1\" data-name=\"shield icon\"></i>Super administrator</div>\n<a class=\"nav-item\" data-kid=\"1-1-2-5-2\" data-name=\"accounts nav link\" href=\"#\"><i class=\"icon-users\" data-kid=\"1-1-2-5-2-1\" data-name=\"users icon\"></i><span class=\"lbl\" data-kid=\"1-1-2-5-2-2\" data-name=\"accounts nav label\">Accounts</span></a>\n<a aria-current=\"page\" class=\"nav-item active\" data-kid=\"1-1-2-5-3\" data-name=\"administrators nav active link\" href=\"#\"><i class=\"icon-lock\" data-kid=\"1-1-2-5-3-1\" data-name=\"lock icon\"></i><span class=\"lbl\" data-kid=\"1-1-2-5-3-2\" data-name=\"administrators nav label\">Administrators</span></a>\n</div>\n</nav>\n<div class=\"sidebar-foot\" data-kid=\"1-1-3\" data-name=\"sidebar user footer\">\n<div class=\"me\" data-kid=\"1-1-3-1\" data-name=\"user profile card with logout\">\n<span class=\"avatar\" data-kid=\"1-1-3-1-1\" data-name=\"user avatar initials\">TM</span>\n<div data-kid=\"1-1-3-1-2\" data-name=\"user identity block\">\n<div class=\"me-name\" data-kid=\"1-1-3-1-2-1\" data-name=\"user name\">Tarisai Mudimu</div>\n<div class=\"me-role\" data-kid=\"1-1-3-1-2-2\" data-name=\"user role\">Super administrator</div>\n</div>\n<i class=\"icon-log-out logout\" data-kid=\"1-1-3-1-3\" data-name=\"logout icon button\"></i>\n</div>\n</div>\n</aside>\n<div class=\"main\" data-kid=\"1-2\" data-name=\"main content column\">\n<header class=\"topbar\" data-kid=\"1-2-1\" data-name=\"topbar header\">\n<div class=\"crumbs\" data-kid=\"1-2-1-1\" data-name=\"breadcrumb navigation\"><span data-kid=\"1-2-1-1-1\" data-name=\"breadcrumb parent label\">Administration</span><span class=\"sep\" data-kid=\"1-2-1-1-2\" data-name=\"breadcrumb separator\">/</span><strong data-kid=\"1-2-1-1-3\" data-name=\"breadcrumb current page\">Administrators</strong></div>\n<div class=\"topbar-right\" data-kid=\"1-2-1-2\" data-name=\"topbar right actions\">\n<span class=\"role-chip\" data-kid=\"1-2-1-2-1\" data-name=\"super admin role chip\"><i class=\"icon-shield-check\" data-kid=\"1-2-1-2-1-1\" data-name=\"role chip shield icon\"></i>Super administrator</span>\n<button class=\"profile\" data-kid=\"1-2-1-2-2\" data-name=\"user profile dropdown button\"><span class=\"avatar sm\" data-kid=\"1-2-1-2-2-1\" data-name=\"profile avatar initials\">TM</span>Tarisai Mudimu<i class=\"icon-chevron-down\" data-kid=\"1-2-1-2-2-2\" data-name=\"profile chevron icon\"></i></button>\n</div>\n</header>\n<div class=\"page\" data-kid=\"1-2-2\" data-name=\"main page container\">\n<div class=\"page-head\" data-kid=\"1-2-2-1\" data-name=\"page title header bar\">\n<h1 data-kid=\"1-2-2-1-1\" data-name=\"page headline\">Users</h1>\n<span class=\"meta tnum\" data-kid=\"1-2-2-1-2\" data-name=\"page result count meta\">6 administrator accounts</span>\n</div>\n<div class=\"tabs\" data-kid=\"1-2-2-2\" data-name=\"tab navigation\">\n<a class=\"tab\" data-kid=\"1-2-2-2-1\" data-name=\"directory tab\" href=\"#\">Directory</a>\n<a aria-current=\"page\" class=\"tab active\" data-kid=\"1-2-2-2-2\" data-name=\"oversight tab active\" href=\"#\"><i class=\"icon-shield\" data-kid=\"1-2-2-2-2-1\" data-name=\"oversight tab shield icon\"></i>Oversight</a>\n</div>\n<section aria-labelledby=\"roster-title\" class=\"panel roster\" data-kid=\"1-2-2-3\" data-name=\"administrator roster section\">\n<div class=\"roster-head\" data-kid=\"1-2-2-3-1\" data-name=\"roster section header\">\n<h2 data-kid=\"1-2-2-3-1-1\" data-name=\"roster section title\" id=\"roster-title\">Administrator accounts</h2>\n<span class=\"cnt tnum\" data-kid=\"1-2-2-3-1-2\" data-name=\"roster account count\">6 accounts, 2 super administrators</span>\n<a class=\"link\" data-kid=\"1-2-2-3-1-3\" data-name=\"open in directory link\" href=\"#\">Open in directory<i class=\"icon-arrow-right\" data-kid=\"1-2-2-3-1-3-1\" data-name=\"arrow icon\"></i></a>\n</div>\n<table aria-label=\"Administrator accounts\" class=\"tbl\" data-kid=\"1-2-2-3-2\" data-name=\"administrator accounts table\">\n<colgroup data-kid=\"1-2-2-3-2-1\" data-name=\"table column layout group\"><col data-kid=\"1-2-2-3-2-1-1\" data-name=\"actor column\" style=\"width:300px\"/><col data-kid=\"1-2-2-3-2-1-2\" data-name=\"email column\" style=\"width:300px\"/><col data-kid=\"1-2-2-3-2-1-3\" data-name=\"level column\" style=\"width:196px\"/><col data-kid=\"1-2-2-3-2-1-4\" data-name=\"access column\" style=\"width:150px\"/><col data-kid=\"1-2-2-3-2-1-5\" data-name=\"action column\"/></colgroup>\n<thead data-kid=\"1-2-2-3-2-2\" data-name=\"table head\">\n<tr data-kid=\"1-2-2-3-2-2-1\" data-name=\"table header row\"><th data-kid=\"1-2-2-3-2-2-1-1\" data-name=\"administrator column header\" scope=\"col\">Administrator</th><th data-kid=\"1-2-2-3-2-2-1-2\" data-name=\"email column header\" scope=\"col\">Email</th><th data-kid=\"1-2-2-3-2-2-1-3\" data-name=\"level column header\" scope=\"col\">Level</th><th data-kid=\"1-2-2-3-2-2-1-4\" data-name=\"access column header\" scope=\"col\">Access</th><th class=\"right\" data-kid=\"1-2-2-3-2-2-1-5\" data-name=\"action column header\" scope=\"col\">Action</th></tr>\n</thead>\n<tbody data-kid=\"1-2-2-3-2-3\" data-name=\"table body\">\n<tr data-kid=\"1-2-2-3-2-3-1\" data-name=\"admin row Tarisai Mudimu\">\n<td data-kid=\"1-2-2-3-2-3-1-1\" data-name=\"admin cell\"><div class=\"wh