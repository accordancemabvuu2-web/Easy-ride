    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "firebase": "^12.16.0",
    "firebase-admin": "^13.5.0",
    "jose": "^6.2.13",
    "lucide-react": "^1.24.0",
    "mongoose": "^9.11.2",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.9.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.13",
    "@tailwindcss/postcss": "^4",
    "@types/google.maps": "^3.65.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
