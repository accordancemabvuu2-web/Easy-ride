      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n</style>\n<div class=\"min-h-screen bg-[#f8f9fa] text-[#202124] [font-family:Inter,Arial,sans-serif] antialiased\" data-kid=\"1\">\n    <div class=\"flex min-h-screen\" data-kid=\"1-1\">\n        <aside class=\"hidden w-[248px] shrink-0 flex-col bg-[#073f2b] px-4 py-5 text-white lg:flex\" data-kid=\"1-1-1\">\n            <a aria-label=\"Easy Ride administration home\" class=\"flex items-center gap-3 px-3 py-2.5\" data-kid=\"1-1-1-1\" href=\"/admin\">\n                <span class=\"flex h-10 w-10 items-center justify-center rounded-xl bg-[#c9a227] text-sm font-bold tracking-tight text-[#02140b]\" data-kid=\"1-1-1-1-1\">\n                    ER\n                </span>\n                <span class=\"min-w-0\" data-kid=\"1-1-1-1-2\">\n                    <span class=\"block text-[15px] font-bold tracking-tight\" data-kid=\"1-1-1-1-2-1\">\n                        Easy Ride\n                    </span>\n                    <span class=\"mt-0.5 block text-xs text-white/65\" data-kid=\"1-1-1-1-2-2\">\n                        Administration\n                    </span>\n                </span>\n            </a>\n            <div class=\"mt-8 px-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-white/60\" data-kid=\"1-1-1-2\">\n                Operations\n            </div>\n            <nav aria-label=\"Admin navigation\" class=\"mt-2 flex flex-col gap-1\" data-kid=\"1-1-1-3\">\n                <a class=\"flex min-h-11 items-center gap-3 rounded-xl px-3 text-sm font-medium text-white/80 hover:bg-white/10\" data-kid=\"1-1-1-3-1\" href=\"/admin\">\n                    <i aria-hidden=\"true\" class=\"icon icon-gauge h-5 w-5 text-[18px]\" data-kid=\"1-1-1-3-1-1\">\n                    </i>\n                    Overview\n                </a>\n                <a class=\"flex min-h-11 items-center gap-3 rounded-xl px-3 text-sm font-medium text-white/80 hover:bg-white/10\" data-kid=\"1-1-1-3-2\" href=\"/admin/users\">\n                    <i aria-hidden=\"true\" class=\"icon icon-users h-5 w-5 text-[18px]\" data-kid=\"1-1-1-3-2-1\">\n                    </i>\n                    Users\n                </a>\n                <a class=\"flex min-h-11 items-center gap-3 rounded-xl px-3 text-sm font-medium text-white/80 hover:bg-white/10\" data-kid=\"1-1-1-3-3\" href=\"/admin/listings\">\n                    <i aria-hidden=\"true\" class=\"icon icon-car-front h-5 w-5 text-[18px]\" data-kid=\"1-1-1-3-3-1\">\n                    </i>\n                    Listings\n                </a>\n                <a class=\"flex min-h-11 items-center gap-3 rounded-xl px-3 text-sm font-medium text-white/80 hover:bg-white/10\" data-kid=\"1-1-1-3-4\" href=\"/admin/reports\">\n                    <i aria-hidden=\"true\" class=\"icon icon-file-warning h-5 w-5 text-[18px]\" data-kid=\"1-1-1-3-4-1\">\n                    </i>\n                    Reports\n                </a>\n                <a class=\"flex min-h-11 items-center gap-3 rounded-xl px-3 text-sm font-medium text-white/80 hover:bg-white/10\" data-kid=\"1-1-1-3-5\" href=\"/admin/bookings\">\n                    <i aria-hidden=\"true\" class=\"icon icon-calendar-days h-5 w-5 text-[18px]\" data-kid=\"1-1-1-3-5-1\">\n                    </i>\n                    Bookings\n                </a>\n                <a class=\"flex min-h-11 items-center gap-3 rounded-xl px-3 text-sm font-medium text-white/80 hover:bg-white/10\" data-kid=\"1-1-1-3-6\" href=\"/admin/offers\">\n                    <i aria-hidden=\"true\" class=\"icon icon-handshake h-5 w-5 text-[18px]\" data-kid=\"1-1-1-3-6-1\">\n                    </i>\n                    Offers\n                </a>\n                <a class=\"flex min-h-11 items-center gap-3 rounded-xl px-3 text-sm font-medium text-white/80 hover:bg-white/10\" data-kid=\"1-1-1-3-7\" href=\"/admin/payments\">\n                    <i aria-hidden=\"true\" class=\"icon icon-badge-dollar-sign h-5 w-5 text-[18px]\" data-kid=\"1-1-1-3-7-1\">\n                    </i>\n                    Payments\n                </a>\n                <a class=\"flex min-h-11 items-center gap-3 rounded-xl px-3 text-sm font-medium text-white/80 hover:bg-white/10\" data-kid=\"1-1-1-3-8\" href=\"/admin/support\">\n                    <i aria-hidden=\"true\" class=\"icon icon-headphones h-5 w-5 text-[18px]\" data-kid=\"1-1-1-3-8-1\">\n                    </i>\n                    Support\n                </a>\n                <a aria-current=\"page\" class=\"flex min-h-11 items-center gap-3 rounded-xl bg-white px-3 text-sm font-semibold text-[#0b5d3b] shadow-sm\" data-kid=\"1-1-1-3-9\" href=\"/admin/verification\">\n                    <i aria-hidden=\"true\" class=\"icon icon-file-check-2 h-5 w-5 text-[18px]\" data-kid=\"1-1-1-3-9-1\">\n                    </i>\n                    Verification\n                </a>\n                <a class=\"flex min-h-11 items-center gap-3 rounded-xl px-3 text-sm font-medium text-white/80 hover:bg-white/10\" data-kid=\"1-1-1-3-10\" href=\"/admin/audit-logs\">\n                    <i aria-hidden=\"true\" class=\"icon icon-history h-5 w-5 text-[18px]\" data-kid=\"1-1-1-3-10-1\">\n                    </i>\n                    Audit logs\n                </a>\n            </nav>\n            <div class=\"mt-auto border-t border-white/15 pt-4\" data-kid=\"1-1-1-4\">\n                <div class=\"flex items-center gap-3 rounded-xl px-3 py-3\" data-kid=\"1-1-1-4-1\">\n                    <span class=\"flex h-9 w-9 items-center justify-center rounded-full border border-white/20 bg-white/10 text-sm font-semibold text-white/90\" data-kid=\"1-1-1-4-1-1\">\n                        A\n                    </span>\n                    <span class=\"min-w-0\" data-kid=\"1-1-1-4-1-2\">\n                        <span class=\"block truncate text-sm font-semibold\" data-kid=\"1-1-1-4-1-2-1\">\n                            Administrator\n                        </span>\n                        <span class=\"mt-0.5 block text-xs text-white/60\" data-kid=\"1-1-1-4-1-2-2\">\n                            Admin account\n                        </span>\n                    </span>\n                </div>\n                <button class=\"mt-1 flex min-h-10 w-full items-center gap-3 rounded-xl px-3 text-sm font-medium text-white/75 hover:bg-white/10\" data-kid=\"1-1-1-4-2\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"icon icon-log-out h-5 w-5 text-[18px]\" data-kid=\"1-1-1-4-2-1\">\n                    </i>\n                    Log out\n                </button>\n            </div>\n        </aside>\n        <main class=\"min-w-0 flex-1\" data-kid=\"1-1-2\">\n            <header class=\"flex h-[68px] items-center justify-between border-b border-[#e5e7eb] bg-white px-5 sm:px-8\" data-kid=\"1-1-2-1\">\n                <div class=\"flex items-center gap-2 text-sm text-[#6b6b6b]\" data-kid=\"1-1-2-1-1\">\n                    <span data-kid=\"1-1-2-1-1-1\">\n                        Admin\n                    </span>\n                    <i aria-hidden=\"true\" class=\"icon icon-chevron-right text-[14px]\" data-kid=\"1-1-2-1-1-2\">\n                    </i>\n                    <span class=\"font-semibold text-[#202124]\" data-kid=\"1-1-2-1-1-3\">\n                        Verification\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-3\" data-kid=\"1-1-2-1-2\">\n                    <span class=\"hidden text-sm text-[#6b6b6b] sm:inline\" data-kid=\"1-1-2-1-2-1\">\n                        Review submitted information before deciding\n                    </span>\n                    <span class=\"flex h-9 w-9 items-center justify-center rounded-full border border-[#e5e7eb] bg-[#f1f3f0] text-xs font-semibold text-[#0b5d3b]\" data-kid=\"1-1-2-1-2-2\">\n                        ER\n                    </span>\n                </div>\n            </header>\n            <div class=\"mx-auto max-w-[1440px] px-5 pb-8 pt-7 sm:px-8\" data-kid=\"1-1-2-2\">\n                <div class=\"flex flex-wrap items-end justify-between gap-5\" data-kid=\"1-1-2-2-1\">\n                    <div class=\"max-w-2xl\" data-kid=\"1-1-2-2-1-1\">\n                        <h1 class=\"text-[30px] font-semibold leading-tight tracking-[-0.03em] text-[#202124]\" data-kid=\"1-1-2-2-1-1-1\">\n                            Verification review\n                        </h1>\n                        <p class=\"mt-2 text-[15px] leading-6 text-[#6b6b6b]\" data-kid=\"1-1-2-2-1-1-2\">\n                            Review the request type and the documents actually submitted. Make a decision only after checking the available evidence.\n                        </p>\n                    </div>\n                    <p class=\"mb-1 flex items-center gap-2 rounded-full border border-[#c9a227]/25 bg-[#c9a227]/10 px-3 py-2 text-sm font-medium text-[#6b6b6b]\" data-kid=\"1-1-2-2-1-2\">\n                        <span class=\"h-2 w-2 rounded-full bg-[#c9a227]\" data-kid=\"1-1-2-2-1-2-1\">\n                        </span>\n                        Pending requests only\n                    </p>\n                </div>\n                <div class=\"mt-6 grid gap-4 rounded-xl border border-[#e5e7eb] bg-white p-4 shadow-sm sm:grid-cols-[minmax(0,1fr)_250px]\" data-kid=\"1-1-2-2-2\">\n                    <label class=\"block min-w-0\" data-kid=\"1-1-2-2-2-1\">\n                        <span class=\"mb-1.5 block text-[13px] font-semibold text-[#3c3c3c]\" data-kid=\"1-1-2-2-2-1-1\">\n                            Search requests\n                        </span>\n                        <span class=\"flex h-11 items-center gap-2.5 rounded-xl border border-[#e5e7eb] bg-[#f8f9fa] px-3.5 focus-within:border-[#0b5d3b] focus-within:ring-2 focus-within:ring-[#0b5d3b]/10\" data-kid=\"1-1-2-2-2-1-2\">\n                            <i aria-hidden=\"true\" class=\"icon icon-search text-[17px] text-[#6b6b6b]\" data-kid=\"1-1-2-2-2-1-2-1\">\n                            </i>\n                            <input aria-label=\"Search requests by name, email, or notes\" class=\"min-w-0 flex-1 bg-transparent text-sm text-[#202124] outline-none placeholder:text-[#9a9a9a]\" data-kid=\"1-1-2-2-2-1-2-2\" placeholder=\"Name, email, or notes\" type=\"search\"/>\n                        </span>\n                    </label>\n                    <label class=\"block\" data-kid=\"1-1-2-2-2-2\">\n                        <span class=\"mb-1.5 block text-[13px] font-semibold text-[#3c3c3c]\" data-kid=\"1-1-2-2-2-2-1\">\n                            Request type\n                        </span>\n                        <span class=\"relative block\" data-kid=\"1-1-2-2-2-2-2\">\n                            <select class=\"h-11 w-full appearance-none rounded-xl border border-[#e5e7eb] bg-white px-3.5 pr-10 text-sm text-[#202124] outline-none focus:border-[#0b5d3b] focus:ring-2 focus:ring-[#0b5d3b]/10\" data-kid=\"1-1-2-2-2-2-2-1\">\n                                <option data-kid=\"1-1-2-2-2-2-2-1-1\">\n                                    All request types\n                                </option>\n                                <option data-kid=\"1-1-2-2-2-2-2-1-2\">\n                                    Identity\n                                </option>\n                                <option data-kid=\"1-1-2-2-2-2-2-1-3\">\n                                    Private seller\n                                </option>\n                                <option data-kid=\"1-1-2-2-2-2-2-1-4\">\n                                    Dealer\n                                </option>\n                            </select>\n                            <i aria-hidden=\"true\" class=\"icon icon-chevron-down pointer-events-none absolute right-3.5 top-1/2 -translate-y-1/2 text-[16px] text-[#6b6b6b]\" data-kid=\"1-1-2-2-2-2-2-2\">\n                            </i>\n                        </span>\n                    </label>\n                </div>\n                <div class=\"mt-5 grid min-h-[470px] gap-5 xl:grid-cols-[minmax(300px,0.76fr)_minmax(0,1.45fr)]\" data-kid=\"1-1-2-2-3\">\n                    <section aria-labelledby=\"queue-heading\" class=\"flex flex-col rounded-xl border border-[#e5e7eb] bg-white shadow-sm\" data-kid=\"1-1-2-2-3-1\">\n                        <div class=\"border-b border-[#e5e7eb] px-5 py-4\" data-kid=\"1-1-2-2-3-1-1\">\n                            <h2 class=\"text-base font-semibold text-[#202124]\" data-kid=\"1-1-2-2-3-1-1-1\" id=\"queue-heading\">\n                                Pending requests\n                            </h2>\n                            <p class=\"mt-1 text-sm text-[#6b6b6b]\" data-kid=\"1-1-2-2-3-1-1-2\">\n                                Identity · Private seller · Dealer\n                            </p>\n                        </div>\n                        <div class=\"flex flex-1 flex-col items-center justify-center px-7 py-12 text-center\" data-kid=\"1-1-2-2-3-1-2\">\n                            <span class=\"flex h-12 w-12 items-center justify-center rounded-xl border border-[#e5e7eb] bg-[#f1f3f0] text-[#0b5d3b]\" data-kid=\"1-1-2-2-3-1-2-1\">\n                                <i aria-hidden=\"true\" class=\"icon icon-files h-6 w-6 text-[22px]\" data-kid=\"1-1-2-2-3-1-2-1-1\">\n                                </i>\n                            </span>\n                            <h3 class=\"mt-4 text-base font-semibold text-[#202124]\" data-kid=\"1-1-2-2-3-1-2-2\">\n                                No pending requests\n                            </h3>\n                            <p class=\"mt-2 max-w-[265px] text-sm leading-6 text-[#6b6b6b]\" data-kid=\"1-1-2-2-3-1-2-3\">\n                                Verification submissions will appear here when they are ready for review.\n                            </p>\n                            <p class=\"mt-5 border-t border-[#e5e7eb] pt-4 text-xs leading-5 text-[#6b6b6b]\" data-kid=\"1-1-2-2-3-1-2-4\">\n                                Choose a request to view its submitted details and available documents.\n                            </p>\n                        </div>\n                    </section>\n                    <section aria-labelledby=\"details-heading\" class=\"flex flex-col rounded-xl border border-[#e5e7eb] bg-white shadow-sm\" data-kid=\"1-1-2-2-3-2\">\n                        <div class=\"flex flex-wrap items-center justify-between gap-3 border-b border-[#e5e7eb] px-5 py-4\" data-kid=\"1-1-2-2-3-2-1\">\n                            <div data-kid=\"1-1-2-2-3-2-1-1\">\n                                <h2 class=\"text-base font-semibold text-[#202124]\" data-kid=\"1-1-2-2-3-2-1-1-1\" id=\"details-heading\">\n                                    Request details\n                                </h2>\n                                <p class=\"mt-1 text-sm text-[#6b6b6b]\" data-kid=\"1-1-2-2-3-2-1-1-2\">\n                                    No request selected\n                                </p>\n                            </div>\n                            <span class=\"rounded-md border border-[#e5e7eb] bg-[#f1f3f0] px-2.5 py-1.5 text-xs font-medium text-[#6b6b6b]\" data-kid=\"1-1-2-2-3-2-1-2\">\n                                Select a pending request\n                            </span>\n                        </div>\n                        <div class=\"flex flex-1 flex-col px-5 py-5\" data-kid=\"1-1-2-2-3-2-2\">\n                            <div class=\"flex items-start gap-3 rounded-lg border-l-2 border-[#0b5d3b] bg-[#f1f3f0] px-4 py-3.5\" data-kid=\"1-1-2-2-3-2-2-1\">\n                                <i aria-hidden=\"true\" class=\"icon icon-info h-5 w-5 shrink-0 text-[18px] text-[#0b5d3b]\" data-kid=\"1-1-2-2-3-2-2-1-1\">\n                                </i>\n                                <p class=\"text-sm leading-5 text-[#3c3c3c]\" data-kid=\"1-1-2-2-3-2-2-1-2\">\n                                    Applicant details, notes, and document previews will appear here after you select a real request.\n                                </p>\n                            </div>\n                            <div class=\"mt-5\" data-kid=\"1-1-2-2-3-2-2-2\">\n                                <div class=\"flex items-baseline justify-between gap-3\" data-kid=\"1-1-2-2-3-2-2-2-1\">\n                                    <h3 class=\"text-sm font-semibold text-[#202124]\" data-kid=\"1-1-2-2-3-2-2-2-1-1\">\n                                        Submitted documents\n                                    </h3>\n                                    <span class=\"text-xs text-[#6b6b6b]\" data-kid=\"1-1-2-2-3-2-2-2-1-2\">\n                                        Shown only when attached\n                                    </span>\n                                </div>\n                                <div class=\"mt-3 divide-y divide-[#e5e7eb] border-y border-[#e5e7eb]\" data-kid=\"1-1-2-2-3-2-2-2-2\">\n                                    <div class=\"flex items-center gap-3 py-3.5\" data-kid=\"1-1-2-2-3-2-2-2-2-1\">\n                                        <span class=\"flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-[#f1f3f0] text-[#6b6b6b]\" data-kid=\"1-1-2-2-3-2-2-2-2-1-1\">\n                                            <i aria-hidden=\"true\" class=\"icon icon-file-text text-[18px]\" data-kid=\"1-1-2-2-3-2-2-2-2-1-1-1\">\n                                            </i>\n                                        </span>\n                                        <span class=\"min-w-0 flex-1\" data-kid=\"1-1-2-2-3-2-2-2-2-1-2\">\n                                            <span class=\"block text-sm font-semibold text-[#202124]\" data-kid=\"1-1-2-2-3-2-2-2-2-1-2-1\">\n                                                Identity document\n                                            </span>\n                                            <span class=\"mt-0.5 block text-xs leading-5 text-[#6b6b6b]\" data-kid=\"1-1-2-2-3-2-2-2-2-1-2-2\">\n                                                Preview appears here if an identity document was submitted.\n                                            </span>\n                                        </span>\n                                        <i aria-hidden=\"true\" class=\"icon icon-arrow-up-right text-[16px] text-[#9a9a9a]\" data-kid=\"1-1-2-2-3-2-2-2-2-1-3\">\n                                        </i>\n                                    </div>\n                                    <div class=\"flex items-center gap-3 py-3.5\" data-kid=\"1-1-2-2-3-2-2-2-2-2\">\n                                        <span class=\"flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-[#f1f3f0] text-[#6b6b6b]\" data-kid=\"1-1-2-2-3-2-2-2-2-2-1\">\n                                            <i aria-hidden=\"true\" class=\"icon icon-file-text text-[18px]\" data-kid=\"1-1-2-2-3-2-2-2-2-2-1-1\">\n                                            </i>\n                                        </span>\n                                        <span class=\"min-w-0 flex-1\" data-kid=\"1-1-2-2-3-2-2-2-2-2-2\">\n                                            <span class=\"block text-sm font-semibold text-[#202124]\" data-kid=\"1-1-2-2-3-2-2-2-2-2-2-1\">\n                                                Business document\n                                                <span class=\"font-normal text-[#6b6b6b]\" data-kid=\"1-1-2-2-3-2-2-2-2-2-2-1-1\">\n                                                    · dealer requests\n                                                </span>\n                                            </span>\n                                            <span class=\"mt-0.5 block text-xs leading-5 text-[#6b6b6b]\" data-kid=\"1-1-2-2-3-2-2-2-2-2-2-2\">\n                                                Preview appears here if a business document was submitted.\n                                            </span>\n                                        </span>\n                                        <i aria-hidden=\"true\" class=\"icon icon-arrow-up-right text-[16px] text-[#9a9a9a]\" data-kid=\"1-1-2-2-3-2-2-2-2-2-3\">\n                                        </i>\n                                    </div>\n                                    <div class=\"flex items-center gap-3 py-3.5\" data-kid=\"1-1-2-2-3-2-2-2-2-3\">\n                                        <span class=\"flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-[#f1f3f0] text-[#6b6b6b]\" data-kid=\"1-1-2-2-3-2-2-2-2-3-1\">\n                                            <i aria-hidden=\"true\" class=\"icon icon-file-text text-[18px]\" data-kid=\"1-1-2-2-3-2-2-2-2-3-1-1\">\n                                            </i>\n                                        </span>\n                                        <span class=\"min-w-0 flex-1\" data-kid=\"1-1-2-2-3-2-2-2-2-3-2\">\n                                            <span class=\"block text-sm font-semibold text-[#202124]\" data-kid=\"1-1-2-2-3-2-2-2-2-3-2-1\">\n                                                Proof of address\n                                                <span class=\"font-normal text-[#6b6b6b]\" data-kid=\"1-1-2-2-3-2-2-2-2-3-2-1-1\">\n                                                    · optional\n                                                </span>\n                                            </span>\n                                            <span class=\"mt-0.5 block text-xs leading-5 text-[#6b6b6b]\" data-kid=\"1-1-2-2-3-2-2-2-2-3-2-2\">\n                                                Preview appears here if proof of address was submitted.\n                                            </span>\n                                        </span>\n                                        <i aria-hidden=\"true\" class=\"icon icon-arrow-up-right text-[16px] text-[#9a9a9a]\" data-kid=\"1-1-2-2-3-2-2-2-2-3-3\">\n                                        </i>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"mt-4 flex flex-1 items-end justify-between gap-4 border-t border-[#e5e7eb] pt-4\" data-kid=\"1-1-2-2-3-2-2-3\">\n                                <p class=\"max-w-[330px] text-xs leading-5 text-[#6b6b6b]\" data-kid=\"1-1-2-2-3-2-2-3-1\">\n                                    Decision controls become available only for a selected pending request.\n                                </p>\n                                <div class=\"flex shrink-0 gap-2\" data-kid=\"1-1-2-2-3-2-2-3-2\">\n                                    <button aria-disabled=\"true\" class=\"inline-flex h-10 items-center gap-2 rounded-lg border border-[#d1d5db] bg-white px-4 text-sm font-semibold text-[#9a9a9a] opacity-70\" data-kid=\"1-1-2-2-3-2-2-3-2-1\" disabled=\"\" type=\"button\">\n                                        <i aria-hidden=\"true\" class=\"icon icon-x text-[15px]\" data-kid=\"1-1-2-2-3-2-2-3-2-1-1\">\n                                        </i>\n                                        Reject\n                                    </button>\n                                    <button aria-disabled=\"true\" class=\"inline-flex h-10 items-center gap-2 rounded-lg bg-[#0b5d3b] px-4 text-sm font-semibold text-white opacity-45\" data-kid=\"1-1-2-2-3-2-2-3-2-2\" disabled=\"\" type=\"button\">\n                                        <i aria-hidden=\"true\" class=\"icon icon-check text-[16px]\" data-kid=\"1-1-2-2-3-2-2-3-2-2-1\">\n                                        </i>\n                                        Approve\n                                    </button>\n                                </div>\n                            </div>\n                        </div>\n                    </section>\n                </div>\n            </div>\n        </main>\n    </div>\n</div>\n",
